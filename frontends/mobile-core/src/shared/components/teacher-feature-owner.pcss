.teacher-mobile-shell {
  min-block-size: 100dvh;
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
}

.teacher-mobile-shell:where(:not([data-student-ui]))[data-theme='light'],
.teacher-mobile-shell:where(:not([data-student-ui])) [data-theme='light'] {
  --rct-color-surface-base: #f2f2f4;
}

/* Teacher five-item dock: keep complete labels at narrow mobile widths. */
@media (max-width: 22.5rem) {
  .mobile-shell:has(> .teacher-feature-owner) > .mobile-bottom-nav .mobile-bottom-nav__label {
    font-size: 0.625rem;
    letter-spacing: 0;
    overflow-wrap: normal;
    white-space: nowrap;
  }
}
/* The Teacher heading owns the first warning row; other roles keep their UI. */
:where(.teacher-mobile-shell:not([data-student-ui])) .teacher-feature-owner .student-warning {
  grid-template-columns: calc(var(--rct-icon-size) * 1.5) minmax(0, 1fr);
}
:where(.teacher-mobile-shell:not([data-student-ui]))
  .teacher-feature-owner .student-warning .student-warning__icon {
  inline-size: calc(var(--rct-icon-size) * 1.5);
  block-size: calc(var(--rct-icon-size) * 1.5);
  min-inline-size: calc(var(--rct-icon-size) * 1.5);
  max-inline-size: calc(var(--rct-icon-size) * 1.5);
  min-block-size: calc(var(--rct-icon-size) * 1.5);
  max-block-size: calc(var(--rct-icon-size) * 1.5);
  grid-column: 1;
  grid-row: 1;
  align-self: start;
  margin-block-start: 0;
  color: var(--rct-color-warning-text);
}
:where(.teacher-mobile-shell:not([data-student-ui]))
  .teacher-feature-owner .student-warning[data-severity='error'] .student-warning__icon {
  color: var(--rct-color-danger-text);
}
:where(.teacher-mobile-shell:not([data-student-ui])) .teacher-feature-owner .student-warning h2 {
  grid-column: 2;
  grid-row: 1;
  line-height: calc(var(--rct-icon-size) * 1.5);
}
/* Telegram owns Back for profile details; PWA keeps the product control. */
.teacher-feature-owner[data-host-back='true'] .profile-back {
  display: none;
}
