{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "otp.verified",
  "description": "OTP-код успешно использован пользователем для входа в веб-панель. Генерируется Auth Service. Потребляется notification-bot для очистки Telegram-сообщений с кодом.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "otp.verified"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "telegram_id"
      ],
      "properties": {
        "telegram_id": {
          "type": "integer"
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
