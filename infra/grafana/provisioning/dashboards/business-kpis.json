        {
          "expr": "(sum by (job,instance,environment) (rate(http_server_requests_seconds_count{status=~\"5..\",termination!=\"cancelled\",uri!~\"/actuator.*|/api-docs.*|/swagger.*\",environment=~\"$environment\",job=~\"$job\",instance=~\"$instance\"}[5m])) or on(job,instance,environment) (0 * sum by (job,instance,environment) (rate(http_server_requests_seconds_count{status=~\"2..|3..|5..\",termination!=\"cancelled\",uri!~\"/actuator.*|/api-docs.*|/swagger.*\",environment=~\"$environment\",job=~\"$job\",instance=~\"$instance\"}[5m])))) / sum by (job,instance,environment) (rate(http_server_requests_seconds_count{status=~\"2..|3..|5..\",termination!=\"cancelled\",uri!~\"/actuator.*|/api-docs.*|/swagger.*\",environment=~\"$environment\",job=~\"$job\",instance=~\"$instance\"}[5m]))",
