{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "late_checkin.requested",
  "description": "Студент запросил подтверждение присутствия (забыл отметиться). Генерируется Attendance Service.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "late_checkin.requested"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "group_id",
        "lesson_id"
      ],
      "properties": {
        "user_id": {
          "type": "integer"
        },
        "group_id": {
          "type": "integer"
        },
        "lesson_id": {
          "type": "integer"
        },
        "student_name": {
          "type": "string"
        },
        "lesson_date": {
          "type": "string",
          "format": "date"
        },
        "lesson_number": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "subject_name": {
          "type": "string"
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
