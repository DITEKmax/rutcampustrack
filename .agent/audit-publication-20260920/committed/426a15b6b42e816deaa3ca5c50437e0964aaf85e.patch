+        {{ retrying ? 'Повторяем…' : 'Повторить' }}
+      </button>
+    </section>
+
+    <section
+      v-else-if="accessBlocked"
+      class="requests-state"
+      :aria-label="accessTitle"
+    >
+      <h2>{{ accessTitle }}</h2>
+      <p>{{ accessDescription }}</p>
+    </section>
+
+    <section
+      v-else-if="requests.length === 0"
+      class="requests-state"
