.admin-page {
  --admin-panel-width: 48rem;
  --admin-table-min: 52rem;
  --admin-card-min: 14rem;
  --admin-panel-pad: var(--space-6);
  display: grid;
  gap: var(--space-6);
  min-inline-size: 0;
}
.admin-heading,
.admin-toolbar,
.admin-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3);
}
.admin-heading {
  justify-content: space-between;
}
.admin-toolbar {
  padding: var(--space-4);
  background: var(--color-surface-raised);
  border-radius: var(--radius-2xl);
  align-items: end;
}
.admin-toolbar .web-field {
  flex: 1;
  min-inline-size: var(--admin-card-min);
}
.admin-panel {
  padding: var(--admin-panel-pad);
  border: var(--rct-border-hairline) solid var(--color-border-default);
  border-radius: var(--radius-2xl);
  display: grid;
  gap: var(--space-4);
  min-inline-size: 0;
  scroll-margin-block-start: var(--space-6);
}
.admin-form {
  max-inline-size: var(--admin-panel-width);
}
.admin-page fieldset,
.admin-page .admin-picker {
  border: 0;
  padding: 0;
  margin: 0;
  min-inline-size: 0;
}
.admin-page legend {
  padding: 0;
  margin-block-end: var(--space-3);
  font-weight: var(--font-weight-medium);
}
.admin-picker {
  display: grid;
  gap: var(--space-3);
}
.admin-page .web-field select,
.admin-page .web-field textarea {
  inline-size: 100%;
  min-block-size: var(--control-height);
  padding: var(--space-2) var(--space-4);
  color: var(--color-text-primary);
  border: var(--rct-border-hairline) solid var(--color-border-default);
  border-radius: var(--radius-xl);
  background: var(--color-surface-raised);
  font: inherit;
  font-size: var(--font-size-body);
}
.admin-export {
  display: grid;
  gap: var(--space-2);
}
.admin-form-grid {
  display: grid;
  gap: var(--space-4);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.admin-table-wrap {
  overflow-x: auto;
  border-radius: var(--radius-xl);
}
.admin-table {
  border-collapse: collapse;
  inline-size: 100%;
  min-inline-size: var(--admin-table-min);
  font-size: var(--font-size-dense);
}
.admin-table th {
  background: var(--color-surface-raised);
  text-align: start;
  font-weight: var(--font-weight-medium);
}
.admin-table th,
.admin-table td {
  padding: var(--space-3) var(--space-4);
  border-block-end: var(--rct-border-hairline) solid var(--color-border-subtle);
  vertical-align: top;
  overflow-wrap: anywhere;
}
.admin-table caption {
  text-align: start;
  padding-block-end: var(--space-3);
  color: var(--color-text-secondary);
}
.admin-table td:first-child {
  font-weight: var(--font-weight-medium);
}
.admin-subtext {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-block-start: var(--space-1);
}
.admin-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3);
}
.admin-check {
  display: flex;
  align-items: start;
  gap: var(--space-3);
}
.admin-check input {
  accent-color: var(--color-accent-now);
  inline-size: var(--space-4);
  block-size: var(--space-4);
  flex-shrink: 0;
}
.admin-checklist {
  display: grid;
  gap: var(--space-3);
}
.admin-metrics {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--admin-card-min)), 1fr));
  gap: var(--space-4);
}
.admin-metric {
  background: var(--color-surface-raised);
  padding: var(--space-6);
  border-radius: var(--radius-2xl);
  display: grid;
  gap: var(--space-2);
}
.admin-metric strong {
  font-size: var(--font-size-title-screen);
}
.admin-danger {
  color: var(--color-state-danger-text);
}
.admin-warning {
  color: var(--color-state-warning-text);
}
.admin-secret {
  overflow-wrap: anywhere;
  font-family: var(--font-family-sans);
  user-select: all;
}
.admin-pairs {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--space-3) var(--space-6);
  margin: 0;
}
.admin-pairs dt {
  color: var(--color-text-secondary);
}
.admin-pairs dd {
  margin: 0;
  overflow-wrap: anywhere;
}
@media (max-width: 48rem) {
  .admin-page {
    --admin-panel-pad: var(--space-4);
  }
  .admin-form-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .admin-toolbar .web-field {
    min-inline-size: 100%;
  }
}
