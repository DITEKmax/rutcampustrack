+function Get-ActuatorDiagnosticSnapshot {
+    param(
+        [Parameter(Mandatory = $true)][int]$FailedPort,
+        [string]$FailedMetric = 'http.server.requests',
+        [string]$FailedTagQuery = 'uri:/api/v1/student/requests/excuse'
+    )
+    $records = [System.Collections.Generic.List[object]]::new()
+    $records.Add((Invoke-ActuatorDiagnosticQuery -Port $FailedPort -Metric $FailedMetric -TagQuery $FailedTagQuery))
+    foreach ($port in @(18515, 18516)) {
+        $records.Add((Invoke-ActuatorDiagnosticQuery -Port $port -Metric 'http.server.requests'))
+    }
+    $gatewayUnfiltered = Invoke-ActuatorDiagnosticQuery -Port 18515 -Metric 'spring.cloud.gateway.requests'
+    $records.Add($gatewayUnfiltered)
+    $routeIds = @($gatewayUnfiltered.availableTags | Where-Object { [string]$_.tag -ceq 'routeId' } | ForEach-Object { @($_.values) })
+    if ($routeIds -contains 'mobile-bff-student-requests-excuse') {
+        $records.Add((Invoke-ActuatorDiagnosticQuery -Port 18515 -Metric 'spring.cloud.gateway.requests' -TagQuery 'routeId:mobile-bff-student-requests-excuse'))
+    }
+    return [ordered]@{
+        schema = 'rct.actuator-counter-diagnostic.v1'
+        failedPort = $FailedPort
+        records = @($records)
+    }
+}
