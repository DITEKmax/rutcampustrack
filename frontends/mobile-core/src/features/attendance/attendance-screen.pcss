}

:where([data-student-ui]) .attendance-lesson-row__head h3,
:where([data-student-ui]):is(.attendance-lesson-row__head h3) {
  inline-size: 100%;
  min-inline-size: 0;
  margin: 0;
  overflow-wrap: anywhere;
