# === Java / Gradle ===
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
out/

# === Coverage artifacts (M08 G10/G12) ===
# Frontend: vitest coverage output
frontends/coverage/
frontends/*/coverage/
# Python: pytest-cov output
.coverage
services/notification-bot/.coverage
services/notification-bot/coverage.xml

# M04 NEW-67: git.properties генерируется на каждом build'е
# (root :generateGitProperties task). В git не коммитится.
services/*/src/main/resources/git.properties
services/*/*-app/src/main/resources/git.properties

# === IDE ===
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
.project
.classpath
.settings/
.history/

# === OS ===
.DS_Store
Thumbs.db

# === Environment ===
.env
.env.*
*.env.local
# Public configuration examples remain versionable.
!.env.example
!.env.*.example
# M13 G25.3 — CI test secrets для e2e (committed, marked CI-ONLY).
!tests/e2e/.env.ci

# === Logs ===
*.log
logs/

# === Python ===
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/

# === Node.js (frontends) ===
node_modules/
dist/
# Landing has no bundler: dist is canonical source and Docker COPY input.
!frontends/landing/dist/
.next/
.angular/
.pnpm-store/
.npm/
.vite/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/

# === Docker ===
docker-compose.override.yml

# Production secrets
.env.prod
.backup-passphrase
*.gpg

# M13 G15 — test-restore артефакты (локальный test-compose stack)
.env.test-restore

# JWT RSA keys (generated at runtime)
keys/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
!gradle/wrapper/*.key

# Local backup directories and database dump formats; SQL migrations and
# intentional source archives (for example font ZIPs) remain versionable.
backups/
.backups/
*.backup
*.backup.*
*.dump
*.sql.gz
*.sql.bz2
*.sql.zst

# Nginx SSL (generated on VPS, not in repo)
nginx/dhparam.pem
nginx/conf.d/*.bak
nginx/conf.d/*.disabled

# M13 G25.3 — self-signed e2e certs (generated on demand, never committed).
tests/e2e/infra/certs/

# M16 — local-only Claude Code / agents data (skills, settings, worktrees).
# Never commit; project-local CLAUDE.md is the only intended exception.
.claude/
.agents/
# Local coordination/evidence/worktrees/tooling and Codex state.
# Already tracked process canon remains tracked; do not untrack automatically.
/.agent/
/.codex/
/.secrets/
