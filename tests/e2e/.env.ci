# M13 G25.3 — CI / local e2e secrets для docker-compose.e2e.yml.
#
# !!! CI-ONLY — НЕ ИСПОЛЬЗОВАТЬ В PROD !!!
# Все значения здесь — статичные плейсхолдеры для эфемерного e2e stack'а.
# Реальные prod-секреты живут в `.env.prod` (gitignored, ротейтся
# через secret-rotation runbook).
#
# Применение (локально):
#   cp tests/e2e/.env.ci .env
#   bash tests/e2e/infra/scripts/generate-test-certs.sh
#   docker compose -f docker-compose.e2e.yml up -d --build

# --- Image tag (e2e всегда build from source, IMAGE_TAG неважен) ---
IMAGE_TAG=e2e-local

# --- Postgres ---
POSTGRES_ACADEMIC_PASSWORD=ci_test_pg_academic
POSTGRES_SCHEDULE_PASSWORD=ci_test_pg_schedule

# --- MongoDB (Bitnami replica set rs0) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=ci_test_mongo_root
MONGO_USER=rct_user
MONGO_PASSWORD=ci_test_mongo_user
MONGO_NOTIFICATION_USER=rct_notification_user
MONGO_NOTIFICATION_PASSWORD=ci_test_mongo_notification
# MongoDB keyfile принимает ТОЛЬКО base64-алфавит (A-Z a-z 0-9 + / = и whitespace).
# Подчёркивания/дефисы → mongod fail "Read security file failed: invalid char in key file"
# (UnsupportedFormat code 12). Сгенерировано через `openssl rand -base64 48`.
MONGODB_REPLICA_SET_KEY="hmxeZPwdN6KQ2Yr9B0rp7ecdt7annWoUR7CnNfyZqXBZ2Uz1i8JpqvxuBMorZdCI"

# --- Redis ---
REDIS_PASSWORD=ci_test_redis

# --- RabbitMQ ---
RABBITMQ_USER=ci_test_rabbit_user
RABBITMQ_PASSWORD=ci_test_rabbit_pass

# --- Auth / gateway internal secrets ---
GRPC_SECRET=ci_test_grpc_secret_32_chars_minimum_xxx
INTERNAL_ISSUER_SECRET=ci_test_internal_issuer_secret_32_chars_xx
TMA_BOT_TOKEN=ci_test_tma_bot_token_placeholder

# --- Notification web ---
# VAPID — не используется в auth-token-lifecycle, dummy-значения OK.
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxI4O8-FbRouAevSmBQ6o18hgE4nSG3qwvJTfKc-ls
VAPID_SUBJECT=mailto:e2e@example.test
NOTIFICATION_WS_ALLOWED_ORIGINS=https://localhost
ALERT_WEBHOOK_SECRET=ci_test_alert_webhook_secret

# --- Notification bot ---
BOT_TOKEN=ci_test_bot_token_placeholder
ADMIN_TELEGRAM_IDS=0
MINI_APP_URL=https://localhost/mini-app/
MINI_APP_WEB_URL=https://localhost/mini-app/

# --- Gateway CORS ---
CORS_ALLOWED_ORIGIN=https://localhost
