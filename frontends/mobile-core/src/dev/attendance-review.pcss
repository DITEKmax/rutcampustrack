@import '../styles/tokens.pcss';
.attendance-review-catalog { max-inline-size: var(--rct-today-content-max); margin-inline: auto; padding: var(--rct-space-4); }
.attendance-review-catalog ul { padding-inline-start: var(--rct-space-5); }
.attendance-review-catalog li { margin-block: var(--rct-space-3); overflow-wrap: anywhere; }
.attendance-review-catalog a { color: var(--rct-color-accent-now); }
.attendance-review-status { margin: var(--rct-space-4); padding: var(--rct-space-3); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-raised); color: var(--rct-color-text-secondary); }
