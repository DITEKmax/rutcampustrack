@@ -0,0 +1,45 @@
+package ru.rutcampustrack.attendance.report.studentprojection;
+
+/** Dense metric shape shared by all five projections. */
+public record AttendanceMetricSet(
+        AttendanceMetricValue present,
+        AttendanceMetricValue presentOrExcused,
+        AttendanceMetricValue excused,
+        AttendanceMetricValue absent,
+        int held,
+        int planned) {
+
+    public AttendanceMetricSet {
+        if (present == null || presentOrExcused == null || excused == null || absent == null) {
+            throw StudentProjectionValidationException.invalidInput("metric values are required");
+        }
+        if (held < 0 || planned < 0 || held > planned) {
+            throw StudentProjectionValidationException.invalidInput(
+                    "metric held/planned counts are inconsistent");
+        }
+        if (present.count() + excused.count() + absent.count() != held
+                || presentOrExcused.count() != present.count() + excused.count()) {
+            throw StudentProjectionValidationException.invalidInput(
+                    "metric status counts are inconsistent");
+        }
+    }
+
+    public static AttendanceMetricSet from(AttendanceMetricCalculator.Metrics metrics) {
+        if (metrics == null) {
+            throw StudentProjectionValidationException.invalidInput("metrics are required");
+        }
+        return new AttendanceMetricSet(
+                new AttendanceMetricValue(metrics.present().count(), metrics.present().percent()),
+                new AttendanceMetricValue(
+                        metrics.presentOrExcused().count(), metrics.presentOrExcused().percent()),
+                new AttendanceMetricValue(metrics.excused().count(), metrics.excused().percent()),
+                new AttendanceMetricValue(metrics.absent().count(), metrics.absent().percent()),
+                metrics.heldCount(),
+                metrics.plannedCount());
+    }
+
+    public static AttendanceMetricSet empty() {
+        AttendanceMetricValue zero = new AttendanceMetricValue(0, null);
+        return new AttendanceMetricSet(zero, zero, zero, zero, 0, 0);
+    }
+}
