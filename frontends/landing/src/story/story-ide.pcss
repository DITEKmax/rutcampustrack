@font-face {
  font-family: 'JetBrains Mono';
  src: url('../../dist/assets/fonts/google/JetBrainsMono-cyrillic.woff2') format('woff2');
  font-display: swap;
  unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
}
@font-face {
  font-family: 'JetBrains Mono';
  src: url('../../dist/assets/fonts/google/JetBrainsMono-latin.woff2') format('woff2');
  font-display: swap;
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
.rct-story__ide {
  --story-mono: 'JetBrains Mono', ui-monospace, monospace;
  min-width: 0;
  margin: 0;
  align-self: start;
  color: #eae5f3;
  background: #16131d;
  border: 1px solid #382b47;
  border-radius: .65rem;
}
.rct-story__ide-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
  min-height: 3rem;
  padding-inline: clamp(.7rem, 1.4vw, 1rem);
  border-bottom: 1px solid #382b47;
}
.rct-story__ide-bar strong {
  min-width: 0;
  overflow-wrap: anywhere;
  font: 620 .83rem/1.35 var(--rct-font-family-sans);
}
.rct-story__ide-nav {
  display: flex;
  align-items: center;
  flex: none;
  gap: .12rem;
  color: #c7b6d4;
  font: 500 .72rem var(--story-mono);
}
.rct-story__ide-nav button {
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  color: #ead4fb;
  border: 0;
  border-radius: .38rem;
  background: transparent;
  cursor: pointer;
}
.rct-story__ide-nav button[aria-disabled='true'] {
  color: #8a7997;
  cursor: default;
}
.rct-story__ide-nav button[aria-disabled='false']:hover {
  background: #332540;
}
.rct-story__ide-nav button:focus-visible {
  outline: 2px solid #e8c2ff;
  outline-offset: -4px;
}
.rct-story__ide-nav svg {
  width: 1.18rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.55;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.rct-story__ide .rct-story__ide-lines {
  display: grid;
  margin: 0;
  padding-inline: 0;
  padding-block: .65rem .8rem;
  list-style: none;
  font: 400 clamp(.72rem, 1.05vw, .82rem)/1.62 var(--story-mono);
}
.rct-story__ide-lines li {
  display: grid;
  grid-template-columns: 3.1em minmax(0, 1fr);
  column-gap: .68em;
  padding-inline: .32rem .66rem;
}
.rct-story__ide-number,
.rct-story__ide-gap > span:first-child {
  color: #a395b0;
  text-align: end;
  font-variant-numeric: tabular-nums;
  user-select: none;
}
.rct-story__ide .rct-story__ide-lines code {
  display: block;
  min-width: 0;
  min-height: 1lh;
  font-family: var(--story-mono);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  tab-size: 4;
  font-variant-ligatures: none;
  font-feature-settings: "liga" 0, "clig" 0, "calt" 0, "dlig" 0, "hlig" 0;
}
.rct-story__ide .rct-story__sr {
  position: absolute;
  inline-size: .0625rem;
  block-size: .0625rem;
  clip-path: inset(50%);
  overflow: hidden;
  white-space: nowrap;
}
.rct-story__ide [data-token='keyword'] { color: #e2aaf6; }
.rct-story__ide [data-token='annotation'] { color: #edc890; }
.rct-story__ide [data-token='string'] { color: #a3ddbd; }
.rct-story__ide [data-token='comment'] { color: #a79bb2; }
.rct-story__ide [data-token='number'] { color: #edb693; }
.rct-story__ide [data-token='type'] { color: #c7b6ff; }
.rct-story__ide [data-token='method'] { color: #ddcbfb; }
.rct-story__ide [data-token='operator'] { color: #c5a9d8; }
