@import '../../styles/tokens.pcss';

.map-screen { max-inline-size: var(--rct-today-content-max); margin-inline: auto; padding: calc(env(safe-area-inset-top) + var(--rct-space-5)) var(--rct-space-4) calc(env(safe-area-inset-bottom) + var(--rct-space-5)); color: var(--rct-color-text-primary); background: var(--rct-color-surface-base); font-family: var(--rct-font-family-sans); @mixin rct-type-body; }
.map-screen__header { display: flex; align-items: center; gap: var(--rct-space-2-half); margin-block-end: var(--rct-space-4); }
.map-screen h1 { min-inline-size: 0; margin: 0; overflow-wrap: anywhere; @mixin rct-type-task-title; }
.map-screen__back { display: grid; place-items: center; flex: 0 0 var(--rct-control-min-touch); inline-size: var(--rct-control-min-touch); block-size: var(--rct-control-min-touch); padding: 0; border: 0; border-radius: var(--rct-task-back-radius); color: var(--rct-color-text-primary); background: var(--rct-color-surface-float); cursor: pointer; @mixin rct-focus-ring; }
.map-screen__content { display: grid; gap: var(--rct-space-3); min-inline-size: 0; }
.map-field { color: var(--rct-color-text-primary); @mixin rct-type-field-label; }
.map-field:not(:first-child) { margin-block-start: var(--rct-space-1); }
.map-field + .map-select { margin-block-start: calc(-1 * var(--rct-space-2)); }
.map-card { display: grid; gap: var(--rct-space-3); min-inline-size: 0; }
.map-card__heading { display: flex; align-items: start; justify-content: space-between; gap: var(--rct-space-3); }
.map-card h2 { margin: 0; overflow-wrap: anywhere; @mixin rct-type-list-title; }
.map-card__heading p, .map-card__status { margin: 0; color: var(--rct-color-text-secondary); @mixin rct-type-lesson-meta; }
.map-preview { display: grid; place-items: center; min-block-size: var(--rct-state-min-height); overflow: auto; border-radius: var(--rct-radius-lg); background: var(--rct-color-surface-raised); scrollbar-width: none; }
.map-preview::-webkit-scrollbar { display: none; }
.map-preview img { display: block; max-inline-size: 100%; block-size: auto; }
.map-empty { display: flex; flex-direction: column; justify-content: center; gap: var(--rct-space-2); min-block-size: var(--rct-state-min-height); margin-block-start: var(--rct-space-2); padding: var(--rct-space-4); border: var(--rct-border-hairline) solid var(--rct-color-border-default); border-radius: var(--rct-radius-lg); @mixin rct-type-dense; }
.map-empty p { margin: 0; overflow-wrap: anywhere; }
.map-empty p + p { color: var(--rct-color-text-secondary); }
.map-actions { display: grid; gap: var(--rct-space-2); }
.map-download, .map-open { display: flex; align-items: center; justify-content: center; min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-3); border: 0; border-radius: var(--rct-radius-full); color: var(--rct-color-accent-on-now); background: var(--rct-color-accent-now); text-decoration: none; text-align: center; overflow-wrap: anywhere; @mixin rct-type-dense; @mixin rct-focus-ring; }
.map-open { color: var(--rct-color-text-primary); background: var(--rct-color-surface-float); }
.map-state { margin: 0; padding: var(--rct-space-4); border-radius: var(--rct-radius-2xl); color: var(--rct-color-text-secondary); background: var(--rct-color-surface-raised); @mixin rct-type-dense; }
