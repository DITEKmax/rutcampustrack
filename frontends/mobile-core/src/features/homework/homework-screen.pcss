@import '../../styles/tokens.pcss';

.homework-screen {
  position: relative;
  min-block-size: 100dvh;
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
  @mixin rct-type-body;
}

.homework-content {
  display: flex;
  flex-direction: column;
  inline-size: min(calc(100% - 2 * var(--rct-space-4)), var(--rct-mobile-content-width));
  min-block-size: 100dvh;
  margin-inline: auto;
  padding-block: calc(env(safe-area-inset-top) + var(--rct-space-5)) calc(env(safe-area-inset-bottom) + 6.75rem);
  gap: var(--rct-space-3);
}

.homework-content h1 {
  margin: 0;
  color: var(--rct-color-text-primary);
  font-size: var(--rct-font-size-title-screen);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.25;
}

.homework-previous,
.homework-material,
.homework-state button {
  min-block-size: var(--rct-control-min-touch);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-2xl);
  padding-inline: var(--rct-space-4);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  font: inherit;
  font-size: var(--rct-font-size-caption);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.35;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.homework-previous {
  display: grid;
  place-items: center;
  inline-size: 100%;
}

.homework-month {
  margin: var(--rct-space-2) 0 calc(var(--rct-space-2) * -1);
  color: var(--rct-color-text-secondary);
  font-size: 0.6875rem;
  font-weight: var(--rct-font-weight-bold);
  letter-spacing: 0.04em;
  line-height: 1.35;
}

.homework-group {
  display: flex;
  flex-direction: column;
  gap: var(--rct-space-3);
}

.homework-group > h2 {
  margin: 0;
  color: var(--rct-color-text-primary);
  font-size: var(--rct-homework-date-heading-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.35;
}

.homework-group__cards {
  display: grid;
  gap: var(--rct-space-3);
}

.homework-card {
  display: grid;
  gap: var(--rct-space-2-half);
  inline-size: 100%;
  min-inline-size: 0;
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
}

.homework-card h3,
.homework-card__title,
.homework-card__description,
.homework-card__error,
.homework-material-error {
  margin: 0;
}

.homework-card h3 {
  overflow-wrap: anywhere;
  font-size: var(--rct-font-size-body);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.35;
}

.homework-card__title,
.homework-card__description {
  overflow-wrap: anywhere;
  color: var(--rct-color-text-secondary);
  font-weight: var(--rct-font-weight-regular);
  line-height: 1.45;
  white-space: pre-line;
}

.homework-card__title {
  font-size: var(--rct-font-size-caption);
}

.homework-card__description {
  font-size: var(--rct-font-size-micro);
  padding-block-start: var(--rct-space-1);
}

.homework-card__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-block-size: var(--rct-control-min-touch);
  gap: var(--rct-space-2);
}

.homework-card__actions--no-material {
  justify-content: flex-end;
}

.homework-material {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--rct-space-2);
  inline-size: 8.875rem;
  padding-inline: var(--rct-space-3);
}

.homework-icon {
  display: inline-block;
  flex: 0 0 auto;
  background-color: currentColor;
  mask-image: var(--rct-icon-mask);
  mask-position: center;
  mask-repeat: no-repeat;
  -webkit-mask-image: var(--rct-icon-mask);
  -webkit-mask-position: center;
  -webkit-mask-repeat: no-repeat;
}

.homework-material__icon {
  inline-size: 1rem;
  block-size: 1rem;
  mask-size: contain;
  -webkit-mask-size: contain;
}

.homework-material-error {
  flex: 1;
  color: var(--rct-color-danger-text);
  font-size: var(--rct-font-size-micro);
  line-height: 1.35;
}

.homework-expand {
  display: grid;
  place-items: center;
  flex: 0 0 var(--rct-control-min-touch);
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-full);
  padding: 0;
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-float);
  cursor: pointer;
  @mixin rct-focus-ring;
}

.homework-expand__icon {
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  mask-size: contain;
  -webkit-mask-size: contain;

}

.homework-expand__icon--open {
  transform: rotate(180deg);
}

.homework-state {
  display: grid;
  place-items: center;
  gap: var(--rct-space-3);
  min-block-size: 12rem;
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-5);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-raised);
  text-align: center;
}

.homework-state h2,
.homework-state p {
  margin: 0;
}

.homework-return-today {
  position: fixed;
  z-index: 2;
  inset-inline-end: max(var(--rct-space-4), calc((100vw - var(--rct-mobile-content-width)) / 2));
  inset-block-end: calc(env(safe-area-inset-bottom) + 5.75rem);
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-full);
  padding: 0;
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-float);
  cursor: pointer;
  @mixin rct-focus-ring;
}

.homework-return-today__icon {
  inline-size: 100%;
  block-size: 100%;
  mask-size: contain;
  -webkit-mask-size: contain;
}

@media (min-width: 26.625rem) {
  .homework-screen {
    max-inline-size: 26.625rem;
    margin-inline: auto;
  }
}


.homework-screen .student-warning { gap: var(--rct-space-4); }
.homework-skeleton { display: grid; gap: var(--rct-space-3); }
.homework-skeleton__card { display: grid; gap: var(--rct-space-3); border-radius: var(--rct-radius-2xl); padding: var(--rct-space-4); background: var(--rct-color-surface-raised); }
.homework-skeleton__line { block-size: var(--rct-space-4); border-radius: var(--rct-radius-full); background: var(--rct-color-surface-float); }
.homework-skeleton__line:first-child { inline-size: 70%; }
.homework-skeleton__track { block-size: calc(var(--rct-control-min-touch) + 2 * var(--rct-space-1)); border-radius: var(--rct-radius-full); background: var(--rct-color-surface-float); }
