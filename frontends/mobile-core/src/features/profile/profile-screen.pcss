}

:where([data-student-ui]) .profile-field__toggle :is(img, .rct-svg-icon),
:where([data-student-ui]):is(.profile-field__toggle :is(img, .rct-svg-icon)) {
  inline-size: var(--rct-profile-control-icon-size, var(--rct-space-5));
  block-size: var(--rct-profile-control-icon-size, var(--rct-space-5));
}

:where([data-student-ui]) .profile-password-policy,
:where([data-student-ui]):is(.profile-password-policy) {
  display: flex;
  min-inline-size: 0;
  align-items: flex-start;
  gap: var(--rct-space-2);
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  line-height: 1.4;
}

:where([data-student-ui]) .profile-password-policy[data-valid='true'],
:where([data-student-ui]):is(.profile-password-policy[data-valid='true']) {
