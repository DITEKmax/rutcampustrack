# Notification Bot — Environment Variables
BOT_TOKEN=your_telegram_bot_token_here
RABBITMQ_URL=amqp://rct_user:rct_dev_pass@rabbitmq:5672/
ACADEMIC_GRPC_HOST=academic-service
ACADEMIC_GRPC_PORT=19091
REDIS_HOST=redis
REDIS_PORT=6379
HEALTH_PORT=8081
MINI_APP_URL=https://t.me/ruttrack_bot/ruttrack
MINI_APP_WEB_URL=https://ruttrack.site/mini-app/

# Private Notification preference authority; configure the same independent token at Notification.
NOTIFICATION_SERVICE_URL=http://notification-web:9094
# 32 bytes, canonical unpadded base64url; openssl rand -base64 32 | tr '/+' '_-' | tr -d '=\n'
BOT_TO_NOTIFICATION_SERVICE_TOKEN=CHANGE_ME
GRPC_SECRET=CHANGE_ME
