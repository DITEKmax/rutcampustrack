--- /dev/null
+++ b/services/schedule-service/schedule-app/src/main/resources/db/migration/V17__student_occurrence_homework_binding.sql
@@ -0,0 +1,416 @@
+-- B0 schedule foundation: one stable logical occurrence may retain multiple
+-- immutable physical generations while its current pointer changes.
+-- Flyway owns the transaction; all source guards precede DDL.
+
+DO $$
+BEGIN
+    -- Existing rows have no authoritative assignment/snapshot provenance. A
+    -- guessed backfill would make the old schedule history ambiguous.
+    IF EXISTS (SELECT 1 FROM schedule_items) THEN
+        RAISE EXCEPTION
+            'V17 cannot migrate legacy schedule_items without assignment provenance';
+    END IF;
+    IF EXISTS (SELECT 1 FROM lessons) THEN
+        RAISE EXCEPTION
+            'V17 cannot migrate legacy lessons without immutable occurrence snapshots';
+    END IF;
+    IF EXISTS (SELECT 1 FROM schedule_one_off_lessons) THEN
+        RAISE EXCEPTION
+            'V17 cannot migrate legacy one-off lessons without occurrence provenance';
+    END IF;
+END
+$$;
+
+-- Do not use the newly-added literal in a same-transaction predicate. It is
+-- available to application writes after this migration commits.
+ALTER TYPE lesson_status ADD VALUE IF NOT EXISTS 'transferred';
+
+ALTER TABLE lessons
+    DROP CONSTRAINT IF EXISTS lessons_schedule_item_id_date_key,
+    DROP CONSTRAINT IF EXISTS lessons_schedule_item_id_fkey;
+
+ALTER TABLE schedule_one_off_lessons
+    DROP CONSTRAINT IF EXISTS uq_one_off_slot;
+
+ALTER TABLE schedule_items
+    ADD COLUMN assignment_id BIGINT NOT NULL,
+    ADD CONSTRAINT schedule_items_assignment_positive_chk
+        CHECK (assignment_id > 0);
+
+CREATE TABLE lesson_occurrences
+(
+    id                  BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    schedule_item_id    BIGINT,
+    one_off_lesson_id   BIGINT,
+    occurrence_date     DATE         NOT NULL,
+    assignment_id       BIGINT       NOT NULL,
+    group_id            BIGINT       NOT NULL,
+    subject_id          BIGINT       NOT NULL,
+    semester_id         BIGINT       NOT NULL,
+    assigned_teacher_id BIGINT       NOT NULL,
+    lesson_type         VARCHAR(16)  NOT NULL,
+    generation          BIGINT       NOT NULL DEFAULT 1,
+    revision            BIGINT       NOT NULL DEFAULT 1,
+    current_lesson_id   BIGINT,
+    created_at          TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
+
+    CONSTRAINT lesson_occurrences_id_positive_chk CHECK (id > 0),
+    CONSTRAINT lesson_occurrences_assignment_positive_chk CHECK (assignment_id > 0),
+    CONSTRAINT lesson_occurrences_group_positive_chk CHECK (group_id > 0),
+    CONSTRAINT lesson_occurrences_subject_positive_chk CHECK (subject_id > 0),
+    CONSTRAINT lesson_occurrences_semester_positive_chk CHECK (semester_id > 0),
+    CONSTRAINT lesson_occurrences_teacher_positive_chk CHECK (assigned_teacher_id > 0),
+    CONSTRAINT lesson_occurrences_type_chk
+        CHECK (lesson_type IN ('lecture', 'practice', 'lab')),
+    CONSTRAINT lesson_occurrences_generation_positive_chk CHECK (generation > 0),
+    CONSTRAINT lesson_occurrences_revision_positive_chk CHECK (revision > 0),
+    CONSTRAINT lesson_occurrences_origin_xor_chk
+        CHECK ((schedule_item_id IS NOT NULL AND one_off_lesson_id IS NULL)
+            OR (schedule_item_id IS NULL AND one_off_lesson_id IS NOT NULL)),
