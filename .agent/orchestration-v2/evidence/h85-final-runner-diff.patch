+function ConvertTo-ActuatorDiagnosticRecord {
+    param(
+        [Parameter(Mandatory = $true)][int]$Port,
+        [Parameter(Mandatory = $true)][string]$Metric,
+        [Parameter(Mandatory = $true)][int]$StatusCode,
+        [AllowNull()][string]$Content,
+        [string]$TagQuery = '',
+        [string]$ContentType = '',
+        [string]$ContentRuntimeType = '',
+        [string]$Transport = 'NONE',
+        [string]$TransportErrorCategory = ''
+    )
+    $record = [ordered]@{
+        schema = 'rct.actuator-counter-diagnostic.v1'
+        port = $Port
+        metric = Limit-EdgeDiagnosticText -Text $Metric -MaxCharacters 256
+        tagQuery = Limit-EdgeDiagnosticText -Text $TagQuery -MaxCharacters 256
+        statusCode = $StatusCode
+        contentType = Limit-EdgeDiagnosticText -Text $ContentType -MaxCharacters 128
+        contentRuntimeType = Limit-EdgeDiagnosticText -Text $ContentRuntimeType -MaxCharacters 128
+        transport = Limit-EdgeDiagnosticText -Text $Transport -MaxCharacters 64
+        errorCategory = Limit-EdgeDiagnosticText -Text $TransportErrorCategory -MaxCharacters 64
+        metricName = $null
+        measurements = @()
+        availableTags = @()
+        parseStatus = 'NOT_RUN'
+    }
+    if (-not [string]::IsNullOrWhiteSpace($TransportErrorCategory)) {
+        return $record
+    }
+    try {
+        if ([string]::IsNullOrWhiteSpace($Content)) { throw 'empty actuator content' }
+        $payload = $Content | ConvertFrom-Json -Depth 12
+        $record.metricName = Limit-EdgeDiagnosticText -Text ([string]$payload.name) -MaxCharacters 256
+        $record.measurements = @($payload.measurements | ForEach-Object {
+                $numericValue = $null
+                if ($_.value -is [sbyte] -or $_.value -is [byte] -or $_.value -is [int16] -or $_.value -is [uint16] -or $_.value -is [int32] -or $_.value -is [uint32] -or $_.value -is [int64] -or $_.value -is [uint64] -or $_.value -is [single] -or $_.value -is [double] -or $_.value -is [decimal]) {
+                    $numericValue = $_.value
+                }
+                [ordered]@{ statistic = Limit-EdgeDiagnosticText -Text ([string]$_.statistic) -MaxCharacters 64; value = $numericValue }
+            } | Select-Object -First 16)
+        $record.availableTags = @($payload.availableTags | ForEach-Object {
+                [ordered]@{ tag = Limit-EdgeDiagnosticText -Text ([string]$_.tag) -MaxCharacters 256; values = @($_.values | ForEach-Object { Limit-EdgeDiagnosticText -Text ([string]$_) -MaxCharacters 256 } | Select-Object -First 16) }
+            } | Select-Object -First 16)
+        $record.parseStatus = 'PASS'
+    } catch {
+        $record.parseStatus = 'INVALID_JSON'
+        if ([string]::IsNullOrWhiteSpace([string]$record.errorCategory)) {
+            $record.errorCategory = 'INVALID_JSON'
+        }
+    }
+    return $record
+}
