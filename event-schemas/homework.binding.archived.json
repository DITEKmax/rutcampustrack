{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "homework.binding.archived",
  "description": "A schedule-service lesson cancellation terminally archived a homework binding.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "homework.binding.archived"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "binding_id",
        "actor_id",
        "request_key",
        "occurrence_id",
        "lesson_id",
        "homework_id",
        "binding_revision"
      ],
      "properties": {
        "binding_id": {
          "type": "integer",
          "minimum": 1
        },
        "actor_id": {
          "type": "integer",
          "minimum": 1,
          "description": "The original author recorded on the binding."
        },
        "request_key": {
          "type": "string",
          "format": "uuid"
        },
        "occurrence_id": {
          "type": "integer",
          "minimum": 1
        },
        "lesson_id": {
          "type": "integer",
          "minimum": 1,
          "description": "The current physical lesson cancelled by this operation."
        },
        "homework_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 2,
          "description": "The revision after the terminal archive transition."
        }
      },
      "additionalProperties": false
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "const": "schedule-service"
    }
  },
  "additionalProperties": false
}
