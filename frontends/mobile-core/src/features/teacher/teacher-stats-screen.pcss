@import '../../styles/tokens.pcss';

.teacher-stats {
  box-sizing: border-box;
  display: grid;
  gap: var(--rct-space-4);
  min-inline-size: 0;
  inline-size: 100%;
  max-inline-size: var(--rct-today-content-max);
  margin-inline: auto;
  padding: var(--rct-space-5) var(--rct-space-4) var(--rct-today-bottom-space);
  color: var(--rct-color-text-primary);
  font-family: var(--rct-font-family-sans);
  font-variant-numeric: tabular-nums;
}
.teacher-stats *, .teacher-stats *::before, .teacher-stats *::after { box-sizing: border-box; }
.teacher-stats h1, .teacher-stats h2, .teacher-stats h3, .teacher-stats p { margin: 0; }
.teacher-stats h1 { font-size: var(--rct-font-size-title-screen); line-height: var(--rct-leading-tight); }
.teacher-stats h2 { font-size: var(--rct-font-size-body); line-height: var(--rct-leading-snug); }
.teacher-stats__tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-float); }
.teacher-stats button { font: inherit; cursor: pointer; @mixin rct-focus-ring; }
.teacher-stats button:disabled { cursor: not-allowed; opacity: 0.55; }
.teacher-stats__tabs button { min-block-size: var(--rct-control-min-touch); min-inline-size: 0; padding: var(--rct-space-2); border: 0; border-radius: var(--rct-radius-xl); background: transparent; color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-caption); }
.teacher-stats__tabs button[aria-pressed='true'] { color: var(--rct-color-accent-on-now); background: var(--rct-color-accent-now); }
.teacher-stats__context, .teacher-stats__cards { display: grid; gap: var(--rct-space-3); min-inline-size: 0; }
.teacher-stats__field { display: grid; gap: var(--rct-space-1); min-inline-size: 0; font-size: var(--rct-font-size-caption); color: var(--rct-color-text-secondary); }
.teacher-stats__toolbar { display: grid; grid-template-columns: minmax(0, 1fr) var(--rct-control-min-touch); gap: var(--rct-space-2); align-items: start; }
.teacher-stats__icon-button { display: grid; place-items: center; inline-size: var(--rct-control-min-touch); block-size: var(--rct-control-min-touch); padding: 0; border: 0; border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-raised); color: var(--rct-color-text-primary); }
.teacher-stats__icon-button .mobile-icon { inline-size: var(--rct-profile-control-icon-size); block-size: var(--rct-profile-control-icon-size); }
.teacher-stats__icon-button[data-active='true'], .teacher-stats__apply { background: var(--rct-color-accent-now); color: var(--rct-color-accent-on-now); }
.teacher-stats__add-sort { display: flex; align-items: center; justify-content: center; gap: var(--rct-space-2); min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-3); border: var(--rct-border-hairline) solid var(--rct-color-border-default); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-raised); color: var(--rct-color-text-primary); font-size: var(--rct-font-size-caption); }
.teacher-stats__filters { display: grid; gap: var(--rct-space-4); min-inline-size: 0; padding: var(--rct-space-4); border: var(--rct-border-hairline) solid var(--rct-color-border-default); border-radius: var(--rct-radius-xl); }
.teacher-stats__types { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--rct-space-2); min-inline-size: 0; margin: 0; border: 0; padding: 0; }
.teacher-stats__types legend, .teacher-stats__range legend { margin-block-end: var(--rct-space-2); color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-caption); }
.teacher-stats__types button { min-inline-size: 0; overflow-wrap: anywhere; min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-1); border: 0; border-radius: var(--rct-radius-lg); background: var(--rct-color-surface-float); color: var(--rct-color-text-primary); font-size: var(--rct-font-size-caption); }
.teacher-stats__types button[aria-pressed='true'] { background: var(--rct-color-accent-now); color: var(--rct-color-accent-on-now); }
.teacher-stats__range { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--rct-space-2); min-inline-size: 0; margin: 0; padding: var(--rct-space-2); border: var(--rct-border-hairline) solid transparent; border-radius: var(--rct-radius-xl); }
.teacher-stats__range label { display: grid; min-inline-size: 0; padding: var(--rct-space-2) var(--rct-space-3); background: var(--rct-color-surface-float); border-radius: var(--rct-radius-lg); color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-micro); }
.teacher-stats__range label input { padding: 0; min-block-size: var(--rct-space-5); border-radius: 0; font-size: var(--rct-font-size-body); }
.teacher-stats input { min-inline-size: 0; inline-size: 100%; min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-3); border: var(--rct-border-hairline) solid transparent; border-radius: var(--rct-radius-lg); background: var(--rct-color-surface-float); color: var(--rct-color-text-primary); font: inherit; @mixin rct-focus-ring; }
.teacher-stats input[aria-invalid='true'], .teacher-stats__range[aria-invalid='true'] { border-color: var(--rct-color-danger-text); }
.teacher-stats__range input[aria-invalid='true'] { border-color: transparent; }
.teacher-stats__field-error { grid-column: 1 / -1; color: var(--rct-color-danger-text); font-size: var(--rct-font-size-caption); }
.teacher-stats__filter-actions { display: flex; justify-content: space-between; gap: var(--rct-space-3); }
.teacher-stats__apply { min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-4); border: 0; border-radius: var(--rct-radius-full); }
.teacher-stats__state { display: grid; place-items: center; min-block-size: var(--rct-state-min-height); text-align: center; color: var(--rct-color-text-secondary); }
.teacher-stats__results-title span { color: var(--rct-color-text-secondary); font-weight: var(--rct-font-weight-regular); }
.teacher-stats__card { display: grid; gap: var(--rct-space-3); min-inline-size: 0; padding: var(--rct-space-3); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-raised); }
.teacher-stats__card h3 { font-size: var(--rct-font-size-dense); line-height: var(--rct-leading-snug); overflow-wrap: anywhere; }
.teacher-stats__card h3 button { display: flex; align-items: center; justify-content: space-between; gap: var(--rct-space-2); inline-size: 100%; min-block-size: var(--rct-control-min-touch); margin-block: calc(var(--rct-space-2) * -1); padding: 0; border: 0; background: transparent; color: inherit; text-align: start; font-weight: var(--rct-font-weight-bold); }
.teacher-stats__card h3 button span { min-inline-size: 0; overflow-wrap: anywhere; }
.teacher-stats__card h3 .mobile-icon { flex: none; transform: rotate(-90deg); }
.teacher-stats__lesson-count { color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-caption); }
.teacher-stats__metrics { display: grid; gap: 0; margin: 0; font-size: var(--rct-font-size-caption); }
.teacher-stats__metrics > div { padding-block: var(--rct-space-2); display: flex; justify-content: space-between; align-items: center; gap: var(--rct-space-3); }
.teacher-stats__metrics dt { display: flex; align-items: center; gap: var(--rct-space-1); }
.teacher-stats__metrics dd { margin: 0; text-align: end; overflow-wrap: anywhere; }
.teacher-stats__symbol { display: inline-grid; place-items: center; flex: none; inline-size: var(--rct-icon-size); block-size: var(--rct-icon-size); border-radius: var(--rct-radius-full); color: var(--rct-color-status-on-fill); font-size: var(--rct-font-size-micro); font-weight: var(--rct-font-weight-bold); line-height: 1; }
.teacher-stats__symbol--present { background: var(--rct-color-status-present-fill); }
.teacher-stats__symbol--excused { background: var(--rct-color-status-excused-fill); }
.teacher-stats__symbol--absent { background: var(--rct-color-status-absent-fill); }
.teacher-stats__journal { display: flex; flex-wrap: wrap; gap: var(--rct-space-2); }
.teacher-stats__journal button { min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-3); border: 0; border-radius: var(--rct-radius-full); background: var(--rct-color-surface-raised); color: var(--rct-color-text-primary); font-size: var(--rct-font-size-caption); }

.teacher-stats__metrics > div + div { border-block-start: var(--rct-border-hairline) solid var(--rct-color-border-default); }
.teacher-stats__card h3 button .teacher-stats__row-name { flex: 1; }
.teacher-stats__card h3 button .teacher-stats__lesson-count { flex: none; font-weight: var(--rct-font-weight-regular); white-space: nowrap; }


.teacher-stats__directory { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--rct-space-2); min-inline-size: 0; }
.teacher-stats__directory-results, .teacher-stats__directory-results > section { display: grid; gap: var(--rct-space-2); min-inline-size: 0; }
.teacher-stats__directory-results { padding: var(--rct-space-3); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-raised); }
.teacher-stats__directory-results button { display: grid; gap: var(--rct-space-1); min-block-size: var(--rct-control-min-touch); min-inline-size: 0; border: 0; border-radius: var(--rct-radius-lg); padding: var(--rct-space-2) var(--rct-space-3); color: var(--rct-color-text-primary); background: var(--rct-color-surface-float); text-align: start; overflow-wrap: anywhere; }
.teacher-stats__directory-results button span + span, .teacher-stats__directory-results p { color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-caption); }
