+import type { MapControllerOptions } from './map-controller'
+import type { MapReadPort } from './map-contract'
+import { MapController } from './map-controller'
+import { MapOfflineStore } from './map-offline-store'
+import { MapSynchronizer } from './map-sync'
+import type { AssetValidationOptions } from './map-validation'
+
+export * from './map-contract'
+export * from './map-controller'
+export * from './map-offline-store'
+export * from './map-sync'
+export * from './map-validation'
+export { default as MapScreen } from './MapScreen.vue'
+
+export interface MapFeatureOptions extends Omit<MapControllerOptions, 'store' | 'synchronizer'> {
+  readonly store?: MapOfflineStore
+  readonly synchronizer?: MapSynchronizer
+  readonly validation?: AssetValidationOptions
+  readonly isCurrent?: (scope: MapControllerOptions['scope']) => boolean
+}
+
+export interface MapFeature {
+  readonly controller: MapController
+  readonly store?: MapOfflineStore
+  readonly synchronizer?: MapSynchronizer
+}
+
+export function createMapFeature(options: MapFeatureOptions): MapFeature {
+  if (options.surface === 'tma') {
+    return { controller: new MapController(options) }
+  }
+  const store = options.store ?? new MapOfflineStore()
+  const synchronizer = options.synchronizer ?? new MapSynchronizer({
+    port: options.port,
+    store,
+    ...(options.validation ? { validation: options.validation } : {}),
+    ...(options.isCurrent ? { isCurrent: options.isCurrent } : {}),
+  })
+  return {
+    controller: new MapController({ ...options, store, synchronizer }),
+    store,
+    synchronizer,
+  }
+}
+
+export function mapPortOnly(port: MapReadPort): Pick<MapFeatureOptions, 'port'> {
+  return { port }
+}
diff --git a/frontends/mobile-core/src/features/map/map-contract.ts b/frontends/mobile-core/src/features/map/map-contract.ts
