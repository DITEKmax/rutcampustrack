+  const metadata = typeof cause === 'object' && cause !== null ? cause as { readonly authority?: unknown; readonly epoch?: unknown; readonly activeRevision?: unknown } : null
+  const authority = metadata?.authority
+  const durable = authority === 'revoked' && metadata?.activeRevision === null
+  const pending = authority === 'pending'
+  const epoch = typeof metadata?.epoch === 'number' ? metadata.epoch : 0
+  const result: MapRevokeResult = { ownerKey: scope.ownerKey, epoch, status: durable ? 'completed' : 'failed', durable, pending }
+  if (!durable && error) return { ...result, error }
+  return result
