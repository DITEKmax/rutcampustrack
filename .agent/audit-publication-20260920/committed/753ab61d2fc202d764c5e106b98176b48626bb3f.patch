+  symbol: string
+  available: boolean
+  reason?: string | null
+}
+
+export interface ExcuseRequestPayload {
+  lessonIds: readonly string[]
+  reason: string
+  comment: string
+  files: readonly RequestFileRef[]
+}
+
+export interface LateCheckinRequestPayload {
+  lessonId: string
+}
