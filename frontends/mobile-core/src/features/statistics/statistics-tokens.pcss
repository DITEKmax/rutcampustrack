/*
 * Feature aliases reference the accepted shared semantic palette and sizes.
 */
.statistics-screen,
.statistics-detail {
  --statistics-surface-base: var(--rct-color-surface-base);
  --statistics-surface-raised: var(--rct-color-surface-raised);
  --statistics-surface-float: var(--rct-color-surface-float);
  --statistics-text-primary: var(--rct-color-text-primary);
  --statistics-text-secondary: var(--rct-color-text-secondary);
  --statistics-text-muted: var(--rct-color-text-muted);
  --statistics-text-disabled: var(--rct-color-disabled-text);
  --statistics-border-default: var(--rct-color-border-default);
  --statistics-border-focus: var(--rct-color-accent-now);
  --statistics-accent-now: var(--rct-color-accent-now);
  --statistics-accent-on-now: var(--rct-color-accent-on-now);
  --statistics-present-fill: var(--rct-color-status-present-fill);
  --statistics-present-text: var(--rct-color-success-text);
  --statistics-absent-fill: var(--rct-color-status-absent-fill);
  --statistics-absent-text: var(--rct-color-danger-text);
  --statistics-excused-fill: var(--rct-color-status-excused-fill);
  --statistics-excused-text: var(--rct-color-warning-text);
  --statistics-none-fill: var(--rct-color-disabled-text);
  --statistics-success-bg: var(--rct-color-success-surface);
  --statistics-danger-bg: var(--rct-error-surface);
  --statistics-warning-text: var(--rct-color-warning-text);
  --statistics-disabled-surface: var(--rct-color-disabled-surface);
  --statistics-font-family: var(--rct-font-family-sans);
  --statistics-font-display: 1.875rem;
  --statistics-font-title: var(--rct-font-size-title-screen);
  --statistics-font-block: var(--rct-font-size-title);
  --statistics-font-body: var(--rct-font-size-body);
  --statistics-font-dense: var(--rct-font-size-dense);
  --statistics-font-caption: var(--rct-font-size-caption);
  --statistics-font-micro: var(--rct-font-size-micro);
  --statistics-font-weight-regular: var(--rct-font-weight-regular);
  --statistics-font-weight-medium: var(--rct-font-weight-medium);
  --statistics-font-weight-bold: var(--rct-font-weight-bold);
  --statistics-radius-lg: var(--rct-radius-lg);
  --statistics-radius-xl: var(--rct-radius-xl);
  --statistics-radius-2xl: var(--rct-radius-2xl);
  --statistics-radius-full: var(--rct-radius-full);
  --statistics-border-hairline: var(--rct-border-hairline);
  --statistics-focus-width: var(--rct-focus-width);
  --statistics-focus-offset: var(--rct-focus-offset);
  --statistics-content-width: var(--rct-mobile-content-width);
  --statistics-inset: var(--rct-space-4);
  --statistics-control: var(--rct-control-min-touch);
  --statistics-metadata: var(--rct-lesson-meta-icon-size);
  --statistics-meta-gap: var(--rct-space-1);
  --statistics-disclosure: 1.375rem;
  --statistics-plot-height: 10.625rem;
  --statistics-history-height: 0.5rem;
  --statistics-dock-height: var(--rct-mobile-dock-height);
  --statistics-dock-bottom: var(--rct-mobile-dock-bottom);
}

@define-mixin statistics-focus-ring {
  &:focus-visible {
    outline: var(--statistics-focus-width) solid var(--statistics-border-focus);
    outline-offset: var(--statistics-focus-offset);
  }
}
