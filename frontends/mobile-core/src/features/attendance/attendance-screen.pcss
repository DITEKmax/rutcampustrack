}
:where([data-student-ui]) .attendance-subject-list__trigger,
:where([data-student-ui]):is(.attendance-subject-list__trigger) {
  justify-content: space-between;
  gap: var(--rct-space-2);
  padding: var(--rct-space-2) var(--rct-space-3);
  background: var(--rct-color-surface-raised);
}
:where([data-student-ui]) .attendance-subject-list__trigger[aria-expanded='true'],
:where([data-student-ui]):is(.attendance-subject-list__trigger[aria-expanded='true']) {
