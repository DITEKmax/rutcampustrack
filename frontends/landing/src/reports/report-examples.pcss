.report-example__copy > p:first-child {
  margin-block: 0 var(--rct-space-2);
}

.report-example__copy h3 {
  font-size: clamp(1.6rem, 3.1vw, 2.7rem);
  font-weight: 670;
  letter-spacing: -.045em;
  line-height: 1.08;
}

.report-example__preview {
  border-radius: var(--rct-radius-xl);
}

.report-example__preview img {
  display: block;
  inline-size: 100%;
  block-size: auto;
  border: var(--landing-rule) solid var(--landing-border);
  border-radius: var(--rct-radius-xl);
  background: var(--landing-bg);
}
