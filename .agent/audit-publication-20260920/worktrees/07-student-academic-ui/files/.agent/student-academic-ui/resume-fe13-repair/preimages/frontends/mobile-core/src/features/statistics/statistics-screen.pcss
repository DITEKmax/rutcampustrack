@import '../../styles/tokens.pcss';
@import './statistics-tokens.pcss';

.statistics-screen,
.statistics-detail {
  display: flex;
  flex-direction: column;
  inline-size: min(100%, 26.625rem);
  box-sizing: border-box;
  min-block-size: 100dvh;
  margin-inline: auto;
  padding: calc(env(safe-area-inset-top) + 1.25rem) var(--statistics-inset) calc(env(safe-area-inset-bottom) + 6.75rem);
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-base);
  font-family: var(--statistics-font-family);
  font-feature-settings: "tnum" 1, "lnum" 1;
  font-variant-numeric: tabular-nums;
  font-size: var(--statistics-font-body);
  line-height: 1.5;
}

.statistics-screen *,
.statistics-detail *,
.statistics-screen *::before,
.statistics-detail *::before,
.statistics-screen *::after,
.statistics-detail *::after {
  box-sizing: border-box;
}

.statistics-screen button,
.statistics-detail button {
  font: inherit;
}

.statistics-screen button,
.statistics-detail button {
  @mixin statistics-focus-ring;
}

.statistics-screen__header,
.statistics-detail__header {
  display: flex;
  align-items: center;
  min-block-size: var(--statistics-control);
  margin-block-end: 0.75rem;
}

.statistics-screen__header h1,
.statistics-detail__header h1 {
  min-inline-size: 0;
  margin: 0;
  overflow-wrap: anywhere;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-title);
  font-weight: var(--statistics-font-weight-bold);
  letter-spacing: -0.015em;
  line-height: 1.2;
}

.statistics-rank {
  display: grid;
  gap: 0.5rem;
  min-block-size: 5.375rem;
  margin-block-end: 0.75rem;
  border-radius: var(--statistics-radius-xl);
  padding: 1rem;
  background: var(--statistics-surface-raised);
}

.statistics-rank p,
.statistics-rank strong {
  margin: 0;
}

.statistics-rank p {
  color: var(--statistics-text-secondary);
  font-size: var(--statistics-font-dense);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.35;
}

.statistics-rank strong {
  color: var(--statistics-text-primary);
  font-size: 1.875rem;
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.15;
}

.statistics-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.75rem;
  margin-block-end: 0.75rem;
}

.statistics-metric {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-block-size: 3rem;
  min-inline-size: 0;
  border-radius: var(--statistics-radius-xl);
  padding: 0.625rem;
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-raised);
  font-size: 1.125rem;
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.25;
}

.statistics-metric__symbol {
  display: grid;
  place-items: center;
  inline-size: 1.75rem;
  block-size: 1.75rem;
  flex: 0 0 auto;
  border-radius: var(--statistics-radius-full);
  color: var(--statistics-accent-on-now);
  font-size: 0.9375rem;
}

.statistics-metric--present .statistics-metric__symbol { background: var(--statistics-present-fill); }
.statistics-metric--absent .statistics-metric__symbol { background: var(--statistics-absent-fill); }
.statistics-metric--excused .statistics-metric__symbol { background: var(--statistics-excused-fill); }

.statistics-state {
  display: grid;
  justify-items: center;
  gap: 0.75rem;
  min-block-size: 12rem;
  border: var(--statistics-border-hairline) solid var(--statistics-border-default);
  border-radius: var(--statistics-radius-2xl);
  padding: 1.25rem;
  color: var(--statistics-text-secondary);
  background: var(--statistics-surface-raised);
  text-align: center;
}

.statistics-state h2,
.statistics-state p {
  margin: 0;
}

.statistics-state h2 {
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-block);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.3;
}

.statistics-state--error {
  border-color: var(--statistics-absent-text);
  background: var(--statistics-danger-bg);
}

.statistics-state__spinner {
  inline-size: 1.25rem;
  block-size: 1.25rem;
  border: 0.1875rem solid color-mix(in srgb, var(--statistics-text-primary) 30%, transparent);
  border-block-start-color: var(--statistics-text-primary);
  border-radius: var(--statistics-radius-full);
  animation: statistics-spin 0.8s linear infinite;
}

.statistics-state__retry {
  min-block-size: var(--statistics-control);
  border: 0;
  border-radius: var(--statistics-radius-xl);
  padding-inline: 1rem;
  color: var(--statistics-accent-on-now);
  background: var(--statistics-accent-now);
  cursor: pointer;
  font-weight: var(--statistics-font-weight-bold);
}

.statistics-chart {
  display: grid;
  gap: 0.75rem;
  margin-block-end: 1.25rem;
  border-radius: var(--statistics-radius-xl);
  padding: 1rem;
  background: var(--statistics-surface-raised);
}

.statistics-chart h2 {
  margin: 0;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-block);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.3;
}

.statistics-chart__range {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.25rem;
  border-radius: var(--statistics-radius-lg);
  padding: 0.25rem;
  background: var(--statistics-surface-float);
}

.statistics-chart__range-button {
  min-block-size: var(--statistics-control);
  border: 0;
  border-radius: var(--statistics-radius-lg);
  padding: 0.5rem 0.625rem;
  color: var(--statistics-text-secondary);
  background: transparent;
  cursor: pointer;
  font-size: var(--statistics-font-dense);
  font-weight: var(--statistics-font-weight-medium);
}

.statistics-chart__range-button--selected {
  color: var(--statistics-accent-on-now) !important;
  background: var(--statistics-accent-now) !important;
}

.statistics-chart__plot {
  min-block-size: 11.875rem;
  border-radius: var(--statistics-radius-lg);
  padding: 0.5rem;
  background: var(--statistics-surface-float);
}

.statistics-chart__plot svg {
  display: block;
  inline-size: 100%;
  block-size: 11.875rem;
  overflow: visible;
}

.statistics-chart__area--present { fill: color-mix(in srgb, var(--statistics-present-fill) 68%, transparent); }
.statistics-chart__area--excused { fill: color-mix(in srgb, var(--statistics-excused-fill) 68%, transparent); }
.statistics-chart__area--absent { fill: color-mix(in srgb, var(--statistics-absent-fill) 68%, transparent); }
.statistics-chart__neutral { fill: var(--statistics-none-fill); opacity: 0.7; }
.statistics-chart__labels text {
  fill: var(--statistics-text-secondary);
  font-family: var(--statistics-font-family);
  font-size: 0.5rem;
}

.statistics-chart__legend {
  display: grid;
  gap: 0.375rem;
  max-block-size: 8rem;
  margin: 0;
  overflow: auto;
  padding: 0;
  color: var(--statistics-text-secondary);
  font-size: var(--statistics-font-micro);
  list-style: none;
}

.statistics-chart__legend li {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}

.statistics-chart__legend li > span:first-child {
  inline-size: 0.5rem;
  block-size: 0.5rem;
  flex: 0 0 auto;
  border-radius: 0.25rem;
  background: var(--statistics-none-fill);
}

.statistics-chart__legend li[data-state='DATA'] > span:first-child { background: var(--statistics-present-fill); }
.statistics-chart__legend li[data-state='NO_DATA'] > span:first-child,
.statistics-chart__legend li[data-state='FUTURE'] > span:first-child { background: var(--statistics-none-fill); }

.statistics-subjects {
  display: grid;
  gap: 0.75rem;
}

.statistics-subjects h2,
.statistics-type-stack h2,
.statistics-type-filter h2 {
  margin: 0;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-block);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.3;
}

.statistics-subjects > ul {
  display: grid;
  gap: 0.5rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.statistics-subject-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  inline-size: 100%;
  min-block-size: 4rem;
  gap: 0.75rem;
  border: 0;
  border-radius: var(--statistics-radius-xl);
  padding: 0.875rem 1rem;
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-raised);
  cursor: pointer;
  text-align: start;
}

.statistics-subject-summary:disabled {
  cursor: default;
  opacity: 0.65;
}

.statistics-subject-summary__name {
  min-inline-size: 0;
  overflow-wrap: anywhere;
  font-size: var(--statistics-font-dense);
  font-weight: var(--statistics-font-weight-bold);
}

.statistics-subject-summary__value {
  flex: 0 0 auto;
  color: var(--statistics-text-secondary);
  font-size: var(--statistics-font-dense);
  font-weight: var(--statistics-font-weight-bold);
}

.statistics-subjects__empty {
  margin: 1.5rem 0;
  color: var(--statistics-text-secondary);
  text-align: center;
}

.statistics-detail__header {
  gap: 0.625rem;
}

.statistics-back-button {
  display: grid;
  flex: 0 0 var(--statistics-control);
  place-items: center;
  inline-size: var(--statistics-control);
  block-size: var(--statistics-control);
  border: 0;
  border-radius: var(--statistics-radius-full);
  padding: 0;
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-float);
  cursor: pointer;
  transform: rotate(90deg);
}

.statistics-back-button img {
  inline-size: 1rem;
  block-size: 1rem;
}

.statistics-detail__header h1 {
  font-size: 1.375rem;
}

.statistics-detail__aggregate {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.75rem;
  margin-block-end: 0.75rem;
}

.statistics-detail__aggregate > div {
  display: grid;
  gap: 0.375rem;
  min-block-size: 4rem;
  border-radius: var(--statistics-radius-xl);
  padding: 0.75rem;
  background: var(--statistics-surface-raised);
}

.statistics-detail__aggregate-label {
  color: var(--statistics-text-secondary);
  font-size: var(--statistics-font-micro);
}

.statistics-detail__aggregate strong {
  color: var(--statistics-text-primary);
  font-size: 1.125rem;
  line-height: 1.2;
}

.statistics-type-filter {
  display: grid;
  gap: 0.625rem;
  margin-block-end: 0.75rem;
}

.statistics-type-filter__options {
  display: flex;
  gap: 0.5rem;
  inline-size: 100%;
  overflow-x: auto;
  padding-block: 0.125rem;
  scrollbar-width: thin;
}

.statistics-type-filter__button {
  flex: 1 0 8rem;
  min-block-size: var(--statistics-control);
  border: var(--statistics-border-hairline) solid var(--statistics-border-default);
  border-radius: var(--statistics-radius-full);
  padding: 0.5rem 0.75rem;
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-float);
  cursor: pointer;
  font-size: var(--statistics-font-caption);
  font-weight: var(--statistics-font-weight-bold);
  white-space: nowrap;
}

.statistics-type-filter__button--selected {
  border-color: var(--statistics-accent-now);
  color: var(--statistics-accent-on-now);
  background: var(--statistics-accent-now);
}

.statistics-type-filter__button:disabled {
  cursor: default;
  opacity: 0.7;
}

.statistics-type-stack {
  display: grid;
  gap: 1.75rem;
}

.statistics-type-card {
  position: relative;
  display: grid;
  gap: 0.625rem;
  min-inline-size: 0;
  border: var(--statistics-border-hairline) solid var(--statistics-border-default);
  border-radius: var(--statistics-radius-xl);
  padding: 1rem 0.75rem 0.75rem;
  background: var(--statistics-surface-raised);
}

.statistics-type-card__pill {
  position: absolute;
  inset-block-start: -0.875rem;
  inset-inline-end: 0.75rem;
  min-block-size: 1.75rem;
  border: var(--statistics-border-hairline) solid var(--statistics-border-default);
  border-radius: var(--statistics-radius-full);
  padding: 0.375rem 1rem;
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-raised);
  font-size: var(--statistics-font-micro);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.25;
}

.statistics-type-card h3 {
  margin: 0;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-caption);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.35;
}

.statistics-type-card__metrics {
  display: flex;
  justify-content: space-between;
  gap: 0.5rem;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-micro);
  font-weight: var(--statistics-font-weight-bold);
}

.statistics-type-card__metric {
  display: inline-flex;
  align-items: center;
  min-inline-size: 0;
  gap: var(--statistics-meta-gap);
}

.statistics-type-card__metric i {
  inline-size: 0.5rem;
  block-size: 0.5rem;
  flex: 0 0 auto;
  border-radius: 0.25rem;
}

.statistics-type-card__metric--present i { background: var(--statistics-present-fill); }
.statistics-type-card__metric--excused i { background: var(--statistics-excused-fill); }
.statistics-type-card__metric--absent i { background: var(--statistics-absent-fill); }

.statistics-type-card__history {
  display: flex;
  inline-size: 100%;
  min-block-size: var(--statistics-history-height);
  gap: 0.25rem;
}

.statistics-type-card__segment {
  display: block;
  min-inline-size: 0;
  min-block-size: var(--statistics-history-height);
  flex: 1 1 0;
  border-radius: var(--statistics-radius-full);
  background: var(--statistics-none-fill);
}

.statistics-type-card__segment--present { background: var(--statistics-present-fill); }
.statistics-type-card__segment--absent { background: var(--statistics-absent-fill); }
.statistics-type-card__segment--excused { background: var(--statistics-excused-fill); }
.statistics-type-card__segment--future,
.statistics-type-card__segment--no-data { background: var(--statistics-none-fill); }

.statistics-dock {
  position: fixed;
  inset-inline: var(--statistics-inset);
  inset-block-end: calc(env(safe-area-inset-bottom) + var(--statistics-dock-bottom));
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: center;
  gap: 0.25rem;
  inline-size: min(calc(100% - 2rem), var(--statistics-content-width));
  min-block-size: var(--statistics-dock-height);
  margin-inline: auto;
  border-radius: var(--statistics-radius-2xl);
  padding: 0.5rem;
  background: color-mix(in srgb, var(--statistics-surface-float) 88%, transparent);
  backdrop-filter: blur(1.5625rem);
  z-index: 2;
}

.statistics-dock__item {
  display: grid;
  grid-template-rows: 1.25rem auto;
  gap: 0.25rem;
  justify-items: center;
  align-content: center;
  min-inline-size: 0;
  min-block-size: 3.75rem;
  border-radius: var(--statistics-radius-lg);
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-micro);
  font-weight: var(--statistics-font-weight-medium);
  line-height: 1.35;
  text-align: center;
}

.statistics-dock__item--active {
  color: var(--statistics-accent-on-now);
  background: var(--statistics-accent-now);
}

.statistics-dock__icon {
  display: grid;
  place-items: center;
  inline-size: 1.75rem;
  block-size: 1.25rem;
}

.statistics-dock__icon img {
  inline-size: 1rem;
  block-size: 1rem;
}

.statistics-visually-hidden {
  position: absolute;
  inline-size: var(--statistics-border-hairline);
  block-size: var(--statistics-border-hairline);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

@keyframes statistics-spin {
  to { transform: rotate(1turn); }
}

@media (prefers-reduced-motion: reduce) {
  .statistics-state__spinner { animation: none; }
}

@media (max-width: 22rem) {
  .statistics-screen,
  .statistics-detail { padding-inline: 0.75rem; }
  .statistics-metrics { gap: 0.375rem; }
  .statistics-metric { padding-inline: 0.5rem; }
  .statistics-metric__symbol { inline-size: 1.5rem; block-size: 1.5rem; }
  .statistics-type-filter__button { flex-basis: 7.25rem; }
  .statistics-dock { inset-inline: 0.75rem; inline-size: calc(100% - 1.5rem); }
}

@media (min-width: 26.625rem) {
  .statistics-screen,
  .statistics-detail { border-inline: var(--statistics-border-hairline) solid var(--statistics-border-default); }
}
