.rct-story > .topology {
  border-block-start: 0;
  background: transparent;
}
.topology > .rct-story__heading {
  margin-inline: auto;
  margin-block-end: clamp(2rem, 4vw, 4rem);
}
.topology__layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
  gap: clamp(.75rem, 1.8vw, 1.6rem);
  width: min(calc(100% - 2 * var(--story-gutter)), 96rem);
  margin-inline: auto;
}
.topology__layout--selected {
  grid-template-columns: minmax(0, 1fr) clamp(13.5rem, 16vw, 17rem);
}
.topology__graph {
  position: relative;
  min-width: 0;
}
.topology__diagram {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
  pointer-events: none;
}
.topology__edges {
  fill: none;
  stroke: #946bb9;
  stroke-width: 1.5;
  stroke-linejoin: round;
  stroke-linecap: round;
}
.topology__edges .topology__edge--telemetry {
  stroke: #917cb4;
  stroke-dasharray: 2 5;
}
.topology__edges .topology__edge--rpc {
  stroke: #bc9bdf;
  stroke-dasharray: 5 4;
}
.topology__edges .topology__edge--signal-bus {
  stroke-dasharray: none;
}
#topology-arrow path {
  fill: none;
  stroke: #bd9cdd;
  stroke-width: 1.35;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.topology__graph--selected .topology__edges {
  stroke: #d9a6ff;
  stroke-width: 2;
}
.topology__graph--selected .topology__edges:not(.topology__edges--muted) .topology__edge--telemetry {
  stroke: #d8c2f2;
}
.topology__graph--selected .topology__edges .topology__edge--rpc {
  stroke: #e0cbff;
}
.topology__graph--selected .topology__edges--muted {
  stroke: #9470aa;
  stroke-width: 1.2;
  opacity: .17;
}
.topology__packets {
  filter: drop-shadow(0 0 .24rem #bc79ff);
}
.topology__level,
.topology__row {
  display: contents;
}
.topology__level > h3 {
  position: absolute;
  inset: var(--level-y) auto auto .5%;
  max-width: 9.5%;
  color: #be9cda;
  font: 600 clamp(.7rem, .86vw, .84rem)/1.3 var(--story-mono);
  transform: translateY(-100%);
  padding-inline-start: .58rem;
  border-inline-start: 2px solid #8b5dab;
}
.topology__node {
  position: absolute;
  inset: var(--node-y) auto auto var(--node-x);
  width: var(--node-w);
  height: var(--node-h);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #624779;
  border-radius: .56rem;
  padding: .32rem .36rem;
  background: #21182c;
  color: #f3e8fa;
  font: 630 clamp(.71rem, .96vw, .91rem)/1.24 var(--rct-font-family-sans);
  overflow-wrap: anywhere;
  cursor: pointer;
  text-align: center;
}
.topology__node[data-tone='accent'] {
  background: #31203f;
  border-color: #aa7cc9;
}
.topology__node[data-tone='data'] {
  background: #1b1425;
  font-size: clamp(.64rem, .84vw, .81rem);
}
.topology__graph--selected .topology__node:not(.topology__node--neighbor, [aria-pressed='true'], :hover, :focus-visible) {
  opacity: .57;
}
.topology__node--neighbor {
  border-color: #ad84d0;
}
.topology__node[aria-pressed='true'] {
  border-color: #ead1ff;
  background: #4b2b64;
  box-shadow: 0 0 0 1px #d9acfa56, 0 0 1.2rem #a95de347;
}
.topology__node:hover {
  border-color: #e2b8fa;
}
.topology__node:focus-visible,
.topology__selection-heading button:focus-visible {
  outline: 2px solid #f0cfff;
  outline-offset: 3px;
}
.topology__mobile-selection {
  display: none;
}
.topology__desktop-selection {
  position: sticky;
  inset-block-start: calc(var(--story-header) + 1rem);
  max-height: calc(100svh - var(--story-header) - 2rem);
  overflow: auto;
  scrollbar-color: #795499 transparent;
}
.topology__selection {
  min-width: 0;
  border-inline-start: 2px solid #78559a;
  padding-inline-start: .85rem;
  overflow-wrap: anywhere;
}
.topology__selection-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .4rem;
  margin-block-end: .3rem;
}
.topology__selection-heading h3 {
  color: #f5e8ff;
  font-size: 1rem;
  font-weight: 690;
}
.topology__selection-heading button {
  flex: 0 0 2.75rem;
  height: 2.75rem;
  display: grid;
  place-items: center;
  border-radius: .5rem;
  border: 0;
  background: transparent;
  color: #e5c5f7;
  cursor: pointer;
}
.topology__selection-heading button:hover {
  background: #2b1b3a;
}
.topology__selection-heading svg {
  stroke: currentColor;
  stroke-width: 1.55;
  stroke-linecap: round;
}
.topology__ports,
.topology__selection-group h4 {
  color: #c7afd9;
  font-size: .77rem;
}
.topology__ports code,
.topology__selection-group code {
  color: #e6c7ff;
  font-size: .74rem;
}
.topology__ports code {
  display: block;
  margin-block-start: .18rem;
}
.topology__selection-group {
  margin-block-start: .85rem;
}
.topology__selection-group h4 {
  margin-block-end: .3rem;
  font-weight: 650;
}
.topology__selection-group li {
  display: grid;
  gap: .24rem;
  border-block-start: 1px solid #4b345b;
  padding-block: .55rem;
}
.topology__direction {
  display: flex;
  align-items: center;
  gap: .35rem;
  color: #f3e8fa;
  font-size: .87rem;
  font-weight: 650;
}
.topology__direction svg {
  flex: 0 0 1.55rem;
  stroke: #bd8ee0;
  stroke-width: 1.6;
  stroke-linecap: round;
  fill: none;
}
.topology__direction--incoming svg {
  transform: scaleX(-1);
}
.topology__direction svg circle {
  stroke: none;
  fill: #fff1ff;
  filter: drop-shadow(0 0 .2rem #dba7ff);
}
.topology__selection-group li p {
  color: #cab7d6;
  font-size: .78rem;
  line-height: 1.4;
}

@media (max-width: 69rem) {
  .topology__layout {
    display: block;
    max-width: 41rem;
  }
  .topology__diagram,
  .topology__desktop-selection {
    display: none;
  }
  .topology__graph {
    display: grid;
    gap: 1.4rem;
  }
  .topology__level {
    display: grid;
    gap: .42rem;
  }
  .topology__level > h3 {
    position: static;
    max-width: none;
    transform: none;
    padding-block: .15rem;
    margin-block-end: .17rem;
    font-size: .76rem;
  }
  .topology__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: .42rem;
  }
  .topology__node {
    position: static;
    width: 100%;
    min-height: 2.8rem;
    height: auto;
    justify-content: flex-start;
    padding: .5rem .56rem;
    font-size: .85rem;
    text-align: start;
  }
  .topology__node[data-tone='data'] {
    font-size: .81rem;
  }
  .topology__mobile-selection {
    display: block;
    grid-column: 1 / -1;
    margin-block: .35rem .65rem;
  }

  .topology__level[data-level='entry'] .topology__row,
  .topology__row[data-leading='grafana'],
  .topology__row[data-leading='dockerLogs'] {
    grid-template-columns: minmax(0, 1fr);
  }
  .topology__level[data-level='clients'] {
    position: relative;
    margin-inline-start: .85rem;
    padding-inline-start: 1.05rem;
  }
  .topology__level[data-level='clients']::before {
    content: '';
    position: absolute;
    inset: -1.4rem auto -.7rem 0;
    border-inline-start: 1px solid #624779;
  }
  .topology__level[data-level='routing'] .topology__row {
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
    column-gap: 1.2rem;
  }
  .topology__row[data-leading='nginx'],
  .topology__row[data-leading='gateway'],
  .topology__row[data-leading='bff'] {
    position: relative;
  }
  .topology__row[data-leading='nginx'],
  .topology__row[data-leading='bff'] {
    margin-block-start: .95rem;
  }
  .topology__row[data-leading='nginx']::before,
  .topology__row[data-leading='gateway']::before,
  .topology__row[data-leading='bff']::before,
  .topology__row[data-leading='gateway']::after {
    content: '';
    position: absolute;
    width: .9rem;
    height: .7rem;
    background: center / contain no-repeat url("data:image/svg+xml,%3Csvg viewBox='0 0 16 12' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 6h13m-4-4 4 4-4 4' fill='none' stroke='%23aa7cc9' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .topology__row[data-leading='nginx']::before,
  .topology__row[data-leading='gateway']::before,
  .topology__row[data-leading='bff']::before {
    top: -.86rem;
    left: .45rem;
    transform: rotate(90deg);
  }
  .topology__row[data-leading='gateway'] {
    margin-block-start: .55rem;
  }
  .topology__row[data-leading='gateway']::after {
    top: 1.03rem;
    left: calc(55% - .44rem);
  }
  .topology__graph--selected .topology__row::before,
  .topology__graph--selected .topology__row::after {
    opacity: .3;
  }
}

.topology__junctions {
  fill: #b795d7;
}
.topology__junctions [data-inactive] {
  opacity: .19;
}
.topology__signal-labels {
  fill: #b39bc8;
  font: 550 13px var(--story-mono);
}
.topology__telemetry-refs span {
  position: absolute;
  inset: var(--node-y) auto auto var(--node-x);
  width: var(--node-w);
  height: var(--node-h);
  display: grid;
  place-items: center;
  padding-inline: .28rem;
  text-align: center;
  color: #d8c7e5;
  background: var(--landing-bg);
  border: 1px dashed #7d6397;
  border-radius: .36rem;
  font: 560 clamp(.62rem, .86vw, .8rem)/1.2 var(--rct-font-family-sans);
}
.topology__graph--selected .topology__telemetry-refs span:not([data-related]) {
  opacity: .55;
}
.topology__telemetry-refs [data-related] {
  color: #f4e5ff;
  border-color: #d8adef;
}
.topology__mobile-routes {
  display: none;
}

@media (max-width: 69rem) {
  .topology__telemetry-refs {
    display: none;
  }
  .topology__mobile-routes:not(:empty) {
    display: grid;
    grid-column: 1 / -1;
    gap: .2rem;
    padding: .18rem .45rem .32rem;
    color: #c4aed5;
    font-size: .74rem;
    line-height: 1.42;
  }
  .topology__mobile-routes strong {
    color: #e1ccef;
    font-weight: 620;
  }
  .topology__route-arrow {
    margin-inline: .16rem;
  }
  .topology__mobile-routes [aria-hidden] {
    color: #b181d7;
  }
  .topology__graph--selected .topology__mobile-target:not([data-related]) {
    opacity: .66;
  }
  .topology__mobile-routes [data-related] {
    color: #f2dfff;
  }
  .topology__mobile-signals {
    margin-block-start: .42rem;
  }
  .topology__mobile-signals p {
    display: grid;
    gap: .14rem;
    padding-inline-start: .48rem;
    border-inline-start: 1px dashed #785a99;
  }
}
