}
:where([data-student-ui]) .statistics-chart__group-line,
:where([data-student-ui]):is(.statistics-chart__group-line) {
  stroke-dasharray: 4 3;
}
:where([data-student-ui]) .statistics-type-card__count,
:where([data-student-ui]):is(.statistics-type-card__count) {
  flex-basis: 100%;
  color: var(--statistics-text-secondary);
  font-weight: var(--statistics-font-weight-regular);
}
