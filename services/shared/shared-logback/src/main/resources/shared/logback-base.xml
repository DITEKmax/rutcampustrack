<?xml version="1.0" encoding="UTF-8"?>
<!--
  Общий Logback-конфиг для всех сервисов (QA7 + NEW-68).

  Подключается в логбэк-spring.xml сервиса:
      <include resource="shared/logback-base.xml"/>

  Даёт:
    * JSON-вывод в stdout через LoggingEventCompositeJsonEncoder.
    * Поля: ts, level, msg (маскированный), logger, thread, trace_id, user_id, event_type.
    * Маскирование Bearer / telegram_id / FCM endpoint в поле msg (MaskingJsonProvider).

  Сервис переопределяет:
    * property SERVICE_NAME (иначе unknown-service).
    * кастомные level'ы для своих логгеров.
-->
<included>

    <property name="SERVICE_NAME" value="${SERVICE_NAME:-unknown-service}"/>

    <appender name="SHARED_JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>ts</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                </timestamp>
                <version>
                    <fieldName>v</fieldName>
                </version>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <!-- ВАЖНО: MaskingJsonProvider вместо стандартного MessageJsonProvider. -->
                <provider class="ru.rutcampustrack.shared.logback.MaskingJsonProvider">
                    <fieldName>msg</fieldName>
                </provider>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>userId</includeMdcKeyName>
                    <includeMdcKeyName>eventType</includeMdcKeyName>
                </mdc>
                <pattern>
                    <pattern>{"service":"${SERVICE_NAME}"}</pattern>
                </pattern>
                <stackTrace>
                    <fieldName>stack</fieldName>
                </stackTrace>
                <arguments>
                    <includeNonStructuredArguments>false</includeNonStructuredArguments>
                </arguments>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="SHARED_JSON_STDOUT"/>
    </root>

</included>
