+                + ", userId=" + userId
+                + ", sessionVersion=" + sessionVersion
+                + ", rolesVersion=" + rolesVersion
+                + ", role=" + role
+                + ", status=" + status
+                + ", groupId=" + groupId
+                + ", isHeadman=" + isHeadman
+                + ", readOnly=" + readOnly
+                + "]";
