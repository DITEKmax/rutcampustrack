@import '../styles/tokens.pcss';
.requests-review-catalog { padding: var(--rct-space-4); overflow-wrap: anywhere; }
.requests-review-catalog a { color: var(--rct-color-accent-now); }
.requests-review { min-inline-size: 0; scrollbar-width: none; }
.requests-review::-webkit-scrollbar { display: none; }
.requests-review-status { padding: var(--rct-space-4); margin-block-end: var(--rct-today-bottom-space); color: var(--rct-color-danger-text); overflow-wrap: anywhere; }
