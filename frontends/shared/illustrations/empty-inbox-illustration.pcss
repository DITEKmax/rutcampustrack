.rct-empty-inbox-illustration {
  display: block;
  inline-size: calc(var(--control-height) * 6.5);
  max-inline-size: 100%;
  block-size: auto;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.rct-empty-inbox-illustration__inside {
  fill: var(--color-accent-soft);
}
.rct-empty-inbox-illustration__fold,
.rct-empty-inbox-illustration__handle {
  stroke: var(--color-border-accent);
}
.rct-empty-inbox-illustration__front {
  fill: var(--color-surface-raised);
  stroke: var(--color-border-strong);
}
.rct-empty-inbox-illustration__placeholder {
  stroke: var(--color-border-strong);
}
.rct-empty-inbox-illustration__detail {
  stroke: var(--color-text-muted);
}
.rct-empty-inbox-illustration__accent {
  fill: var(--color-border-strong);
}
