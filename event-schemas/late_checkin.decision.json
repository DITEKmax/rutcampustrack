{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "late_checkin.decision",
  "description": "Староста нажал кнопку одобрения/отклонения в Telegram. Публикуется notification-bot и потребляется Attendance Service для применения решения.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "late_checkin.decision"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "approved",
        "decision_by"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        },
        "approved": {
          "type": "boolean"
        },
        "decision_by": {
          "type": "integer",
          "minimum": 1,
          "description": "Внутренний academic user_id старосты, принявшего решение."
        }
      }
    },
    "event_version": {
      "const": 1
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "const": "notification-bot"
    }
  }
}
