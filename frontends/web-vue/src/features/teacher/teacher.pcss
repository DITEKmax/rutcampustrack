.teacher-page {
  --web-teacher-journal-name-width: 11rem;
  --web-teacher-journal-column-width: 4rem;
  --web-teacher-filter-width: 22.5rem;
  --web-teacher-date-width: 12rem;
  --web-teacher-stats-metric-width: 12rem;
  --web-teacher-panel-width: 45rem;
  --web-teacher-attachment-height: 28rem;
  min-inline-size: 0;
  gap: var(--space-5);
  overflow-wrap: anywhere;
  font-size: var(--rct-font-size-body);
  color: var(--rct-color-text-primary);
}
.teacher-page h2 {
  font-size: var(--rct-font-size-title-block);
  font-weight: var(--rct-font-weight-medium);
  line-height: var(--rct-leading-snug);
}
.teacher-home-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  gap: var(--space-5);
  align-items: start;
}
.teacher-lesson-layout {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-5);
  align-items: start;
}
.teacher-panel {
  background: var(--rct-color-surface-raised);
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  min-inline-size: 0;
}
.teacher-links,
.teacher-day-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: var(--rct-space-3);
}
.teacher-links a {
  text-underline-offset: var(--rct-space-1);
}
.teacher-table-scroll {
  min-inline-size: 0;
  max-inline-size: 100%;
  overflow-x: auto;
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  background: var(--color-surface-raised);
  scrollbar-gutter: stable;
}
.teacher-table {
  inline-size: 100%;
  border-spacing: 0;
  border-collapse: separate;
  font-size: var(--rct-font-size-dense);
  line-height: var(--rct-leading-caption);
  text-align: start;
}
.teacher-table th,
.teacher-table td {
  border-inline-end: var(--rct-border-hairline) solid var(--rct-color-border-subtle);
  border-block-end: var(--rct-border-hairline) solid var(--rct-color-border-subtle);
  padding: var(--rct-space-2) var(--rct-space-3);
  font-weight: var(--rct-font-weight-regular);
  text-align: start;
}
.teacher-table th:last-child,
.teacher-table td:last-child {
  border-inline-end: 0;
}
.teacher-table tr:last-child td,
.teacher-table tbody tr:last-child th {
  border-block-end: 0;
}
.teacher-table thead th {
  background: var(--web-data-header-surface);
  color: var(--rct-color-text-secondary);
  font-weight: var(--rct-font-weight-medium);
}
.teacher-table tbody td,
.teacher-table tbody th {
  background: var(--color-surface-raised);
}
.teacher-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  gap: var(--space-3);
}
.teacher-filters > .web-field,
.teacher-types {
  flex: 1 1 var(--web-teacher-filter-width);
  min-inline-size: 0;
  max-inline-size: var(--web-teacher-filter-width);
}
.teacher-filters .web-field-value { white-space: normal; overflow: visible; }
.teacher-types {
  display: grid;
  gap: var(--space-1);
  font-size: var(--rct-font-size-dense);
}
.teacher-types-label { color: var(--color-text-secondary); font-weight: var(--font-weight-medium); }
.teacher-type-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.teacher-type-buttons > .web-button {
  flex: 1 1 auto;
  padding-inline: var(--space-2);
}
.teacher-page .web-button {
  min-inline-size: 0;
  max-inline-size: 100%;
  white-space: normal;
  overflow-wrap: anywhere;
}
.teacher-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  gap: var(--rct-space-3);
}
.teacher-toolbar .web-field {
  min-inline-size: 0;
}
.teacher-period > .web-field {
  flex: 0 1 var(--web-teacher-date-width);
  max-inline-size: 100%;
}
.teacher-day-pager {
  display: grid;
  grid-template-columns: var(--web-workspace-control-height) minmax(0, 1fr) repeat(2, var(--web-workspace-control-height));
  align-items: center;
  gap: var(--rct-space-2);
  padding: var(--rct-space-2);
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  background: var(--rct-color-surface-raised);
}
.teacher-day-pager > .web-field { min-inline-size: 0; margin: 0; }
.teacher-day-pager .web-icon-button { inline-size: var(--web-workspace-control-height); block-size: var(--web-workspace-control-height); padding: 0; }
.teacher-day-list {
  gap: var(--space-2);
}
.teacher-day-list li {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: start;
  gap: var(--rct-space-3);
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
  background: var(--color-surface-raised);
  font-size: var(--rct-font-size-dense);
}
.teacher-day-content {
  display: grid;
  gap: var(--rct-space-1);
  overflow-wrap: anywhere;
}
.teacher-day-content a {
  justify-self: start;
  font-weight: var(--font-weight-medium);
  color: inherit;
}
.teacher-day-list .teacher-day-cancelled {
  color: var(--color-state-danger-text);
  background: var(--color-state-danger-bg);
  border-color: var(--color-state-danger-border);
}
.teacher-day-list .teacher-day-one-off {
  color: var(--color-state-success-text);
  background: var(--color-state-success-bg);
  border-color: var(--color-state-success-border);
}
.teacher-day-moved .teacher-day-status,
.teacher-request-pending { color: var(--color-state-warning-text); }
.teacher-day-status { font-weight: var(--font-weight-medium); }
.teacher-day-list .teacher-day-active {
  color: var(--web-action-ink);
  background: var(--web-action-fill);
  border-color: var(--web-action-fill);
}
.teacher-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  inline-size: var(--rct-space-5);
  block-size: var(--rct-space-5);
  border-radius: var(--rct-radius-full);
  font-size: var(--rct-font-size-micro);
  font-weight: var(--rct-font-weight-medium);
  vertical-align: middle;
}
.teacher-mark-present {
  background: var(--rct-color-status-present-fill);
  color: var(--rct-color-status-present-on-fill);
}
.teacher-mark-excused {
  background: var(--rct-color-status-excused-fill);
  color: var(--rct-color-status-excused-on-fill);
}
.teacher-mark-absent {
  background: var(--rct-color-status-absent-fill);
  color: var(--rct-color-status-absent-on-fill);
}
.teacher-mark-none {
  background: var(--rct-color-status-none-fill);
  color: var(--rct-color-status-none-on-fill);
}
.teacher-pending {
  position: absolute;
  inset-inline-end: calc(-1 * var(--rct-space-2));
  inset-block-start: calc(-1 * var(--rct-space-2));
  color: var(--rct-color-text-primary);
}
.teacher-cell-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--rct-space-1);
  border: 0;
  background: transparent;
  cursor: pointer;
  color: inherit;
  border-radius: var(--rct-radius-xs);
}
.teacher-roster td {
  text-align: center;
}
.teacher-journal .teacher-table {
  inline-size: max-content;
  min-inline-size: 100%;
}
.teacher-journal {
  scroll-padding-inline-start: calc(var(--web-teacher-journal-name-width) + var(--space-2));
}
.teacher-journal .teacher-table > thead > tr > th { text-align: center; }
.teacher-journal .teacher-table > thead > tr:nth-child(n+2) > th:last-child { border-inline-end: var(--rct-border-hairline) solid var(--rct-color-border-default); }
.teacher-journal td {
  text-align: center;
  padding-block: var(--rct-space-1);
}
.teacher-journal .teacher-journal-slot {
  inline-size: var(--web-teacher-journal-column-width);
  min-inline-size: var(--web-teacher-journal-column-width);
  max-inline-size: var(--web-teacher-journal-column-width);
  padding-inline: var(--space-2);
}
.teacher-journal-times .teacher-journal-slot {
  background: color-mix(in srgb, var(--web-data-header-surface) 70%, var(--color-surface-raised));
}
.teacher-journal-types .teacher-journal-slot {
  background: color-mix(in srgb, var(--web-data-header-surface) 35%, var(--color-surface-raised));
}
.teacher-journal-times th > span,
.teacher-journal-dates .web-caption { display: block; }
.teacher-journal .teacher-sticky-name {
  position: sticky;
  inset-inline-start: 0;
  z-index: 1;
  inline-size: var(--web-teacher-journal-name-width);
  min-inline-size: var(--web-teacher-journal-name-width);
  max-inline-size: var(--web-teacher-journal-name-width);
  overflow-wrap: anywhere;
}
.teacher-journal .teacher-cross > :is(th, td),
.teacher-journal :is(th, td).teacher-cross {
  background: color-mix(in srgb, var(--web-action-fill) 50%, var(--color-surface-raised));
  color: var(--color-text-primary);
}
.teacher-journal tr.teacher-cross .teacher-journal-slot.teacher-cross {
  background: var(--web-action-fill);
  color: var(--web-action-ink);
}
.teacher-excuse-header { display: flex; align-items: start; justify-content: space-between; gap: var(--rct-space-4); }
.teacher-excuse-header > .web-icon-button { flex-shrink: 0; }
.teacher-excuse {
  inline-size: min(100%, var(--web-teacher-panel-width));
  align-self: start;
}
.teacher-definitions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3) var(--space-5);
  margin: 0;
}
.teacher-definitions dt {
  font-size: var(--rct-font-size-caption);
  color: var(--rct-color-text-muted);
  margin-block-end: var(--rct-space-1);
}
.teacher-definitions dd {
  margin: 0;
}
.teacher-attachment {
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  overflow-wrap: anywhere;
}
.teacher-attachment-header {
  display: grid;
  grid-template-columns: var(--space-6) minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--space-2);
  min-inline-size: 0;
}
.teacher-attachment-header > strong { min-inline-size: 0; overflow-wrap: anywhere; }
.teacher-checkbox { display: inline-flex; align-items: center; gap: var(--rct-space-2); min-block-size: var(--web-workspace-control-height); }
.teacher-checkbox input { appearance: none; display: inline-grid; place-items: center; flex-shrink: 0; inline-size: var(--rct-space-5); block-size: var(--rct-space-5); margin: 0; border: var(--rct-border-hairline) solid var(--rct-color-border-default); border-radius: var(--rct-radius-xs); background: var(--rct-color-surface-raised); }
.teacher-checkbox input:checked { background: var(--web-action-fill); border-color: var(--web-action-ink); }
.teacher-checkbox input::after { content: ''; inline-size: var(--rct-space-2); block-size: var(--rct-space-3); border: solid var(--web-action-ink); border-width: 0 calc(var(--rct-border-hairline) * 2) calc(var(--rct-border-hairline) * 2) 0; transform: rotate(45deg); opacity: 0; }
.teacher-checkbox input:checked::after { opacity: 1; }
.teacher-attachment-image {
  max-inline-size: 100%;
  max-block-size: var(--web-teacher-attachment-height);
  object-fit: contain;
  align-self: start;
}
.teacher-export .web-field {
  max-inline-size: var(--web-teacher-filter-width);
}
.teacher-scope-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-1);
  align-self: center;
}
.teacher-column-tools {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-2);
  align-items: center;
}
.teacher-text-button {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--rct-space-1);
  border: 0;
  background: transparent;
  color: inherit;
  text-align: start;
  padding: 0;
  cursor: pointer;
  font: inherit;
}
.teacher-text-button[aria-disabled='true'],
.teacher-attachment .web-button[aria-disabled='true'] { cursor: default; }
.teacher-text-button .web-caption {
  flex-basis: 100%;
}
.teacher-stats-table {
  min-inline-size: max-content;
}
.teacher-stats-table th {
  min-inline-size: var(--web-teacher-stats-metric-width);
}
.teacher-stats-table td > span {
  display: block;
}
.teacher-statistics-page .teacher-filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); inline-size: 100%; }
.teacher-statistics-page .teacher-filters > :is(.web-field, .teacher-types) { inline-size: 100%; max-inline-size: none; }
.teacher-statistics-search { flex: 1 1 var(--web-teacher-filter-width); max-inline-size: var(--web-teacher-filter-width); }
.teacher-statistics-page .teacher-applied-context { margin-block-end: calc(-1 * var(--space-3)); }
@media (width < 64rem) {
  .teacher-lesson-layout {
    grid-template-columns: minmax(0, 1fr);
  }
}
@media (width < 48rem) {
  .teacher-home-layout,
  .teacher-statistics-page .teacher-filters { grid-template-columns: minmax(0, 1fr); }
  .teacher-filters {
    flex-direction: column;
    gap: var(--rct-space-3);
  }
  .teacher-filters > .web-field,
  .teacher-filters > .teacher-types {
    inline-size: 100%;
    max-inline-size: none;
    flex-basis: auto;
  }
  .teacher-page {
    --web-teacher-journal-name-width: 9rem;
    --web-teacher-stats-metric-width: 9rem;
  }
}
@media (width < 32rem) {
  .teacher-day-list li { grid-template-columns: minmax(0, 1fr); }
  .teacher-page { --web-teacher-journal-name-width: 8rem; }
}
