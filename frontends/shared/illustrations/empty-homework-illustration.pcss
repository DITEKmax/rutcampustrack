.rct-empty-homework-illustration { display: block; inline-size: calc(var(--control-height) * 6.5); max-inline-size: 100%; block-size: auto; stroke-linecap: round; stroke-linejoin: round; }
.rct-empty-homework-illustration__paper { fill: var(--color-surface-raised); stroke: var(--color-border-strong); }
.rct-empty-homework-illustration__binding, .rct-empty-homework-illustration__lines { stroke: var(--color-text-muted); }
.rct-empty-homework-illustration__check { fill: var(--color-accent-soft); stroke: var(--color-border-accent); }
.rct-empty-homework-illustration__tick { stroke: var(--color-border-accent); }
.rct-empty-homework-illustration__dot { fill: var(--color-border-strong); }
