{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson.deleted",
  "description": "Одна или несколько записей Lesson были физически удалены в schedule-service (например, при редактировании ScheduleItem с регенерацией PLANNED-пар). Потребители должны удалить все свои записи, привязанные к этим lesson_id, чтобы не остались orphan-строки, которые будут выглядеть как дубликаты после пересоздания.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "lesson.deleted"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "lesson_ids"
      ],
      "properties": {
        "lesson_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
