@import '../../styles/tokens.pcss';
.admin-more { display: grid; gap: var(--rct-space-6); max-inline-size: calc(var(--rct-mobile-content-width) + var(--rct-space-4) * 2); margin-inline: auto; padding: calc(var(--rct-space-5) + env(safe-area-inset-top)) var(--rct-space-4); color: var(--rct-color-text-primary); font-family: var(--rct-font-family-sans); }
.admin-more h1 { margin: 0; font-size: var(--rct-font-size-title-screen); line-height: var(--rct-leading-snug); }
.admin-more h2 { margin: 0 0 var(--rct-space-3); font-size: var(--rct-font-size-title-block); }
.admin-more__row { display: flex; align-items: center; gap: var(--rct-space-4); inline-size: 100%; min-block-size: calc(var(--rct-space-4) * 4); padding: var(--rct-space-4); border: 0; border-radius: var(--rct-radius-xl); color: inherit; background: var(--rct-color-surface-raised); font: inherit; font-size: var(--rct-font-size-title-block); font-weight: var(--rct-font-weight-bold); text-align: start; cursor: pointer; @mixin rct-focus-ring; }
.admin-more__row span { flex: 1; min-inline-size: 0; overflow-wrap: anywhere; }
.admin-more__row img { flex: none; }

.admin-more section { display: grid; gap: var(--rct-space-3); }
.admin-more section h2 { margin: 0; }
.admin-more__row > .mobile-icon { flex: none; }
