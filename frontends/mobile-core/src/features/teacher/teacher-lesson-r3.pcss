@import '../../styles/tokens.pcss';
.teacher-screen .teacher-lesson-card { padding-inline-end: var(--rct-space-4); }
.teacher-lesson-card .teacher-lesson-card__title, .teacher-lesson-card .teacher-lesson-card__meta { padding-inline-end: calc(var(--rct-space-4) * 2); }
.teacher-lesson-card[data-one-off='true'] { color: var(--rct-color-text-primary); background: var(--rct-color-success-surface); }
.teacher-lesson-card[data-current='true'] { color: var(--rct-color-accent-on-now); background: var(--rct-color-accent-now); }
.teacher-lesson-card[data-cancelled='true'] { color: var(--rct-color-text-secondary); background: var(--rct-color-surface-float); }
.teacher-lesson-card__topline { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--rct-space-2); min-inline-size: 0; }
.teacher-lesson-card__time { min-inline-size: 0; }
.teacher-lesson-card .teacher-lesson-card__group { flex: none; max-inline-size: 50%; margin: 0; padding: var(--rct-space-1) var(--rct-space-2); border-radius: var(--rct-radius-full); background: var(--rct-role-overlay-surface); color: var(--rct-color-text-primary); font-size: var(--rct-font-size-micro); text-align: end; overflow-wrap: anywhere; }
.teacher-lesson-card__tags { display: flex; flex-wrap: wrap; gap: var(--rct-space-1); margin-block-end: var(--rct-space-1); }
.teacher-lesson-card__tag { padding: var(--rct-space-half) var(--rct-space-2); border-radius: var(--rct-radius-full); color: var(--rct-color-text-primary); background: var(--rct-color-surface-float); font-size: var(--rct-font-size-micro); }
.teacher-lesson-card__tag[data-tone='cancelled'] { color: var(--rct-color-danger-text); background: var(--rct-error-surface); }
.teacher-lesson-card__tag[data-tone='one-off'] { color: var(--rct-color-status-on-fill); background: var(--rct-color-status-present-fill); }
.teacher-lesson-card__tag[data-tone='active'] { color: var(--rct-color-accent-on-now); background: var(--rct-color-accent-now); }
.teacher-lesson-card__cancellation { margin-block-start: var(--rct-space-2); font-size: var(--rct-font-size-caption); white-space: pre-wrap; overflow-wrap: anywhere; }
.teacher-lesson-detail__download { position: relative; flex: none; margin-inline-start: auto; }
