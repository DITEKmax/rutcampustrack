@import '../../styles/tokens.pcss';
.teacher-journal {
  display: grid;
  gap: var(--rct-space-4);
  box-sizing: border-box;
  min-inline-size: 0;
  inline-size: 100%;
  max-inline-size: var(--rct-today-content-max);
  margin-inline: auto;
  padding: var(--rct-space-5) var(--rct-space-4) var(--rct-today-bottom-space);
  color: var(--rct-color-text-primary);
  font-family: var(--rct-font-family-sans);
  font-variant-numeric: tabular-nums;
}
.teacher-journal *,
.teacher-journal *::before,
.teacher-journal *::after {
  box-sizing: border-box;
}
.teacher-journal h1,
.teacher-journal p {
  margin: 0;
  overflow-wrap: anywhere;
}
.teacher-journal h1 {
  min-inline-size: 0;
  font-size: var(--rct-font-size-title-screen);
  line-height: var(--rct-leading-tight);
}
.teacher-journal h1 small {
  display: block;
  margin-block-start: var(--rct-space-1);
  font-size: var(--rct-font-size-caption);
  font-weight: var(--rct-font-weight-regular);
  color: var(--rct-color-text-secondary);
}
.teacher-journal__header {
  display: flex;
  gap: var(--rct-space-3);
  align-items: center;
}
.teacher-journal button {
  font: inherit;
  cursor: pointer;
  @mixin rct-focus-ring;
}
.teacher-journal button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}
.teacher-journal__icon {
  display: grid;
  place-items: center;
  flex: none;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-xl);
  padding: 0;
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
}
.teacher-journal__icon .mobile-icon {
  inline-size: var(--rct-profile-control-icon-size);
  block-size: var(--rct-profile-control-icon-size);
}
.teacher-journal__type-toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--rct-control-min-touch);
  align-items: start;
  gap: var(--rct-space-2);
}
.teacher-journal__types {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(0, 1fr);
  gap: var(--rct-space-1);
  min-inline-size: 0;
}
.teacher-journal__types button {
  min-inline-size: 0;
  min-block-size: var(--rct-control-min-touch);
  padding: var(--rct-space-2) var(--rct-space-1);
  border: 0;
  border-radius: var(--rct-radius-lg);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  font-size: var(--rct-font-size-micro);
  overflow-wrap: anywhere;
}
.teacher-journal__types button[aria-pressed='true'],
.teacher-journal__icon[aria-pressed='true'],
.teacher-journal__download {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
.teacher-journal__types button:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}
.teacher-journal__state {
  display: grid;
  place-items: center;
  min-block-size: var(--rct-state-min-height);
  color: var(--rct-color-text-secondary);
  text-align: center;
}
.teacher-journal__loading {
  min-inline-size: 0;
  overflow: hidden;
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-raised);
}
.teacher-journal__loading-row {
  display: grid;
  grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
  align-items: center;
  gap: var(--rct-space-3);
  min-block-size: var(--rct-control-min-touch);
  padding: var(--rct-space-2);
  border-block-end: var(--rct-border-hairline) solid var(--rct-color-border-default);
}
.teacher-journal__loading-row:last-child {
  border-block-end: 0;
}
.teacher-journal__loading-line {
  block-size: var(--rct-space-3);
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-skeleton-fill);
}
.teacher-journal__loading-row:first-child .teacher-journal__loading-line {
  inline-size: 70%;
}
.teacher-journal__table-panel {
  min-inline-size: 0;
}
.teacher-journal__table-scroll {
  position: relative;
  min-inline-size: 0;
  max-inline-size: 100%;
  overflow: auto;
  border-radius: var(--rct-radius-lg);
  isolation: isolate;
  overflow-anchor: none;
  overscroll-behavior-inline: contain;
  scrollbar-color: var(--rct-color-accent-now) var(--rct-color-surface-float);
  touch-action: pan-x pan-y;
  @mixin rct-focus-ring;
}
.teacher-journal__table {
  border-spacing: 0;
  border-collapse: separate;
  inline-size: max-content;
  min-inline-size: 100%;
  font-size: var(--rct-font-size-caption);
  background: var(--rct-color-surface-raised);
  zoom: var(--teacher-journal-scale, 1);
}
.teacher-journal__table th,
.teacher-journal__table td {
  padding: var(--rct-space-2);
  border-block-end: var(--rct-border-hairline) solid var(--rct-color-border-default);
  text-align: center;
}
.teacher-journal__table thead th {
  color: var(--rct-color-text-secondary);
  font-weight: var(--rct-font-weight-regular);
}
.teacher-journal__table thead th span {
  display: block;
}
.teacher-journal__table .teacher-journal__name {
  --teacher-journal-sticky-width: min(
    var(--rct-teacher-journal-name-width),
    calc(55vw / var(--teacher-journal-scale, 1))
  );
  position: sticky;
  inset-inline-start: 0;
  z-index: 1;
  inline-size: var(--teacher-journal-sticky-width);
  min-inline-size: var(--teacher-journal-sticky-width);
  max-inline-size: var(--teacher-journal-sticky-width);
  background: var(--rct-color-surface-raised);
  text-align: start;
  white-space: normal;
  overflow-wrap: anywhere;
  box-shadow: var(--rct-border-hairline) 0 0 var(--rct-color-border-default);
}
.teacher-journal__table tbody .teacher-journal__name {
  font-weight: var(--rct-font-weight-medium);
}
.teacher-journal__lesson-heading {
  display: grid;
  place-content: center;
  gap: var(--rct-space-1);
  min-block-size: var(--rct-control-min-touch);
  min-inline-size: var(--rct-control-min-touch);
  inline-size: 100%;
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-1);
  background: transparent;
  color: inherit;
}
.teacher-journal__date-heading {
  font-weight: var(--rct-font-weight-medium);
}
.teacher-journal__table td,
.teacher-journal__table thead th:not(.teacher-journal__name) {
  min-inline-size: var(--rct-control-min-touch);
}
.teacher-journal__percent {
  white-space: nowrap;
}
.teacher-journal__student-heading {
  display: block;
  inline-size: 100%;
  min-block-size: var(--rct-control-min-touch);
  padding: 0;
  border: 0;
  border-radius: var(--rct-radius-md);
  background: transparent;
  color: inherit;
  text-align: start;
  overflow-wrap: anywhere;
}
.teacher-journal__table .teacher-journal__type-heading {
  border: var(--rct-border-hairline) solid var(--rct-color-border-strong);
  font-size: var(--rct-font-size-micro);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
}
.teacher-journal__table .teacher-journal__metric-heading,
.teacher-journal__table .teacher-journal__percent {
  background: var(--rct-color-surface-float);
  border-inline-start: var(--rct-border-hairline) solid var(--rct-color-border-default);
}
.teacher-journal__table [data-selected-column='true'],
.teacher-journal__table [data-selected-row='true'] > th,
.teacher-journal__table
  [data-selected-row='true']
  > td:not([data-threshold='meets'], [data-threshold='below']) {
  background: light-dark(var(--rct-color-accent-soft), var(--rct-color-accent-now));
  color: light-dark(var(--rct-color-text-primary), var(--rct-color-accent-on-now));
}
.teacher-journal__table [data-selected-row='true'] > td[data-selected-column='true'] {
  background: light-dark(var(--rct-color-accent-now), var(--rct-color-accent-now-hover));
  color: var(--rct-color-accent-on-now);
}
.teacher-journal__table
  [data-selected-column='true']
  :is(
    .teacher-journal__cancelled-label,
    .teacher-journal__mark--none,
    .teacher-journal__mark--cancelled .teacher-journal__cell-circle
  ),
.teacher-journal__table
  [data-selected-row='true']
  :is(
    .teacher-journal__mark--none,
    .teacher-journal__mark--cancelled .teacher-journal__cell-circle
  ) {
  color: inherit;
}
.teacher-journal__table
  [data-selected-row='true']
  .teacher-journal__percent:is([data-threshold='meets'], [data-threshold='below']) {
  box-shadow:
    inset 0 var(--rct-border-hairline) var(--rct-color-accent-now),
    inset 0 calc(-1 * var(--rct-border-hairline)) var(--rct-color-accent-now);
}
.teacher-journal__table [data-selected-column='true'] .teacher-journal__date-heading:focus-visible,
.teacher-journal__table [data-selected-row='true'] .teacher-journal__student-heading:focus-visible {
  outline-color: light-dark(var(--rct-color-accent-now), var(--rct-color-accent-on-now));
}
.teacher-journal__table thead tr:first-child > th {
  border-block-end-color: var(--rct-color-border-strong);
}
.teacher-journal__table .teacher-journal__type-row > th {
  border-block-end: calc(var(--rct-border-hairline) * 2) solid var(--rct-color-border-strong);
}
.teacher-journal__table [data-day-start='true'] {
  border-inline-start: calc(var(--rct-border-hairline) * 2) solid var(--rct-color-border-strong);
}
.teacher-journal__table .teacher-journal__percent[data-threshold='meets'] {
  background: var(--rct-color-success-surface);
  color: var(--rct-color-success-text);
}
.teacher-journal__table .teacher-journal__percent[data-threshold='below'] {
  background: var(--rct-color-state-danger-bg);
  color: var(--rct-color-danger-text);
}
.teacher-journal__table tfoot > tr > th,
.teacher-journal__table tfoot > tr > td {
  border-block-start: calc(var(--rct-border-hairline) * 2) solid var(--rct-color-border-strong);
  vertical-align: top;
}
.teacher-journal__threshold {
  inline-size: var(--rct-control-min-touch);
  border-inline-start: var(--rct-border-hairline) solid var(--rct-color-border-default);
}
.teacher-journal__threshold-input {
  inline-size: 100%;
  min-inline-size: var(--rct-control-min-touch);
  max-inline-size: calc(var(--rct-control-min-touch) + var(--rct-space-6));
  min-block-size: var(--rct-control-min-touch);
  padding: var(--rct-space-1);
  border: var(--rct-border-hairline) solid var(--rct-color-border-strong);
  border-radius: var(--rct-radius-md);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
  font: inherit;
  text-align: center;
  @mixin rct-focus-ring;
}
.teacher-journal__threshold-input[aria-invalid='true'] {
  border-color: var(--rct-color-state-danger-border);
}
.teacher-journal__threshold-error {
  display: block;
  max-inline-size: calc(var(--rct-control-min-touch) + var(--rct-space-6));
  padding-block-start: var(--rct-space-1);
  color: var(--rct-color-danger-text);
  font-size: var(--rct-font-size-micro);
}
.teacher-journal p.teacher-journal__legend {
  display: flex;
  align-items: center;
  gap: var(--rct-space-2);
  margin-block-start: var(--rct-space-3);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}
.teacher-journal__table thead .teacher-journal__metric-symbols {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--rct-space-1);
}
.teacher-journal__metric-mark {
  display: inline-grid;
  place-items: center;
  flex: none;
  inline-size: var(--rct-profile-control-icon-size);
  block-size: var(--rct-profile-control-icon-size);
  border-radius: var(--rct-radius-full);
  font-size: var(--rct-font-size-micro);
  font-style: normal;
  font-weight: var(--rct-font-weight-bold);
  line-height: 1;
}
.teacher-journal__metric-mark--present {
  background: var(--rct-color-status-present-fill);
  color: var(--rct-color-status-present-on-fill);
}
.teacher-journal__metric-mark--excused {
  background: var(--rct-color-status-excused-fill);
  color: var(--rct-color-status-excused-on-fill);
}
.teacher-journal__metric-mark--absent {
  background: var(--rct-color-status-absent-fill);
  color: var(--rct-color-status-absent-on-fill);
}
.teacher-journal__present {
  color: var(--rct-color-success-text);
}
.teacher-journal__excused {
  color: var(--rct-color-warning-text);
}
.teacher-journal__absent {
  color: var(--rct-color-danger-text);
}
.teacher-journal__mark {
  position: relative;
  display: inline-grid;
  place-items: center;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  padding: 0;
  border: 0;
  border-radius: var(--rct-radius-full);
  background: transparent;
  font-weight: var(--rct-font-weight-bold);
}
.teacher-journal__cell-circle {
  display: grid;
  place-items: center;
  inline-size: var(--rct-headman-status-size);
  block-size: var(--rct-headman-status-size);
  border-radius: var(--rct-radius-full);
  font-size: var(--rct-font-size-caption);
  line-height: 1;
}
.teacher-journal__mark--present .teacher-journal__cell-circle {
  color: var(--rct-color-status-present-on-fill);
  background: var(--rct-color-status-present-fill);
}
.teacher-journal__mark--excused .teacher-journal__cell-circle {
  color: var(--rct-color-status-excused-on-fill);
  background: var(--rct-color-status-excused-fill);
}
.teacher-journal__mark--absent .teacher-journal__cell-circle {
  color: var(--rct-color-status-absent-on-fill);
  background: var(--rct-color-status-absent-fill);
}
.teacher-journal__pending-ring,
.teacher-journal__mark--absent[data-pending-ticket='true'] .teacher-journal__cell-circle {
  outline: calc(var(--rct-border-hairline) * 2) solid var(--rct-color-state-warning-border);
  outline-offset: var(--rct-border-hairline);
}
.teacher-journal__table :is([data-selected-row='true'], [data-selected-column='true'])
  .teacher-journal__mark--absent[data-pending-ticket='true'] .teacher-journal__cell-circle {
  box-shadow: 0 0 0 calc(var(--rct-border-hairline) * 4) var(--rct-color-surface-raised);
}
.teacher-journal__mark--cancelled .teacher-journal__cell-circle {
  color: var(--rct-color-text-muted);
  background: transparent;
}
.teacher-journal__cancelled-label {
  display: block;
  color: var(--rct-color-text-muted);
  font-size: var(--rct-font-size-micro);
}
.teacher-journal__mark--none {
  color: var(--rct-color-text-secondary);
}
.teacher-journal__sr {
  position: absolute;
  inline-size: var(--rct-border-hairline);
  block-size: var(--rct-border-hairline);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
.teacher-journal__chart {
  display: grid;
  min-inline-size: 0;
  gap: var(--rct-space-3);
  padding: var(--rct-space-2);
  border-radius: var(--rct-radius-xl);
  background: var(--rct-color-surface-raised);
}
.teacher-journal__plot {
  display: block;
  inline-size: 100%;
  block-size: auto;
}
.teacher-journal__chart-grid line {
  stroke: var(--rct-color-border-default);
  stroke-width: 1;
}
.teacher-journal__chart-grid text,
.teacher-journal__chart-axis text,
.teacher-journal__chart-probe {
  fill: var(--rct-color-text-secondary);
  font-family: inherit;
  font-size: var(--rct-font-size-micro);
}
.teacher-journal__chart-probe {
  visibility: hidden;
}
.teacher-journal__plot g[tabindex] {
  cursor: pointer;
  @mixin rct-focus-ring;
}
.teacher-journal__bar--present {
  fill: var(--rct-color-success-text);
}
.teacher-journal__bar--excused {
  fill: var(--rct-color-warning-text);
}
.teacher-journal__bar--absent {
  fill: var(--rct-color-danger-text);
}
.teacher-journal__chart p {
  font-size: var(--rct-font-size-caption);
}
.teacher-journal__chart-readout {
  display: grid;
  gap: var(--rct-space-2);
  min-inline-size: 0;
  padding: var(--rct-space-2);
  font-size: var(--rct-font-size-caption);
}
.teacher-journal__chart-lesson {
  display: grid;
  gap: var(--rct-space-1);
  font-weight: var(--rct-font-weight-bold);
}
.teacher-journal__chart-lesson span {
  color: var(--rct-color-text-secondary);
  font-weight: var(--rct-font-weight-regular);
}
.teacher-journal__chart-metrics {
  display: grid;
  grid-template-columns: minmax(0, 1fr) max-content;
  gap: var(--rct-space-1) var(--rct-space-3);
  margin: 0;
}
.teacher-journal__chart-metrics dt {
  overflow-wrap: anywhere;
  color: var(--rct-color-text-secondary);
}
.teacher-journal__chart-metrics dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
  text-align: end;
}
.teacher-journal__export {
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--rct-control-min-touch);
  align-items: start;
  gap: var(--rct-space-2);
}
.teacher-journal__preparing {
  display: flex;
  align-items: center;
  gap: var(--rct-space-3);
  padding: var(--rct-space-3);
  border-radius: var(--rct-radius-xl);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-secondary);
}
.teacher-journal__spinner {
  flex: none;
  inline-size: var(--rct-progress-size);
  block-size: var(--rct-progress-size);
  border: var(--rct-progress-stroke) solid var(--rct-color-border-default);
  border-inline-start-color: var(--rct-color-accent-now);
  border-radius: var(--rct-radius-full);
  animation: teacher-journal-spin 900ms linear infinite;
}
@keyframes teacher-journal-spin {
  to {
    transform: rotate(360deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  .teacher-journal__spinner {
    animation: none;
  }
}

.teacher-journal__back {
  border-radius: var(--rct-radius-full);
}
