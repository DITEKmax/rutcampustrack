+        CyclicBarrier barrier = new CyclicBarrier(2);
+        try {
+            Future<SessionStatePort.RefreshResult> first = executor.submit(() -> {
+                barrier.await();
+                return service.refresh(new SessionLifecycleService.RefreshRequest(
+                        USER_ID, SESSION_ID, INITIAL_JTI,
