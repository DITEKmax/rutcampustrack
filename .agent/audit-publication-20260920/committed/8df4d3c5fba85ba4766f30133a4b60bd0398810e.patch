+<script setup lang="ts">
+import { computed, nextTick, onBeforeUnmount, onMounted, ref, shallowRef, watch } from 'vue'
+import type { MapRevokeSignal, MapViewState } from './map-contract'
+import type { MapController } from './map-controller'
+import './map-screen.pcss'
+
+const props = withDefaults(defineProps<{
+  controller: MapController
+  theme?: 'dark' | 'light'
+}>(), { theme: 'dark' })
+
+const emit = defineEmits<{ back: []; revoke: [signal: MapRevokeSignal] }>()
+const state = shallowRef<MapViewState>(props.controller.getSnapshot())
+const viewport = ref<HTMLElement | null>(null)
+const buildingSelect = ref<HTMLSelectElement | null>(null)
+const floorSelect = ref<HTMLSelectElement | null>(null)
+const viewportWidth = ref(0)
+const viewportHeight = ref(0)
+const scale = ref(1)
+const drag = ref<{ pointerId: number; x: number; y: number } | null>(null)
+let unsubscribe: (() => void) | null = null
+let unsubscribeInvalidation: (() => void) | null = null
+let resizeObserver: ResizeObserver | null = null
+let mounted = false
+let mountGeneration = 0
+let selectorGeneration = 0
+
+type SelectionIdentity = {
+  readonly buildingId: string | null
+  readonly floorId: string | null
+  readonly assetUrl: string | null
+  readonly asset: string | null
+}
+
+type SelectorInteraction = {
+  readonly mountGeneration: number
+  readonly selectorGeneration: number
+  readonly before: SelectionIdentity
+}
+
+const building = computed(() => state.value.catalog?.buildings.find((item) => item.id === state.value.selectedBuildingId) ?? null)
+const descriptor = computed(() => state.value.plan && state.value.assetFormat ? state.value.plan[state.value.assetFormat] : null)
+const intrinsicWidth = computed(() => descriptor.value?.width ?? descriptor.value?.viewBox?.[2] ?? 640)
+const intrinsicHeight = computed(() => descriptor.value?.height ?? descriptor.value?.viewBox?.[3] ?? 360)
+const fitScale = computed(() => {
+  if (viewportWidth.value <= 0 || viewportHeight.value <= 0) return 1
+  return Math.min(1, viewportWidth.value / intrinsicWidth.value, viewportHeight.value / intrinsicHeight.value)
+})
+const imageWidth = computed(() => Math.max(1, Math.round(intrinsicWidth.value * fitScale.value * scale.value)))
+const imageHeight = computed(() => Math.max(1, Math.round(intrinsicHeight.value * fitScale.value * scale.value)))
+const zoomLabel = computed(() => `${Math.round(scale.value * 100)}%`)
+const zoomAnnouncement = computed(() => {
+  const base = state.value.announcement.replace(/,?\s*масштаб\s+\d+%\.?$/iu, '').trim()
+  return base ? `${base} Масштаб ${zoomLabel.value}.` : `Масштаб ${zoomLabel.value}.`
+})
+const canZoomOut = computed(() => scale.value > 1)
+const canZoomIn = computed(() => scale.value < 4)
+const hasViewer = computed(() => state.value.phase === 'ready' && state.value.assetUrl !== null)
+const showRetainedRetry = computed(() => hasViewer.value && (state.value.message !== null || state.value.syncStatus === 'update-failed' || state.value.syncStatus === 'storage-unavailable'))
+
+onMounted(() => {
+  mounted = true
+  mountGeneration += 1
+  invalidateSelectorHandlers()
+  unsubscribe = props.controller.subscribe((next) => {
+    const previous = state.value
+    state.value = next
+    if (supersedesSelectorInteraction(previous, next)) invalidateSelectorHandlers()
+  })
+  unsubscribeInvalidation = props.controller.subscribeInvalidation((signal) => {
+    invalidateSelectorHandlers()
+    emit('revoke', signal)
+  })
+  resizeObserver = typeof ResizeObserver === 'function' ? new ResizeObserver(updateViewportSize) : null
+  void openMap()
+})
+
+onBeforeUnmount(() => {
+  mounted = false
+  mountGeneration += 1
+  invalidateSelectorHandlers()
+  unsubscribe?.()
+  unsubscribeInvalidation?.()
+  resizeObserver?.disconnect()
+  props.controller.dispose()
+})
+
+watch(() => state.value.assetUrl, () => resetViewport())
+
+watch(viewport, (element, previous) => {
+  if (previous) resizeObserver?.unobserve(previous)
+  if (element) {
+    resizeObserver?.observe(element)
+    updateViewportSize()
+  }
+}, { flush: 'post' })
+
+async function selectBuilding(value: string): Promise<void> {
+  const before = selectionIdentity()
+  const interaction: SelectorInteraction = { mountGeneration, selectorGeneration: ++selectorGeneration, before }
+  await props.controller.selectBuilding(value)
+  if (!isCurrentSelectorInteraction(interaction)) return
+  await restoreControlledSelectors(interaction)
+  if (!isCurrentSelectorInteraction(interaction)) return
+  if (selectionChanged(interaction.before, selectionIdentity())) resetViewportForInteraction(interaction)
+}
+
+async function selectFloor(value: string): Promise<void> {
+  const before = selectionIdentity()
+  const interaction: SelectorInteraction = { mountGeneration, selectorGeneration: ++selectorGeneration, before }
+  await props.controller.selectFloor(value)
+  if (!isCurrentSelectorInteraction(interaction)) return
+  await restoreControlledSelectors(interaction)
+  if (!isCurrentSelectorInteraction(interaction)) return
+  if (selectionChanged(interaction.before, selectionIdentity())) resetViewportForInteraction(interaction)
+}
+
+async function restoreControlledSelectors(interaction: SelectorInteraction): Promise<void> {
+  if (!isCurrentSelectorInteraction(interaction)) return
+  await nextTick()
+  if (!isCurrentSelectorInteraction(interaction)) return
+  if (buildingSelect.value && isCurrentSelectorInteraction(interaction)) {
+    buildingSelect.value.value = state.value.selectedBuildingId ?? ''
+  }
+  if (!isCurrentSelectorInteraction(interaction)) return
+  if (floorSelect.value && isCurrentSelectorInteraction(interaction)) {
+    floorSelect.value.value = state.value.selectedFloorId ?? ''
+  }
+}
+
+function selectionIdentity(): SelectionIdentity {
+  const plan = state.value.plan
+  const asset = plan === null ? null : [
+    plan.version,
+    plan.png.format,
+    plan.png.state,
+    plan.png.id ?? '',
+    plan.png.bytes,
+    plan.png.sha256 ?? '',
+    plan.svg.format,
+    plan.svg.state,
+    plan.svg.id ?? '',
+    plan.svg.bytes,
+    plan.svg.sha256 ?? '',
+  ].join(':')
+  return { buildingId: state.value.selectedBuildingId, floorId: state.value.selectedFloorId, assetUrl: state.value.assetUrl, asset }
+}
+
+function selectionChanged(before: ReturnType<typeof selectionIdentity>, after: ReturnType<typeof selectionIdentity>): boolean {
+  return before.buildingId !== after.buildingId || before.floorId !== after.floorId || before.assetUrl !== after.assetUrl || before.asset !== after.asset
+}
+
+function isCurrentSelectorInteraction(interaction: SelectorInteraction): boolean {
+  return mounted
+    && interaction.mountGeneration === mountGeneration
+    && interaction.selectorGeneration === selectorGeneration
+}
+
+function invalidateSelectorHandlers(): void {
+  selectorGeneration += 1
+}
+
+function supersedesSelectorInteraction(previous: MapViewState, next: MapViewState): boolean {
+  return previous.offline !== next.offline
+    || (previous.phase !== next.phase && (next.phase === 'idle' || next.phase === 'session-inactive' || previous.phase === 'session-inactive'))
+}
+
+async function retry(): Promise<void> {
+  invalidateSelectorHandlers()
+  await props.controller.retry()
+}
+
+async function openMap(): Promise<void> {
+  await props.controller.open()
+}
+
+function zoomBy(delta: number): void {
+  scale.value = clamp(Number((scale.value + delta).toFixed(2)), 1, 4)
+}
+
+function resetViewport(): void {
+  scale.value = 1
+  viewport.value?.scrollTo({ left: 0, top: 0 })
+}
+
+function resetViewportForInteraction(interaction: SelectorInteraction): void {
+  if (!isCurrentSelectorInteraction(interaction)) return
+  resetViewport()
+}
+
+function onKeydown(event: KeyboardEvent): void {
+  if (!hasViewer.value) return
+  if (event.key === '+' || event.key === '=') {
+    event.preventDefault()
+    zoomBy(0.25)
+  } else if (event.key === '-' || event.key === '_') {
+    event.preventDefault()
+    zoomBy(-0.25)
+  } else if (event.key === '0') {
+    event.preventDefault()
+    resetViewport()
+  } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight' || event.key === 'ArrowUp' || event.key === 'ArrowDown') {
+    event.preventDefault()
+    const distance = event.shiftKey ? 48 : 24
+    viewport.value?.scrollBy({
+      left: event.key === 'ArrowLeft' ? -distance : event.key === 'ArrowRight' ? distance : 0,
+      top: event.key === 'ArrowUp' ? -distance : event.key === 'ArrowDown' ? distance : 0,
+    })
+  }
+}
+
+function onWheel(event: WheelEvent): void {
+  if (!event.ctrlKey && !event.metaKey) return
+  event.preventDefault()
+  zoomBy(event.deltaY < 0 ? 0.25 : -0.25)
+}
+
+function onPointerdown(event: PointerEvent): void {
+  if (event.button !== 0) return
+  if ((event.target as Element).closest('button')) return
+  drag.value = { pointerId: event.pointerId, x: event.clientX, y: event.clientY }
+  ;(event.currentTarget as HTMLElement).setPointerCapture(event.pointerId)
+}
+
+function onPointermove(event: PointerEvent): void {
+  if (!drag.value || drag.value.pointerId !== event.pointerId) return
+  viewport.value?.scrollBy({ left: drag.value.x - event.clientX, top: drag.value.y - event.clientY })
+  drag.value = { pointerId: event.pointerId, x: event.clientX, y: event.clientY }
+}
+
+function onPointerup(event: PointerEvent): void {
+  if (drag.value?.pointerId === event.pointerId) drag.value = null
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(max, Math.max(min, value))
+}
+
+function updateViewportSize(): void {
+  viewportWidth.value = viewport.value?.clientWidth ?? 0
+  viewportHeight.value = viewport.value?.clientHeight ?? 0
+}
+
+function syncLabel(syncStatus: MapViewState['syncStatus'], offline: boolean, message: string | null): string | null {
+  if (syncStatus === 'updated') return 'Карты обновлены и сохранены для офлайн-доступа.'
+  if (syncStatus === 'unchanged') return 'Сохранённые карты актуальны.'
+  if (syncStatus === 'update-failed') return 'Обновление не удалось; показана последняя сохранённая версия.'
+  if (syncStatus === 'storage-unavailable' && offline) return message ?? 'Текущая карта доступна из памяти; подключись к сети, чтобы обновить её.'
+  if (syncStatus === 'storage-unavailable') return 'Хранилище недоступно; текущая карта работает онлайн.'
+  if (syncStatus === 'no-cache') return 'Полной сохранённой версии пока нет.'
+  return null
+}
+</script>
+
+<template>
+  <main
+    class="map-screen"
+    :data-theme="theme"
+    aria-labelledby="map-title"
+  >
+    <header class="map-screen__header">
+      <button
+        class="map-screen__back"
+        type="button"
+        aria-label="Назад"
+        @click="emit('back')"
+      >
+        ←
+      </button>
+      <h1 id="map-title">
+        Карта кампуса
+      </h1>
+      <span
+        class="map-screen__header-spacer"
+        aria-hidden="true"
+      />
+      <p
+        v-if="state.offline"
+        class="map-screen__offline"
+        role="status"
+      >
+        {{ state.syncStatus === 'storage-unavailable' ? 'Офлайн · текущая карта доступна из памяти; подключись к сети, чтобы обновить её.' : 'Офлайн · используются сохранённые карты' }}
+      </p>
+    </header>
+
+    <section
+      v-if="state.catalog"
+      class="map-screen__selectors"
+      aria-label="Выбор карты"
+    >
+      <label class="map-field">
+        <span>Корпус</span>
+        <select
+          ref="buildingSelect"
+          :value="state.selectedBuildingId ?? ''"
+          :disabled="state.catalog.buildings.length === 0"
+          aria-label="Корпус"
+          @change="selectBuilding(($event.target as HTMLSelectElement).value)"
+        >
+          <option
+            v-for="item in state.catalog.buildings"
+            :key="item.id"
+            :value="item.id"
+          >
+            {{ item.label }}
+          </option>
+        </select>
+      </label>
+      <label class="map-field">
+        <span>Этаж</span>
+        <select
+          ref="floorSelect"
+          :value="state.selectedFloorId ?? ''"
+          :disabled="!building || building.floors.length === 0"
+          aria-label="Этаж"
+          @change="selectFloor(($event.target as HTMLSelectElement).value)"
+        >
+          <option
+            v-for="floor in building?.floors ?? []"
+            :key="floor.id"
+            :value="floor.id"
+          >
+            {{ floor.label }}
+          </option>
+        </select>
+      </label>
+    </section>
+
+    <section
+      v-if="state.phase === 'loading'"
+      class="map-screen__state"
+      aria-live="polite"
+    >
+      <p aria-hidden="true">
+        ◌
+      </p>
+      <p>Загружаем карту…</p>
+    </section>
+    <section
+      v-else-if="state.phase === 'empty-catalog' || state.phase === 'empty-floors' || state.phase === 'no-plan' || state.phase === 'offline-no-cache' || state.phase === 'unavailable' || state.phase === 'forbidden' || state.phase === 'session-inactive'"
+      class="map-screen__state"
+      :class="{ 'map-screen__state--error': state.phase === 'forbidden' || state.phase === 'session-inactive', 'map-screen__state--empty': state.phase === 'no-plan' }"
+      :role="state.phase === 'forbidden' || state.phase === 'session-inactive' ? 'alert' : 'status'"
+    >
+      <template v-if="state.phase === 'no-plan'">
+        <p>Для этого этажа схема не загружена</p>
+        <p>Выбери другой этаж</p>
+      </template>
+      <template v-else>
+        <h2>{{ state.phase === 'offline-no-cache' ? 'Карта не сохранена' : state.phase === 'forbidden' ? 'Нет доступа' : state.phase === 'session-inactive' ? 'Сессия недоступна' : 'Карта пока недоступна' }}</h2>
+        <p>{{ state.message }}</p>
+      </template>
+      <button
+        v-if="state.phase === 'offline-no-cache' || state.phase === 'unavailable'"
+        class="map-screen__retry"
+        type="button"
+        @click="retry"
+      >
+        Повторить
+      </button>
+    </section>
+    <section
+      v-else-if="state.phase === 'error'"
+      class="map-screen__state map-screen__state--error"
+      role="alert"
+    >
+      <h2>Не удалось показать карту</h2>
+      <p>{{ state.message }}</p>
+      <button
+        class="map-screen__retry"
+        type="button"
+        @click="retry"
+      >
+        Повторить
+      </button>
+    </section>
+    <section
+      v-else-if="hasViewer"
+      class="map-viewer"
+      aria-label="Просмотр плана этажа"
+    >
+      <div class="map-viewer__canvas">
+        <div class="map-viewer__toolbar">
+          <button
+            class="map-viewer__button"
+            type="button"
+            :disabled="!canZoomOut"
+            aria-label="Уменьшить карту"
+            @click="zoomBy(-0.25)"
+          >
+            −
+          </button>
+          <span class="map-viewer__toolbar-label">{{ zoomLabel }}</span>
+          <button
+            class="map-viewer__button"
+            type="button"
+            :disabled="!canZoomIn"
+            aria-label="Увеличить карту"
+            @click="zoomBy(0.25)"
+          >
+            +
+          </button>
+          <button
+            class="map-viewer__button"
+            type="button"
+            aria-label="Сбросить масштаб и положение"
+            @click="resetViewport"
+          >
+            ⟳
+          </button>
+        </div>
+        <div
+          ref="viewport"
+          class="map-viewer__viewport"
+          tabindex="0"
+          role="application"
+          aria-label="План этажа. Стрелки перемещают, плюс и минус меняют масштаб, 0 сбрасывает"
+          @keydown="onKeydown"
+          @pointerdown="onPointerdown"
+          @pointermove="onPointermove"
+          @pointerup="onPointerup"
+          @pointercancel="onPointerup"
+          @wheel="onWheel"
+        >
+          <img
+            class="map-viewer__image"
+            :src="state.assetUrl ?? undefined"
+            :alt="state.assetAlt ?? 'План этажа'"
+            :width="imageWidth"
+            :height="imageHeight"
+            draggable="false"
+          >
+        </div>
+      </div>
+      <button
+        v-if="showRetainedRetry"
+        class="map-screen__retry map-viewer__retry"
+        type="button"
+        @click="retry"
+      >
+        Повторить обновление
+      </button>
+      <p
+        class="map-viewer__status"
+        role="status"
+        aria-live="polite"
+      >
+        {{ zoomAnnouncement }}
+      </p>
+      <p
+        v-if="syncLabel(state.syncStatus, state.offline, state.message)"
+        class="map-screen__sync"
+        role="status"
+      >
+        {{ syncLabel(state.syncStatus, state.offline, state.message) }}
+      </p>
+    </section>
+    <section
+      v-else
+      class="map-screen__state"
+      aria-live="polite"
+    >
+      <p>
+        Открой карту, чтобы загрузить план этажа.
+      </p>
+    </section>
+
+    <p
+      class="map-screen__visually-hidden"
+      role="status"
+      aria-live="polite"
+    >
+      {{ zoomAnnouncement }}
+    </p>
+  </main>
+</template>
