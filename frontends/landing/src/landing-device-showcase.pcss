.landing-section.surface-return {
  --surface-return-wash: color-mix(in srgb, var(--landing-purple) 54%, transparent);
  --surface-return-frame-width: 15.75rem;
  --surface-return-stage-width: 68rem;
  --surface-return-frame-border: color-mix(in srgb, var(--landing-accent) 30%, transparent);
  --surface-return-shadow: 0 var(--rct-space-5) var(--rct-space-10) var(--rct-color-shadow-overlay-strong);
  --surface-return-shift: var(--rct-space-8);

  position: relative;
  isolation: isolate;
  overflow: clip;
  padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem);
  background: radial-gradient(ellipse 62% 58% at 50% 46%, var(--surface-return-wash), transparent);
}

.surface-return__anchor {
  position: absolute;
  inset-block-start: 0;
  scroll-margin-block-start: calc(var(--landing-header) + var(--rct-space-3));
}

.surface-return__stage {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: stretch;
  gap: var(--rct-space-3);
  max-inline-size: var(--surface-return-stage-width);
  margin-inline: auto;
}

.surface-return__screens {
  display: grid;
  flex-basis: 100%;
  grid-template-columns: repeat(3, minmax(0, var(--surface-return-frame-width)));
  justify-content: center;
  align-items: start;
  gap: clamp(1rem, 3vw, 2.5rem);
  padding: var(--rct-space-3) var(--rct-space-6) calc(var(--surface-return-shift) + var(--rct-space-5));
  perspective: 87.5rem;
}

.surface-return__screen {
  position: relative;
  min-inline-size: 0;
}

.surface-return__screen--left {
  transform: translateY(var(--surface-return-shift)) rotateY(12deg) rotateZ(-7deg);
}

.surface-return__screen--center {
  z-index: 1;
}

.surface-return__screen--right {
  transform: translateY(var(--surface-return-shift)) rotateY(-12deg) rotateZ(7deg);
}

@media (prefers-reduced-motion: no-preference) {
  .surface-return__screens[data-showcase-motion] .surface-return__screen:not([data-visible]) {
    opacity: 0;
  }

  .surface-return__screens[data-showcase-motion] .surface-return__screen[data-visible] {
    animation: surface-return-screen-enter 500ms cubic-bezier(.18, .72, .25, 1)
      var(--surface-return-screen-delay, 0ms) both;
  }
}

@media (width > 42rem) {
  .surface-return__screen--center {
    --surface-return-screen-delay: 80ms;
  }

  .surface-return__screen--right {
    --surface-return-screen-delay: 160ms;
  }
}

@keyframes surface-return-screen-enter {
  from {
    opacity: 0;
    translate: 0 var(--rct-space-6);
  }

  to {
    opacity: 1;
    translate: none;
  }
}

.surface-return__frame {
  padding: var(--rct-space-1-half);
  border: var(--landing-rule) solid var(--surface-return-frame-border);
  border-radius: var(--rct-radius-2xl);
  background-color: var(--landing-surface);
  box-shadow: var(--surface-return-shadow);
}

.surface-return__frame img {
  display: block;
  inline-size: 100%;
  block-size: auto;
  border-radius: var(--rct-radius-xl);
}

.surface-return__screen figcaption {
  margin-block-start: var(--rct-space-4);
  color: var(--landing-muted);
  font-size: var(--rct-font-size-caption);
  line-height: var(--rct-leading-caption);
  text-align: center;
}

.surface-return__callout {
  z-index: 2;
  display: flex;
  flex: 0 1 auto;
  align-items: center;
  gap: var(--rct-space-3);
  max-inline-size: 100%;
  padding: var(--rct-space-3) var(--rct-space-4);
  border: var(--landing-rule) solid var(--landing-border);
  border-radius: var(--landing-radius);
  background-color: color-mix(in srgb, var(--landing-surface) 88%, var(--landing-accent));
  box-shadow: var(--surface-return-shadow);
  font-size: var(--rct-font-size-caption);
  line-height: var(--rct-leading-caption);
}

.surface-return__badge {
  display: grid;
  flex: none;
  place-items: center;
  inline-size: var(--rct-space-9);
  block-size: var(--rct-space-9);
  border-radius: var(--rct-radius-full);
  background-color: color-mix(in srgb, var(--landing-accent) 15%, transparent);
  color: var(--landing-accent);
}

.surface-return__callout strong {
  font-weight: var(--rct-font-weight-medium);
}

@media (min-width: 68rem) {
  .surface-return__callout {
    position: absolute;
    gap: var(--rct-space-2);
    padding: var(--rct-space-2) var(--rct-space-3);
    font-size: var(--rct-font-size-micro);
  }

  .surface-return__callout--role {
    inset: -2% auto auto 0;
    transform: rotate(-4deg);
  }

  .surface-return__callout--access {
    inset: auto 0 14% auto;
    transform: rotate(3deg);
  }
}

@media (max-width: 48rem) {
  .surface-return__screens {
    gap: var(--rct-space-4);
  }
}

@media (max-width: 42rem) {
  .surface-return__screens {
    grid-template-columns: minmax(0, 21.5rem);
    gap: var(--rct-space-7);
    padding: 0 0 var(--rct-space-5);
  }

  .surface-return__screen--left,
  .surface-return__screen--right {
    transform: none;
  }

  .surface-return__callout {
    flex-basis: 20rem;
  }
}
