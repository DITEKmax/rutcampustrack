:where([data-student-ui]):is(.profile-row:disabled) {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
  opacity: 0.72;
}

:where([data-student-ui]) .profile-more-row:active,
:where([data-student-ui]):is(.profile-more-row:active),
:where([data-student-ui]) .profile-row:active,
:where([data-student-ui]):is(.profile-row:active),
:where([data-student-ui]) .profile-role-card:active,
:where([data-student-ui]):is(.profile-role-card:active) {
  transform: translateY(var(--rct-border-hairline));
}

:where([data-student-ui]) .profile-card,
:where([data-student-ui]):is(.profile-card) {
  display: flex;
  align-items: center;
  gap: var(--rct-profile-card-gap, var(--rct-space-3));
  inline-size: 100%;
  min-block-size: var(--rct-profile-card-height, var(--rct-form-textarea-height));
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  background: var(--profile-color-surface-raised);
}

:where([data-student-ui]) .profile-avatar,
:where([data-student-ui]):is(.profile-avatar) {
  display: grid;
  flex: 0 0 var(--rct-profile-avatar-size, calc(var(--rct-role-avatar-size) + var(--rct-space-2)));
  place-items: center;
  inline-size: var(
    --rct-profile-avatar-size,
    calc(var(--rct-role-avatar-size) + var(--rct-space-2))
  );
  block-size: var(
