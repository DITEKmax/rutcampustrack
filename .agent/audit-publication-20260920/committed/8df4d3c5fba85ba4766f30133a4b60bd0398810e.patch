+
+function isDurableAuthorityLoss(error: MapError): boolean {
+  const cause = error.causeValue
+  return typeof cause === 'object' && cause !== null && 'authorityChanged' in cause && (cause as { readonly authorityChanged?: unknown }).authorityChanged === true
