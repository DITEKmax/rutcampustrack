@import '../../styles/tokens.pcss';

.admin-dashboard-screen {
  min-block-size: 100dvh;
  max-inline-size: var(--rct-mobile-content-width);
  margin-inline: auto;
  padding: calc(env(safe-area-inset-top) + var(--rct-space-5)) var(--rct-space-4) calc(env(safe-area-inset-bottom) + var(--rct-space-5));
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
  font-family: var(--rct-font-family-sans);
  @mixin rct-type-body;
}

.admin-dashboard-screen__header,
.admin-dashboard-screen__content,
.admin-dashboard-screen__stats,
.admin-dashboard-screen__stat {
  display: grid;
  gap: var(--rct-space-3);
}

.admin-dashboard-screen__header {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  margin-block-end: var(--rct-space-5);
}

.admin-dashboard-screen__header h1,
.admin-dashboard-screen__eyebrow,
.admin-dashboard-screen__semester,
.admin-dashboard-screen__stats,
.admin-dashboard-screen__state {
  margin: 0;
}

.admin-dashboard-screen__eyebrow,
.admin-dashboard-screen__semester span,
.admin-dashboard-screen__stat dt {
  color: var(--rct-color-text-muted);
  font-size: var(--rct-font-size-caption);
}

.admin-dashboard-screen__header h1 {
  font-size: var(--rct-font-size-title-screen);
  font-weight: var(--rct-font-weight-bold);
}

.admin-dashboard-screen__refresh {
  min-block-size: var(--rct-control-min-touch);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding-inline: var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  font: inherit;
  font-size: var(--rct-font-size-caption);
  font-weight: var(--rct-font-weight-bold);
  cursor: pointer;
  @mixin rct-focus-ring;
}

.admin-dashboard-screen__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--rct-space-2);
}

.admin-dashboard-screen__refresh:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: default;
}

.admin-dashboard-screen__semester {
  display: grid;
  gap: var(--rct-space-1);
}

.admin-dashboard-screen__semester strong {
  font-weight: var(--rct-font-weight-medium);
}

.admin-dashboard-screen__stats {
  gap: var(--rct-space-3);
}

.admin-dashboard-screen__stat {
  gap: var(--rct-space-1);
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-4);
  background: var(--rct-color-surface-raised);
}

.admin-dashboard-screen__stat dt {
  order: 1;
}

.admin-dashboard-screen__stat dd {
  order: 0;
  margin: 0;
  font-size: var(--rct-font-size-title-screen);
  font-weight: var(--rct-font-weight-bold);
  font-variant-numeric: tabular-nums;
}

.admin-dashboard-screen__state {
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-raised);
}

.admin-dashboard-screen__state--error {
  color: var(--rct-color-danger-text);
}

@media (prefers-reduced-motion: reduce) {
  .admin-dashboard-screen * {
    scroll-behavior: auto;
    transition-duration: 0ms;
    animation-duration: 0ms;
  }
}
