diff --git a/frontends/mobile-core/src/features/map/map-validation.ts b/frontends/mobile-core/src/features/map/map-validation.ts
new file mode 100644
index 00000000..a633a562
--- /dev/null
+++ b/frontends/mobile-core/src/features/map/map-validation.ts
@@ -0,0 +1,373 @@
+import type {
+  MapAssetDescriptor,
+  MapAssetRequest,
+  MapCachedAsset,
+  MapCatalog,
+  MapFormat,
+  MapManifest,
+  MapPlan,
+} from './map-contract'
+import { MapError, mapAssetKey } from './map-contract'
+
+const MAX_ASSET_BYTES = 10 * 1024 * 1024
+const MAX_RASTER_SIDE = 16_384
+const MAX_RASTER_PIXELS = 40_000_000
+const MAX_SVG_EXTENT = 16_384
+const MAX_SVG_ELEMENTS = 10_000
+const SHA256_RE = /^[a-f0-9]{64}$/i
+const SVG_NS = 'http://www.w3.org/2000/svg'
+const XMLNS_NS = 'http://www.w3.org/2000/xmlns/'
+
+const SVG_ELEMENTS = new Set([
+  'svg', 'g', 'path', 'rect', 'circle', 'ellipse', 'line', 'polyline', 'polygon', 'text',
+])
+const SVG_ATTRIBUTES = new Set([
+  'aria-label', 'class', 'cx', 'cy', 'd', 'fill', 'fill-opacity', 'font-size', 'height',
+  'id', 'opacity', 'points', 'r', 'role', 'rx', 'ry', 'stroke', 'stroke-linecap',
+  'stroke-linejoin', 'stroke-opacity', 'stroke-width', 'text-anchor', 'viewbox',
+  'width', 'x', 'x1', 'x2', 'y', 'y1', 'y2',
+])
+
+export interface ValidatedMapAsset {
+  readonly descriptor: MapAssetDescriptor
+  readonly blob: Blob
+  readonly sha256: string
+  readonly width?: number
+  readonly height?: number
+  readonly viewBox?: readonly [number, number, number, number]
+}
+
+export interface AssetValidationOptions {
+  readonly decodePng?: (blob: Blob) => Promise<{ readonly width: number; readonly height: number }>
+}
+
+export function validateCatalog(input: unknown): MapCatalog {
+  const source = asRecord(input, 'catalog')
+  const revision = nonEmptyString(source.revision, 'catalog.revision')
+  const buildings = arrayOf(source.buildings, 'catalog.buildings').map((building, index) => validateBuilding(building, index))
+  assertUnique(buildings.map((building) => building.id), 'catalog building ids')
+  for (const building of buildings) {
+    assertUnique(building.floors.map((floor) => floor.id), `building ${building.id} floor ids`)
+    for (const floor of building.floors) {
+      if (floor.plan !== null) validatePlanMetadata(floor.plan, building.id, floor.id)
+    }
+  }
+  return { revision, buildings }
+}
+
+export function validatePlan(input: unknown, buildingId: string, floorId: string): MapPlan {
+  return validatePlanMetadata(input, buildingId, floorId)
+}
+
+export function validateManifest(input: unknown): MapManifest {
+  const source = asRecord(input, 'manifest')
+  if (source.schemaVersion !== 1) throw invalid('manifest.schemaVersion', 'неподдерживаемая версия схемы')
+  if (source.validationPolicyVersion !== 1) throw invalid('manifest.validationPolicyVersion', 'неподдерживаемая политика проверки')
+  const catalog = validateCatalog(source)
+  return {
+    schemaVersion: 1,
+    validationPolicyVersion: 1,
+    revision: catalog.revision,
+    buildings: catalog.buildings,
+  }
+}
+
+export async function validateAssetBlob(descriptor: MapAssetDescriptor, blob: Blob, options: AssetValidationOptions = {}): Promise<ValidatedMapAsset> {
+  if (descriptor.state !== 'ready' || descriptor.id === null || descriptor.sha256 === null) throw invalid('asset.state', 'запрошен ассет, который не готов')
+  const expectedType = descriptor.format === 'png' ? 'image/png' : 'image/svg+xml'
+  if (descriptor.contentType !== expectedType) throw invalid('asset.contentType', 'MIME не соответствует формату')
+  if (blob.type !== expectedType) throw invalid('asset.blob.type', 'ответ ассета имеет неожиданный MIME')
+  if (!Number.isSafeInteger(descriptor.bytes) || descriptor.bytes <= 0 || descriptor.bytes > MAX_ASSET_BYTES) throw invalid('asset.bytes', 'размер ассета выходит за лимит')
+  if (blob.size !== descriptor.bytes) throw invalid('asset.bytes', 'размер ассета не совпадает с манифестом')
+  if (!SHA256_RE.test(descriptor.sha256)) throw invalid('asset.sha256', 'манифест не содержит SHA-256')
+
+  const bytes = new Uint8Array(await blob.arrayBuffer())
+  const sha256 = await digestSha256(bytes)
+  if (sha256 !== descriptor.sha256.toLowerCase()) throw invalid('asset.sha256', 'хеш ассета не совпадает с манифестом')
+
+  if (descriptor.format === 'png') {
+    const dimensions = validatePngStructure(bytes, descriptor)
+    const decoded = await (options.decodePng ?? decodePngBlob)(blob)
+    if (decoded.width !== dimensions.width || decoded.height !== dimensions.height) throw invalid('asset.png.decode', 'декодированные размеры PNG не совпадают')
+    return { descriptor, blob, sha256, ...dimensions }
+  }
+  const svg = decodeUtf8(bytes)
+  const viewBox = validateSvg(svg, descriptor)
+  return { descriptor, blob, sha256, viewBox }
+}
+
+export async function validateCachedAsset(asset: MapCachedAsset, descriptor: MapAssetDescriptor, options: AssetValidationOptions = {}): Promise<ValidatedMapAsset> {
+  if (descriptor.state !== 'ready' || descriptor.id === null || descriptor.sha256 === null || asset.assetId !== descriptor.id || asset.format !== descriptor.format || asset.contentType !== descriptor.contentType || asset.key !== mapAssetKey(asset)) {
+    throw invalid('cache.asset-key', 'сохранённый ассет не принадлежит заявленному формату')
+  }
+  return validateAssetBlob(descriptor, asset.blob, options)
+}
+
+export function assetRequestFor(descriptor: MapAssetDescriptor, buildingId: string, floorId: string, version: string, signal: AbortSignal): MapAssetRequest {
+  if (descriptor.state !== 'ready' || descriptor.id === null) throw invalid('asset.request', 'нельзя запросить неготовый формат')
+  return { buildingId, floorId, version, format: descriptor.format, assetId: descriptor.id, signal }
+}
+
+export function maxAssetBytes(): number {
+  return MAX_ASSET_BYTES
+}
+
+function validateBuilding(input: unknown, index: number): MapCatalog['buildings'][number] {
+  const source = asRecord(input, `catalog.buildings[${index}]`)
+  const id = nonEmptyString(source.id, `building[${index}].id`)
+  const label = nonEmptyString(source.label, `building[${index}].label`)
+  const floors = arrayOf(source.floors, `building[${index}].floors`).map((floor, floorIndex) => {
+    const item = asRecord(floor, `building[${index}].floors[${floorIndex}]`)
+    const floorId = nonEmptyString(item.id, `floor[${floorIndex}].id`)
+    const floorLabel = nonEmptyString(item.label, `floor[${floorIndex}].label`)
+    const plan = item.plan === null || item.plan === undefined ? null : validatePlanMetadata(item.plan, id, floorId)
+    return { id: floorId, label: floorLabel, plan }
+  })
+  return { id, label, floors }
+}
+
+function validatePlanMetadata(input: unknown, buildingId: string, floorId: string): MapPlan {
+  const source = asRecord(input, 'plan')
+  if (source.buildingId !== buildingId || source.floorId !== floorId) throw invalid('plan.parent', 'план ссылается на другой корпус или этаж')
+  const version = nonEmptyString(source.version, 'plan.version')
+  const label = nonEmptyString(source.label, 'plan.label')
+  const png = validateAssetDescriptor(source.png, 'plan.png', 'png')
+  const svg = validateAssetDescriptor(source.svg, 'plan.svg', 'svg')
+  return { buildingId, floorId, version, label, png, svg }
+}
+
+function validateAssetDescriptor(input: unknown, path: string, format: MapFormat): MapAssetDescriptor {
+  const source = asRecord(input, path)
+  const state = source.state
+  if (state !== 'absent' && state !== 'processing' && state !== 'ready' && state !== 'failed') throw invalid(`${path}.state`, 'неизвестное состояние формата')
+  const expectedType = format === 'png' ? 'image/png' : 'image/svg+xml'
+  if (source.contentType !== expectedType) throw invalid(`${path}.contentType`, 'неверный MIME')
+  const bytes = source.bytes
+  if (typeof bytes !== 'number' || !Number.isSafeInteger(bytes) || bytes < 0 || bytes > MAX_ASSET_BYTES) throw invalid(`${path}.bytes`, 'неверный размер')
+  const idValue = source.id
+  const shaValue = source.sha256
+  let id: string | null = null
+  let sha256: string | null = null
+  if (state === 'ready') {
+    id = nonEmptyString(idValue, `${path}.id`)
+    sha256 = nonEmptyString(shaValue, `${path}.sha256`)
+    if (!SHA256_RE.test(sha256)) throw invalid(`${path}.sha256`, 'нужен SHA-256 для готового ассета')
+  }
+  if (state !== 'ready' && idValue !== null && idValue !== undefined) throw invalid(`${path}.id`, 'неготовый формат не должен содержать asset id')
+  if (state !== 'ready' && shaValue !== null && shaValue !== undefined) throw invalid(`${path}.sha256`, 'неготовый формат не должен содержать SHA-256')
+  const descriptor: MapAssetDescriptor = { id, format, contentType: expectedType, state, bytes, sha256 }
+  if (source.width !== undefined) descriptorWithOptionalNumber(descriptor, source.width, `${path}.width`)
+  if (source.height !== undefined) descriptorWithOptionalNumber(descriptor, source.height, `${path}.height`)
+  if (source.viewBox !== undefined) descriptorWithOptionalViewBox(descriptor, source.viewBox, `${path}.viewBox`)
+  if (state !== 'ready' && bytes !== 0) throw invalid(`${path}.bytes`, 'неготовый формат не должен содержать размер файла')
+  return descriptor
+}
+
+function descriptorWithOptionalNumber(descriptor: MapAssetDescriptor, value: unknown, path: string): void {
+  if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0 || value > MAX_RASTER_SIDE) throw invalid(path, 'размер выходит за лимит')
+  const target = path.endsWith('.height') ? 'height' : 'width'
+  ;(descriptor as { width?: number; height?: number })[target] = value
+}
+
+function descriptorWithOptionalViewBox(descriptor: MapAssetDescriptor, value: unknown, path: string): void {
+  if (!Array.isArray(value) || value.length !== 4 || value.some((item) => typeof item !== 'number' || !Number.isFinite(item))) throw invalid(path, 'viewBox должен быть массивом из четырёх чисел')
+  const [x, y, width, height] = value as [number, number, number, number]
+  if (width <= 0 || height <= 0 || width > MAX_SVG_EXTENT || height > MAX_SVG_EXTENT) throw invalid(path, 'viewBox выходит за лимит')
+  ;(descriptor as { viewBox?: readonly [number, number, number, number] }).viewBox = [x, y, width, height]
+}
+
+function validatePngStructure(bytes: Uint8Array, descriptor: MapAssetDescriptor): { width: number; height: number } {
+  const signature = [137, 80, 78, 71, 13, 10, 26, 10]
+  if (bytes.length < 24 || signature.some((item, index) => bytes[index] !== item)) throw invalid('asset.png', 'неверная PNG сигнатура')
+  let offset = 8
+  let seenHeader = false
+  let seenData = false
+  let seenEnd = false
+  let width = 0
+  let height = 0
+  while (offset + 12 <= bytes.length) {
+    const length = readUint32(bytes, offset)
+    const typeStart = offset + 4
+    const dataStart = typeStart + 4
+    const crcStart = dataStart + length
+    if (length > bytes.length || crcStart + 4 > bytes.length) throw invalid('asset.png', 'PNG содержит обрезанный chunk')
+    const type = String.fromCharCode(...bytes.slice(typeStart, dataStart))
+    const typeAndData = bytes.slice(typeStart, crcStart)
+    if (readUint32(bytes, crcStart) !== crc32(typeAndData)) throw invalid('asset.png', 'CRC PNG chunk не совпадает')
+    if (type === 'IHDR') {
+      if (seenHeader || length !== 13 || offset !== 8) throw invalid('asset.png', 'некорректный IHDR')
+      seenHeader = true
+      width = readUint32(bytes, dataStart)
+      height = readUint32(bytes, dataStart + 4)
+    } else if (type === 'IDAT') {
+      if (!seenHeader || seenEnd) throw invalid('asset.png', 'некорректный IDAT')
+      seenData = true
+    } else if (type === 'IEND') {
+      if (!seenHeader || !seenData || length !== 0 || seenEnd) throw invalid('asset.png', 'некорректный IEND')
+      seenEnd = true
+    }
+    offset = crcStart + 4
+    if (seenEnd) break
+  }
+  if (!seenHeader || !seenData || !seenEnd || offset !== bytes.length) throw invalid('asset.png', 'PNG не завершён IEND')
+  if (width <= 0 || height <= 0 || width > MAX_RASTER_SIDE || height > MAX_RASTER_SIDE || width * height > MAX_RASTER_PIXELS) throw invalid('asset.png', 'размер PNG выходит за лимит')
+  if (descriptor.width !== undefined && descriptor.width !== width) throw invalid('asset.png.width', 'ширина PNG не совпадает')
+  if (descriptor.height !== undefined && descriptor.height !== height) throw invalid('asset.png.height', 'высота PNG не совпадает')
+  return { width, height }
+}
+
+async function decodePngBlob(blob: Blob): Promise<{ readonly width: number; readonly height: number }> {
+  const createBitmap = (globalThis as typeof globalThis & { createImageBitmap?: (image: Blob) => Promise<ImageBitmap> }).createImageBitmap
+  if (createBitmap) {
+    let bitmap: ImageBitmap | null = null
+    try {
+      bitmap = await createBitmap(blob)
+      return { width: bitmap.width, height: bitmap.height }
+    } catch (error) {
+      throw invalid('asset.png.decode', 'браузер не смог декодировать PNG', error)
+    } finally {
+      bitmap?.close()
+    }
+  }
+  const ImageCtor = (globalThis as typeof globalThis & { Image?: new () => HTMLImageElement }).Image
+  const createObjectUrl = globalThis.URL?.createObjectURL
+  const revokeObjectUrl = globalThis.URL?.revokeObjectURL
+  if (!ImageCtor || !createObjectUrl || !revokeObjectUrl) throw invalid('asset.png.decode', 'декодер PNG недоступен в текущем runtime')
+  const image = new ImageCtor()
+  const url = createObjectUrl(blob)
+  try {
+    image.src = url
+    if (typeof image.decode === 'function') await image.decode()
+    else await new Promise<void>((resolve, reject) => {
+      image.onload = () => resolve()
+      image.onerror = () => reject(new Error('PNG load failed'))
+    })
+    return { width: image.naturalWidth, height: image.naturalHeight }
+  } catch (error) {
+    throw invalid('asset.png.decode', 'браузер не смог декодировать PNG', error)
+  } finally {
+    revokeObjectUrl(url)
+  }
+}
+
+function validateSvg(source: string, descriptor: MapAssetDescriptor): readonly [number, number, number, number] {
+  if (source.length === 0 || /<!\s*(?:DOCTYPE|ENTITY)|<\?xml|<\?(?!xml)|<script\b|<style\b|<foreignObject\b|<image\b|<use\b|<animate(?:Transform|Motion)?\b|@import/i.test(source)) throw invalid('asset.svg', 'SVG содержит запрещённый XML или активное содержимое')
+  const Parser = (globalThis as typeof globalThis & { DOMParser?: typeof DOMParser }).DOMParser
+  if (!Parser) throw invalid('asset.svg.parser', 'строгий XML DOMParser недоступен в текущем runtime')
+  const viewBox = parseSvgWithDomParser(source, Parser)
+  if (descriptor.viewBox && descriptor.viewBox.some((value, index) => value !== viewBox[index])) throw invalid('asset.svg.viewBox', 'viewBox не совпадает с манифестом')
+  return viewBox
+}
+
+function parseSvgWithDomParser(source: string, Parser: typeof DOMParser): readonly [number, number, number, number] {
+  const document = new Parser().parseFromString(source, 'image/svg+xml')
+  if (document.getElementsByTagName('parsererror').length > 0) throw invalid('asset.svg.xml', 'SVG не является well-formed XML')
+  const root = document.documentElement
+  if (!root || root.localName !== 'svg' || root.namespaceURI !== SVG_NS) throw invalid('asset.svg.root', 'нужен SVG root в namespace SVG')
+  const viewBox = readSvgViewBox(root.getAttribute('viewBox'))
+  let count = 0
+  walkSvgElement(root, true, () => { count += 1; if (count > MAX_SVG_ELEMENTS) throw invalid('asset.svg', 'слишком много SVG-элементов') })
+  return viewBox
+}
+
+function walkSvgElement(element: Element, root: boolean, visit: () => void): void {
+  visit()
+  for (const attribute of Array.from(element.attributes)) {
+    if (attribute.namespaceURI === XMLNS_NS) {
+      if (!root || attribute.name !== 'xmlns' || attribute.value !== SVG_NS) throw invalid('asset.svg.namespace', 'разрешён только root xmlns SVG')
+      continue
+    }
+    const attributeName = attribute.localName.toLowerCase()
+    if (attribute.namespaceURI !== null || !SVG_ATTRIBUTES.has(attributeName) || !validSvgAttributeValue(attributeName, attribute.value)) throw invalid('asset.svg.attribute', `SVG-атрибут ${attribute.name} запрещён`)
+  }
+  if (root && element.getAttribute('xmlns') !== SVG_NS) throw invalid('asset.svg.namespace', 'SVG root должен объявить namespace')
+  for (const child of Array.from(element.childNodes)) {
+    if (child.nodeType === 1) {
+      const childElement = child as Element
+      if (childElement.namespaceURI !== SVG_NS || !SVG_ELEMENTS.has(childElement.localName)) throw invalid('asset.svg.element', `SVG-элемент ${childElement.localName} запрещён`)
+      walkSvgElement(childElement, false, visit)
+    } else if (child.nodeType !== 3 && child.nodeType !== 4) {
+      throw invalid('asset.svg.xml', 'SVG содержит неподдерживаемый узел')
+    }
+  }
+}
+
+function readSvgViewBox(value: string | null): readonly [number, number, number, number] {
+  if (!value) throw invalid('asset.svg.viewBox', 'SVG должен иметь viewBox')
+  const parts = value.trim().split(/[\s,]+/).map(Number)
+  if (parts.length !== 4 || parts.some((item) => !Number.isFinite(item))) throw invalid('asset.svg.viewBox', 'некорректный viewBox')
+  const viewBox = parts as [number, number, number, number]
+  if (viewBox[2] <= 0 || viewBox[3] <= 0 || viewBox[2] > MAX_SVG_EXTENT || viewBox[3] > MAX_SVG_EXTENT) throw invalid('asset.svg.viewBox', 'viewBox выходит за лимит')
+  return viewBox
+}
+
+function validSvgAttributeValue(name: string, value: string): boolean {
+  if (containsUnsafeSvgValue(value)) return false
+  if (name === 'fill' || name === 'stroke') return /^(?:none|currentcolor|transparent|#[0-9a-f]{3,8}|[a-z]{1,32})$/i.test(value)
+  if (name === 'd') return /^[0-9a-z\s,.+-]+$/i.test(value)
+  if (name === 'points') return /^[0-9e\s,.+-]+$/i.test(value)
+  if (name === 'stroke-linecap') return /^(?:butt|round|square)$/i.test(value)
+  if (name === 'stroke-linejoin') return /^(?:miter|round|bevel)$/i.test(value)
+  if (name === 'text-anchor') return /^(?:start|middle|end)$/i.test(value)
+  if (name === 'role') return /^(?:img|presentation)$/i.test(value)
+  if (name === 'id' || name === 'class') return /^[A-Za-z0-9_.-]{1,64}$/.test(value)
+  if (name === 'aria-label') return value.length > 0 && value.length <= 256 && !/[<>&]/.test(value)
+  if (name === 'viewbox') return /^[0-9e\s,.+-]+$/i.test(value)
+  return /^-?(?:\d+(?:\.\d+)?|\.\d+)(?:e[-+]?\d+)?$/i.test(value)
+}
+
+function containsUnsafeSvgValue(value: string): boolean {
+  const decodedCss = value.replace(/\\([0-9a-f]{1,6})(?:\s)?/gi, (_, code: string) => String.fromCodePoint(Number.parseInt(code, 16)))
+  return /[\\<>]|\b(?:https?|file|javascript|data):|url\s*\(|[()]/i.test(decodedCss)
+}
+
+function decodeUtf8(bytes: Uint8Array): string {
+  try {
+    return new TextDecoder('utf-8', { fatal: true }).decode(bytes)
+  } catch (error) {
+    throw invalid('asset.svg.encoding', 'SVG не является корректным UTF-8', error)
+  }
+}
+
+async function digestSha256(bytes: Uint8Array): Promise<string> {
+  const subtle = globalThis.crypto?.subtle
+  if (!subtle) throw new MapError('asset-invalid', 'Web Crypto недоступна для проверки хеша')
+  const digest = await subtle.digest('SHA-256', bytes.slice().buffer as ArrayBuffer)
+  return [...new Uint8Array(digest)].map((value) => value.toString(16).padStart(2, '0')).join('')
+}
+
+function readUint32(bytes: Uint8Array, offset: number): number {
+  return ((bytes[offset] ?? 0) * 0x1000000) + ((bytes[offset + 1] ?? 0) << 16) + ((bytes[offset + 2] ?? 0) << 8) + (bytes[offset + 3] ?? 0)
+}
+
+function crc32(bytes: Uint8Array): number {
+  let crc = 0xffffffff
+  for (const byte of bytes) {
+    crc ^= byte
+    for (let bit = 0; bit < 8; bit += 1) crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1))
+  }
+  return (crc ^ 0xffffffff) >>> 0
+}
+
+function asRecord(input: unknown, path: string): Record<string, unknown> {
+  if (typeof input !== 'object' || input === null || Array.isArray(input)) throw invalid(path, 'ожидался объект')
+  return input as Record<string, unknown>
+}
+
+function arrayOf(input: unknown, path: string): unknown[] {
+  if (!Array.isArray(input)) throw invalid(path, 'ожидался массив')
+  return input
+}
+
+function nonEmptyString(input: unknown, path: string): string {
+  if (typeof input !== 'string' || input.trim().length === 0 || input.length > 512) throw invalid(path, 'ожидалась непустая строка')
+  return input
+}
+
+function assertUnique(values: readonly string[], path: string): void {
+  if (new Set(values).size !== values.length) throw invalid(path, 'обнаружены повторяющиеся идентификаторы')
+}
+
+function invalid(path: string, message: string, causeValue?: unknown): MapError {
+  return new MapError('invalid-response', `${path}: ${message}`, causeValue)
+}
