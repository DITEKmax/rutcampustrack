@import '../styles/tokens.pcss';
.teacher-review-catalog { display: flex; flex-wrap: wrap; gap: var(--rct-space-2); padding: var(--rct-space-3); color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-micro); }
.teacher-review-catalog p { flex-basis: 100%; margin: 0; }
.teacher-review-catalog a { color: inherit; }
