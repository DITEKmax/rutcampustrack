+function Invoke-ActuatorDiagnosticQuery {
+    param(
+        [Parameter(Mandatory = $true)][int]$Port,
+        [Parameter(Mandatory = $true)][string]$Metric,
+        [string]$TagQuery = ''
+    )
+    $uri = "http://127.0.0.1:$Port/actuator/metrics/$Metric"
+    if (-not [string]::IsNullOrWhiteSpace($TagQuery)) {
+        $uri += "?tag=$([Uri]::EscapeDataString($TagQuery))"
+    }
+    try {
+        $response = Invoke-WebRequest -Method Get -Uri $uri -TimeoutSec 10 -SkipHttpErrorCheck
+        $rawContent = $response.Content
+        $contentType = ''
+        try {
+            if ($null -ne $response.Headers) { $contentType = [string]$response.Headers['Content-Type'] }
+        } catch { $contentType = '' }
+        $contentRuntimeType = if ($null -eq $rawContent) { 'NULL' } else { [string]$rawContent.GetType().FullName }
+        $normalizedContent = $null
+        $transport = 'NONE'
+        $transportErrorCategory = ''
+        if ($rawContent -is [byte[]]) {
+            $mediaType = (($contentType -split ';', 2)[0]).Trim().ToLowerInvariant()
+            if ($mediaType -ne 'application/json' -and -not $mediaType.EndsWith('+json')) {
+                $transportErrorCategory = 'NON_JSON_MEDIA_TYPE'
+            } else {
+                try {
+                    $normalizedContent = [Text.UTF8Encoding]::new($false, $true).GetString([byte[]]$rawContent)
+                    $transport = 'UTF8_BYTES'
+                } catch {
+                    $transportErrorCategory = 'INVALID_UTF8'
+                }
+            }
+        } elseif ($rawContent -is [string]) {
+            $normalizedContent = [string]$rawContent
+            $transport = 'STRING'
+        } elseif ($null -eq $rawContent) {
+            $transportErrorCategory = 'MISSING_CONTENT'
+        } else {
+            $transportErrorCategory = 'UNSUPPORTED_CONTENT_TYPE'
+        }
+        return ConvertTo-ActuatorDiagnosticRecord -Port $Port -Metric $Metric -StatusCode ([int]$response.StatusCode) -Content $normalizedContent -TagQuery $TagQuery -ContentType $contentType -ContentRuntimeType $contentRuntimeType -Transport $transport -TransportErrorCategory $transportErrorCategory
+    } catch {
+        return [ordered]@{
+            schema = 'rct.actuator-counter-diagnostic.v1'
+            port = $Port
+            metric = Limit-EdgeDiagnosticText -Text $Metric -MaxCharacters 256
+            tagQuery = Limit-EdgeDiagnosticText -Text $TagQuery -MaxCharacters 256
+            statusCode = $null
+            contentType = ''
+            contentRuntimeType = ''
+            transport = 'NONE'
+            errorCategory = 'REQUEST_FAILED'
+            metricName = $null
+            measurements = @()
+            availableTags = @()
+            parseStatus = 'UNAVAILABLE'
+        }
+    }
+}
