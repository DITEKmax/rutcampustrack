/*
 * FE13 aliases resolved from docs/design/tokens-v2.json.
 * Dark/light primitives are intentionally local to the feature root so the
 * host can provide a theme without changing the shell or global token file.
 */
.attendance-screen {
  --attendance-surface-base: var(--rct-color-surface-base);
  --attendance-surface-raised: var(--rct-color-surface-raised);
  --attendance-surface-float: var(--rct-color-surface-float);
  --attendance-text-primary: var(--rct-color-text-primary);
  --attendance-text-secondary: var(--rct-color-text-secondary);
  --attendance-text-muted: var(--rct-color-text-muted);
  --attendance-text-disabled: var(--rct-color-disabled-text);
  --attendance-border-default: var(--rct-color-border-default);
  --attendance-border-focus: var(--rct-color-border-focus);
  --attendance-accent-now: var(--rct-color-accent-now);
  --attendance-accent-on-now: var(--rct-color-accent-on-now);
  --attendance-present-fill: var(--rct-color-status-present-fill);
  --attendance-present-text: var(--rct-color-status-present-text);
  --attendance-absent-fill: var(--rct-color-status-absent-fill);
  --attendance-absent-text: var(--rct-color-status-absent-text);
  --attendance-excused-fill: var(--rct-color-status-excused-fill);
  --attendance-excused-text: var(--rct-color-status-excused-text);
  --attendance-none-fill: var(--rct-color-status-none-fill);
  --attendance-success-bg: var(--rct-color-state-success-bg);
  --attendance-danger-bg: var(--rct-color-state-danger-bg);
  --attendance-warning-text: var(--rct-color-state-warning-text);
  --attendance-disabled-surface: var(--rct-color-disabled-surface);
  --attendance-font-family: var(--rct-font-family-sans);
  --attendance-font-display: 2rem;
  --attendance-font-title: 1.5rem;
  --attendance-font-block: 1.125rem;
  --attendance-font-body: 1rem;
  --attendance-font-dense: 0.875rem;
  --attendance-font-caption: 0.8125rem;
  --attendance-font-micro: 0.75rem;
  --attendance-font-weight-regular: 400;
  --attendance-font-weight-medium: 500;
  --attendance-font-weight-bold: 600;
  --attendance-radius-lg: 0.75rem;
  --attendance-radius-xl: 1rem;
  --attendance-radius-2xl: 1.5rem;
  --attendance-radius-full: 62.4375rem;
  --attendance-border-hairline: 0.0625rem;
  --attendance-focus-width: 0.125rem;
  --attendance-focus-offset: 0.125rem;
  --attendance-content-width: 22.375rem;
  --attendance-inset: 1rem;
  --attendance-control: 2.75rem;
  --attendance-metadata: 0.625rem;
  --attendance-meta-gap: 0.25rem;
  --attendance-disclosure: 1.375rem;
  --attendance-plot-height: 10.625rem;
  --attendance-history-height: 0.5rem;
  --attendance-dock-height: 4.75rem;
  --attendance-dock-bottom: 1rem;
}

@define-mixin attendance-focus-ring {
  &:focus-visible {
    outline: var(--attendance-focus-width) solid var(--attendance-border-focus);
    outline-offset: var(--attendance-focus-offset);
  }
}
