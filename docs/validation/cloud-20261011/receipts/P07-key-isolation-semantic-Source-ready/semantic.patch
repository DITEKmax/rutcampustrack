diff --git a/services/notification-service/notification-app/src/test/java/ru/rutcampustrack/notification/security/PublicKeyProvisioningTest.java b/services/notification-service/notification-app/src/test/java/ru/rutcampustrack/notification/security/PublicKeyProvisioningTest.java
