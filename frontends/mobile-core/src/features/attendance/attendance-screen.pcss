}
:where([data-student-ui]) .attendance-period-pager button:enabled:active,
:where([data-student-ui]):is(.attendance-period-pager button:enabled:active) {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
:where([data-student-ui]) .attendance-period-pager button:disabled,
:where([data-student-ui]):is(.attendance-period-pager button:disabled),
:where([data-student-ui]) .attendance-day-rail__item:disabled,
:where([data-student-ui]):is(.attendance-day-rail__item:disabled),
:where([data-student-ui]) .attendance-sunday:disabled,
:where([data-student-ui]):is(.attendance-sunday:disabled) {
  opacity: 1;
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: default;
}
:where([data-student-ui]) .attendance-day-rail__item:disabled strong,
:where([data-student-ui]):is(.attendance-day-rail__item:disabled strong) {
  color: inherit;
}
:where([data-student-ui]) .attendance-day-rail__item--selected:not(:disabled),
:where([data-student-ui]):is(.attendance-day-rail__item--selected:not(:disabled)) {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
:where([data-student-ui]) .attendance-day-rail__item--selected:not(:disabled) strong,
:where([data-student-ui]):is(.attendance-day-rail__item--selected:not(:disabled) strong) {
  color: inherit;
}
:where([data-student-ui]) .attendance-subject-list > ul,
:where([data-student-ui]):is(.attendance-subject-list > ul) {
  gap: var(--rct-space-3);
}
:where([data-student-ui]) .attendance-subject-list__heading,
:where([data-student-ui]):is(.attendance-subject-list__heading) {
