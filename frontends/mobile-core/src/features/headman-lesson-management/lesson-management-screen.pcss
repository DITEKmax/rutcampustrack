@import '../../styles/tokens.pcss';
.lesson-management {
  display: grid;
  align-content: start;
  gap: var(--rct-space-4);
  min-block-size: calc(100dvh - var(--rct-space-5) * 2);
  max-inline-size: var(--rct-mobile-content-width);
  margin-inline: auto;
  padding: var(--rct-space-5) var(--rct-space-4) var(--rct-headman-page-bottom-space);
  box-sizing: border-box;
  color: var(--rct-color-text-primary);
}
.lesson-management h1,
.lesson-management h2,
.lesson-management p {
  margin: 0;
}
.lesson-management h1 {
  font-size: var(--rct-font-size-title-screen);
  line-height: var(--rct-leading-tight);
}
.lesson-management h2 {
  font-size: var(--rct-font-size-dense);
}
.lesson-management button,
.lesson-management input,
.lesson-management select,
.lesson-management textarea {
  font: inherit;
  @mixin rct-focus-ring;
}
.lesson-management button {
  cursor: pointer;
}
.lesson-management button:disabled {
  cursor: default;
  opacity: 0.5;
}
.lesson-management__child-header {
  display: grid;
  grid-template-columns: var(--rct-control-min-touch) minmax(0, 1fr) var(--rct-control-min-touch);
  align-items: center;
}
.lesson-management__child-header h1 {
  font-size: var(--rct-font-size-title);
  text-align: center;
}
.lesson-management__back {
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
}
.lesson-management__week {
  display: grid;
  grid-template-columns: var(--rct-control-min-touch) minmax(0, 1fr) var(--rct-control-min-touch);
  align-items: center;
  text-align: center;
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-raised);
  font-size: var(--rct-font-size-caption);
}
.lesson-management__week button {
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  background: transparent;
  color: var(--rct-color-text-primary);
}
.lesson-management__week small {
  display: block;
  color: var(--rct-color-accent-now);
  font-size: var(--rct-font-size-micro);
}
.lesson-management__next {
  transform: rotate(180deg);
}
.lesson-management__switches {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--rct-space-2);
}
.lesson-management__switches button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-2);
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  text-align: start;
  font-size: var(--rct-font-size-caption);
}
.lesson-management__switch {
  display: block;
  flex: 0 0 var(--rct-space-6);
  block-size: var(--rct-space-3);
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-surface-float);
}
.lesson-management__switch::after {
  content: '';
  display: block;
  inline-size: var(--rct-space-3);
  block-size: var(--rct-space-3);
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-text-secondary);
}
.lesson-management__switches [aria-checked='true'] .lesson-management__switch {
  background: var(--rct-color-accent-now);
}
.lesson-management__switches [aria-checked='true'] .lesson-management__switch::after {
  margin-inline-start: auto;
  background: var(--rct-color-accent-on-now);
}
.lesson-management__date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-2);
  font-size: var(--rct-font-size-caption);
  color: var(--rct-color-text-secondary);
}
.lesson-management__date input {
  inline-size: 50%;
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  color: var(--rct-color-text-primary);
  background: transparent;
}
.lesson-management__row {
  display: grid;
  gap: var(--rct-space-2);
}
.lesson-management__row:empty {
  display: none;
}
.lesson-management__time {
  display: flex;
  justify-content: space-between;
  font-size: var(--rct-font-size-micro);
}
.lesson-management__time strong {
  font-weight: var(--rct-font-weight-medium);
}
.lesson-management__time span,
.lesson-management__muted {
  color: var(--rct-color-text-secondary);
}
.lesson-management__card {
  position: relative;
  display: grid;
  gap: var(--rct-space-2);
  inline-size: 100%;
  box-sizing: border-box;
  border: 0;
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-4);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  text-align: start;
}
.lesson-management__card strong {
  padding-inline-end: var(--rct-space-4);
  font-size: var(--rct-font-size-dense);
  font-weight: var(--rct-font-weight-medium);
  overflow-wrap: anywhere;
}
.lesson-management__card span {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--rct-space-1);
  font-size: var(--rct-font-size-caption);
  color: var(--rct-color-text-secondary);
}
.lesson-management__card small {
  color: var(--rct-color-danger-text);
  font-size: var(--rct-font-size-micro);
}
.lesson-management__card[data-cancelled='true'] {
  background: var(--rct-error-surface);
}
.lesson-management__chevron {
  position: absolute;
  inset-inline-end: var(--rct-space-3);
  inset-block-start: 50%;
  transform: translateY(-50%) rotate(180deg);
}
.lesson-management__free {
  min-block-size: calc(var(--rct-control-min-touch) * 2);
  border: 0;
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-3);
  color: var(--rct-color-success-text);
  background: var(--rct-color-success-surface);
  font-size: var(--rct-font-size-caption);
}
.lesson-management__primary {
  min-block-size: var(--rct-control-min-touch);
  inline-size: 100%;
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
  font-size: var(--rct-font-size-dense);
  font-weight: var(--rct-font-weight-bold);
}
.lesson-management__danger {
  background: var(--rct-error-surface);
  color: var(--rct-color-danger-text);
}
.lesson-management__action,
.lesson-management__select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-2);
  min-block-size: var(--rct-control-min-touch);
  inline-size: 100%;
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  background: var(--rct-color-surface-raised);
  color: var(--rct-color-text-primary);
  text-align: start;
  font-size: var(--rct-font-size-dense);
}
.lesson-management__danger-text {
  color: var(--rct-color-danger-text);
}
.lesson-management__field {
  display: grid;
  gap: var(--rct-space-2);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}
.lesson-management__field input,
.lesson-management__field select,
.lesson-management__field textarea,
.lesson-management__field > strong {
  box-sizing: border-box;
  inline-size: 100%;
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  font-size: var(--rct-font-size-dense);
}
.lesson-management__field textarea {
  min-block-size: calc(var(--rct-control-min-touch) * 3);
  resize: vertical;
}
.lesson-management__field small {
  justify-self: end;
}
.lesson-management__preview {
  display: grid;
  gap: var(--rct-space-2);
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-3);
  background: var(--rct-color-surface-raised);
}
.lesson-management__preview > div {
  display: grid;
  gap: var(--rct-space-1);
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  color: var(--rct-color-danger-text);
  background: var(--rct-error-surface);
  font-size: var(--rct-font-size-caption);
}
.lesson-management__preview > div:last-child {
  color: var(--rct-color-success-text);
  background: var(--rct-color-success-surface);
}
.lesson-management__arrow {
  justify-self: center;
  display: grid;
  place-items: center;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border-radius: var(--rct-radius-full);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
.lesson-management__footer {
  position: sticky;
  inset-block-end: var(--rct-space-4);
  margin-block-start: var(--rct-space-6);
  padding-block-start: var(--rct-space-4);
  background: var(--rct-color-surface-base);
}
.lesson-management__calendar {
  padding: var(--rct-space-3);
  border-radius: var(--rct-radius-xl);
  background: var(--rct-color-surface-raised);
}
.lesson-management__calendar > div:first-child {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lesson-management__calendar button {
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-lg);
  background: transparent;
  color: var(--rct-color-text-primary);
}
.lesson-management__calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: var(--rct-space-1);
  text-align: center;
  font-size: var(--rct-font-size-micro);
}
.lesson-management__calendar-grid [aria-pressed='true'] {
  background: var(--rct-color-accent-now);
  color: var(--rct-color-accent-on-now);
}
.lesson-management__calendar-grid [data-outside='true'] {
  color: var(--rct-color-text-muted);
}
.lesson-management__empty,
.lesson-management__confirmation {
  display: grid;
  gap: var(--rct-space-3);
  padding: var(--rct-space-4);
  border-radius: var(--rct-radius-xl);
  background: var(--rct-color-surface-raised);
  color: var(--rct-color-text-secondary);
}
.lesson-management__notice {
  font-size: var(--rct-font-size-caption);
  color: var(--rct-color-success-text);
}

.lesson-management:has(.lesson-management__footer) {
  display: flex;
  flex-direction: column;
  padding-block-end: var(--rct-space-4);
}
.lesson-management__footer {
  margin-block-start: auto;
}

.lesson-management {
  max-inline-size: calc(var(--rct-mobile-content-width) + var(--rct-space-4) * 2);
}
.lesson-management__primary {
  min-block-size: calc(var(--rct-control-min-touch) + var(--rct-space-1));
}

.lesson-management__child-header h1 {
  font-size: calc(var(--rct-font-size-title) + var(--rct-space-half));
}

.lesson-management__calendar {
  overflow-x: auto;
}
.lesson-management__calendar-grid {
  min-inline-size: calc(var(--rct-control-min-touch) * 7 + var(--rct-space-1) * 6);
}

.lesson-management__weekdays {
  display: flex;
  gap: var(--rct-space-2);
  overflow-x: auto;
}
.lesson-management__weekdays button {
  flex: 0 0 calc((100% - var(--rct-space-2) * 4) / 5);
  display: grid;
  place-items: center;
  gap: var(--rct-space-1);
  min-block-size: calc(var(--rct-control-min-touch) + var(--rct-space-4));
  border: 0;
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-2);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-raised);
  font-size: var(--rct-font-size-micro);
}
.lesson-management__weekdays button[aria-pressed='true'] {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
.lesson-management[data-management-view='log'] .lesson-management__child-header h1 {
  font-size: var(--rct-today-hero-title-size);
}

.lesson-management[data-management-view='log'] {
  padding: var(--rct-space-4);
}
.lesson-management[data-management-view='log'] .headman-actions {
  padding: 0;
}
