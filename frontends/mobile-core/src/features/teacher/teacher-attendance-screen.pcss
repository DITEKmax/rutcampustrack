@import '../../styles/tokens.pcss';
.teacher-attendance__filters { display: grid; gap: var(--rct-space-3); min-inline-size: 0; }
.teacher-attendance__field { display: grid; gap: var(--rct-space-1); min-inline-size: 0; color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-caption); }
.teacher-attendance__field > span { padding-inline-start: var(--rct-space-3); }
.teacher-attendance__field .headman-stats-select__trigger { background: var(--rct-color-surface-float); }
.teacher-attendance__dates { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--rct-space-2); }
.teacher-attendance__types { display: flex; flex-wrap: wrap; gap: var(--rct-space-2); margin: 0; border: 0; padding: 0; }
.teacher-attendance__types legend { inline-size: 100%; margin-block-end: var(--rct-space-2); padding-inline-start: var(--rct-space-3); color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-caption); }
.teacher-attendance__type { min-block-size: var(--rct-control-min-touch); border: 0; border-radius: var(--rct-radius-full); padding: var(--rct-space-2) var(--rct-space-3); color: var(--rct-color-text-secondary); background: var(--rct-color-surface-float); }
.teacher-attendance__type[aria-pressed='true'] { color: var(--rct-color-accent-on-now); background: var(--rct-color-accent-now); }
.teacher-attendance__period-toggle { display: flex; align-items: center; gap: var(--rct-space-2); justify-self: start; min-block-size: var(--rct-control-min-touch); border: 0; padding: var(--rct-space-2) var(--rct-space-3); color: var(--rct-color-text-secondary); background: transparent; }
.teacher-attendance__field-error { color: var(--rct-color-danger-text); font-size: var(--rct-font-size-caption); overflow-wrap: anywhere; }
