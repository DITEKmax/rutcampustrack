# Production пример: placeholders, не готовый набор для запуска.
# Рабочий .env.prod в корне — источник inline значений; файлы — в .secrets/production/.
# После разрешённой правки до первого deploy: deployment-secrets.py refresh-project --mode production.
# PROD_ENV, PROD_SECRET_FILES_B64 и owner-inventory.json производные: не редактировать вручную.
# Пути ниже серверные /opt: локальные bytes берутся из .secrets/production/files по mapping.
# Одинарные кавычки сохраняют literal $. Не выполнять source .env.prod.
## Ревизия и проект. Workflow подставляет IMAGE_TAG из проверенного DEPLOY_SHA.
IMAGE_TAG='CHANGE_ME_EXACT_RELEASE_SHA'
COMPOSE_PROJECT_NAME='rutcampustrack'

## Приватная сеть: четыре адреса менять согласованно.
GATEWAY_PRIVATE_SUBNET='172.30.0.0/24'
GATEWAY_NETWORK_GATEWAY='172.30.0.1'
GATEWAY_NGINX_IPV4='172.30.0.10'
GATEWAY_DYNAMIC_IP_RANGE='172.30.0.128/25'

## PostgreSQL: 11 независимых ролей. Меняй пароль в соответствующем .secrets/production/files/*.
PG_ACADEMIC_BOOTSTRAP_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-academic-bootstrap-password'
PG_ACADEMIC_RUNTIME_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-academic-runtime-password'
PG_ACADEMIC_SERVICE_RUNTIME_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-academic-service-runtime-password'
PG_ACADEMIC_MIGRATION_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-academic-migration-password'
PG_ACADEMIC_MONITOR_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-academic-monitor-password'
PG_AUTH_RUNTIME_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-auth-runtime-password'
PG_AUTH_MIGRATION_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-auth-migration-password'
PG_SCHEDULE_BOOTSTRAP_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-schedule-bootstrap-password'
PG_SCHEDULE_RUNTIME_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-schedule-runtime-password'
PG_SCHEDULE_MIGRATION_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-schedule-migration-password'
PG_SCHEDULE_MONITOR_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/pg-schedule-monitor-password'

## Mongo/Redis/Rabbit: inline пароли меняются здесь только до развёртывания. Existing volumes требуют отдельной rotation.
MONGO_USER='rct_user'
MONGO_PASSWORD='CHANGE_ME'
MONGO_ROOT_PASSWORD='CHANGE_ME'
MONGO_NOTIFICATION_USER='rct_notification_user'
MONGO_NOTIFICATION_PASSWORD='CHANGE_ME'
MONGODB_REPLICA_SET_KEY='CHANGE_ME'
REDIS_PASSWORD='CHANGE_ME'
RABBITMQ_USER='rct_user'
RABBITMQ_PASSWORD='CHANGE_ME'

## Redis ACL/maps — производные. Monitor пароли: editable/redis-monitor-password и editable/redis-cache-monitor-password.
# Cache runtime password: files/redis-cache-runtime-password; Mongo monitor: files/mongo-monitor-env.
REDIS_CACHE_RUNTIME_PASSWORD_FILE='/opt/rutcampustrack-secrets/active/redis-cache-runtime-password'
REDIS_SERVER_ACL_FILE='/opt/rutcampustrack-secrets/active/redis-server-acl'
REDIS_CACHE_SERVER_ACL_FILE='/opt/rutcampustrack-secrets/active/redis-cache-server-acl'
REDIS_MONITOR_PASSWORD_MAP_FILE='/opt/rutcampustrack-secrets/active/redis-monitor-password-map'
REDIS_CACHE_MONITOR_PASSWORD_MAP_FILE='/opt/rutcampustrack-secrets/active/redis-cache-monitor-password-map'
MONGO_MONITOR_ENV_FILE='/opt/rutcampustrack-secrets/active/mongo-monitor-env'

## Telegram: BOT_TOKEN = TMA_BOT_TOKEN. BOT_ALERT_TOKEN сохранён для валидатора, новый бот не требуется.
BOT_TOKEN='CHANGE_ME'
TMA_BOT_TOKEN='CHANGE_ME'
BOT_ALERT_TOKEN='CHANGE_ME'
ADMIN_TELEGRAM_IDS=''

## Web Push: сохраняй парную provider-конфигурацию. Не копируй production keys в local.
VAPID_PUBLIC_KEY='CHANGE_ME'
VAPID_PRIVATE_KEY='CHANGE_ME'
VAPID_SUBJECT='mailto:admin@ruttrack.site'

## Публичные URL: меняй на согласованный hostname.
MINI_APP_URL='https://t.me/ruttrack_bot/ruttrack'
MINI_APP_WEB_URL='https://ruttrack.site/mini-app/'
CORS_ALLOWED_ORIGIN='https://ruttrack.site'
NOTIFICATION_WS_ALLOWED_ORIGINS='https://ruttrack.site'

## Независимые inline межсервисные credentials. Не повторяй значения разных направлений.
GRPC_SECRET='CHANGE_ME'
INTERNAL_ISSUER_SECRET='CHANGE_ME'
CAMPUS_MAP_USAGE_HMAC_KEY='CHANGE_ME'
ACADEMIC_TO_SCHEDULE_SERVICE_TOKEN='CHANGE_ME'
SCHEDULE_TO_ACADEMIC_SERVICE_TOKEN='CHANGE_ME'
ATTENDANCE_TO_ACADEMIC_SERVICE_TOKEN='CHANGE_ME'
BOT_TO_NOTIFICATION_SERVICE_TOKEN='CHANGE_ME'

## Направленные token-файлы: каждое значение меняется в отдельном files/*.
MOBILE_BFF_TO_AUTH_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/mobile-bff-to-auth-service-token'
ACADEMIC_TO_AUTH_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/academic-to-auth-service-token'
ATTENDANCE_TO_AUTH_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/attendance-to-auth-service-token'
AUTH_TO_ACADEMIC_PRESENTATION_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/auth-to-academic-presentation-service-token'
MOBILE_BFF_TO_ACADEMIC_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/mobile-bff-to-academic-service-token'
MOBILE_BFF_TO_ATTENDANCE_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/mobile-bff-to-attendance-service-token'
MOBILE_BFF_TO_SCHEDULE_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/mobile-bff-to-schedule-service-token'
ATTENDANCE_BOT_READ_TO_ACADEMIC_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/attendance-bot-read-to-academic-service-token'
ATTENDANCE_BOT_READ_TO_SCHEDULE_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/attendance-bot-read-to-schedule-service-token'
ACADEMIC_REPORT_TO_ATTENDANCE_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/academic-report-to-attendance-service-token'
ACADEMIC_REPORT_TO_SCHEDULE_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/academic-report-to-schedule-service-token'
NOTIFICATION_TO_ACADEMIC_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/notification-to-academic-service-token'
BOT_TO_READ_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/bot-to-read-service-token'
BOT_TO_AUTH_SERVICE_TOKEN_FILE='/opt/rutcampustrack-secrets/active/bot-to-auth-service-token'

## TLS: files/<service>-tls/*.crt/*.key. Ключ монтируется только серверу. Refresh не генерирует сертификаты.
AUTH_GRPC_TLS_DIR='/opt/rutcampustrack-secrets/active/auth-tls'
ACADEMIC_GRPC_TLS_DIR='/opt/rutcampustrack-secrets/active/academic-tls'
SCHEDULE_GRPC_TLS_DIR='/opt/rutcampustrack-secrets/active/schedule-tls'
ATTENDANCE_GRPC_TLS_DIR='/opt/rutcampustrack-secrets/active/attendance-tls'
MOBILE_BFF_GRPC_TLS_DIR='/opt/rutcampustrack-secrets/active/mobile-bff-tls'
ACADEMIC_GRPC_TLS_AUTHORITY='academic-service'

## Operator BasicAuth: plaintext в editable/operator-password. SWAGGER_HTPASSWD — производный, refresh сохранит salt.
# Grafana admin password и webhook secret — inline значения ниже.
SWAGGER_HTPASSWD='operator:$apr1$CHANGE_ME$CHANGE_ME'
GRAFANA_PASSWORD='CHANGE_ME'
ALERT_WEBHOOK_SECRET='CHANGE_ME'
NOTIFICATION_HISTORY_TTL_DAYS='30'
