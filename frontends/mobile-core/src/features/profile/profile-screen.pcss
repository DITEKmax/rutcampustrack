    calc(var(--rct-role-avatar-size) + var(--rct-space-2))
  );
  border-radius: var(--rct-radius-full);
  color: var(--profile-color-accent-on-now);
  background: var(--profile-color-accent-now);
  font-size: var(--rct-font-size-title);
  font-weight: var(--rct-font-weight-bold);
}

:where([data-student-ui]) .profile-card__copy,
:where([data-student-ui]):is(.profile-card__copy) {
  display: grid;
  min-inline-size: 0;
  gap: var(--rct-space-1);
}

:where([data-student-ui]) .profile-card__name,
:where([data-student-ui]):is(.profile-card__name),
:where([data-student-ui]) .profile-card__meta,
:where([data-student-ui]):is(.profile-card__meta) {
  overflow-wrap: anywhere;
  margin: 0;
}

:where([data-student-ui]) .profile-card__name,
:where([data-student-ui]):is(.profile-card__name) {
  font-size: var(--rct-homework-date-heading-size);
  font-weight: var(--rct-font-weight-bold);
}

:where([data-student-ui]) .profile-card__meta,
:where([data-student-ui]):is(.profile-card__meta) {
