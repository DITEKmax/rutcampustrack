@import '../styles/tokens.pcss';
.profile-map-review-catalog, .profile-map-review-controls { display: grid; gap: var(--rct-space-3); margin: var(--rct-space-4); padding: var(--rct-space-4); color: var(--rct-color-text-primary); background: var(--rct-color-surface-raised); border-radius: var(--rct-radius-2xl); overflow-wrap: anywhere; font-family: var(--rct-font-family-sans); }
.profile-map-review-catalog a { color: var(--rct-color-accent-now); min-block-size: var(--rct-control-min-touch); }
.profile-map-review-controls { margin-block-end: var(--rct-today-bottom-space); }
.profile-map-review-controls button { min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2); border: 0; border-radius: var(--rct-radius-lg); color: var(--rct-color-text-primary); background: var(--rct-color-surface-float); font: inherit; cursor: pointer; @mixin rct-focus-ring; }
