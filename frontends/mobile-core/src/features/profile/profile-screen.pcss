  flex: 0 0 var(--rct-space-4);
  inline-size: var(--rct-space-4);
  block-size: var(--rct-space-4);
  accent-color: var(--profile-color-accent-now);
}

:where([data-student-ui]) .profile-note,
:where([data-student-ui]):is(.profile-note),
:where([data-student-ui]) .profile-security-note,
:where([data-student-ui]):is(.profile-security-note) {
