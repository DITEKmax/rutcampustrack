  border-radius: 0.75rem;
  padding-inline: 0.625rem;
  color: var(--requests-danger);
  background: transparent;
  font: inherit;
  font-size: 0.8125rem;
  cursor: pointer;
  @mixin rct-focus-ring;
}

:where([data-student-ui]) .request-attachment-preview,
:where([data-student-ui]):is(.request-attachment-preview) {
  display: grid;
  min-inline-size: 0;
  gap: 0.25rem;
}

:where([data-student-ui]) .request-attachment-preview__image,
:where([data-student-ui]):is(.request-attachment-preview__image),
:where([data-student-ui]) .request-attachment-preview__pdf,
:where([data-student-ui]):is(.request-attachment-preview__pdf) {
  display: block;
  inline-size: 100%;
  block-size: 18rem;
  border: 0.0625rem solid var(--requests-border);
  border-radius: var(--rct-radius-2xl);
  background: var(--requests-base);
}

:where([data-student-ui]) .request-attachment-preview__image,
:where([data-student-ui]):is(.request-attachment-preview__image) {
  object-fit: contain;
}

:where([data-student-ui]) .request-attachment-preview__message,
:where([data-student-ui]):is(.request-attachment-preview__message) {
  color: var(--requests-secondary);
  font-size: 0.8125rem;
  line-height: 1.4;
}

:where([data-student-ui]) .request-attachment-preview__open,
:where([data-student-ui]):is(.request-attachment-preview__open) {
  display: inline-flex;
  align-items: center;
  min-block-size: 2.75rem;
  justify-self: start;
  color: var(--requests-text);
  font-size: 0.8125rem;
  line-height: 1.35;
  text-decoration: underline;
  text-underline-offset: 0.15rem;
}

:where([data-student-ui]) .requests-submit-action,
:where([data-student-ui]):is(.requests-submit-action) {
  margin-block-start: 0.25rem;
}

:where([data-student-ui]) .requests-type-list,
:where([data-student-ui]):is(.requests-type-list) {
  display: grid;
  gap: 0.75rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

:where([data-student-ui]) .requests-type-choice,
:where([data-student-ui]):is(.requests-type-choice) {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  inline-size: 100%;
  min-block-size: 5.75rem;
  border: 0.0625rem solid transparent;
  border-radius: var(--rct-radius-2xl);
  padding: 1rem;
  color: var(--requests-text);
  background: var(--requests-raised);
  font-size: 1rem;
  font-weight: var(--rct-font-weight-bold);
  text-align: start;
}

:where([data-student-ui]) .requests-type-choice:disabled,
:where([data-student-ui]):is(.requests-type-choice:disabled) {
  cursor: not-allowed;
  opacity: 0.72;
}

:where([data-student-ui]) .requests-type-choice--unavailable,
:where([data-student-ui]):is(.requests-type-choice--unavailable) {
  border-color: var(--requests-border);
}

:where([data-student-ui]) .requests-type-choice__symbol,
:where([data-student-ui]):is(.requests-type-choice__symbol),
:where([data-student-ui]) .requests-type-choice__mark,
:where([data-student-ui]):is(.requests-type-choice__mark) {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  inline-size: var(--rct-today-present-size);
  block-size: var(--rct-today-present-size);
  border-radius: var(--rct-radius-full);
  @mixin rct-type-status;
}

:where([data-student-ui]) .requests-type-choice__symbol--excuse,
:where([data-student-ui]):is(.requests-type-choice__symbol--excuse) {
  color: var(--rct-color-status-excused-on-fill);
  background: var(--rct-color-status-excused-fill);
}

:where([data-student-ui]) .requests-type-choice__symbol-pair,
:where([data-student-ui]):is(.requests-type-choice__symbol-pair) {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.375rem;
  inline-size: 6.9375rem;
  block-size: 2.75rem;
}

:where([data-student-ui]) .requests-type-choice__mark--late,
:where([data-student-ui]):is(.requests-type-choice__mark--late) {
  color: var(--rct-color-status-absent-on-fill);
  background: var(--rct-color-status-absent-fill);
}

:where([data-student-ui]) .requests-type-choice__mark--positive,
:where([data-student-ui]):is(.requests-type-choice__mark--positive) {
  color: var(--rct-color-status-present-on-fill);
  background: var(--rct-color-status-present-fill);
}

:where([data-student-ui]) .requests-type-choice__pair-arrow,
:where([data-student-ui]):is(.requests-type-choice__pair-arrow) {
  flex: 0 0 auto;
  color: var(--requests-secondary);
  font-size: 0.9375rem;
  font-weight: var(--rct-font-weight-bold);
  line-height: 1;
}

:where([data-student-ui]) .requests-type-choice__label,
:where([data-student-ui]):is(.requests-type-choice__label) {
  min-inline-size: 0;
  overflow-wrap: anywhere;
}

:where([data-student-ui]) .requests-type-choice__arrow,
:where([data-student-ui]):is(.requests-type-choice__arrow) {
  margin-inline-start: auto;
  color: var(--requests-secondary);
  font-size: 1.75rem;
  font-weight: var(--rct-font-weight-regular);
  line-height: 1;
}

:where([data-student-ui]) .requests-type-choice__reason,
:where([data-student-ui]):is(.requests-type-choice__reason) {
  margin-block-start: 0.375rem;
  padding-inline: 0.75rem;
}

:where([data-student-ui]) .requests-form-status,
:where([data-student-ui]):is(.requests-form-status) {
  margin-block-start: -0.5rem;
}

:where([data-student-ui]) .request-inline-action,
:where([data-student-ui]):is(.request-inline-action),
:where([data-student-ui]) .requests-inline-action,
:where([data-student-ui]):is(.requests-inline-action) {
  margin-inline-start: 0.375rem;
  border: 0;
  padding: 0;
  color: var(--requests-accent);
  background: transparent;
  font: inherit;
  font-weight: var(--rct-font-weight-bold);
  text-decoration: underline;
  cursor: pointer;
  @mixin rct-focus-ring;
}

:where([data-student-ui]) .request-late-lesson-card,
:where([data-student-ui]):is(.request-late-lesson-card) {
  display: grid;
  gap: 0.5rem;
  border-radius: var(--rct-radius-2xl);
  padding: 1rem;
  color: var(--requests-text);
  background: var(--requests-raised);
}

:where([data-student-ui]) .request-late-lesson-card__head,
:where([data-student-ui]):is(.request-late-lesson-card__head) {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
}

:where([data-student-ui]) .request-late-lesson-card h2,
:where([data-student-ui]):is(.request-late-lesson-card h2) {
  max-inline-size: 16rem;
  overflow-wrap: anywhere;
  font-size: 1rem;
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.3;
}

:where([data-student-ui]) .request-late-mark,
:where([data-student-ui]):is(.request-late-mark) {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  inline-size: 2.25rem;
  block-size: 2.25rem;
  border-radius: var(--rct-radius-full);
  color: var(--requests-on-accent);
  background: var(--rct-color-status-absent-fill);
  font-size: 1rem;
  font-weight: var(--rct-font-weight-bold);
}

:where([data-student-ui]) .request-budget-card,
:where([data-student-ui]):is(.request-budget-card) {
  display: grid;
  gap: 0.5rem;
  border-radius: var(--rct-radius-2xl);
  padding: 1rem;
  color: var(--requests-secondary);
  background: var(--requests-raised);
}

:where([data-student-ui]) .request-budget-card p,
:where([data-student-ui]):is(.request-budget-card p) {
  font-size: 0.8125rem;
  line-height: 1.35;
}

:where([data-student-ui]) .request-budget-card strong,
:where([data-student-ui]):is(.request-budget-card strong) {
  color: var(--requests-text);
  font-size: 1.5rem;
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.2;
}

:where([data-student-ui]) .request-confirmation-panel,
:where([data-student-ui]):is(.request-confirmation-panel) {
  display: grid;
  gap: 0.75rem;
  border-radius: var(--rct-radius-2xl);
  padding: 1rem;
  color: var(--requests-warning);
  background: var(--requests-warning-fill);
}

:where([data-student-ui]) .request-confirmation-panel h2,
:where([data-student-ui]):is(.request-confirmation-panel h2) {
  font-size: 1rem;
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.3;
}

:where([data-student-ui]) .request-confirmation-panel p,
:where([data-student-ui]):is(.request-confirmation-panel p) {
  font-size: 0.8125rem;
  line-height: 1.45;
}

:where([data-student-ui]) .request-confirmation-panel .requests-submit-action,
:where([data-student-ui]):is(.request-confirmation-panel .requests-submit-action) {
  margin-block-start: 0.5rem;
}

:where([data-student-ui]) .request-confirmation-panel .requests-secondary-action,
:where([data-student-ui]):is(.request-confirmation-panel .requests-secondary-action) {
  color: var(--requests-text);
  background: var(--requests-float);
}

@keyframes requests-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  :where([data-student-ui]) .requests-primary-action,
  :where([data-student-ui]):is(.requests-primary-action),
  :where([data-student-ui]) .requests-submit-action,
  :where([data-student-ui]):is(.requests-submit-action),
  :where([data-student-ui]) .requests-secondary-action,
  :where([data-student-ui]):is(.requests-secondary-action),
  :where([data-student-ui]) .requests-danger-action,
  :where([data-student-ui]):is(.requests-danger-action),
  :where([data-student-ui]) .requests-tab,
  :where([data-student-ui]):is(.requests-tab),
  :where([data-student-ui]) .requests-inline-action,
  :where([data-student-ui]):is(.requests-inline-action),
  :where([data-student-ui]) .requests-back-button,
  :where([data-student-ui]):is(.requests-back-button),
  :where([data-student-ui]) .request-card__attachment-action,
  :where([data-student-ui]):is(.request-card__attachment-action),
  :where([data-student-ui]) .request-lesson-recovery-action,
  :where([data-student-ui]):is(.request-lesson-recovery-action) {
    transition: none;
  }

  :where([data-student-ui]) .requests-skeleton,
  :where([data-student-ui]):is(.requests-skeleton) {
    animation: none;
  }
}

@media (max-width: 21rem) {
  :where([data-student-ui]) .request-card__head,
  :where([data-student-ui]):is(.request-card__head),
  :where([data-student-ui]) .request-late-lesson-card__head,
  :where([data-student-ui]):is(.request-late-lesson-card__head) {
    align-items: flex-start;
    flex-direction: column;
  }

  :where([data-student-ui]) .request-status,
  :where([data-student-ui]):is(.request-status) {
    justify-self: start;
  }
}

:where([data-student-ui]) .requests-screen,
:where([data-student-ui]):is(.requests-screen),
:where([data-student-ui]) .requests-type-screen,
:where([data-student-ui]):is(.requests-type-screen) {
  min-inline-size: 0;
  overflow-wrap: anywhere;
  padding-block: var(--rct-space-5) var(--rct-today-bottom-space);
}
:where([data-student-ui]) .requests-screen__header h1,
:where([data-student-ui]):is(.requests-screen__header h1) {
  @mixin rct-type-screen-title;
}
:where([data-student-ui]) .requests-type-screen .requests-form-header h1,
:where([data-student-ui]):is(.requests-type-screen .requests-form-header h1) {
  @mixin rct-type-task-title;
}
:where([data-student-ui]) .requests-type-choice,
:where([data-student-ui]):is(.requests-type-choice),
:where([data-student-ui]) .requests-type-choice--unavailable,
:where([data-student-ui]):is(.requests-type-choice--unavailable) {
  border: 0;
}
:where([data-student-ui]) .requests-type-choice__symbol-pair,
:where([data-student-ui]):is(.requests-type-choice__symbol-pair) {
  inline-size: auto;
}
:where([data-student-ui]) .request-card__head h2,
:where([data-student-ui]):is(.request-card__head h2) {
  min-inline-size: 0;
  font-size: var(--rct-font-size-body);
}
:where([data-student-ui]) .request-status,
:where([data-student-ui]):is(.request-status) {
  flex: 0 0 auto;
}
:where([data-student-ui]) .request-lesson-card,
:where([data-student-ui]):is(.request-lesson-card) {
  inline-size: 100%;
  min-inline-size: 0;
}
:where([data-student-ui]) .requests-state,
:where([data-student-ui]):is(.requests-state) {
  border: 0;
}
:where([data-student-ui]) .requests-state--error,
:where([data-student-ui]):is(.requests-state--error) {
  background: var(--rct-error-surface);
}
:where([data-student-ui]) .requests-state--error h2,
:where([data-student-ui]):is(.requests-state--error h2) {
  color: var(--rct-color-danger-text);
}
:where([data-student-ui]) .requests-screen > .student-warning,
:where([data-student-ui]):is(.requests-screen > .student-warning) {
  margin-block-start: var(--rct-space-3);
}

/* Request metadata uses the same semantic icons at the caption text size. */
:where([data-student-ui]) .request-card__details-head,
:where([data-student-ui]):is(.request-card__details-head) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-3);
}
:where([data-student-ui]) .request-card__meta p,
:where([data-student-ui]):is(.request-card__meta p) {
  display: flex;
  align-items: center;
  gap: var(--rct-space-1);
}
:where([data-student-ui]) .request-card__meta .mobile-icon,
:where([data-student-ui]):is(.request-card__meta .mobile-icon),
:where([data-student-ui]) .request-lesson-card .mobile-icon,
:where([data-student-ui]):is(.request-lesson-card .mobile-icon),
:where([data-student-ui]) .request-lesson-option__meta .mobile-icon,
:where([data-student-ui]):is(.request-lesson-option__meta .mobile-icon) {
  flex: 0 0 auto;
  inline-size: var(--rct-font-size-caption);
  block-size: var(--rct-font-size-caption);
}
:where([data-student-ui]) .request-card__toggle,
:where([data-student-ui]):is(.request-card__toggle) {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-full);
  color: var(--requests-secondary);
  background: var(--requests-float);
  cursor: pointer;
  @mixin rct-focus-ring;
}
:where([data-student-ui]) .request-card__toggle .mobile-icon,
:where([data-student-ui]):is(.request-card__toggle .mobile-icon) {
  inline-size: var(--rct-icon-size);
  block-size: var(--rct-icon-size);
}
:where([data-student-ui]) .request-card__toggle-icon--expanded,
:where([data-student-ui]):is(.request-card__toggle-icon--expanded) {
  transform: rotate(180deg);
}
:where([data-student-ui]) .request-lesson-card,
:where([data-student-ui]):is(.request-lesson-card) {
  border-radius: var(--rct-radius-2xl);
}
:where([data-student-ui]) .request-lesson-retained,
:where([data-student-ui]):is(.request-lesson-retained) {
  display: grid;
  gap: var(--rct-space-2);
}
:where([data-student-ui]) .request-lesson-retained__help,
:where([data-student-ui]):is(.request-lesson-retained__help) {
  color: var(--requests-secondary);
  @mixin rct-type-lesson-meta;
}
:where([data-student-ui]) .request-lesson-retained__row,
:where([data-student-ui]):is(.request-lesson-retained__row) {
  flex-wrap: wrap;
  color: var(--requests-muted);
}
:where([data-student-ui]) .request-lesson-retained__row .request-lesson-recovery-action,
:where([data-student-ui]):is(.request-lesson-retained__row .request-lesson-recovery-action),
:where([data-student-ui]) .requests-selection-screen .request-lesson-recovery-action,
:where([data-student-ui]):is(.requests-selection-screen .request-lesson-recovery-action) {
  border: 0;
  color: var(--requests-secondary);
  background: var(--requests-float);
}
:where([data-student-ui]) .request-lesson-option__absence,
:where([data-student-ui]):is(.request-lesson-option__absence) {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border-radius: var(--rct-radius-full);
  color: var(--rct-color-status-absent-on-fill);
  background: var(--rct-color-status-absent-fill);
  @mixin rct-type-field-label;
  font-weight: var(--rct-font-weight-bold);
}
:where([data-student-ui]) .request-lesson-option__lifecycle,
:where([data-student-ui]):is(.request-lesson-option__lifecycle) {
  flex: 0 1 auto;
  color: var(--requests-muted);
  @mixin rct-type-lesson-meta;
}
