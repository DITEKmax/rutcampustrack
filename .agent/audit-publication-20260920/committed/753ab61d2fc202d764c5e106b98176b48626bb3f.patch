+        return AttendanceMetricSet.from(
+                AttendanceMetricCalculator.calculate(List.of(occurrences)));
+    }
+
+    private static void assertMetricSet(
+            AttendanceMetricSet expected,
+            AttendanceMetricSet actual) {
+        assertThat(actual.held()).isEqualTo(expected.held());
+        assertThat(actual.planned()).isEqualTo(expected.planned());
+        assertMetricValue(expected.present(), actual.present());
+        assertMetricValue(expected.presentOrExcused(), actual.presentOrExcused());
+        assertMetricValue(expected.excused(), actual.excused());
+        assertMetricValue(expected.absent(), actual.absent());
+    }
+
+    private static void assertMetricValue(
+            AttendanceMetricValue expected,
+            AttendanceMetricValue actual) {
+        assertThat(actual.count()).isEqualTo(expected.count());
+        if (expected.percent() == null) {
+            assertThat(actual.percent()).isNull();
+        } else {
+            assertThat(actual.percent()).isEqualByComparingTo(expected.percent());
+        }
+    }
+
+    private static void assertSeries(
+            List<AttendanceSeriesPoint> actual,
+            List<SeriesExpectation> expected) {
+        assertThat(actual).hasSize(expected.size());
+        for (int index = 0; index < expected.size(); index++) {
+            AttendanceSeriesPoint actualPoint = actual.get(index);
+            SeriesExpectation expectedPoint = expected.get(index);
+            assertThat(actualPoint.dateFrom()).isEqualTo(expectedPoint.dateFrom());
+            assertThat(actualPoint.dateTo()).isEqualTo(expectedPoint.dateTo());
+            assertThat(actualPoint.state()).isEqualTo(expectedPoint.state());
+            assertMetricSet(expectedPoint.metrics(), actualPoint.metrics());
+        }
+    }
+
+    private record SeriesExpectation(
+            LocalDate dateFrom,
+            LocalDate dateTo,
+            ProjectionPointState state,
+            AttendanceMetricSet metrics) {
+    }
+
+    private record SelectedTypesCase(
+            List<ProjectionLessonType> requested,
+            List<ProjectionLessonType> selected,
+            AttendanceMetricSet aggregate,
+            List<SeriesExpectation> series) {
+    }
+
+    private static void assertKind(org.assertj.core.api.ThrowableAssert.ThrowingCallable invocation,
+                                   StudentProjectionValidationException.Kind expected) {
+        assertThatThrownBy(invocation)
+                .isInstanceOf(StudentProjectionValidationException.class)
+                .satisfies(error -> assertThat(((StudentProjectionValidationException) error).kind())
+                        .isEqualTo(expected));
+    }
+
+    private static StudentProjectionInput input(
+            List<ProjectionOccurrence> occurrences,
+            List<ProjectionMark> marks,
+            List<ProjectionRankParticipant> roster) {
+        return new StudentProjectionInput(
+                new ProjectionScope(
+                        STUDENT,
+                        SEMESTER,
+                        SEMESTER_FROM,
+                        SEMESTER_TO,
+                        List.of(new ProjectionMembershipInterval(
+                                GROUP, SEMESTER_FROM, SEMESTER_TO.plusDays(1)))),
+                NOW,
+                occurrences,
+                marks,
+                roster);
+    }
+
+    private static ProjectionMark mark(
+            long occurrenceId,
+            long studentId,
+            long generation,
+            AttendanceStatus status) {
+        return new ProjectionMark(occurrenceId, studentId, generation, status);
+    }
+
+    private static ProjectionOccurrence occurrence(
+            long occurrenceId,
+            long currentLessonId,
+            long subjectId,
+            String subjectName,
+            ProjectionLessonType type,
+            LocalDate date,
+            ProjectionLifecycle lifecycle,
+            long generation) {
+        return new ProjectionOccurrence(
+                occurrenceId,
+                currentLessonId,
+                1_000L + occurrenceId,
+                SEMESTER,
+                GROUP,
+                subjectId,
+                subjectName,
+                500L,
+                type,
+                generation,
+                1L,
+                date,
+                (int) occurrenceId,
+                LocalTime.of(9, 0),
+                LocalTime.of(10, 0),
+                null,
+                lifecycle);
+    }
+}
