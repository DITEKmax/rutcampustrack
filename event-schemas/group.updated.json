{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "group.updated",
  "description": "Состав группы изменён. Генерируется Academic Service.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "traceparent": {
      "$ref": "_common.json#/$defs/traceparent"
    },
    "request_id": {
      "$ref": "_common.json#/$defs/requestId"
    },
    "event_type": {
      "const": "group.updated"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "group_id"
      ],
      "properties": {
        "group_id": {
          "type": "integer"
        },
        "affected_user_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Optional exact recipients frozen before canonical group deletion; hidden projection invalidation only."
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
