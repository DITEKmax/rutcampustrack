@import '../../styles/tokens.pcss';

.mobile-upload {
  position: relative;
  display: grid;
  justify-items: center;
  gap: var(--rct-space-2);
  padding: var(--rct-space-4);
  min-block-size: var(--rct-form-upload-height);
  border: var(--rct-border-hairline) dashed var(--rct-color-border-default);
  border-radius: var(--rct-radius-xl);
  background: var(--rct-color-surface-base);
  cursor: pointer;
}
.mobile-upload input[type='file'] {
  position: absolute;
  inset: 0;
  inline-size: 100%;
  block-size: 100%;
  opacity: 0;
  cursor: pointer;
}
.mobile-upload:focus-within {
  outline: var(--rct-border-hairline) solid var(--rct-color-accent-now);
  outline-offset: var(--rct-space-half);
}
.mobile-upload small {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-micro);
}
