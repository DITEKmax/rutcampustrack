.rct-attendance-filter-illustration { display: block; inline-size: calc(var(--control-height) * 6.5); max-inline-size: 100%; block-size: auto; stroke-linecap: round; stroke-linejoin: round; }
.rct-attendance-filter-illustration__paper { fill: var(--color-surface-raised); stroke: var(--color-border-strong); }
.rct-attendance-filter-illustration__grid { stroke: var(--color-border-default); }
.rct-attendance-filter-illustration__binding, .rct-attendance-filter-illustration__detail { stroke: var(--color-text-muted); }
.rct-attendance-filter-illustration__mark, .rct-attendance-filter-illustration__filter { fill: var(--color-accent-soft); stroke: var(--color-border-accent); }
.rct-attendance-filter-illustration__dot { fill: var(--color-border-strong); }
