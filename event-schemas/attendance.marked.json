{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attendance.marked",
  "description": "Студент отметился на паре. Генерируется Attendance Service.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "attendance.marked"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "lesson_id",
        "user_id",
        "group_id",
        "status",
        "marked_by"
      ],
      "properties": {
        "lesson_id": {
          "type": "integer"
        },
        "user_id": {
          "type": "integer"
        },
        "group_id": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "present",
            "absent",
            "excused",
            "free_attendance"
          ]
        },
        "marked_by": {
          "type": "string",
          "enum": [
            "student_geo",
            "headman",
            "auto_scheduler",
            "late_checkin",
            "headman_excuse"
          ]
        },
        "lesson_number": {
          "$ref": "_common.json#/$defs/lessonNumber",
          "description": "Optional. NOTIF unification: bot/PWA/web показывают студенту 'Староста проставил статус ... на паре №N'."
        },
        "lesson_date": {
          "type": "string",
          "format": "date",
          "description": "Optional. ISO-8601 date пары (LocalDate.toString())."
        },
        "subject_id": {
          "type": "integer",
          "description": "Optional. Subject ID для resolve через cache на consumer."
        },
        "subject_name": {
          "type": "string",
          "description": "Optional. Имя предмета — обогащение для display, best-effort gRPC lookup в publisher."
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
