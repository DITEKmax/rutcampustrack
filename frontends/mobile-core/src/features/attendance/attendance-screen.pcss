:where([data-student-ui]) .attendance-day-rail__item:focus-visible,
:where([data-student-ui]):is(.attendance-day-rail__item:focus-visible),
:where([data-student-ui]) .attendance-graph__column:focus-visible,
:where([data-student-ui]):is(.attendance-graph__column:focus-visible) {
