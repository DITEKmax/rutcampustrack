  font: inherit;
  font-size: var(--rct-font-size-body);
}

:where([data-student-ui]) .profile-field__toggle,
:where([data-student-ui]):is(.profile-field__toggle) {
  display: grid;
  flex: 0 0 var(--rct-control-min-touch);
  place-items: center;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
