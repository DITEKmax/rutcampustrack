  font-size: var(--rct-font-size-caption);
}

:where([data-student-ui]) .profile-role-list,
:where([data-student-ui]):is(.profile-role-list) {
  display: grid;
  gap: var(--rct-space-3);
}

:where([data-student-ui]) .profile-role-card,
:where([data-student-ui]):is(.profile-role-card) {
  display: flex;
  align-items: center;
  gap: var(--rct-space-3);
  inline-size: 100%;
  min-block-size: var(
    --rct-profile-more-row-height,
    calc(var(--rct-control-min-touch) + var(--rct-space-5) + var(--rct-space-4))
  );
  border: 0;
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-raised);
  font: inherit;
  text-align: start;
  cursor: pointer;
}

:where([data-student-ui]) .profile-role-card[data-selected='true'],
:where([data-student-ui]):is(.profile-role-card[data-selected='true']) {
  color: var(--profile-color-accent-on-now);
  background: var(--profile-color-accent-now);
}

:where([data-student-ui]) .profile-role-card[data-disabled='true'],
:where([data-student-ui]):is(.profile-role-card[data-disabled='true']) {
  color: var(--profile-color-text-secondary);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}

:where([data-student-ui]) .profile-role-card__avatar,
