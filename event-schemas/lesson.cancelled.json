{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson.cancelled",
  "description": "Пара отменена старостой/админом. Генерируется Schedule Service. M09 G5 — full snapshot (start_time, end_time, lesson_number, cancelled_by, cancelled_at) чтобы downstream не нужны были second-look gRPC вызовы в schedule.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "lesson.cancelled"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "lesson_id",
        "group_id",
        "subject_id",
        "date"
      ],
      "properties": {
        "lesson_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "group_id": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "start_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "lesson_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 8
        },
        "cancel_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "cancelled_by": {
          "type": [
            "integer",
            "null"
          ],
          "description": "user_id старосты/админа. NULL для legacy-строк, отменённых до миграции V13."
        },
        "cancelled_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "ISO-8601 с offset. NULL для legacy-строк до миграции V13."
        },
        "semester_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lesson_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lecture",
            "practice",
            "lab",
            null
          ]
        },
        "lesson_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "assignment_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "assigned_teacher_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "room": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
