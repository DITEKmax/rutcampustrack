# ==========================================================================
# Production environment template (copy to .env.prod and заполнить)
# .env.prod is gitignored — secrets never committed.
# ==========================================================================

# PostgreSQL
POSTGRES_ACADEMIC_PASSWORD=CHANGE_ME
POSTGRES_SCHEDULE_PASSWORD=CHANGE_ME

# RabbitMQ
RABBITMQ_USER=rct_user
RABBITMQ_PASSWORD=CHANGE_ME

# Telegram
BOT_TOKEN=CHANGE_ME  # @BotFather → /newbot
TMA_BOT_TOKEN=CHANGE_ME  # same as BOT_TOKEN for unified TMA auth

# VAPID (Web Push) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=CHANGE_ME@example.com

# Frontend / App URLs
MINI_APP_URL=https://t.me/ruttrack_bot/ruttrack

# MongoDB
MONGO_USER=rct_user
MONGO_PASSWORD=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME
# M10 G1 D2 — отдельный credential для notification_db (PoLP).
MONGO_NOTIFICATION_USER=rct_notification_user
MONGO_NOTIFICATION_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# ==========================================================================
# M11 G4 (NEW-125): Swagger UI basic-auth
# ==========================================================================
# Формат: «login:hashed_password» (htpasswd-совместимый bcrypt или apr1).
# Генерация:
#   htpasswd -nB swagger                    # bcrypt (предпочтительно)
#   openssl passwd -apr1 <password> | \     # apr1 (fallback без apache2-utils)
#     awk '{print "swagger:"$1}'
# ВАЖНО: в этом файле `$` в hash'е должно быть удвоено (`$$`) —
# docker-compose интерполирует `${VAR}` в YAML; без escape'а compose
# видит `$apr1` как undefined variable и подставляет пустую строку.
# В runtime env контейнера `$$` декодируется обратно в `$`.
# Пример: `$apr1$abc$xyz` → в этом файле пишем `$$apr1$$abc$$xyz`.
#
# Nginx на старте копирует значение в /etc/nginx/.htpasswd (см.
# docker-compose.prod.yml:nginx.command).
# Rotation раз в 6 мес — см. docs/runbooks/swagger-prod-access.md.
SWAGGER_HTPASSWD=swagger:$$apr1$$CHANGE$$ME

# Internal service-to-service gRPC auth (M03a — shared secret)
GRPC_SECRET=CHANGE_ME  # openssl rand -base64 32

# GitHub Container Registry (CI image pulls)
GHCR_TOKEN=CHANGE_ME  # https://github.com/settings/tokens — read:packages

# CORS
CORS_ALLOWED_ORIGIN=https://ruttrack.site

# Monitoring
BOT_ALERT_TOKEN=CHANGE_ME  # отдельный Telegram bot для Alertmanager

# Grafana
GRAFANA_LOGIN=admin
GRAFANA_PASSWORD=CHANGE_ME
