index 00000000..8edeee4c
--- /dev/null
+++ b/services/attendance-service/attendance-app/src/main/java/ru/rutcampustrack/attendance/report/studentprojection/StudentProjectionCalculator.java
@@ -0,0 +1,848 @@
+package ru.rutcampustrack.attendance.report.studentprojection;
+
+import ru.rutcampustrack.attendance.contract.enums.AttendanceStatus;
+
+import java.time.DayOfWeek;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Pure B2 attendance/statistics projection assembler.
+ *
+ * <p>The calculator accepts only an already resolved scope and immutable
+ * source snapshots. It performs no I/O, authentication, transport mapping or
+ * persistence. All public methods normalize the same source rules before
+ * constructing their output, while {@link #calculate(StudentProjectionInput)}
+ * returns every range-independent slice from one normalized set.</p>
+ */
+public final class StudentProjectionCalculator {
+
+    private static final ZoneId MOSCOW = ZoneId.of("Europe/Moscow");
+    private static final List<ProjectionLessonType> TYPE_ORDER =
+            ProjectionLessonType.canonicalOrder();
+    private static final String[] RUSSIAN_WEEKDAYS = {
+            "пн", "вт", "ср", "чт", "пт", "сб", "вс"
+    };
+    private static final String[] RUSSIAN_MONTHS = {
+            "января", "февраля", "марта", "апреля", "мая", "июня",
+            "июля", "августа", "сентября", "октября", "ноября", "декабря"
+    };
+
+    private StudentProjectionCalculator() {
+    }
+
+    /** Builds all range-independent B2 slices from one validated source set. */
+    public static StudentProjectionSnapshot calculate(StudentProjectionInput input) {
+        return Prepared.from(input).snapshot();
+    }
+
+    /** Alias for adapters that use the verb "project". */
+    public static StudentProjectionSnapshot project(StudentProjectionInput input) {
+        return calculate(input);
+    }
+
+    public static StudentAttendanceOverviewProjection attendanceOverview(
+            StudentProjectionInput input) {
+        return Prepared.from(input).attendanceOverview();
+    }
+
+    public static StudentAttendanceSubjectsProjection attendanceSubjects(
+            StudentProjectionInput input) {
+        return Prepared.from(input).attendanceSubjects();
+    }
+
+    public static StudentAttendanceGraphProjection attendanceGraph(
+            StudentProjectionInput input,
+            ProjectionRange range) {
+        return Prepared.from(input).attendanceGraph(range);
+    }
+
+    public static StudentStatisticsOverviewProjection statisticsOverview(
+            StudentProjectionInput input,
+            ProjectionRange range) {
+        return Prepared.from(input).statisticsOverview(range);
+    }
+
+    public static StudentStatisticsSubjectDetailProjection statisticsSubjectDetail(
+            StudentProjectionInput input,
+            Long subjectId,
+            ProjectionRange range,
+            List<ProjectionLessonType> selectedTypes) {
+        return Prepared.from(input).statisticsSubjectDetail(subjectId, range, selectedTypes);
+    }
+
+    private static final class Prepared {
+        private final ProjectionScope scope;
+        private final Instant serverNow;
+        private final LocalDate today;
+        private final List<ProjectionOccurrence> occurrences;
+        private final Map<Long, ProjectionMark> ownMarksByOccurrence;
+        private final List<ProjectionRankParticipant> rankRoster;
+
+        private Prepared(
+                ProjectionScope scope,
+                Instant serverNow,
+                LocalDate today,
+                List<ProjectionOccurrence> occurrences,
+                Map<Long, ProjectionMark> ownMarksByOccurrence,
+                List<ProjectionRankParticipant> rankRoster) {
+            this.scope = scope;
+            this.serverNow = serverNow;
+            this.today = today;
+            this.occurrences = occurrences;
+            this.ownMarksByOccurrence = ownMarksByOccurrence;
+            this.rankRoster = rankRoster;
+        }
+
+        private static Prepared from(StudentProjectionInput input) {
+            if (input == null) {
+                throw StudentProjectionValidationException.invalidInput("input is null");
+            }
+            ProjectionScope scope = input.scope();
+            validateScope(scope);
+            Instant serverNow = input.serverNow();
+            if (serverNow == null) {
+                throw StudentProjectionValidationException.invalidInput("serverNow is null");
+            }
+
+            List<ProjectionMembershipInterval> intervals = validateIntervals(scope);
+            List<ProjectionOccurrence> source = input.occurrences();
+            if (source == null) {
+                throw StudentProjectionValidationException.invalidInput("occurrences are null");
+            }
+
+            List<ProjectionOccurrence> ordered = new ArrayList<>(source.size());
+            Map<Long, ProjectionOccurrence> byId = new HashMap<>();
+            Set<Long> currentLessonIds = new HashSet<>();
+            Map<Long, String> subjectNames = new HashMap<>();
+            for (ProjectionOccurrence occurrence : source) {
+                validateOccurrence(occurrence, scope, intervals);
+                Long occurrenceId = occurrence.occurrenceId();
+                if (byId.putIfAbsent(occurrenceId, occurrence) != null) {
+                    throw StudentProjectionValidationException.duplicateOccurrence(
+                            "occurrence id " + occurrenceId + " is present more than once");
+                }
+                if (!currentLessonIds.add(occurrence.currentLessonId())) {
+                    throw StudentProjectionValidationException.lineageMismatch(
+                            "current physical lesson " + occurrence.currentLessonId()
+                                    + " represents more than one logical occurrence");
+                }
+                String previousName = subjectNames.putIfAbsent(
+                        occurrence.subjectId(), occurrence.subjectName());
+                if (previousName != null && !previousName.equals(occurrence.subjectName())) {
+                    throw StudentProjectionValidationException.invalidMetadata(
+                            "subject " + occurrence.subjectId() + " has conflicting names");
+                }
+                ordered.add(occurrence);
+            }
+            ordered.sort(OCCURRENCE_ORDER);
+
+            List<ProjectionRankParticipant> roster = input.rankRoster();
+            if (roster == null) {
+                throw StudentProjectionValidationException.invalidRoster("rank roster is null");
+            }
+            Set<Long> rosterIds = validateRoster(scope.studentId(), roster);
+
+            List<ProjectionMark> marks = input.marks();
+            if (marks == null) {
+                throw StudentProjectionValidationException.invalidInput("marks are null");
+            }
+            Map<MarkKey, ProjectionMark> marksByKey = new HashMap<>();
+            Map<Long, ProjectionMark> ownMarks = new HashMap<>();
+            for (ProjectionMark mark : marks) {
+                validateMark(mark, scope.studentId(), rosterIds, byId);
+                ProjectionMark previous = marksByKey.putIfAbsent(
+                        new MarkKey(mark.occurrenceId(), mark.studentId(), mark.generation()),
+                        mark);
+                if (previous != null) {
+                    throw StudentProjectionValidationException.duplicateMark(
+                            "mark key " + markKey(mark) + " is present more than once");
+                }
+                if (mark.studentId().equals(scope.studentId())) {
+                    ownMarks.put(mark.occurrenceId(), mark);
+                }
+            }
+
+            return new Prepared(
+                    scope,
+                    serverNow,
+                    serverNow.atZone(MOSCOW).toLocalDate(),
+                    List.copyOf(ordered),
+                    Map.copyOf(ownMarks),
+                    List.copyOf(roster));
+        }
+
+        private StudentProjectionSnapshot snapshot() {
+            StudentAttendanceOverviewProjection overview = attendanceOverview();
+            StudentAttendanceSubjectsProjection subjects = attendanceSubjects();
+            StudentAttendanceGraphProjection days = attendanceGraph(ProjectionRange.DAYS);
+            StudentAttendanceGraphProjection weeks = attendanceGraph(ProjectionRange.WEEKS);
+            StudentStatisticsOverviewProjection statisticsDays =
+                    statisticsOverview(ProjectionRange.DAYS);
+            StudentStatisticsOverviewProjection statisticsWeeks =
+                    statisticsOverview(ProjectionRange.WEEKS);
+            return new StudentProjectionSnapshot(
+                    overview, subjects, days, weeks, statisticsDays, statisticsWeeks);
+        }
+
+        private StudentAttendanceOverviewProjection attendanceOverview() {
+            AttendanceMetricSet metrics = metricSet(occurrences);
+            List<StudentAttendanceDay> days = dayRows(occurrences);
+            return new StudentAttendanceOverviewProjection(
+                    Long.toString(scope.semesterId()), serverNow, metrics, days);
+        }
+
+        private StudentAttendanceSubjectsProjection attendanceSubjects() {
+            List<AttendanceSubjectProjection> subjects = new ArrayList<>();
+            for (Map.Entry<Long, List<ProjectionOccurrence>> entry
+                    : groupBySubject(occurrences).entrySet()) {
+                List<ProjectionOccurrence> subjectOccurrences = entry.getValue();
+                List<AttendanceSubjectTypeSummary> cards = new ArrayList<>();
+                for (ProjectionLessonType type : availableTypes(subjectOccurrences)) {
+                    List<ProjectionOccurrence> typeOccurrences = filterType(
+                            subjectOccurrences, type);
+                    cards.add(new AttendanceSubjectTypeSummary(
+                            type,
+                            metricSet(typeOccurrences),
+                            history(typeOccurrences)));
+                }
+                ProjectionOccurrence first = subjectOccurrences.get(0);
+                subjects.add(new AttendanceSubjectProjection(
+                        Long.toString(entry.getKey()), first.subjectName(), cards));
+            }
+            return new StudentAttendanceSubjectsProjection(
+                    Long.toString(scope.semesterId()), serverNow, subjects);
+        }
+
+        private StudentAttendanceGraphProjection attendanceGraph(ProjectionRange range) {
+            requireRange(range);
+            return new StudentAttendanceGraphProjection(
+                    Long.toString(scope.semesterId()),
+                    serverNow,
+                    range,
+                    series(occurrences, range));
+        }
+
+        private StudentStatisticsOverviewProjection statisticsOverview(ProjectionRange range) {
+            requireRange(range);
+            AttendanceMetricSet metrics = metricSet(occurrences);
+            StatisticsOwnRank rank = ownRank();
+            List<StatisticsSubjectSummary> summaries = new ArrayList<>();
+            for (Map.Entry<Long, List<ProjectionOccurrence>> entry
+                    : groupBySubject(occurrences).entrySet()) {
+                ProjectionOccurrence first = entry.getValue().get(0);
+                summaries.add(new StatisticsSubjectSummary(
+                        Long.toString(entry.getKey()),
+                        first.subjectName(),
+                        metricSet(entry.getValue())));
+            }
+            return new StudentStatisticsOverviewProjection(
+                    Long.toString(scope.semesterId()),
+                    serverNow,
+                    range,
+                    metrics,
+                    rank,
+                    series(occurrences, range),
+                    summaries);
+        }
+
+        private StudentStatisticsSubjectDetailProjection statisticsSubjectDetail(
+                Long subjectId,
+                ProjectionRange range,
+                List<ProjectionLessonType> selectedTypes) {
+            requireRange(range);
+            if (subjectId == null || subjectId <= 0) {
+                throw StudentProjectionValidationException.invalidInput(
+                        "subject id must be positive");
+            }
+            List<ProjectionOccurrence> subjectOccurrences = groupBySubject(occurrences).get(subjectId);
+            if (subjectOccurrences == null || subjectOccurrences.isEmpty()) {
+                throw StudentProjectionValidationException.subjectNotFound(
+                        "subject " + subjectId + " is not in the authorized occurrence set");
+            }
+            List<ProjectionLessonType> available = availableTypes(subjectOccurrences);
+            List<ProjectionLessonType> selected = selectTypes(selectedTypes, available);
+            Set<ProjectionLessonType> selectedSet = Set.copyOf(selected);
+            List<ProjectionOccurrence> selectedOccurrences = subjectOccurrences.stream()
+                    .filter(occurrence -> selectedSet.contains(occurrence.lessonType()))
+                    .toList();
+            List<StatisticsTypeCard> typeCards = new ArrayList<>();
+            for (ProjectionLessonType type : available) {
+                List<ProjectionOccurrence> typeOccurrences = filterType(
+                        subjectOccurrences, type);
+                typeCards.add(new StatisticsTypeCard(
+                        type,
+                        metricSet(typeOccurrences),
+                        history(typeOccurrences)));
+            }
+            ProjectionOccurrence first = subjectOccurrences.get(0);
+            return new StudentStatisticsSubjectDetailProjection(
+                    Long.toString(scope.semesterId()),
+                    serverNow,
+                    Long.toString(subjectId),
+                    first.subjectName(),
+                    range,
+                    available,
+                    selected,
+                    metricSet(selectedOccurrences),
+                    series(selectedOccurrences, range),
+                    typeCards);
+        }
+
+        private StatisticsOwnRank ownRank() {
+            List<OwnRankCalculator.Participant> acceptedRoster = new ArrayList<>(rankRoster.size());
+            for (ProjectionRankParticipant participant : rankRoster) {
+                acceptedRoster.add(new OwnRankCalculator.Participant(
+                        participant.participantId(), participant.metrics()));
+            }
+            OwnRankCalculator.Rank rank = OwnRankCalculator.calculate(
+                    scope.studentId(), acceptedRoster);
+            return new StatisticsOwnRank(rank.position(), rank.participantCount(), rank.available());
+        }
+
+        private AttendanceMetricSet metricSet(List<ProjectionOccurrence> source) {
+            return AttendanceMetricSet.from(
+                    AttendanceMetricCalculator.calculate(acceptedOccurrences(source)));
+        }
+
+        private List<AttendanceMetricCalculator.Occurrence> acceptedOccurrences(
+                List<ProjectionOccurrence> source) {
+            List<AttendanceMetricCalculator.Occurrence> result = new ArrayList<>(source.size());
+            for (ProjectionOccurrence occurrence : source) {
+                AttendanceStatus status = null;
+                ProjectionMark mark = ownMarksByOccurrence.get(occurrence.occurrenceId());
+                if (mark != null) {
+                    status = mark.status();
+                }
+                AttendanceMetricCalculator.OccurrenceState state = switch (occurrence.lifecycle()) {
+                    case PLANNED -> AttendanceMetricCalculator.OccurrenceState.PLANNED;
+                    case ACTIVE -> AttendanceMetricCalculator.OccurrenceState.ACTIVE;
+                    case CLOSED -> AttendanceMetricCalculator.OccurrenceState.CLOSED;
+                    case CANCELLED -> AttendanceMetricCalculator.OccurrenceState.CANCELLED;
+                    case TRANSFERRED_OUT -> throw StudentProjectionValidationException.lineageMismatch(
+                            "transferred source occurrence " + occurrence.occurrenceId()
+                                    + " cannot enter metrics");
+                };
+                result.add(new AttendanceMetricCalculator.Occurrence(
+                        occurrence.occurrenceId(), state, status));
+            }
+            return result;
+        }
+
+        private List<StudentAttendanceDay> dayRows(List<ProjectionOccurrence> source) {
+            Map<LocalDate, List<ProjectionOccurrence>> byDate = new TreeMap<>();
+            for (ProjectionOccurrence occurrence : source) {
+                byDate.computeIfAbsent(occurrence.date(), ignored -> new ArrayList<>())
+                        .add(occurrence);
+            }
+            List<StudentAttendanceDay> days = new ArrayList<>(byDate.size());
+            for (Map.Entry<LocalDate, List<ProjectionOccurrence>> entry : byDate.entrySet()) {
+                List<StudentAttendanceLesson> lessons = new ArrayList<>(entry.getValue().size());
+                for (ProjectionOccurrence occurrence : entry.getValue()) {
+                    lessons.add(new StudentAttendanceLesson(
+                            Long.toString(occurrence.currentLessonId()),
+                            occurrence.date(),
+                            Integer.toString(occurrence.lessonNumber()),
+                            new AttendanceSubjectRef(
+                                    Long.toString(occurrence.subjectId()), occurrence.subjectName()),
+                            occurrence.lessonType(),
+                            new AttendanceLessonSchedule(
+                                    occurrence.startsAt(), occurrence.endsAt(), occurrence.room()),
+                            lessonStatus(occurrence),
+                            List.of()));
+                }
+                LocalDate date = entry.getKey();
+                days.add(new StudentAttendanceDay(
+                        date,
+                        RUSSIAN_WEEKDAYS[date.getDayOfWeek().getValue() - 1],
+                        Integer.toString(date.getDayOfMonth()),
+                        dayState(date),
+                        lessons));
+            }
+            return days;
+        }
+
+        private ProjectionDayState dayState(LocalDate date) {
+            if (date.isBefore(today)) {
+                return ProjectionDayState.PAST;
+            }
+            if (date.equals(today)) {
+                return ProjectionDayState.CURRENT;
+            }
+            return ProjectionDayState.FUTURE;
+        }
+
+        private ProjectionLessonStatus lessonStatus(ProjectionOccurrence occurrence) {
+            return switch (occurrence.lifecycle()) {
+                case PLANNED -> ProjectionLessonStatus.FUTURE;
+                case ACTIVE -> ProjectionLessonStatus.ACTIVE;
+                case CANCELLED -> ProjectionLessonStatus.CANCELLED;
+                case TRANSFERRED_OUT -> throw StudentProjectionValidationException.lineageMismatch(
+                        "transferred source occurrence " + occurrence.occurrenceId()
+                                + " cannot be visible as a current lesson");
+                case CLOSED -> closedLessonStatus(occurrence);
+            };
+        }
+
+        private ProjectionLessonStatus closedLessonStatus(ProjectionOccurrence occurrence) {
+            ProjectionMark mark = ownMarksByOccurrence.get(occurrence.occurrenceId());
+            if (mark == null) {
+                return ProjectionLessonStatus.ABSENT;
+            }
+            return switch (mark.status()) {
+                case PRESENT -> ProjectionLessonStatus.PRESENT;
+                case ABSENT -> ProjectionLessonStatus.ABSENT;
+                case EXCUSED -> ProjectionLessonStatus.EXCUSED;
+                case FREE_ATTENDANCE -> throw StudentProjectionValidationException
+                        .unsupportedAttendanceStatus("FREE_ATTENDANCE is not a student mark");
+                case CANCELLED -> throw StudentProjectionValidationException.invalidMetadata(
+                        "closed occurrence " + occurrence.occurrenceId()
+                                + " has a CANCELLED mark");
+            };
+        }
+
+        private List<AttendanceHistorySegment> history(List<ProjectionOccurrence> source) {
+            List<AttendanceHistorySegment> result = new ArrayList<>();
+            for (ProjectionOccurrence occurrence : source) {
+                if (occurrence.lifecycle() == ProjectionLifecycle.CANCELLED) {
+                    continue;
+                }
+                result.add(new AttendanceHistorySegment(
+                        historyId(occurrence), historyStatus(occurrence)));
+            }
+            return result;
+        }
+
+        private ProjectionHistoryStatus historyStatus(ProjectionOccurrence occurrence) {
+            return switch (occurrence.lifecycle()) {
+                case PLANNED, ACTIVE -> ProjectionHistoryStatus.FUTURE;
+                case CLOSED -> switch (lessonStatus(occurrence)) {
+                    case PRESENT -> ProjectionHistoryStatus.PRESENT;
+                    case ABSENT -> ProjectionHistoryStatus.ABSENT;
+                    case EXCUSED -> ProjectionHistoryStatus.EXCUSED;
+                    case ACTIVE, FUTURE, NO_DATA, CANCELLED -> throw StudentProjectionValidationException
+                            .invalidMetadata("closed occurrence has non-terminal lesson status");
+                };
+                case CANCELLED -> throw StudentProjectionValidationException.invalidMetadata(
+                        "cancelled occurrence cannot enter history");
+                case TRANSFERRED_OUT -> throw StudentProjectionValidationException.lineageMismatch(
+                        "transferred source occurrence cannot enter history");
+            };
+        }
+
+        private static String historyId(ProjectionOccurrence occurrence) {
+            return "occurrence:" + occurrence.occurrenceId()
+                    + ":generation:" + occurrence.generation();
+        }
+
+        private List<AttendanceSeriesPoint> series(
+                List<ProjectionOccurrence> source,
+                ProjectionRange range) {
+            if (source.isEmpty()) {
+                return List.of();
+            }
+            if (range == ProjectionRange.DAYS) {
+                Map<LocalDate, List<ProjectionOccurrence>> buckets = new TreeMap<>();
+                for (ProjectionOccurrence occurrence : source) {
+                    buckets.computeIfAbsent(occurrence.date(), ignored -> new ArrayList<>())
+                            .add(occurrence);
+                }
+                List<AttendanceSeriesPoint> result = new ArrayList<>(buckets.size());
+                for (Map.Entry<LocalDate, List<ProjectionOccurrence>> entry : buckets.entrySet()) {
+                    LocalDate date = entry.getKey();
+                    AttendanceMetricCalculator.Metrics metrics =
+                            AttendanceMetricCalculator.calculate(acceptedOccurrences(entry.getValue()));
+                    result.add(new AttendanceSeriesPoint(
+                            "day:" + date,
+                            Integer.toString(date.getDayOfMonth()),
+                            date,
+                            date,
+                            pointState(metrics),
+                            AttendanceMetricSet.from(metrics)));
+                }
+                return result;
+            }
+            if (range != ProjectionRange.WEEKS) {
+                throw StudentProjectionValidationException.invalidRange("unsupported range " + range);
+            }
+            Map<LocalDate, List<ProjectionOccurrence>> buckets = new TreeMap<>();
+            for (ProjectionOccurrence occurrence : source) {
+                LocalDate monday = occurrence.date().with(
+                        java.time.temporal.TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY));
+                buckets.computeIfAbsent(monday, ignored -> new ArrayList<>()).add(occurrence);
+            }
+            List<AttendanceSeriesPoint> result = new ArrayList<>(buckets.size());
+            LocalDate semesterLastDay = scope.semesterTo();
+            for (Map.Entry<LocalDate, List<ProjectionOccurrence>> entry : buckets.entrySet()) {
+                LocalDate monday = entry.getKey();
+                LocalDate dateFrom = max(monday, scope.semesterFrom());
+                LocalDate dateTo = min(monday.plusDays(6), semesterLastDay);
+                AttendanceMetricCalculator.Metrics metrics =
+                        AttendanceMetricCalculator.calculate(acceptedOccurrences(entry.getValue()));
+                result.add(new AttendanceSeriesPoint(
+                        "week:" + dateFrom + ":" + dateTo,
+                        weekLabel(dateFrom, dateTo),
+                        dateFrom,
+                        dateTo,
+                        pointState(metrics),
+                        AttendanceMetricSet.from(metrics)));
+            }
+            return result;
+        }
+
+        private static ProjectionPointState pointState(
+                AttendanceMetricCalculator.Metrics metrics) {
+            if (metrics.heldCount() > 0) {
+                return ProjectionPointState.DATA;
+            }
+            if (metrics.plannedCount() > 0) {
+                return ProjectionPointState.FUTURE;
+            }
+            return ProjectionPointState.NO_DATA;
+        }
+
+        private static LocalDate max(LocalDate left, LocalDate right) {
+            return left.isAfter(right) ? left : right;
+        }
+
+        private static LocalDate min(LocalDate left, LocalDate right) {
+            return left.isBefore(right) ? left : right;
+        }
+
+        private static String weekLabel(LocalDate dateFrom, LocalDate dateTo) {
+            if (dateFrom.getMonth() == dateTo.getMonth()) {
+                return dateFrom.getDayOfMonth() + "–" + dateTo.getDayOfMonth()
+                        + " " + RUSSIAN_MONTHS[dateFrom.getMonthValue() - 1];
+            }
+            return dateFrom.getDayOfMonth() + " "
+                    + RUSSIAN_MONTHS[dateFrom.getMonthValue() - 1]
+                    + " – " + dateTo.getDayOfMonth() + " "
+                    + RUSSIAN_MONTHS[dateTo.getMonthValue() - 1];
+        }
+
+        private Map<Long, List<ProjectionOccurrence>> groupBySubject(
+                List<ProjectionOccurrence> source) {
+            Map<Long, List<ProjectionOccurrence>> result = new TreeMap<>();
+            for (ProjectionOccurrence occurrence : source) {
+                result.computeIfAbsent(occurrence.subjectId(), ignored -> new ArrayList<>())
+                        .add(occurrence);
+            }
+            return result;
+        }
+
+        private static List<ProjectionLessonType> availableTypes(
+                List<ProjectionOccurrence> source) {
+            Set<ProjectionLessonType> present = new HashSet<>();
+            for (ProjectionOccurrence occurrence : source) {
+                present.add(occurrence.lessonType());
+            }
+            List<ProjectionLessonType> result = new ArrayList<>();
+            for (ProjectionLessonType type : TYPE_ORDER) {
+                if (present.contains(type)) {
+                    result.add(type);
+                }
+            }
+            return List.copyOf(result);
+        }
+
+        private static List<ProjectionOccurrence> filterType(
+                List<ProjectionOccurrence> source,
+                ProjectionLessonType type) {
+            List<ProjectionOccurrence> result = new ArrayList<>();
+            for (ProjectionOccurrence occurrence : source) {
+                if (occurrence.lessonType() == type) {
+                    result.add(occurrence);
+                }
+            }
+            return result;
+        }
+
+        private static List<ProjectionLessonType> selectTypes(
+                List<ProjectionLessonType> requested,
+                List<ProjectionLessonType> available) {
+            if (requested == null || requested.isEmpty()) {
+                return available;
+            }
+            Set<ProjectionLessonType> requestedSet = new HashSet<>();
+            for (ProjectionLessonType type : requested) {
+                if (type == null) {
+                    throw StudentProjectionValidationException.invalidSelectedTypes(
+                            "selected lesson type is null");
+                }
+                if (!requestedSet.add(type)) {
+                    throw StudentProjectionValidationException.invalidSelectedTypes(
+                            "selected lesson types contain duplicate " + type);
+                }
+                if (!available.contains(type)) {
+                    throw StudentProjectionValidationException.invalidSelectedTypes(
+                            "selected lesson type " + type + " is not available");
+                }
+            }
+            List<ProjectionLessonType> result = new ArrayList<>();
+            for (ProjectionLessonType type : TYPE_ORDER) {
+                if (requestedSet.contains(type)) {
+                    result.add(type);
+                }
+            }
+            return List.copyOf(result);
+        }
+
+        private static void requireRange(ProjectionRange range) {
+            if (range == null) {
+                throw StudentProjectionValidationException.invalidRange("range is null");
+            }
+        }
+
+        private static final Comparator<ProjectionOccurrence> OCCURRENCE_ORDER =
+                Comparator.comparing(ProjectionOccurrence::date)
+                        .thenComparing(ProjectionOccurrence::startsAt)
+                        .thenComparing(ProjectionOccurrence::lessonNumber)
+                        .thenComparing(ProjectionOccurrence::currentLessonId)
+                        .thenComparing(ProjectionOccurrence::occurrenceId);
+
+        private static void validateScope(ProjectionScope scope) {
+            if (scope == null) {
+                throw StudentProjectionValidationException.invalidScope("scope is null");
+            }
+            requirePositive(scope.studentId(), "student id", StudentProjectionValidationException.Kind.INVALID_SCOPE);
+            requirePositive(scope.semesterId(), "semester id", StudentProjectionValidationException.Kind.INVALID_SCOPE);
+            if (scope.semesterFrom() == null || scope.semesterTo() == null) {
+                throw StudentProjectionValidationException.invalidScope(
+                        "semester bounds are required");
+            }
+            if (scope.semesterFrom().isAfter(scope.semesterTo())) {
+                throw StudentProjectionValidationException.invalidScope(
+                        "semester date_to must be on or after date_from");
+            }
+            if (scope.membershipIntervals() == null) {
+                throw StudentProjectionValidationException.invalidScope(
+                        "resolved membership intervals are null");
+            }
+        }
+
+        private static List<ProjectionMembershipInterval> validateIntervals(
+                ProjectionScope scope) {
+            List<ProjectionMembershipInterval> intervals =
+                    new ArrayList<>(scope.membershipIntervals().size());
+            LocalDate semesterEndExclusive = semesterEndExclusive(scope);
+            for (ProjectionMembershipInterval interval : scope.membershipIntervals()) {
+                if (interval == null) {
+                    throw StudentProjectionValidationException.invalidInterval(
+                            "membership interval is null");
+                }
+                requirePositive(interval.groupId(), "membership group id",
+                        StudentProjectionValidationException.Kind.INVALID_INTERVAL);
+                if (interval.dateFrom() == null || interval.dateTo() == null
+                        || !interval.dateFrom().isBefore(interval.dateTo())) {
+                    throw StudentProjectionValidationException.invalidInterval(
+                            "membership interval must be a non-empty half-open range");
+                }
+                if (interval.dateFrom().isBefore(scope.semesterFrom())
+                        || interval.dateTo().isAfter(semesterEndExclusive)) {
+                    throw StudentProjectionValidationException.invalidInterval(
+                            "membership interval is outside the semester bounds");
+                }
+                intervals.add(interval);
+            }
+            intervals.sort(Comparator.comparing(ProjectionMembershipInterval::dateFrom)
+                    .thenComparing(ProjectionMembershipInterval::dateTo)
+                    .thenComparing(ProjectionMembershipInterval::groupId));
+            // Gaps and overlaps are evaluated against concrete occurrences
+            // below. A student may leave a semester gap, and an unused
+            // overlap cannot authorize anything by itself.
+            return List.copyOf(intervals);
+        }
+
+        private static LocalDate semesterEndExclusive(ProjectionScope scope) {
+            try {
+                return scope.semesterTo().plusDays(1);
+            } catch (java.time.DateTimeException exception) {
+                throw StudentProjectionValidationException.invalidScope(
+                        "semester date_to has no representable exclusive boundary");
+            }
+        }
+
+        private static void validateOccurrence(
+                ProjectionOccurrence occurrence,
+                ProjectionScope scope,
+                List<ProjectionMembershipInterval> intervals) {
+            if (occurrence == null) {
+                throw StudentProjectionValidationException.invalidMetadata(
+                        "occurrence is null");
+            }
+            requirePositive(occurrence.occurrenceId(), "occurrence id",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.currentLessonId(), "current lesson id",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.assignmentId(), "assignment id",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.semesterId(), "occurrence semester id",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.groupId(), "occurrence group id",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.subjectId(), "subject id",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.assignedTeacherId(), "assigned teacher id",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.generation(), "occurrence generation",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            requirePositive(occurrence.revision(), "occurrence revision",
+                    StudentProjectionValidationException.Kind.INVALID_METADATA);
+            if (!scope.semesterId().equals(occurrence.semesterId())) {
+                throw StudentProjectionValidationException.invalidScope(
+                        "occurrence " + occurrence.occurrenceId()
+                                + " belongs to another semester");
+            }
+            if (occurrence.date() == null
+                    || occurrence.date().isBefore(scope.semesterFrom())
+                    || occurrence.date().isAfter(scope.semesterTo())) {
+                throw StudentProjectionValidationException.invalidScope(
+                        "occurrence " + occurrence.occurrenceId()
+                                + " date is outside the semester");
+            }
+            if (occurrence.subjectName() == null || occurrence.subjectName().isBlank()) {
+                throw StudentProjectionValidationException.invalidMetadata(
+                        "occurrence " + occurrence.occurrenceId() + " has no subject name");
+            }
+            if (occurrence.lessonType() == null) {
+                throw StudentProjectionValidationException.invalidMetadata(
+                        "occurrence " + occurrence.occurrenceId() + " has no lesson type");
+            }
+            if (occurrence.lifecycle() == null) {
+                throw StudentProjectionValidationException.invalidMetadata(
+                        "occurrence " + occurrence.occurrenceId() + " has no lifecycle");
+            }
+            if (occurrence.lifecycle() == ProjectionLifecycle.TRANSFERRED_OUT) {
+                throw StudentProjectionValidationException.lineageMismatch(
+                        "transferred source occurrence " + occurrence.occurrenceId()
+                                + " cannot be a current projection row");
+            }
+            if (occurrence.lessonNumber() == null || occurrence.lessonNumber() <= 0
+                    || occurrence.startsAt() == null || occurrence.endsAt() == null
+                    || !occurrence.startsAt().isBefore(occurrence.endsAt())) {
+                throw StudentProjectionValidationException.invalidMetadata(
+                        "occurrence " + occurrence.occurrenceId()
+                                + " has invalid lesson schedule metadata");
+            }
+            if (occurrence.room() != null && occurrence.room().isBlank()) {
+                throw StudentProjectionValidationException.invalidMetadata(
+                        "occurrence " + occurrence.occurrenceId() + " has a blank room");
+            }
+
+            ProjectionMembershipInterval covering = null;
+            int coveringCount = 0;
+            for (ProjectionMembershipInterval interval : intervals) {
+                if (!occurrence.date().isBefore(interval.dateFrom())
+                        && occurrence.date().isBefore(interval.dateTo())) {
+                    covering = interval;
+                    coveringCount++;
+                }
+            }
+            if (coveringCount == 0) {
+                throw StudentProjectionValidationException.intervalGap(
+                        "occurrence " + occurrence.occurrenceId()
+                                + " date has no resolved membership interval");
+            }
+            if (coveringCount != 1) {
+                throw StudentProjectionValidationException.intervalOverlap(
+                        "occurrence " + occurrence.occurrenceId()
+                                + " date has " + coveringCount + " covering intervals");
+            }
+            if (!covering.groupId().equals(occurrence.groupId())) {
+                throw StudentProjectionValidationException.wrongGroup(
+                        "occurrence " + occurrence.occurrenceId()
+                                + " group does not match its covering interval");
+            }
+        }
+
+        private static Set<Long> validateRoster(
+                Long ownStudentId,
+                List<ProjectionRankParticipant> roster) {
+            Set<Long> rosterIds = new HashSet<>();
+            List<OwnRankCalculator.Participant> acceptedRoster = new ArrayList<>(roster.size());
+            for (ProjectionRankParticipant participant : roster) {
+                if (participant == null) {
+                    throw StudentProjectionValidationException.invalidRoster(
+                            "roster contains null entry");
+                }
+                requirePositive(participant.participantId(), "roster participant id",
+                        StudentProjectionValidationException.Kind.INVALID_ROSTER);
+                if (!rosterIds.add(participant.participantId())) {
+                    throw StudentProjectionValidationException.invalidRoster(
+                            "duplicate roster participant id " + participant.participantId());
+                }
+                acceptedRoster.add(new OwnRankCalculator.Participant(
+                        participant.participantId(), participant.metrics()));
+            }
+            // The accepted calculator owns metric invariants and exact rank
+            // semantics. This call is validation as well as a no-output gate.
+            OwnRankCalculator.calculate(ownStudentId, acceptedRoster);
+            return Set.copyOf(rosterIds);
+        }
+
+        private static void validateMark(
+                ProjectionMark mark,
+                Long ownStudentId,
+                Set<Long> rosterIds,
+                Map<Long, ProjectionOccurrence> occurrencesById) {
+            if (mark == null) {
+                throw StudentProjectionValidationException.invalidMark("mark is null");
+            }
+            requirePositive(mark.occurrenceId(), "mark occurrence id",
+                    StudentProjectionValidationException.Kind.INVALID_MARK);
+            requirePositive(mark.studentId(), "mark participant id",
+                    StudentProjectionValidationException.Kind.INVALID_MARK);
+            requirePositive(mark.generation(), "mark generation",
+                    StudentProjectionValidationException.Kind.INVALID_MARK);
+            if (mark.status() == null) {
+                throw StudentProjectionValidationException.invalidMark(
+                        "mark status is null");
+            }
+            if (mark.status() == AttendanceStatus.FREE_ATTENDANCE) {
+                throw StudentProjectionValidationException.unsupportedAttendanceStatus(
+                        "FREE_ATTENDANCE is not a student mark");
+            }
+            if (!mark.studentId().equals(ownStudentId) && !rosterIds.contains(mark.studentId())) {
+                throw StudentProjectionValidationException.markScopeMismatch(
+                        "mark participant " + mark.studentId()
+                                + " is outside caller and authoritative roster");
+            }
+            ProjectionOccurrence occurrence = occurrencesById.get(mark.occurrenceId());
+            if (occurrence == null) {
+                throw StudentProjectionValidationException.markScopeMismatch(
+                        "mark references unknown occurrence " + mark.occurrenceId());
+            }
+            if (!mark.generation().equals(occurrence.generation())) {
+                throw StudentProjectionValidationException.generationMismatch(
+                        "mark " + markKey(mark) + " is from an old/current-mismatched generation");
+            }
+        }
+
+        private static void requirePositive(
+                Long value,
+                String name,
+                StudentProjectionValidationException.Kind kind) {
+            if (value == null || value <= 0) {
+                throw new StudentProjectionValidationException(
+                        kind, name + " must be a positive authoritative id/value");
+            }
+        }
+
+        private static String markKey(ProjectionMark mark) {
+            return "(" + mark.occurrenceId() + "," + mark.studentId()
+                    + "," + mark.generation() + ")";
+        }
+
+        private record MarkKey(Long occurrenceId, Long studentId, Long generation) {
+        }
+    }
+}
