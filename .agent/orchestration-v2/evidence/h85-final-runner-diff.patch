+function New-DeterministicScheduleSeed {
+    param(
+        [Parameter(Mandatory = $true)][string]$AcademicContainerId,
+        [Parameter(Mandatory = $true)][long]$GroupId,
+        [Parameter(Mandatory = $true)][long]$SemesterId,
+        [Parameter(Mandatory = $true)][long]$SubjectId,
+        [Parameter(Mandatory = $true)][long]$AssignmentId
+    )
+
+    Assert-That (Test-Path -LiteralPath $script:seedSchedulePath -PathType Leaf) 'accepted Schedule seed is missing before derivation'
+    Assert-That (-not [string]::IsNullOrWhiteSpace($script:runDir)) 'owned run directory is missing before seed derivation'
+    Assert-That (Test-Path -LiteralPath $script:runDir -PathType Container) 'owned run directory does not exist before seed derivation'
+
+    $acceptedSeedHash = Get-Sha256Hex -Path $script:seedSchedulePath
+    $expectedSeedHash = 'cf8f55e2fbc2fbb5ffd3d8073cba3b7136b4fae84f9123f012b9da7995c705ae'
+    Assert-That ($acceptedSeedHash -ceq $expectedSeedHash) 'accepted Schedule seed is not the frozen deterministic fixture source'
+    Assert-That ([string]$script:report.source.acceptedScheduleSeed.sha256 -ceq $expectedSeedHash) 'source validation reported an unexpected accepted Schedule seed digest'
+
+    # The Academic seed owns the date window. Capture tomorrow exactly once
+    # before deriving the disposable Schedule seed.
+    $academicWindowSql = @"
+SET TIME ZONE 'Europe/Moscow';
+SELECT
+    CASE WHEN EXISTS (
+        SELECT 1
+        FROM semesters semester
+        JOIN assignments assignment ON assignment.semester_id = semester.id
+        WHERE semester.id = $SemesterId
+          AND assignment.id = $AssignmentId
+          AND assignment.group_id = $GroupId
+          AND assignment.subject_id = $SubjectId
+          AND semester.is_active
+          AND (CURRENT_DATE + 1) BETWEEN semester.date_from AND semester.date_to
+          AND assignment.valid_from <= CURRENT_DATE + 1
+          AND (assignment.valid_until_exclusive IS NULL OR CURRENT_DATE + 1 < assignment.valid_until_exclusive)
+    ) THEN 'true' ELSE 'false' END
+    || '|' || (CURRENT_DATE + 1)::text
+    || '|' || COALESCE((SELECT date_from::text FROM semesters WHERE id = $SemesterId), '')
+    || '|' || COALESCE((SELECT date_to::text FROM semesters WHERE id = $SemesterId), '')
+    || '|' || COALESCE((SELECT valid_from::text FROM assignments WHERE id = $AssignmentId), '')
+    || '|' || COALESCE((SELECT valid_until_exclusive::text FROM assignments WHERE id = $AssignmentId), '');
+"@
+    $academicWindow = Read-PsqlScalar -ContainerId $AcademicContainerId -Database academic_db -Purpose 'verify deterministic seed date window' -Sql $academicWindowSql
+    $windowParts = $academicWindow.Split('|')
+    Assert-That ($windowParts.Count -eq 6 -and $windowParts[0] -eq 'true') 'tomorrow Moscow is outside the owned Academic semester or assignment interval'
+    $targetDate = $windowParts[1]
+    Assert-That ($targetDate -match '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') 'Academic seed target date is malformed'
+
+    $acceptedSeedText = [IO.File]::ReadAllText($script:seedSchedulePath)
+    $currentDateCount = [regex]::Matches($acceptedSeedText, '\bCURRENT_DATE\b').Count
+    $activeLiteralCount = [regex]::Matches($acceptedSeedText, "'active'").Count
+    Assert-That ($currentDateCount -eq 9) "accepted Schedule seed CURRENT_DATE token count changed: expected 9, got $currentDateCount"
+    Assert-That ($activeLiteralCount -eq 2) "accepted Schedule seed active literal count changed: expected 2, got $activeLiteralCount"
+
+    $targetDateSql = "DATE '$targetDate'"
+    $derivedSeedText = $acceptedSeedText.Replace('CURRENT_DATE', $targetDateSql).Replace("'active'", "'planned'")
+    Assert-That ([regex]::Matches($derivedSeedText, '\bCURRENT_DATE\b').Count -eq 0) 'derived Schedule seed retained an untransformed CURRENT_DATE dependency'
+    Assert-That ([regex]::Matches($derivedSeedText, [regex]::Escape($targetDateSql)).Count -eq $currentDateCount) 'derived Schedule seed date substitution count is incomplete'
+    Assert-That ([regex]::Matches($derivedSeedText, "'planned'").Count -eq $activeLiteralCount) 'derived Schedule seed active-to-planned substitution count is incomplete'
+
+    $derivedSeedPath = Join-Path $script:runDir 'seed-schedule-deterministic.sql'
+    if (Test-Path -LiteralPath $derivedSeedPath -PathType Leaf) {
+        throw "refusing to overwrite existing derived Schedule seed: $derivedSeedPath"
+    }
+    [IO.File]::WriteAllText($derivedSeedPath, $derivedSeedText, [Text.UTF8Encoding]::new($false))
+    $writtenSeedText = [IO.File]::ReadAllText($derivedSeedPath)
+    Assert-That ([regex]::Matches($writtenSeedText, '\bCURRENT_DATE\b').Count -eq 0) 'written derived Schedule seed retained an untransformed CURRENT_DATE dependency'
+    Assert-That ([regex]::Matches($writtenSeedText, [regex]::Escape($targetDateSql)).Count -eq $currentDateCount) 'written derived Schedule seed date substitution count changed'
+    Assert-That ([regex]::Matches($writtenSeedText, "'planned'").Count -eq $activeLiteralCount) 'written derived Schedule seed active-to-planned count changed'
+
+    $targetDateValue = [DateTime]::ParseExact($targetDate, 'yyyy-MM-dd', [Globalization.CultureInfo]::InvariantCulture)
+    $targetDayOfWeek = [int]$targetDateValue.DayOfWeek
+    if ($targetDayOfWeek -eq 0) { $targetDayOfWeek = 7 }
+    return [ordered]@{
+        path = $derivedSeedPath
+        acceptedPath = $script:seedSchedulePath
+        acceptedSha256 = $acceptedSeedHash
+        derivedSha256 = Get-Sha256Hex -Path $derivedSeedPath
+        targetDate = $targetDate
+        targetDayOfWeek = $targetDayOfWeek
+        timezone = 'Europe/Moscow'
+        academicSemesterDateFrom = $windowParts[2]
+        academicSemesterDateTo = $windowParts[3]
+        assignmentValidFrom = $windowParts[4]
+        assignmentValidUntilExclusive = if ([string]::IsNullOrWhiteSpace($windowParts[5])) { $null } else { $windowParts[5] }
+        currentDateSubstitutions = $currentDateCount
+        activeToPlannedSubstitutions = $activeLiteralCount
+        academicDateGuard = 'PASS'
+    }
+}
