{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson.reminder",
  "description": "Напоминание об отметке во время активной пары. Публикуется Schedule Service раз на пару при достижении середины (LessonReminderJob, V15: lessons.reminder_midpoint_sent_at). Per-user фильтрация (студент уже отметился — не слать) выполняется потребителями (notification-bot через Redis, фронт через локальный attendance state).",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "lesson.reminder"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "lesson_id",
        "group_id",
        "subject_id",
        "lesson_number",
        "start_time",
        "end_time",
        "phase"
      ],
      "properties": {
        "lesson_id": {
          "type": "integer"
        },
        "group_id": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "lesson_number": {
          "$ref": "_common.json#/$defs/lessonNumber"
        },
        "start_time": {
          "type": "string",
          "format": "time"
        },
        "end_time": {
          "type": "string",
          "format": "time"
        },
        "room": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": ["midpoint", "near_end"],
          "description": "Фаза напоминания. Сейчас публикуется только midpoint; near_end зарезервирован."
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (schedule-service)."
    }
  }
}
