@import '../../styles/tokens.pcss';
.headman-group { --rct-group-accent-soft:#32135e; --rct-group-switch-on:#14a885; display:grid; align-content:start; gap:var(--rct-space-4); max-inline-size:calc(var(--rct-mobile-content-width) + var(--rct-space-4) * 2); margin-inline:auto; padding:var(--rct-space-4) var(--rct-space-4) 8rem; color:var(--rct-color-text-primary); }
.headman-group__header { display:flex; align-items:center; gap:var(--rct-space-3); min-block-size:2.75rem; margin-block-end:var(--rct-space-1); }
.headman-group__header h1 { margin:0; flex:1; font-size:1.375rem; line-height:2rem; font-weight:var(--rct-font-weight-bold); }
.headman-group[data-group-view='list'] h1 { font-size:var(--rct-font-size-title-screen); text-align:center; }
.headman-group button { font:inherit; cursor:pointer; @mixin rct-focus-ring; }
.headman-group button:disabled { cursor:default; opacity:.55; }
.headman-group__back { display:grid; place-items:center; flex:0 0 2.75rem; min-block-size:2.75rem; padding:0; border:0; border-radius:var(--rct-radius-full); background:var(--rct-color-surface-raised); color:var(--rct-color-text-primary); }
.headman-group__back svg { inline-size:1rem; block-size:1rem; }
.headman-group__count { margin:0; font-size:var(--rct-font-size-caption); color:var(--rct-color-text-secondary); }
.headman-group__search { display:flex; align-items:center; gap:var(--rct-space-2); min-block-size:2.75rem; border:var(--rct-border-hairline) solid var(--rct-color-border-default); border-radius:var(--rct-radius-xl); padding-inline:var(--rct-space-3); background:var(--rct-color-surface-raised); }
.headman-group__search svg { inline-size:1rem; block-size:1rem; flex-shrink:0; }
.headman-group__search input { font:inherit; color:var(--rct-color-text-primary); background:transparent; border:0; min-inline-size:0; inline-size:100%; min-block-size:2.75rem; @mixin rct-focus-ring; }
.headman-group__list { display:grid; gap:var(--rct-space-1); }
.headman-group__member { position:relative; display:flex; align-items:center; justify-content:space-between; gap:var(--rct-space-3); min-block-size:3.5rem; border:0; border-radius:var(--rct-radius-xl); padding:.375rem .875rem; background:var(--rct-color-surface-raised); color:var(--rct-color-text-primary); text-align:start; overflow:hidden; }
.headman-group__member strong { display:block; font-size:.9375rem; line-height:1.375rem; font-weight:var(--rct-font-weight-medium); overflow-wrap:anywhere; }
.headman-group__member small { display:block; font-size:var(--rct-font-size-micro); line-height:1.125rem; color:var(--rct-color-text-secondary); }
.headman-group__member > svg, .headman-group__configure svg { inline-size:1rem; block-size:1rem; flex-shrink:0; transform:rotate(-90deg); }
.headman-group__member[data-role='Староста']::before, .headman-group__member[data-role='Помощник старосты']::before { content:''; position:absolute; inset-inline-start:0; inset-block:.5rem; inline-size:.25rem; border-radius:var(--rct-radius-full); background:var(--rct-color-accent-now); }
.headman-group__member[data-role='Помощник старосты']::before { background:var(--rct-color-success-text); }
.headman-group__identity, .headman-group__summary { display:grid; align-content:center; gap:var(--rct-space-2); min-block-size:5.625rem; padding:.875rem; border-radius:var(--rct-radius-xl); background:var(--rct-color-surface-raised); }
.headman-group__identity h2 { font-size:1.25rem; line-height:1.625rem; margin:0; overflow-wrap:anywhere; }
.headman-group__identity p, .headman-group__summary p { margin:0; color:var(--rct-color-text-secondary); font-size:var(--rct-font-size-dense); }
.headman-group__summary { min-block-size:5rem; }
.headman-group__summary h2 { margin:0; font-size:.9375rem; }
.headman-group[data-group-view='permissions'] .headman-group__identity { min-block-size:7rem; gap:var(--rct-space-4); }
.headman-group[data-group-view='permissions'] .headman-group__identity h2 { font-size:var(--rct-font-size-title); }
.headman-group__configure, .headman-group__dirty { display:flex; align-items:center; justify-content:space-between; gap:var(--rct-space-3); min-block-size:3rem; padding:.875rem; margin:0; border:0; border-radius:var(--rct-radius-xl); background:var(--rct-group-accent-soft); color:var(--rct-color-text-primary); font-weight:var(--rct-font-weight-bold); }
.headman-group__dirty { min-block-size:2.75rem; font-size:var(--rct-font-size-caption); }
.headman-group__permissions { display:grid; gap:var(--rct-space-2); }
.headman-group__permission { display:flex; align-items:center; gap:var(--rct-space-2); min-block-size:5rem; padding:.875rem; border-radius:var(--rct-radius-xl); background:var(--rct-color-surface-raised); }
.headman-group__permission-name { flex:1; min-inline-size:0; font-size:.9375rem; line-height:1.25rem; overflow-wrap:anywhere; }
.headman-group__permission-status { font-size:var(--rct-font-size-micro); color:var(--rct-color-danger-text); }
.headman-group__permission-status[data-enabled='true'] { color:var(--rct-color-success-text); }
.headman-group__switch { display:grid; place-items:center; flex:0 0 3.25rem; min-block-size:2.75rem; border:0; padding:0; background:transparent; }
.headman-group__switch > span { position:relative; display:block; inline-size:2.5rem; block-size:1.25rem; border-radius:var(--rct-radius-full); background:var(--rct-color-danger-fill); }
.headman-group__switch > span::after { content:''; position:absolute; inset-block:.125rem; inset-inline-start:.125rem; inline-size:1rem; border-radius:var(--rct-radius-full); background:var(--rct-color-text-on-fill-strong); }
.headman-group__switch[aria-checked='true'] > span { background:var(--rct-group-switch-on); }
.headman-group__switch[aria-checked='true'] > span::after { inset-inline-start:1.375rem; }
.headman-group__footer { position:sticky; inset-block-end:var(--rct-space-4); margin-block-start:var(--rct-space-6); background:var(--rct-color-surface-base); padding-block:var(--rct-space-2); }
.headman-group__primary { inline-size:100%; min-block-size:3rem; padding:var(--rct-space-3); border:0; border-radius:var(--rct-radius-xl); font-weight:var(--rct-font-weight-bold); color:var(--rct-color-accent-on-now); background:var(--rct-color-accent-now); }
.headman-group__field { display:grid; gap:var(--rct-space-2); }
.headman-group__field select { min-block-size:2.75rem; min-inline-size:0; border:var(--rct-border-hairline) solid var(--rct-color-border-default); border-radius:var(--rct-radius-xl); padding:var(--rct-space-2); color:var(--rct-color-text-primary); background:var(--rct-color-surface-raised); font:inherit; }
.headman-group__dialog-actions { display:flex; flex-wrap:wrap; gap:var(--rct-space-2); }
.headman-group__dialog-actions button { flex:1 1 7rem; min-block-size:3rem; border:0; border-radius:var(--rct-radius-xl); padding:var(--rct-space-3); }
.headman-group__notice { margin:0; color:var(--rct-color-success-text); }
@media (max-width:22rem) { .headman-group__permission { flex-wrap:wrap; } .headman-group__permission-name { flex-basis:100%; } .headman-group__permission-status { margin-inline-start:auto; } }

.headman-group[data-group-view='permissions'] { display:flex; flex-direction:column; min-block-size:100dvh; padding-block-end:var(--rct-space-4); }
.headman-group[data-group-view='permissions'] .headman-group__footer { margin-block-start:auto; }
.headman-group__dirty, .headman-group__configure { color:var(--rct-color-text-on-fill-strong); }

.headman-group__member[data-role='Студент'] { min-block-size:2.75rem; }
