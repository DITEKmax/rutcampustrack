}
:where([data-student-ui]) .attendance-week-pager__metadata,
:where([data-student-ui]):is(.attendance-week-pager__metadata) {
  color: var(--rct-color-text-secondary);
}
:where([data-student-ui]) .attendance-period-pager button,
:where([data-student-ui]):is(.attendance-period-pager button) {
  display: grid;
  place-items: center;
}
:where([data-student-ui]) .attendance-period-pager__next,
:where([data-student-ui]):is(.attendance-period-pager__next) {
  transform: rotate(180deg);
}
:where([data-student-ui]) .attendance-period-pager button:enabled:hover,
:where([data-student-ui]):is(.attendance-period-pager button:enabled:hover) {
