{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "group.promotion.completed",
  "description": "Один итог первой применённой партии автоматического цикла; не итог всех групп цикла.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "traceparent": {"$ref": "_common.json#/$defs/traceparent"},
    "request_id": {"$ref": "_common.json#/$defs/requestId"},
    "event_type": {
      "const": "group.promotion.completed"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "cycle_semester_id",
        "cycle_date_to",
        "promoted",
        "graduated",
        "skipped"
      ],
      "properties": {
        "cycle_semester_id": {
          "type": "integer",
          "minimum": 1
        },
        "cycle_date_to": {
          "type": "string",
          "format": "date"
        },
        "promoted": {
          "type": "integer",
          "minimum": 0
        },
        "graduated": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "actor_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "event_version": {
      "const": 1
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
