@import '../../../../shared/foundation/mixins.pcss';

.web-map {
  --web-map-height: 37.5rem;
  --web-map-picker-width: 22.5rem;
  --web-map-control-width: 4rem;
  --web-map-control-height: 2.75rem;
  gap: var(--rct-space-6);
  min-inline-size: 0;
}
.web-map-pickers {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-6);
}
.web-map-pickers .web-field {
  flex: 0 1 var(--web-map-picker-width);
  min-inline-size: 0;
  margin: 0;
}
.web-map-pickers select {
  inline-size: 100%;
}
.web-map-viewer {
  position: relative;
  block-size: var(--web-map-height);
  border: var(--rct-border-hairline) solid var(--color-border-default);
  border-radius: var(--rct-radius-2xl);
  overflow: hidden;
}
.web-map-viewport {
  inline-size: 100%;
  block-size: 100%;
  overflow: auto;
  @mixin rct-focus-ring;
}
.web-map-canvas {
  inline-size: calc(100% * var(--web-map-zoom, 1));
  block-size: calc(100% * var(--web-map-zoom, 1));
  min-inline-size: 100%;
  min-block-size: 100%;
  padding: var(--rct-space-4);
}
.web-map-canvas img {
  display: block;
  inline-size: 100%;
  block-size: 100%;
  max-inline-size: none;
  object-fit: contain;
  user-select: none;
}
.web-map-zoomed {
  cursor: grab;
}
.web-map-zoomed:active {
  cursor: grabbing;
}
.web-map-controls {
  position: absolute;
  inset-block-start: var(--rct-space-4);
  inset-inline-end: var(--rct-space-4);
  display: flex;
  flex-direction: column;
  gap: var(--rct-space-2);
}
.web-map-controls .web-button {
  inline-size: var(--web-map-control-width);
  min-block-size: var(--web-map-control-height);
  border-radius: var(--rct-radius-lg);
  font-size: var(--rct-font-size-title);
  padding: var(--rct-space-1);
  background: var(--color-surface-raised);
}
.web-map-scale {
  position: absolute;
  inset-block-end: var(--rct-space-4);
  inset-inline-end: var(--rct-space-4);
  padding: var(--rct-space-1) var(--rct-space-2);
  border-radius: var(--rct-radius-md);
  background: var(--color-surface-raised);
  pointer-events: none;
}
.web-map-state {
  padding: var(--rct-space-6);
}
.web-map-downloads {
  display: grid;
  gap: var(--rct-space-3);
}
.web-map-downloads a {
  text-decoration: underline;
  overflow-wrap: anywhere;
}
@mixin rct-compact {
  .web-map-pickers {
    flex-direction: column;
    gap: var(--rct-space-4);
  }
  .web-map-pickers .web-field {
    flex: auto;
    inline-size: 100%;
  }
}
