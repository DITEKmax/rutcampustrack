@import '../../styles/tokens.pcss';
.teacher-journal { display: grid; gap: var(--rct-space-4); box-sizing: border-box; min-inline-size: 0; inline-size: 100%; max-inline-size: var(--rct-today-content-max); margin-inline: auto; padding: var(--rct-space-5) var(--rct-space-4) var(--rct-today-bottom-space); color: var(--rct-color-text-primary); font-family: var(--rct-font-family-sans); font-variant-numeric: tabular-nums; }
.teacher-journal *, .teacher-journal *::before, .teacher-journal *::after { box-sizing: border-box; }
.teacher-journal h1, .teacher-journal p { margin: 0; overflow-wrap: anywhere; }
.teacher-journal h1 { min-inline-size: 0; font-size: var(--rct-font-size-title-screen); line-height: var(--rct-leading-tight); }
.teacher-journal h1 small { display: block; margin-block-start: var(--rct-space-1); font-size: var(--rct-font-size-caption); font-weight: var(--rct-font-weight-regular); color: var(--rct-color-text-secondary); }
.teacher-journal__header { display: flex; gap: var(--rct-space-3); align-items: center; }
.teacher-journal button { font: inherit; cursor: pointer; @mixin rct-focus-ring; }
.teacher-journal button:disabled { cursor: not-allowed; opacity: 0.55; }
.teacher-journal__icon { display: grid; place-items: center; flex: none; inline-size: var(--rct-control-min-touch); block-size: var(--rct-control-min-touch); border: 0; border-radius: var(--rct-radius-xl); padding: 0; color: var(--rct-color-text-primary); background: var(--rct-color-surface-raised); }
.teacher-journal__icon .mobile-icon { inline-size: var(--rct-profile-control-icon-size); block-size: var(--rct-profile-control-icon-size); }
.teacher-journal__type-toolbar { display: grid; grid-template-columns: minmax(0, 1fr) var(--rct-control-min-touch); align-items: start; gap: var(--rct-space-2); }
.teacher-journal__types { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--rct-space-1); min-inline-size: 0; }
.teacher-journal__types button { min-inline-size: 0; min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-1); border: 0; border-radius: var(--rct-radius-lg); color: var(--rct-color-text-primary); background: var(--rct-color-surface-raised); font-size: var(--rct-font-size-micro); overflow-wrap: anywhere; }
.teacher-journal__types button[aria-pressed='true'], .teacher-journal__icon[aria-pressed='true'], .teacher-journal__download { color: var(--rct-color-accent-on-now); background: var(--rct-color-accent-now); }
.teacher-journal__types button:disabled { color: var(--rct-color-disabled-text); background: var(--rct-color-disabled-surface); cursor: not-allowed; }
.teacher-journal__state { display: grid; place-items: center; min-block-size: var(--rct-state-min-height); color: var(--rct-color-text-secondary); text-align: center; }
.teacher-journal__table-scroll { min-inline-size: 0; max-inline-size: 100%; overflow-x: auto; border-radius: var(--rct-radius-lg); @mixin rct-focus-ring; }
.teacher-journal__table { border-spacing: 0; border-collapse: separate; inline-size: max-content; min-inline-size: 100%; font-size: var(--rct-font-size-micro); background: var(--rct-color-surface-raised); }
.teacher-journal__table caption { text-align: start; padding: var(--rct-space-2); color: var(--rct-color-text-secondary); }
.teacher-journal__table th, .teacher-journal__table td { padding: var(--rct-space-2); border-block-end: var(--rct-border-hairline) solid var(--rct-color-border-default); text-align: center; }
.teacher-journal__table thead th { color: var(--rct-color-text-secondary); font-weight: var(--rct-font-weight-regular); }
.teacher-journal__table thead th span { display: block; }
.teacher-journal__table .teacher-journal__name { position: sticky; inset-inline-start: 0; z-index: 1; inline-size: var(--rct-teacher-journal-name-width); min-inline-size: var(--rct-teacher-journal-name-width); max-inline-size: var(--rct-teacher-journal-name-width); background: var(--rct-color-surface-raised); text-align: start; white-space: normal; overflow-wrap: anywhere; box-shadow: var(--rct-border-hairline) 0 0 var(--rct-color-border-default); }
.teacher-journal__table td, .teacher-journal__table thead th:not(.teacher-journal__name) { min-inline-size: var(--rct-control-min-touch); }
.teacher-journal__percent { white-space: nowrap; }
.teacher-journal__percent span { display: block; }
.teacher-journal__present { color: var(--rct-color-success-text); }
.teacher-journal__excused { color: var(--rct-color-warning-text); }
.teacher-journal__absent { color: var(--rct-color-danger-text); }
.teacher-journal__mark { display: inline-grid; place-items: center; inline-size: var(--rct-control-min-touch); block-size: var(--rct-control-min-touch); padding: 0; border: 0; border-radius: var(--rct-radius-full); background: transparent; font-weight: var(--rct-font-weight-bold); }
.teacher-journal__mark--present { color: var(--rct-color-success-text); }
.teacher-journal__mark--excused { color: var(--rct-color-warning-text); }
.teacher-journal__mark--absent { color: var(--rct-color-danger-text); }
.teacher-journal__mark--none { color: var(--rct-color-text-secondary); }
.teacher-journal__sr { position: absolute; inline-size: var(--rct-border-hairline); block-size: var(--rct-border-hairline); overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.teacher-journal__chart { display: grid; min-inline-size: 0; gap: var(--rct-space-3); padding: var(--rct-space-2); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-raised); }
.teacher-journal__plot { display: block; inline-size: 100%; block-size: auto; }
.teacher-journal__chart-grid line { stroke: var(--rct-color-border-default); stroke-width: 1; }
.teacher-journal__chart-grid text, .teacher-journal__chart-axis text, .teacher-journal__chart-probe { fill: var(--rct-color-text-secondary); font-family: inherit; font-size: var(--rct-font-size-micro); }
.teacher-journal__chart-probe { visibility: hidden; }
.teacher-journal__plot g[tabindex] { cursor: pointer; @mixin rct-focus-ring; }
.teacher-journal__bar--present { fill: var(--rct-color-success-text); }
.teacher-journal__bar--excused { fill: var(--rct-color-warning-text); }
.teacher-journal__bar--absent { fill: var(--rct-color-danger-text); }
.teacher-journal__legend { display: flex; flex-wrap: wrap; gap: var(--rct-space-2); font-size: var(--rct-font-size-micro); }
.teacher-journal__chart p { font-size: var(--rct-font-size-caption); }
.teacher-journal__export { display: grid; grid-template-columns: minmax(0, 1fr) var(--rct-control-min-touch); align-items: start; gap: var(--rct-space-2); }
.teacher-journal__preparing { display: flex; align-items: center; gap: var(--rct-space-3); padding: var(--rct-space-3); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-float); color: var(--rct-color-text-secondary); }
.teacher-journal__spinner { flex: none; inline-size: var(--rct-progress-size); block-size: var(--rct-progress-size); border: var(--rct-progress-stroke) solid var(--rct-color-border-default); border-inline-start-color: var(--rct-color-accent-now); border-radius: var(--rct-radius-full); animation: teacher-journal-spin 900ms linear infinite; }
@keyframes teacher-journal-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .teacher-journal__spinner { animation: none; } }
