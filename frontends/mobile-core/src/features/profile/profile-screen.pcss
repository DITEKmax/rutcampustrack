}

:where([data-student-ui]) .profile-role-card[data-selected='true'] .profile-role-card__avatar,
:where([data-student-ui]):is(.profile-role-card[data-selected='true'] .profile-role-card__avatar) {
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-base);
}

:where([data-student-ui]) .profile-role-card__copy,
:where([data-student-ui]):is(.profile-role-card__copy) {
  display: grid;
  min-inline-size: 0;
  gap: var(--rct-space-half);
}

:where([data-student-ui]) .profile-role-card__title,
:where([data-student-ui]):is(.profile-role-card__title),
:where([data-student-ui]) .profile-role-card__meta,
:where([data-student-ui]):is(.profile-role-card__meta) {
  overflow-wrap: anywhere;
  margin: 0;
}

:where([data-student-ui]) .profile-role-card__title,
:where([data-student-ui]):is(.profile-role-card__title) {
  font-size: var(--rct-font-size-body);
  font-weight: var(--rct-font-weight-bold);
}

:where([data-student-ui]) .profile-role-card__meta,
:where([data-student-ui]):is(.profile-role-card__meta) {
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

:where([data-student-ui]) .profile-role-card[data-selected='true'] .profile-role-card__meta,
:where([data-student-ui]):is(.profile-role-card[data-selected='true'] .profile-role-card__meta) {
