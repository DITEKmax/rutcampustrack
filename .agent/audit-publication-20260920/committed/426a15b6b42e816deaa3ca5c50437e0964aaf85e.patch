+
+            UUID winnerJti = port.sessions.get(SESSION_ID).currentRefreshJti();
+            SessionStatePort.RefreshResult previous = service.refresh(new SessionLifecycleService.RefreshRequest(
+                    USER_ID, SESSION_ID, INITIAL_JTI,
