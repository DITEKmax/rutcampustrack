}
:where([data-student-ui]) .attendance-subject-list__cards,
:where([data-student-ui]):is(.attendance-subject-list__cards) {
  padding-block: var(--rct-space-5) var(--rct-space-3);
}
:where([data-student-ui]) .attendance-status-badge--active,
:where([data-student-ui]):is(.attendance-status-badge--active) {
