.admin-map-review-catalog { display: flex; flex-wrap: wrap; gap: var(--rct-space-2); padding: var(--rct-space-4); color: var(--rct-color-text-primary); background: var(--rct-color-surface-raised); font-family: var(--rct-font-family-sans); }
.admin-map-review-catalog a { color: var(--rct-color-accent-now); }
.admin-map-review-catalog p { inline-size: 100%; margin: 0; }
