{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "mobile-core/src/**/*.ts",
    "pwa-vue/vite.config.ts",
    "pwa-vue/src/**/*.ts",
    "tma-vue/vite.config.ts",
    "tma-vue/src/**/*.ts"
  ]
}
