@import '../styles/tokens.pcss';
.homework-review-catalog { padding: var(--rct-space-4); overflow-wrap: anywhere; }
.homework-review-catalog a { color: var(--rct-color-accent-now); }
.homework-review-status { position: fixed; z-index: 5; inset: auto var(--rct-space-4) 7rem; margin: 0; border-radius: var(--rct-radius-xl); padding: var(--rct-space-3); background: var(--rct-color-surface-float); color: var(--rct-color-text-primary); overflow-wrap: anywhere; }
