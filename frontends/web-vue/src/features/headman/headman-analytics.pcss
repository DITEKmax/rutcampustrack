.headman-analytics { gap: var(--space-6); min-inline-size: 0; }
.headman-analytics h2 { font-size: var(--font-size-title-block); }
.headman-period-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-3); border: var(--web-border) solid var(--color-border-accent); border-radius: var(--radius-2xl); background: var(--color-surface-raised); }
.headman-period-toolbar .student-period-context { flex: 1 1 50%; inline-size: 100%; border: 0; padding: 0; background: transparent; }
.headman-period-title { flex: 1; padding-inline: var(--space-3); font-size: var(--font-size-dense); font-weight: var(--font-weight-medium); }
.headman-filter-bar { display: flex; align-items: end; flex-wrap: wrap; gap: var(--space-4); padding: var(--space-4); border: var(--web-border) solid var(--color-border-subtle); border-radius: var(--radius-2xl); background: var(--color-surface-raised); }
.headman-filter-bar > .web-field { flex: 1 1 calc(var(--control-height) * 5); min-inline-size: 0; }
.headman-analytics .headman-type-picker { flex: 1 1 calc(var(--control-height) * 6); border: 0; border-radius: 0; padding: 0; margin: 0; }
.headman-type-picker legend { margin-block-end: var(--space-2); padding: 0; font-size: var(--font-size-caption); color: var(--color-text-secondary); }
.headman-type-picker > div { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.headman-choice { position: relative; display: inline-flex; align-items: center; font-size: var(--font-size-dense); }
.headman-choice > input { position: absolute; inline-size: var(--web-border); block-size: var(--web-border); padding: 0; margin: 0; opacity: 0; }
.headman-choice > span { display: inline-flex; align-items: center; justify-content: center; min-block-size: var(--control-height); padding: var(--space-2) var(--space-4); border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-full); color: var(--color-text-primary); background: var(--color-surface-base); cursor: pointer; }
.headman-choice > input:checked + span { border-color: var(--color-accent-now); background: var(--color-accent-now); color: var(--color-accent-on-now); }
.headman-choice > input:focus-visible + span { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: var(--space-1); }
.headman-choice > input:disabled + span, .headman-choice:has(input:disabled) > span { cursor: default; opacity: .55; }
.headman-analytics-scroll { overflow: auto; min-inline-size: 0; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--color-border-accent) 55%, transparent) transparent; overscroll-behavior: contain; }
.headman-analytics-scroll::-webkit-scrollbar { inline-size: var(--space-1); block-size: var(--space-1); }
.headman-analytics-scroll::-webkit-scrollbar-track, .headman-analytics-scroll::-webkit-scrollbar-corner { background: transparent; }
.headman-analytics-scroll::-webkit-scrollbar-thumb { border-radius: var(--radius-full); background: color-mix(in srgb, var(--color-border-accent) 55%, transparent); }
.headman-analytics-scroll::-webkit-scrollbar-button { display: none; inline-size: 0; block-size: 0; }
.headman-analytics-scroll:focus-visible { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: var(--space-1); }
@supports selector(::-webkit-scrollbar) { .headman-analytics-scroll { scrollbar-width: auto; scrollbar-color: auto; } }
.headman-journal-viewport { --journal-column: calc(var(--control-height) * 2); --journal-name: 14rem; overflow-x: auto; overflow-y: hidden; overscroll-behavior-y: auto; border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-2xl); }
.headman-journal-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-5); min-block-size: calc(var(--control-height) * 9); padding: var(--space-8) var(--space-4); text-align: center; color: var(--color-text-secondary); }
.headman-journal-empty > p { margin: 0; }
.headman-journal-grid { table-layout: fixed; inline-size: max(100%, calc(var(--journal-name) + var(--journal-columns) * var(--journal-column))); border-collapse: separate; border-spacing: 0; font-size: var(--font-size-micro); }
.headman-journal-grid :is(th, td) { position: relative; isolation: isolate; padding: 0; border-inline-end: var(--web-border) solid var(--color-border-default); border-block-end: var(--web-border) solid var(--color-border-default); text-align: center; vertical-align: middle; }
.headman-journal-grid .headman-journal-name { position: sticky; inset-inline-start: 0; z-index: 2; inline-size: var(--journal-name); min-inline-size: var(--journal-name); max-inline-size: var(--journal-name); padding-inline: var(--space-3); background: var(--color-surface-base); text-align: start; font-weight: var(--font-weight-medium); }
.headman-journal-grid thead .headman-journal-name { text-align: center; z-index: 3; }
.headman-journal-grid thead th { color: var(--color-text-secondary); background: var(--color-surface-base); font-weight: var(--font-weight-medium); }
.headman-journal-grid thead tr:nth-child(-n+2) th:not(.headman-journal-name) { padding-block: var(--space-1); }
.headman-journal-grid thead tr:nth-child(4) th { padding-block: var(--space-2); }
.headman-journal-grid .is-day-end { border-inline-end: calc(var(--web-border) * 2) solid var(--color-border-strong); }
.headman-journal-grid .is-current { background: var(--color-accent-now); color: var(--color-accent-on-now); }
.headman-journal-subject { display: flex; align-items: center; justify-content: center; inline-size: 100%; block-size: var(--student-attendance-subject-height, 13.3125rem); padding: var(--space-3); border: 0; border-radius: 0; color: inherit; background: transparent; font: inherit; font-weight: var(--font-weight-medium); overflow-wrap: anywhere; cursor: pointer; }
.headman-journal-subject > span { writing-mode: vertical-rl; rotate: 180deg; max-inline-size: 100%; text-align: center; }
.headman-journal-date .web-date-label-trigger > .mobile-icon { display: none; }
.headman-journal-grid :is(.headman-journal-cell, .headman-journal-subject, .headman-journal-type, .headman-journal-name > span) { position: relative; z-index: 1; }
.headman-journal-grid .is-hover-column::before,
.headman-journal-grid .is-hover-row > :is(th, td)::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: color-mix(in srgb, var(--color-accent-now) 12%, transparent); }
.headman-journal-grid .is-hover-row > .is-hover-column::before { background: color-mix(in srgb, var(--color-accent-now) 22%, transparent); }
.headman-journal-grid .is-cancelled::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background-image: repeating-linear-gradient(45deg, transparent, transparent calc(var(--space-1) - var(--web-border) * 1.5), color-mix(in srgb, var(--color-border-default) 55%, transparent) calc(var(--space-1) - var(--web-border) * 1.5), color-mix(in srgb, var(--color-border-default) 55%, transparent) var(--space-1)); }
.headman-journal-grid :is(.headman-journal-cell, .headman-journal-subject):focus-visible { z-index: 3; }
.headman-journal-grid .is-cancelled { background: var(--color-surface-raised); }
.headman-journal-subject:focus-visible { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: calc(-1 * var(--focus-width)); }
.headman-journal-cell { display: inline-flex; align-items: center; justify-content: center; inline-size: 100%; min-block-size: var(--space-8); padding: var(--space-1); border: 0; background: transparent; color: var(--color-text-primary); }
.headman-journal-cell:focus-visible { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: calc(-1 * var(--focus-width)); }
.headman-journal-badge { display: inline-grid; place-items: center; inline-size: var(--space-5); block-size: var(--space-5); flex-shrink: 0; border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-full); background: var(--color-status-none-fill); color: var(--color-status-none-on-fill); font-size: var(--font-size-micro); font-weight: var(--font-weight-medium); }
.headman-journal-badge[data-status='PRESENT'] { background: var(--color-status-present-fill); color: var(--color-status-present-on-fill); border-color: transparent; }
.headman-journal-badge[data-status='EXCUSED'] { background: var(--color-status-excused-fill); color: var(--color-status-excused-on-fill); border-color: transparent; }
.headman-journal-badge[data-status='ABSENT'] { background: var(--color-status-absent-fill); color: var(--color-status-absent-on-fill); border-color: transparent; }
.headman-journal-badge[data-status='ABSENT'].is-auto { border: var(--focus-width) solid var(--color-status-absent-ring); background: transparent; color: var(--color-status-absent-text); }
.headman-journal-badge[data-status='CANCELLED'] { background: transparent; color: var(--color-text-muted); }
.headman-analytics .headman-detail { padding: var(--space-5); border-radius: var(--radius-2xl); }
.headman-analytics .headman-detail form { max-inline-size: calc(var(--control-height) * 18); }
.headman-analytics input[type='file']::file-selector-button { min-block-size: var(--control-height); padding-inline: var(--space-4); margin-inline-end: var(--space-3); border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-full); background: var(--color-surface-base); color: var(--color-text-primary); font: inherit; }
.headman-analytics .headman-list { list-style: none; padding: 0; }
.headman-analytics .headman-list > li { padding-block: var(--space-2); border-block-end: var(--web-border) solid var(--color-border-subtle); }
.headman-metric-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
.headman-metric-card { display: grid; grid-template-columns: minmax(0, 1fr) calc(var(--control-height) * 2 + var(--space-8)); align-items: center; gap: var(--space-3); min-inline-size: 0; min-block-size: calc(var(--control-height) * 4); padding: var(--space-4); border: var(--web-border) solid var(--color-border-subtle); border-radius: var(--radius-2xl); background: var(--color-surface-raised); }
.headman-metric-card > div:first-child { display: grid; gap: var(--space-1); }
.headman-metric-card h2 { font-size: var(--font-size-dense); font-weight: var(--font-weight-medium); }
.headman-donut { position: relative; aspect-ratio: 1; inline-size: 100%; color: var(--color-status-present-text); }
.headman-donut svg { display: block; inline-size: 100%; block-size: 100%; overflow: visible; }
.headman-donut circle { fill: none; stroke-width: 8; }
.headman-donut-track { stroke: var(--color-border-subtle); }
.headman-donut-value { stroke: currentColor; }
.headman-donut > div { position: absolute; inset: var(--space-3); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: var(--space-1); color: var(--color-text-primary); }
.headman-donut strong { font-size: var(--font-size-title-block); font-weight: var(--font-weight-bold); }
.headman-donut span { font-size: var(--font-size-caption); color: var(--color-text-muted); white-space: nowrap; }
.headman-metric-card[data-metric='presentOrExcused'] .headman-donut, .headman-metric-card[data-metric='excused'] .headman-donut { color: var(--color-status-excused-text); }
.headman-metric-card[data-metric='absent'] .headman-donut { color: var(--color-status-absent-text); }
.headman-analytics-footer { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); }
.headman-analytics-footer > .web-field { inline-size: min(100%, calc(var(--control-height) * 6)); }
.headman-stats-viewport { border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-2xl); }
.headman-statistics-table { inline-size: 100%; min-inline-size: calc(var(--control-height) * 30); border-collapse: separate; border-spacing: 0; font-size: var(--font-size-dense); }
.headman-statistics-table :is(th, td) { padding: var(--space-2); border-inline-end: var(--web-border) solid var(--color-border-subtle); border-block-end: var(--web-border) solid var(--color-border-subtle); text-align: center; }
.headman-statistics-table thead th { background: var(--color-surface-raised); color: var(--color-text-secondary); font-size: var(--font-size-caption); font-weight: var(--font-weight-medium); }
.headman-statistics-table > thead > tr > th { border-inline-end-color: var(--color-border-default); }
.headman-statistics-table > thead > tr:first-child > :is(:nth-child(5), :nth-child(6), :nth-child(7)),
.headman-statistics-table > thead > tr:nth-child(2) > :is(:nth-child(3), :nth-child(6)),
.headman-statistics-table > tbody > tr:not(.headman-student-reveal) > :is(:nth-child(5), :nth-child(8), :nth-child(11)) { border-inline-end: calc(var(--web-border) * 2) solid var(--color-border-strong); }
.headman-statistics-table thead button { border: 0; padding: 0; font: inherit; background: transparent; color: inherit; cursor: pointer; }
.headman-statistics-table .headman-stats-name { position: sticky; inset-inline-start: 0; z-index: 1; inline-size: calc(var(--control-height) * 6); min-inline-size: calc(var(--control-height) * 6); text-align: start; background: var(--color-surface-base); }
.headman-statistics-table thead .headman-stats-name { background: var(--color-surface-raised); }
.headman-statistics-table tbody td { block-size: calc(var(--control-height) + var(--space-4)); }
.headman-statistics-table td > strong { display: block; font-size: var(--font-size-dense); font-weight: var(--font-weight-medium); }
.headman-statistics-table td > small { display: block; color: var(--color-text-muted); font-size: var(--font-size-caption); }
.headman-student-trigger { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); inline-size: 100%; min-block-size: var(--control-height); padding: 0; border: 0; border-radius: 0; font: inherit; text-align: start; background: transparent; color: inherit; cursor: pointer; }
.headman-student-trigger svg { flex-shrink: 0; }
.headman-student-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
.headman-statistics-table .is-selected > :is(th, td) { background: var(--color-accent-now); color: var(--color-accent-on-now); }
.headman-statistics-table .is-selected td > small { color: inherit; }
.headman-student-reveal > td { text-align: start; padding: var(--space-4); }
.headman-student-reveal > td > .headman-panel { padding: 0; border: 0; background: transparent; }
.headman-student-reveal .headman-table-scroll { border-radius: var(--radius-xl); }
@media (width < 80rem) { .headman-metric-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (width < 40rem) { .headman-metric-cards { grid-template-columns: minmax(0, 1fr); } .headman-period-toolbar .student-period-context { flex-basis: 100%; } }

.headman-journal-types > div { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.headman-journal-types .headman-choice, .headman-journal-types .headman-choice > span { inline-size: 100%; min-inline-size: 0; }
.headman-journal-types :is(.web-button, .headman-choice > span) { padding-inline: var(--space-2); text-align: center; }
.headman-journal-mark-actions { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; min-block-size: var(--space-8); padding: var(--space-1); }
.headman-journal-mark-control { display: grid; place-items: center; inline-size: var(--space-6); block-size: var(--space-8); flex-shrink: 0; padding: 0; border: 0; border-radius: var(--radius-full); background: transparent; color: inherit; cursor: pointer; }
.headman-journal-mark-control .headman-journal-badge { inline-size: var(--space-6); block-size: var(--space-6); font-size: var(--font-size-caption); }
.headman-journal-badge.is-neutral { background: var(--color-surface-inverse); color: var(--color-text-on-inverse); border-color: var(--color-border-default); }
[data-theme='light'] .headman-journal-badge.is-neutral { background: var(--color-status-none-fill); color: var(--color-status-none-on-fill); }
.headman-journal-mark-actions.has-mark .is-neutral, .headman-journal-cell.is-future .headman-journal-badge { opacity: .12; }
.headman-journal-mark-control:is(:hover, :focus-visible) .is-neutral { opacity: 1; }
.headman-journal-mark-control:focus-visible { position: relative; z-index: 3; outline: var(--focus-width) solid var(--color-border-focus); outline-offset: 0; }
.headman-journal-mark-actions:focus-within { z-index: 3; }
.headman-journal-mark-control:disabled { cursor: default; opacity: .6; }
.headman-journal-excuse-dialog { overflow-wrap: anywhere; }
.headman-journal-excuse-dialog h2 { font-size: var(--font-size-title-block); }
.headman-page .headman-journal-excuse-fields { display: grid; gap: var(--space-4); padding: 0; border: 0; }
.headman-journal-excuse-dialog .web-confirm-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.headman-journal-recovery { display: grid; gap: var(--space-3); }
.headman-page .headman-journal-export-weeks { border: 0; padding: 0; }
.headman-journal-export-weeks legend { margin-block-end: var(--space-3); font-size: var(--font-size-caption); color: var(--color-text-secondary); }
.headman-journal-export-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(calc(var(--control-height) * 4), 1fr)); gap: var(--space-2); }
.headman-journal-export-grid .headman-choice, .headman-journal-export-grid .headman-choice > span { inline-size: 100%; min-inline-size: 0; }
.headman-journal-export-grid .headman-choice > span { min-block-size: var(--control-height); text-align: center; }
.headman-journal-export-download { display: flex; justify-content: flex-end; }
.headman-journal-export-download > .web-stack { align-items: end; }
.headman-journal-export-download .web-stack > .web-button:first-child { background: var(--color-surface-inverse); color: var(--color-text-on-inverse); border-color: var(--color-surface-inverse); }

.headman-statistics-filters > .headman-statistics-types { flex: 1.5 1 calc(var(--control-height) * 8); }
.headman-statistics-types > div { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
.headman-statistics-types .headman-choice, .headman-statistics-types .headman-choice > span { inline-size: 100%; min-inline-size: 0; }
.headman-statistics-types .headman-choice > span { padding-inline: var(--space-2); text-align: center; }
.headman-statistics-filters > .headman-statistics-search { flex: 1.2 1 calc(var(--control-height) * 6); }
.headman-statistics-filters > .web-button { flex: 0 0 auto; }
.headman-statistics-page .student-chart-data { border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-2xl); }
.headman-trend {
  --headman-trend-height: calc(var(--control-height) * 9);
  /* Keep the original table target; plot, labels, padding and rail share that height. */
  --student-chart-height: calc(var(--headman-trend-height) - var(--space-6) - var(--space-2) - var(--space-1));
}
.headman-trend .student-chart-frame,
.headman-trend .student-chart-scroll,
.headman-trend .student-chart-data { block-size: var(--headman-trend-height); }
.headman-trend .student-chart-scroll { overflow-y: hidden; }
.headman-trend .student-chart-data { max-block-size: var(--headman-trend-height); }

.headman-student-requests > li { display: grid; gap: var(--space-1); }
.headman-student-request-number { justify-self: start; font-weight: var(--font-weight-medium); }
.headman-statistics-format > label { position: absolute; inline-size: var(--web-border); block-size: var(--web-border); padding: 0; margin: calc(-1 * var(--web-border)); overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.headman-statistics-page .headman-statistics-results { gap: var(--space-2); }
.headman-statistics-page .headman-statistics-table-footer { align-items: center; gap: var(--space-2); }
.headman-statistics-trend-download { margin-inline-start: auto; }

.headman-statistics-filters > .headman-statistics-reset { align-self: end; min-block-size: var(--control-height); background: color-mix(in srgb, var(--color-surface-raised) 90%, var(--color-text-primary)); color: var(--color-text-primary); border-color: transparent; }
.headman-statistics-filters > .headman-statistics-reset:hover:not(:disabled) { background: color-mix(in srgb, var(--color-surface-raised) 84%, var(--color-text-primary)); }
.headman-statistics-export-controls { align-items: start; }
