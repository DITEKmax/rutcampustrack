+package ru.rutcampustrack.attendance.report.studentprojection;
+
+import java.util.Objects;
+
+/** Typed fail-closed error for the pure projection input boundary. */
+public final class StudentProjectionValidationException extends RuntimeException {
+
+    public enum Kind {
+        INVALID_INPUT,
+        INVALID_SCOPE,
+        INVALID_INTERVAL,
+        INTERVAL_GAP,
+        INTERVAL_OVERLAP,
+        WRONG_GROUP,
+        INVALID_METADATA,
+        DUPLICATE_OCCURRENCE,
+        LINEAGE_MISMATCH,
+        INVALID_MARK,
+        DUPLICATE_MARK,
+        MARK_SCOPE_MISMATCH,
+        GENERATION_MISMATCH,
+        UNSUPPORTED_ATTENDANCE_STATUS,
+        INVALID_ROSTER,
+        INVALID_RANGE,
+        INVALID_SELECTED_TYPES,
+        SUBJECT_NOT_FOUND
+    }
+
+    private final Kind kind;
+
+    public StudentProjectionValidationException(Kind kind, String message) {
+        super(Objects.requireNonNull(message, "message"));
+        this.kind = Objects.requireNonNull(kind, "kind");
+    }
+
+    public Kind kind() {
+        return kind;
+    }
+
+    public Kind reason() {
+        return kind;
+    }
+
+    static StudentProjectionValidationException invalidInput(String detail) {
+        return error(Kind.INVALID_INPUT, detail);
+    }
+
+    static StudentProjectionValidationException invalidScope(String detail) {
+        return error(Kind.INVALID_SCOPE, detail);
+    }
+
+    static StudentProjectionValidationException invalidInterval(String detail) {
+        return error(Kind.INVALID_INTERVAL, detail);
+    }
+
+    static StudentProjectionValidationException intervalGap(String detail) {
+        return error(Kind.INTERVAL_GAP, detail);
+    }
+
+    static StudentProjectionValidationException intervalOverlap(String detail) {
+        return error(Kind.INTERVAL_OVERLAP, detail);
+    }
+
+    static StudentProjectionValidationException wrongGroup(String detail) {
+        return error(Kind.WRONG_GROUP, detail);
+    }
+
+    static StudentProjectionValidationException invalidMetadata(String detail) {
+        return error(Kind.INVALID_METADATA, detail);
+    }
+
+    static StudentProjectionValidationException duplicateOccurrence(String detail) {
+        return error(Kind.DUPLICATE_OCCURRENCE, detail);
+    }
+
+    static StudentProjectionValidationException lineageMismatch(String detail) {
+        return error(Kind.LINEAGE_MISMATCH, detail);
+    }
+
+    static StudentProjectionValidationException invalidMark(String detail) {
+        return error(Kind.INVALID_MARK, detail);
+    }
+
+    static StudentProjectionValidationException duplicateMark(String detail) {
+        return error(Kind.DUPLICATE_MARK, detail);
+    }
+
+    static StudentProjectionValidationException markScopeMismatch(String detail) {
+        return error(Kind.MARK_SCOPE_MISMATCH, detail);
+    }
+
+    static StudentProjectionValidationException generationMismatch(String detail) {
+        return error(Kind.GENERATION_MISMATCH, detail);
+    }
+
+    static StudentProjectionValidationException unsupportedAttendanceStatus(String detail) {
+        return error(Kind.UNSUPPORTED_ATTENDANCE_STATUS, detail);
+    }
+
+    static StudentProjectionValidationException invalidRoster(String detail) {
+        return error(Kind.INVALID_ROSTER, detail);
+    }
+
+    static StudentProjectionValidationException invalidRange(String detail) {
+        return error(Kind.INVALID_RANGE, detail);
+    }
+
+    static StudentProjectionValidationException invalidSelectedTypes(String detail) {
+        return error(Kind.INVALID_SELECTED_TYPES, detail);
+    }
+
+    static StudentProjectionValidationException subjectNotFound(String detail) {
+        return error(Kind.SUBJECT_NOT_FOUND, detail);
+    }
+
+    private static StudentProjectionValidationException error(Kind kind, String detail) {
+        return new StudentProjectionValidationException(kind, kind + ": " + detail);
+    }
+}
