}

:where([data-student-ui]) .profile-role-card__status,
:where([data-student-ui]):is(.profile-role-card__status) {
  margin-inline-start: auto;
  color: inherit;
  font-size: var(--rct-font-size-micro);
  text-align: end;
}

:where([data-student-ui]) .profile-theme-group,
:where([data-student-ui]):is(.profile-theme-group) {
  display: grid;
  gap: var(--rct-space-2);
  border: 0;
