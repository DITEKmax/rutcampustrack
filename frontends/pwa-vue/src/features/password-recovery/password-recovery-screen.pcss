.password-recovery-screen .recovery-content {
  overflow-wrap: anywhere;
}

.password-recovery-screen .recovery-meta {
  margin: 0;
}

.password-recovery-screen .recovery-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  column-gap: var(--rct-space-2);
  margin-block-start: var(--rct-space-2);
}

.password-recovery-screen .recovery-quiet-button {
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-md);
  padding: var(--rct-space-2) var(--rct-space-3);
  background: transparent;
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-dense);
  line-height: var(--rct-leading-normal);
  text-decoration: underline;
}

.password-recovery-screen .recovery-quiet-button:hover:not(:disabled) {
  color: var(--rct-color-text-primary);
}

.password-recovery-screen .recovery-quiet-button:disabled {
  color: var(--rct-color-disabled-text);
}

.password-recovery-screen .recovery-help {
  margin: var(--rct-space-3) 0 0;
}

@media (height < 40rem) {
  .rct-auth.password-recovery-screen {
    padding-block: max(var(--rct-space-3), env(safe-area-inset-top))
      max(var(--rct-space-3), env(safe-area-inset-bottom));
  }
}
