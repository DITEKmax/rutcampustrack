@import '../../../../shared/foundation/mixins.pcss';

.admin-page {
  --admin-panel-width: 48rem;
  --admin-table-min: 52rem;
  --admin-card-min: 14rem;
  --admin-panel-pad: var(--space-4);
  display: grid;
  gap: var(--space-5);
  min-inline-size: 0;
}
.admin-heading,
.admin-toolbar,
.admin-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3);
}
.admin-heading {
  justify-content: space-between;
}
.admin-toolbar {
  padding: var(--space-3);
  background: var(--color-surface-raised);
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  align-items: end;
}
.admin-toolbar .web-field {
  flex: 1 1 var(--admin-card-min);
  min-inline-size: 0;
}
.admin-toolbar .admin-search {
  flex-grow: 2;
}
.admin-filter-disclosure {
  flex-basis: 100%;
  min-inline-size: 0;
}
.admin-filter-disclosure > summary {
  padding-block: var(--space-2);
  cursor: pointer;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  overflow-wrap: anywhere;
}
.admin-filter-disclosure > summary small {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}
.admin-filter-disclosure[open] > summary {
  margin-block-end: var(--space-3);
  border-block-end: var(--web-border) solid var(--web-panel-line);
}
.admin-toolbar-detail {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  gap: var(--space-3);
}
.admin-panel {
  padding: var(--admin-panel-pad);
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  background: var(--color-surface-raised);
  display: grid;
  gap: var(--space-4);
  min-inline-size: 0;
  scroll-margin-block-start: var(--space-6);
}
.admin-form {
  max-inline-size: var(--admin-panel-width);
}
.admin-form-section {
  display: grid;
  gap: var(--space-3);
  padding-block-start: var(--space-3);
  border-block-start: var(--web-border) solid var(--web-panel-line);
  min-inline-size: 0;
}
.admin-compact-field {
  inline-size: min(100%, var(--admin-card-min));
}
.admin-toolbar .admin-compact-field {
  flex: 0 1 var(--admin-card-min);
}
.admin-page fieldset,
.admin-page .admin-picker {
  border: 0;
  padding: 0;
  margin: 0;
  min-inline-size: 0;
}
.admin-page legend {
  padding: 0;
  margin-block-end: var(--space-3);
  font-weight: var(--font-weight-medium);
}
.admin-picker {
  display: grid;
  gap: var(--space-3);
}
.admin-picker summary {
  cursor: pointer;
  inline-size: fit-content;
}
.admin-picker[open] summary {
  margin-block-end: var(--space-3);
}
.admin-page .web-field select,
.admin-page .web-field textarea {
  inline-size: 100%;
  min-block-size: var(--control-height);
  padding: var(--space-2) var(--space-4);
  color: var(--color-text-primary);
  border: var(--rct-border-hairline) solid var(--color-border-default);
  border-radius: var(--radius-xl);
  background: var(--color-surface-raised);
  font: inherit;
  font-size: var(--font-size-body);
}
.admin-export {
  display: grid;
  gap: var(--space-2);
}
.admin-page .web-field-trigger { padding-inline-start: var(--space-3); padding-inline-end: var(--space-6); }
.admin-export-format > label { position: absolute; inline-size: var(--rct-border-hairline); block-size: var(--rct-border-hairline); margin: calc(-1 * var(--rct-border-hairline)); padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.admin-export-format { min-inline-size: calc(var(--control-height) * 3); max-inline-size: calc(var(--control-height) * 6); }
.admin-group-combobox { min-inline-size: 0; }
.admin-combobox-control { position: relative; min-inline-size: 0; }
.admin-combobox-control > input { inline-size: 100%; padding-inline-end: calc(var(--control-height) + var(--space-2)); }
.admin-combobox-control > .mobile-icon { position: absolute; inset-inline-end: var(--space-4); inset-block-start: 50%; transform: translateY(-50%); pointer-events: none; color: var(--color-text-muted); }
.admin-combobox-options { padding: var(--space-2); }
.admin-combobox-options:popover-open { display: grid; gap: var(--space-2); }
.admin-combobox-options .admin-check { padding: var(--space-2); }
.admin-registry { display: grid; gap: var(--space-4); min-inline-size: 0; }
.admin-detail-row > td {
  --admin-detail-pad: var(--space-5);
  padding: var(--admin-detail-pad);
  background: var(--color-surface-base);
  font-weight: var(--font-weight-regular);
}
.admin-detail-row .admin-inline-editor {
  position: sticky;
  inset-inline-start: var(--admin-detail-pad);
  inline-size: calc(100cqi - var(--admin-detail-pad) * 2);
  max-inline-size: 100%;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.admin-editor-sections { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: var(--space-5); min-inline-size: 0; }
.admin-editor-sections > .admin-form { inline-size: 100%; max-inline-size: none; }
.admin-editor-sections > :is(.admin-actions, .web-notice) { grid-column: 1 / -1; }
.admin-editor-sections.is-creating { grid-template-columns: minmax(0, 1fr); }
.admin-editor-sections.is-creating > .admin-form { max-inline-size: var(--admin-panel-width); }
@media (max-width: 64rem) { .admin-editor-sections { grid-template-columns: minmax(0, 1fr); } }
.admin-form-grid {
  display: grid;
  gap: var(--space-4);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.admin-table-wrap {
  @mixin rct-focus-ring;
  container-type: inline-size;
  overflow-x: auto;
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
}
.admin-table {
  border-collapse: collapse;
  inline-size: 100%;
  min-inline-size: var(--admin-table-min);
  font-size: var(--font-size-dense);
}
.admin-table th {
  background: var(--color-surface-raised);
  text-align: start;
  font-weight: var(--font-weight-medium);
}
.admin-table th,
.admin-table td {
  padding: var(--space-2) var(--space-3);
  border-block-end: var(--rct-border-hairline) solid var(--color-border-subtle);
  vertical-align: top;
  overflow-wrap: anywhere;
}
.admin-table caption {
  text-align: start;
  padding-block-end: var(--space-3);
  color: var(--color-text-secondary);
}
.admin-table td:first-child {
  font-weight: var(--font-weight-medium);
}
.admin-subtext {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-block-start: var(--space-1);
}
.admin-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3);
}
.admin-check {
  display: flex;
  align-items: start;
  gap: var(--space-3);
}
.admin-check input {
  accent-color: var(--color-accent-now);
  inline-size: var(--space-4);
  block-size: var(--space-4);
  flex-shrink: 0;
}
.admin-checklist {
  display: grid;
  gap: var(--space-3);
}
.admin-counts {
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  background: var(--color-surface-raised);
  border: var(--web-border) solid var(--web-panel-line);
  border-radius: var(--radius-lg);
  overflow-wrap: anywhere;
}
.admin-counts > div {
  padding: var(--space-3) var(--space-4);
  display: grid;
  align-content: start;
  gap: var(--space-1);
}
.admin-counts > div + div {
  border-inline-start: var(--web-border) solid var(--web-panel-line);
}
.admin-counts dd {
  margin: 0;
}
.admin-counts strong {
  font-size: var(--font-size-title-screen);
}
.admin-counts small,
.admin-activity-table small {
  display: block;
}
.admin-activity-heading {
  align-items: end;
}
.admin-activity-scope {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  gap: var(--space-3);
  inline-size: min(100%, var(--admin-panel-width) / 2);
  min-inline-size: 0;
}
.admin-activity-metric {
  inline-size: min(100%, var(--admin-panel-width) / 2);
}
.admin-activity-table {
  border-spacing: 0;
  inline-size: 100%;
  font-size: var(--font-size-dense);
}
.admin-activity-table thead {
  background: var(--web-data-header-surface);
}
.admin-activity-table :is(th, td) {
  padding: var(--space-2) var(--space-3);
  border-block-end: var(--web-border) solid var(--web-panel-line);
  vertical-align: top;
  text-align: start;
  overflow-wrap: anywhere;
}
.admin-activity-table thead th:nth-child(2) {
  overflow-wrap: normal;
}
.admin-activity-table tbody th {
  font-weight: var(--font-weight-medium);
}
.admin-activity-table :is(td:last-child, small) {
  color: var(--color-text-secondary);
}
.admin-activity-table small {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-regular);
}
.admin-field-error {
  font-size: var(--font-size-caption);
  color: var(--color-state-danger-text);
  overflow-wrap: anywhere;
}
.admin-upload-fields input[type='file'] {
  max-inline-size: 100%;
}
.admin-upload-fields > .web-caption {
  margin-block-end: var(--space-3);
}
.admin-upload-fields > .admin-field-error {
  margin-block-start: var(--space-3);
}
.admin-danger {
  color: var(--color-state-danger-text);
}
.admin-warning {
  color: var(--color-state-warning-text);
}
.admin-feedback-error {
  background: var(--color-state-danger-bg);
  border-color: var(--color-state-danger-border);
  display: grid;
  gap: var(--space-3);
  justify-items: start;
}
.admin-feedback-error strong {
  color: var(--color-state-danger-text);
}
.admin-secret {
  overflow-wrap: anywhere;
  font-family: var(--font-family-sans);
  user-select: all;
}
.admin-pairs {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--space-3) var(--space-6);
  margin: 0;
}
.admin-pairs dt {
  color: var(--color-text-secondary);
}
.admin-pairs dd {
  margin: 0;
  overflow-wrap: anywhere;
}
@media (max-width: 48rem) {
  .admin-detail-row > td {
    --admin-detail-pad: var(--space-3);
  }
  .admin-form-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .admin-toolbar .web-field {
    flex-basis: min(100%, var(--admin-card-min) / 2);
  }
  .admin-toolbar .admin-search {
    flex-basis: 100%;
  }
  .admin-counts > div {
    padding-inline: var(--space-2);
    font-size: var(--font-size-caption);
  }
  .admin-counts strong {
    font-size: var(--font-size-title-block);
  }
  .admin-activity-table {
    font-size: var(--font-size-caption);
  }
  .admin-activity-table :is(th, td) {
    padding-inline: var(--space-1);
  }
}
