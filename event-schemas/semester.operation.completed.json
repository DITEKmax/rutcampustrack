{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "semester.operation.completed",
  "description": "Сохранённый конечный исход длительной операции с семестром.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "traceparent": {"$ref": "_common.json#/$defs/traceparent"},
    "request_id": {"$ref": "_common.json#/$defs/requestId"},
    "event_type": {
      "const": "semester.operation.completed"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "operation_id",
        "semester_id",
        "action",
        "outcome",
        "semester_name",
        "date_from",
        "date_to"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "semester_id": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "ARCHIVE",
            "RESTORE",
            "DELETE"
          ]
        },
        "outcome": {
          "enum": [
            "COMPLETED",
            "CANCELLED"
          ]
        },
        "semester_name": {
          "type": "string"
        },
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "actor_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "event_version": {
      "const": 1
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
