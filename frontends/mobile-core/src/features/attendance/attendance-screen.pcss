}

:where([data-student-ui]) .attendance-screen .attendance-graph__columns::-webkit-scrollbar,
:where([data-student-ui]):is(.attendance-screen .attendance-graph__columns::-webkit-scrollbar),
:where([data-student-ui]) .attendance-screen .attendance-day-rail::-webkit-scrollbar,
:where([data-student-ui]):is(.attendance-screen .attendance-day-rail::-webkit-scrollbar) {
