+package ru.rutcampustrack.attendance.report.studentprojection;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+
+/** One accepted-calculator count and its nullable percentage. */
+public record AttendanceMetricValue(int count, BigDecimal percent) {
+
+    public AttendanceMetricValue {
+        if (count < 0) {
+            throw StudentProjectionValidationException.invalidInput(
+                    "metric count must be non-negative");
+        }
+        if (percent != null) {
+            if (percent.signum() < 0 || percent.compareTo(BigDecimal.valueOf(100)) > 0) {
+                throw StudentProjectionValidationException.invalidInput(
+                        "metric percent must be between 0 and 100");
+            }
+            percent = percent.setScale(2, RoundingMode.HALF_UP);
+        }
+    }
+}
