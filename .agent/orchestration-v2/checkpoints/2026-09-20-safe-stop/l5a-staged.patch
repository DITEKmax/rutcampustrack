+        when(grants.findByUserIdAndRoleAndStatus(7L, "teacher", "active"))
+                .thenReturn(List.of(mock(ru.rutcampustrack.academic.entity.UserRoleGrant.class)));
+        when(semesters.findById(33L)).thenReturn(Optional.of(semester));
