@import '../../styles/tokens.pcss';

.headman-journal {
  display: grid;
  gap: var(--rct-space-4);
  max-inline-size: var(--rct-mobile-content-width);
  margin-inline: auto;
  padding: var(--rct-space-5) var(--rct-space-4) 8rem;
  color: var(--rct-color-text-primary);
}

.headman-journal h1,
.headman-journal h2,
.headman-journal p,
.headman-journal ol {
  margin: 0;
}

.headman-journal__header,
.headman-journal__section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--rct-space-3);
}

.headman-journal__eyebrow {
  margin-block-end: var(--rct-space-1) !important;
  color: var(--rct-color-accent-now);
  font-size: var(--rct-font-size-caption);
  font-weight: var(--rct-font-weight-medium);
}

.headman-journal h1 {
  font-size: var(--rct-font-size-title-screen);
  line-height: var(--rct-leading-tight);
}

.headman-journal h2 {
  font-size: var(--rct-font-size-title);
  line-height: var(--rct-leading-tight);
}

.headman-journal__date,
.headman-journal__section-header p,
.headman-journal__lesson-copy span,
.headman-journal__row-meta {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.headman-journal__date {
  margin-block-start: var(--rct-space-1) !important;
  text-transform: capitalize;
}

.headman-journal__today,
.headman-journal__date-nav button,
.headman-journal__lesson {
  min-block-size: var(--rct-control-min-touch);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  font: inherit;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.headman-journal__today {
  flex: 0 0 auto;
  padding-inline: var(--rct-space-3);
  font-size: var(--rct-font-size-caption);
}

.headman-journal__today:disabled,
.headman-journal__date-nav button:disabled,
.headman-journal__lesson:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}

.headman-journal__date-nav {
  display: grid;
  grid-template-columns: var(--rct-control-min-touch) minmax(0, 1fr) var(--rct-control-min-touch);
  align-items: center;
  gap: var(--rct-space-2);
}

.headman-journal__date-nav button {
  padding: 0;
  font-size: 1.25rem;
}

.headman-journal__date-nav output {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  text-align: center;
  text-transform: capitalize;
}

.headman-journal__state,
.headman-journal__empty {
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-4);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-raised);
}

.headman-journal__state--error {
  color: var(--rct-color-danger-text);
}

.headman-journal__state--notice {
  color: var(--rct-color-warning-text);
}

.headman-journal__lessons,
.headman-journal__roster {
  display: grid;
  gap: var(--rct-space-3);
}

.headman-journal__lesson-list {
  display: grid;
  gap: var(--rct-space-2);
  padding: 0;
  list-style: none;
}

.headman-journal__lesson {
  display: grid;
  grid-template-columns: 2.75rem minmax(0, 1fr);
  gap: var(--rct-space-3);
  inline-size: 100%;
  padding: var(--rct-space-3);
  text-align: start;
}

.headman-journal__lesson[data-selected='true'] {
  border-color: var(--rct-color-accent-now);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}

.headman-journal__lesson-number {
  display: grid;
  place-items: center;
  inline-size: 2.25rem;
  block-size: 2.25rem;
  border-radius: var(--rct-radius-full);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  font-weight: var(--rct-font-weight-bold);
}

.headman-journal__lesson[data-selected='true'] .headman-journal__lesson-number {
  color: var(--rct-color-accent-now);
  background: var(--rct-color-accent-on-now);
}

.headman-journal__lesson-copy {
  display: grid;
  gap: var(--rct-space-1);
  min-inline-size: 0;
}

.headman-journal__lesson-copy strong {
  font-size: var(--rct-font-size-body);
}

.headman-journal__lesson[data-selected='true'] .headman-journal__lesson-copy span {
  color: color-mix(in srgb, currentColor 78%, transparent);
}

.headman-journal__section-header {
  align-items: center;
}

.headman-journal__lesson-actions {
  display: grid;
  gap: var(--rct-space-2);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-3);
  background: var(--rct-color-surface-raised);
}

.headman-journal__lesson-actions h3,
.headman-journal__lesson-actions h4,
.headman-journal__lesson-actions p {
  margin: 0;
}

.headman-journal__lesson-actions h3 {
  font-size: var(--rct-font-size-body);
}

.headman-journal__lesson-actions h4 {
  font-size: var(--rct-font-size-caption);
}

.headman-journal__lesson-actions p {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.headman-journal__lesson-actions label {
  display: grid;
  gap: var(--rct-space-1);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.headman-journal__lesson-actions input,
.headman-journal__lesson-actions select {
  min-block-size: var(--rct-control-min-touch);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding-inline: var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  font: inherit;
  @mixin rct-focus-ring;
}

.headman-journal__lesson-actions button {
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding-inline: var(--rct-space-3);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
  font: inherit;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.headman-journal__lesson-actions button:disabled,
.headman-journal__lesson-actions input:disabled,
.headman-journal__lesson-actions select:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}

.headman-journal__transfer-task,
.headman-journal__transfer-status {
  display: grid;
  gap: var(--rct-space-2);
  border-block-start: var(--rct-border-hairline) solid var(--rct-color-border-default);
  padding-block-start: var(--rct-space-3);
}

.headman-journal__transfer-task-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--rct-space-2);
}

.headman-journal__lesson-actions .headman-journal__transfer-secondary {
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
}

.headman-journal__lesson-actions .headman-journal__transfer-error {
  display: grid;
  gap: var(--rct-space-2);
  color: var(--rct-color-danger-text);
}

.headman-journal__server-flag {
  max-inline-size: 9rem;
  color: var(--rct-color-success-text);
  font-size: var(--rct-font-size-micro);
  text-align: end;
}

.headman-journal__row-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-1) var(--rct-space-2);
  align-items: center;
}

.headman-journal__badge {
  color: var(--rct-color-text-primary);
  font-weight: var(--rct-font-weight-medium);
}

.headman-journal__attachment {
  border: 0;
  padding: 0;
  color: var(--rct-color-accent-now);
  background: transparent;
  font: inherit;
  text-decoration: underline;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.headman-journal__reason-edit {
  border: 0;
  padding: 0;
  color: var(--rct-color-accent-now);
  background: transparent;
  font: inherit;
  text-decoration: underline;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.headman-journal__reason-edit:disabled {
  color: var(--rct-color-disabled-text);
  cursor: not-allowed;
}

.headman-journal__attachment:disabled {
  color: var(--rct-color-disabled-text);
  cursor: not-allowed;
}

.headman-journal__attachment-error {
  color: var(--rct-color-danger-text);
}

.headman-journal__weekly-export {
  display: grid;
  gap: var(--rct-space-3);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-4);
  background: var(--rct-color-surface-raised);
}

.headman-journal__weekly-export h2,
.headman-journal__weekly-export p {
  margin: 0;
}

.headman-journal__weekly-export-controls {
  display: grid;
  gap: var(--rct-space-3);
  min-inline-size: 0;
}

.headman-journal__weekly-export-context {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  overflow-wrap: anywhere;
}

.headman-journal__weekly-weeks {
  display: grid;
  gap: var(--rct-space-1);
  min-inline-size: 0;
  margin: 0;
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-2) var(--rct-space-3);
}

.headman-journal__weekly-weeks legend,
.headman-journal__weekly-format {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.headman-journal__weekly-week {
  display: flex;
  align-items: center;
  gap: var(--rct-space-2);
  min-block-size: var(--rct-control-min-touch);
  color: var(--rct-color-text-primary);
  font-size: var(--rct-font-size-body);
  cursor: pointer;
}

.headman-journal__weekly-week input {
  inline-size: 1.25rem;
  block-size: 1.25rem;
  flex: 0 0 auto;
  accent-color: var(--rct-color-accent-now);
}

.headman-journal__weekly-week span {
  min-inline-size: 0;
  overflow-wrap: anywhere;
}

.headman-journal__weekly-format {
  display: grid;
  gap: var(--rct-space-1);
}

.headman-journal__weekly-format .headman-stats-select__trigger {
  background: var(--rct-color-surface-float);
}

.headman-journal__weekly-download {
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding-inline: var(--rct-space-3);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
  font: inherit;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.headman-journal__weekly-download:disabled,
.headman-journal__weekly-format .headman-stats-select__trigger:disabled,
.headman-journal__weekly-weeks:disabled .headman-journal__weekly-week {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}

@media (max-width: 24rem) {
  .headman-journal__header,
  .headman-journal__section-header {
    flex-direction: column;
  }

  .headman-journal__server-flag {
    max-inline-size: none;
    text-align: start;
  }
}

/* Filled mobile marks are independent of the source of the attendance record. */
.headman-journal__row-meta {
  display: grid;
  gap: 0;
  font-size: var(--rct-font-size-micro);
}
.headman-journal__badge {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-micro);
  font-weight: var(--rct-font-weight-regular);
}
.headman-journal {
  gap: var(--rct-space-3);
  max-inline-size: var(--rct-today-content-max);
  padding-block-end: var(--rct-headman-page-bottom-space);
}
.headman-journal__header {
  position: relative;
  min-block-size: var(--rct-control-min-touch);
  justify-content: center;
  align-items: center;
}
.headman-journal h1 {
  font-size: var(--rct-font-size-title);
}
.headman-journal__date-nav {
  border-radius: var(--rct-radius-xl);
  background: var(--rct-color-surface-raised);
}
.headman-journal__date-nav button {
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
}
.headman-journal__date-nav output {
  color: var(--rct-color-text-primary);
  font-size: var(--rct-font-size-dense);
}
.headman-journal__next {
  transform: rotate(180deg);
}
.headman-journal__context {
  display: grid;
  gap: var(--rct-space-2);
  padding: var(--rct-space-3);
  border-radius: var(--rct-radius-xl);
  background: var(--rct-color-surface-raised);
}
.headman-journal__context h2 {
  font-size: var(--rct-font-size-body);
  overflow-wrap: anywhere;
}
.headman-journal__context p,
.headman-journal__context span {
  display: flex;
  align-items: center;
  gap: var(--rct-space-2);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}
.headman-journal__context div {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--rct-space-3);
}
.headman-journal__visually-hidden {
  position: absolute;
  inline-size: var(--rct-border-hairline);
  block-size: var(--rct-border-hairline);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
.headman-journal details > summary {
  min-block-size: var(--rct-control-min-touch);
  cursor: pointer;
  color: var(--rct-color-text-primary);
  font-size: var(--rct-font-size-dense);
  @mixin rct-focus-ring;
}

.headman-journal__ticket-link {
  grid-column: 1;
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  padding: var(--rct-space-2);
  background: transparent;
  color: var(--rct-color-text-primary);
  text-decoration: underline;
  text-align: start;
}
.headman-journal__linked-request {
  display: grid;
  gap: var(--rct-space-3);
  padding: var(--rct-space-4);
  border-radius: var(--rct-radius-2xl);
  background: var(--rct-color-surface-raised);
  overflow-wrap: anywhere;
}
.headman-journal__linked-request :is(h2, p, ul) {
  margin: 0;
}
.headman-journal__linked-request button {
  min-block-size: var(--rct-control-min-touch);
  padding: var(--rct-space-2) var(--rct-space-3);
  border: 0;
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-base);
  color: var(--rct-color-text-primary);
}

.headman-journal__attachment-details {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--rct-space-2);
}

.headman-journal__empty {
  text-align: center;
}
.headman-journal__weekly-weeks {
  border: 0;
  padding: 0;
}
.headman-journal__weekly-dropdown {
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-3);
  background: var(--rct-color-surface-raised);
}
.headman-journal__weekly-dropdown > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-3);
  list-style: none;
}
.headman-journal__weekly-dropdown > summary::-webkit-details-marker {
  display: none;
}
.headman-journal__weekly-dropdown[open] > summary .mobile-icon {
  transform: rotate(180deg);
}
.headman-journal__linked-request h2 {
  font-size: var(--rct-font-size-title);
}
.headman-journal__linked-request > p {
  display: flex;
  align-items: center;
  gap: var(--rct-space-2);
}
.headman-journal__request-tag {
  justify-self: start;
  padding: var(--rct-space-1) var(--rct-space-3);
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-surface-float);
  font-size: var(--rct-font-size-caption);
}

.headman-journal__weekly-export {
  border: 0;
}

/* R2 compact dialogs and separate week cards; existing mutation/preview controls remain unchanged. */
.headman-journal__lesson-actions {
  padding: var(--rct-space-3);
  gap: var(--rct-space-2);
}
.headman-journal__lesson-actions > header,
.headman-journal__weekly-export > header {
  margin-block-end: var(--rct-space-2);
}
.headman-journal__lesson-actions > header h2 {
  font-size: var(--rct-font-size-body);
}
.headman-journal__lesson-actions .mobile-tools-sheet__content {
  gap: var(--rct-space-2);
}
.headman-journal__weekly-export {
  padding: var(--rct-space-3);
  background: var(--rct-color-surface-raised);
}
.headman-journal__weekly-export-controls {
  gap: var(--rct-space-2);
}
.headman-journal__weekly-dropdown {
  padding: 0;
  background: transparent;
}
.headman-journal__weekly-dropdown > summary {
  min-block-size: var(--rct-control-min-touch);
  padding: var(--rct-space-3);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-float);
  font-weight: var(--rct-font-weight-medium);
  cursor: pointer;
  @mixin rct-focus-ring;
}
.headman-journal__weekly-count {
  margin-inline-start: auto;
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  font-weight: var(--rct-font-weight-regular);
}
.headman-journal__weekly-dropdown[open] > summary {
  margin-block-end: var(--rct-space-2);
}
.headman-journal__weekly-weeks {
  gap: var(--rct-space-2);
}
.headman-journal__weekly-week {
  padding: var(--rct-space-3);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-float);
}
.headman-journal__weekly-weeks:not(:disabled) .headman-journal__weekly-week[data-selected='true'] {
  border-color: var(--rct-color-accent-now);
  background: var(--rct-color-accent-soft);
}
.headman-journal__weekly-format {
  padding: var(--rct-space-3);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-float);
}
.headman-journal__weekly-format .headman-stats-select__trigger:not(:disabled) {
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  background: var(--rct-color-surface-raised);
}
.headman-journal__request-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--rct-space-2);
}
.headman-journal__request-heading :is(.request-status-badge, .headman-journal__request-tag) {
  padding: var(--rct-space-1) var(--rct-space-3);
  font-size: var(--rct-font-size-caption);
  line-height: var(--rct-leading-snug);
}
