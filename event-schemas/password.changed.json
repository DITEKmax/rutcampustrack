{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutcampustrack.ru/event-schemas/password.changed.json",
  "title": "password.changed",
  "description": "Metadata-only notification emitted after a credential update commits.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": { "const": "password.changed" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": [ "telegram_id" ],
      "properties": {
        "telegram_id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "event_version": { "const": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "source": { "const": "auth-service" }
  },
  "additionalProperties": false
}
