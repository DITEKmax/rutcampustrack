{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson.one_off.created",
  "description": "Разовая (one-off) пара создана старостой. Генерируется Schedule Service (Phase 60-04).",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "lesson.one_off.created"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "one_off_lesson_id",
        "group_id",
        "subject_id",
        "date",
        "lesson_number"
      ],
      "properties": {
        "one_off_lesson_id": {
          "type": "integer"
        },
        "group_id": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "lesson_number": {
          "$ref": "_common.json#/$defs/lessonNumber"
        },
        "classroom": {
          "type": [
            "string",
            "null"
          ]
        },
        "lesson_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "semester_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lesson_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lecture",
            "practice",
            "lab",
            null
          ]
        },
        "lesson_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "assignment_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "assigned_teacher_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "start_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "room": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
