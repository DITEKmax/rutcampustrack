  inline-size: var(--rct-role-avatar-size);
  block-size: var(--rct-role-avatar-size);
  border-radius: var(--rct-radius-full);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-float);
  font-size: var(--rct-font-size-body);
