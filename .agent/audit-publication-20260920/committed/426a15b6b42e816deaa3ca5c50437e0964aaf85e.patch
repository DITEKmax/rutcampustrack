+    minCodePoints: value.minCodePoints,
+    maxUtf8Bytes: value.maxUtf8Bytes,
+    requiresDecimalDigit: value.requiresDecimalDigit,
+    specialCategories: categories,
+    normalization: 'NONE',
+  }
