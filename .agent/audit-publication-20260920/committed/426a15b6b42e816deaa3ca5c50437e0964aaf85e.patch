+    private static boolean canReadHomework(InternalJwtClaims claims) {
+        if (!"STUDENT".equalsIgnoreCase(claims.role())
+                || claims.userId() <= 0
+                || claims.groupId() == null
+                || claims.groupId() <= 0) {
+            return false;
+        }
+        if (!claims.readOnly()) {
+            return "ACTIVE".equalsIgnoreCase(claims.status());
+        }
+        return isTerminalStatus(claims.status());
