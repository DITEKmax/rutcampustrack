+  readonly authority?: MapAuthorityState
+  readonly epoch: number
+  readonly activeRevision: string | null
+  readonly snapshot: PersistedSnapshot | null
+}
+
+interface PendingRevocation {
+  readonly databaseName: string
+  readonly ownerKey: string
+  readonly generation: number
+  epoch: number
+  inFlight: Promise<MapRevokeResult> | null
+}
+
+// A failed tombstone keeps a process-local deny fence until retry succeeds. It
+// cannot describe a durable erase across a reload or a new realm when every
+// IndexedDB write is failing; callers must retain the retry obligation.
+const pendingRevocations = new Map<string, PendingRevocation>()
+
+function pendingRevocationKey(databaseName: string, ownerKey: string): string {
+  return `${databaseName}\u0000${ownerKey}`
+}
+
+export interface MapOfflineStoreOptions {
+  readonly databaseName?: string
+  readonly indexedDB?: IDBFactory
+  readonly validation?: AssetValidationOptions
+}
+
+export interface MapLifecycleEvent {
+  readonly kind: 'revoked' | 'updated'
+  readonly ownerKey: string
+  readonly generation: number | null
+  readonly epoch: number
+  readonly revision: string | null
+}
+
+export class MapOfflineStore {
+  private readonly databaseName: string
+  private readonly indexedDb: IDBFactory | undefined
+  private readonly validation: AssetValidationOptions
+  private databasePromise: Promise<IDBDatabase> | null = null
+  private readonly lifecycleListeners = new Map<string, Set<(event: MapLifecycleEvent) => void>>()
+  private readonly lifecycleChannel: BroadcastChannel | null
+  private closeRequested = false
+
+  constructor(options: MapOfflineStoreOptions = {}) {
+    this.databaseName = options.databaseName ?? DEFAULT_DATABASE_NAME
+    this.indexedDb = options.indexedDB ?? globalThis.indexedDB
+    this.validation = options.validation ?? {}
+    this.lifecycleChannel = typeof globalThis.BroadcastChannel === 'function' ? new globalThis.BroadcastChannel(`${this.databaseName}:lifecycle`) : null
+    if (this.lifecycleChannel) this.lifecycleChannel.onmessage = (event: MessageEvent<MapLifecycleEvent>) => this.dispatchLifecycle(event.data, false)
+  }
+
+  subscribeLifecycle(scope: MapOwnerScope, listener: (event: MapLifecycleEvent) => void): () => void {
+    const trustedScope = requireScope(scope)
+    const listeners = this.lifecycleListeners.get(trustedScope.ownerKey) ?? new Set<(event: MapLifecycleEvent) => void>()
+    listeners.add(listener)
+    this.lifecycleListeners.set(trustedScope.ownerKey, listeners)
+    return () => {
+      listeners.delete(listener)
+      if (listeners.size === 0) this.lifecycleListeners.delete(trustedScope.ownerKey)
+    }
+  }
+
+  async getOwnerState(scope: MapOwnerScope): Promise<MapOwnerState> {
+    return this.ensureScopeState(requireScope(scope))
+  }
+
+  private async ensureScopeState(scope: MapOwnerScope): Promise<MapOwnerState> {
+    if (!Number.isSafeInteger(scope.generation) || scope.generation <= 0) throw new MapError('stale', 'generation trusted scope недействителен')
+    const key = pendingRevocationKey(this.databaseName, scope.ownerKey)
+    const pending = pendingRevocations.get(key)
+    if (pending) {
+      const record = await this.readRecord(scope.ownerKey).catch((error: unknown) => {
+        if (error instanceof MapError && error.kind === 'storage') return undefined
+        throw error
+      })
+      return pendingState(scope.ownerKey, record, pending)
+    }
+    const observed = await this.readRecord(scope.ownerKey)
+    if (!observed) return ownerStateFromRecord(scope.ownerKey, undefined, scope.generation)
+    if (observed) {
+      const observedState = ownerStateFromRecord(scope.ownerKey, observed)
+      const canAdvance = observedState.generation !== null && scope.generation > observedState.generation && scope.freshAuthority === true && observedState.authority !== 'pending'
+      if (observedState.generation === scope.generation || !canAdvance) return observedState.generation === scope.generation ? observedState : { ...observedState, authority: 'revoked' }
+    }
+    const database = await this.openDatabase()
+    const transaction = database.transaction(OWNER_STORE, 'readwrite')
+    const objectStore = transaction.objectStore(OWNER_STORE)
+    let nextState: MapOwnerState | null = null
+    let operationError: MapError | null = null
+    return new Promise<MapOwnerState>((resolve, reject) => {
+      transaction.oncomplete = () => {
+        if (operationError) reject(operationError)
+        else if (nextState) resolve(nextState)
+        else reject(new MapError('storage', 'IDB authority transaction did not produce a state'))
+      }
+      transaction.onerror = () => { operationError ??= storageError(transaction.error) }
+      transaction.onabort = () => { reject(operationError ?? new MapError('storage', 'IDB authority transaction aborted')) }
+      const request = objectStore.get(scope.ownerKey)
+      request.onerror = () => {
+        operationError = storageError(request.error)
+        try { transaction.abort() } catch { /* transaction already closed */ }
+      }
+      request.onsuccess = () => {
+        const current = request.result as PersistedOwnerRecord | undefined
+        const pendingAtTransition = pendingRevocations.get(key)
+        if (pendingAtTransition) {
+          nextState = pendingState(scope.ownerKey, current, pendingAtTransition)
+          return
+        }
+        if (!current) {
+          nextState = ownerStateFromRecord(scope.ownerKey, undefined, scope.generation)
+          return
+        }
+        const currentState = ownerStateFromRecord(scope.ownerKey, current)
+        if (currentState.generation === scope.generation) {
+          nextState = currentState
+          return
+        }
+        if (currentState.generation !== null && scope.generation > currentState.generation && scope.freshAuthority === true && currentState.authority !== 'pending') {
+          const freshEpoch = currentState.epoch + 1
+          objectStore.put({ ownerKey: scope.ownerKey, generation: scope.generation, authority: 'virgin', epoch: freshEpoch, activeRevision: null, snapshot: null } satisfies PersistedOwnerRecord)
+          nextState = { ownerKey: scope.ownerKey, generation: scope.generation, authority: 'virgin', epoch: freshEpoch, activeRevision: null }
+          return
+        }
+        nextState = { ...currentState, authority: 'revoked' }
+      }
+    })
+  }
+
+  async readSnapshot(scope: MapOwnerScope): Promise<MapSnapshot | null> {
+    const trustedScope = requireScope(scope)
+    const authority = await this.getOwnerState(trustedScope)
+    if (authority.authority === 'pending' || authority.authority === 'revoked') throw authorityError(authority, trustedScope)
+    if (authority.authority === 'virgin') return null
+    const record = await this.readRecord(trustedScope.ownerKey)
+    if (!record || record.generation !== trustedScope.generation || record.authority !== 'active' || !record.snapshot) {
+      const current = await this.getOwnerState(trustedScope)
+      throw authorityError(current, trustedScope)
+    }
+    return this.readValidatedSnapshot(record, trustedScope)
+  }
+
+  private async readValidatedSnapshot(record: PersistedOwnerRecord, scope: MapOwnerScope): Promise<MapSnapshot> {
+    try {
+      const persistedSnapshot = record.snapshot
+      if (!persistedSnapshot) throw new Error('snapshot отсутствует')
+      const manifest = validateManifest(persistedSnapshot.manifest)
+      if (record.activeRevision !== manifest.revision || persistedSnapshot.assets.some((asset) => asset.key !== mapAssetKey(asset))) {
+        throw new Error('revision or asset key mismatch')
+      }
+      const expected = readyDescriptors(manifest)
+      const actualKeys = new Set(persistedSnapshot.assets.map((asset) => asset.key))
+      if (actualKeys.size !== persistedSnapshot.assets.length || expected.size !== actualKeys.size || [...expected.keys()].some((key) => !actualKeys.has(key))) throw new Error('complete snapshot asset set mismatch')
+      for (const asset of persistedSnapshot.assets) {
+        const descriptor = expected.get(asset.key)
+        if (!descriptor || asset.bytes !== descriptor.bytes || asset.sha256 !== descriptor.sha256) throw new Error(`unexpected asset ${asset.key}`)
+        await validateCachedAsset(asset, descriptor, this.validation)
+        const afterAsset = await this.getOwnerState(scope)
+        if (afterAsset.authority !== 'active' || afterAsset.generation !== scope.generation || afterAsset.epoch !== record.epoch || afterAsset.activeRevision !== manifest.revision) throw authorityError(afterAsset, scope)
+      }
+      const current = await this.getOwnerState(scope)
+      if (current.authority !== 'active' || current.generation !== scope.generation || current.epoch !== record.epoch || current.activeRevision !== manifest.revision) throw authorityError(current, scope)
+      return {
+        ownerKey: scope.ownerKey,
+        generation: scope.generation,
+        epoch: record.epoch,
+        manifest,
+        assets: persistedSnapshot.assets,
+      }
+    } catch (error) {
+      if (error instanceof MapError && (error.kind === 'storage' || error.kind === 'stale')) throw error
+      throw new MapError('corrupt', 'сохранённый снимок карты повреждён и не доверен', error)
+    }
+  }
+
+  async commitSnapshot(scope: MapOwnerScope, expected: MapOwnerState, manifest: MapManifest, assets: readonly MapCachedAsset[]): Promise<MapSnapshot> {
+    const trustedScope = requireScope(scope)
+    if (expected.ownerKey !== trustedScope.ownerKey) throw new MapStaleCommitError('scope owner не совпадает с captured owner')
+    if (expected.generation !== trustedScope.generation) throw new MapStaleCommitError('scope generation не совпадает с captured authority')
+    if (expected.authority === 'revoked' || expected.authority === 'pending') throw authorityError(expected, trustedScope)
+    if (pendingRevocations.has(pendingRevocationKey(this.databaseName, trustedScope.ownerKey))) throw new MapStaleCommitError('очистка offline-кэша владельца ещё не завершена')
+    const checkedManifest = validateManifest(manifest)
+    await validateCompleteAssets(checkedManifest, assets, this.validation)
+    const database = await this.openDatabase()
+    const transaction = database.transaction(OWNER_STORE, 'readwrite')
+    const objectStore = transaction.objectStore(OWNER_STORE)
+    let operationError: MapError | null = null
+    let currentEpoch = expected.epoch
+    let resultGeneration = scope.generation
+
+    const result = await new Promise<MapSnapshot>((resolve, reject) => {
+      transaction.oncomplete = () => {
+        if (operationError) {
+          reject(operationError)
+          return
+        }
+        resolve({ ownerKey: trustedScope.ownerKey, generation: resultGeneration, epoch: currentEpoch, manifest: checkedManifest, assets })
+      }
+      transaction.onerror = () => {
+        operationError ??= storageError(transaction.error)
+      }
+      transaction.onabort = () => {
+        reject(operationError ?? new MapError('storage', 'IDB transaction aborted'))
+      }
+      const request = objectStore.get(trustedScope.ownerKey)
+      request.onerror = () => {
+        operationError = storageError(request.error)
+        try { transaction.abort() } catch { /* transaction already closed */ }
+      }
+      request.onsuccess = () => {
+        const current = request.result as PersistedOwnerRecord | undefined
+        if (pendingRevocations.has(pendingRevocationKey(this.databaseName, trustedScope.ownerKey))) {
+          operationError = new MapStaleCommitError('очистка offline-кэша владельца началась до commit')
+          try { transaction.abort() } catch { /* transaction already closed */ }
+          return
+        }
+        const actualState = ownerStateFromRecord(trustedScope.ownerKey, current, expected.authority === 'virgin' ? trustedScope.generation : undefined)
+        const expectedAuthority = expected.authority ?? (expected.activeRevision === null && expected.epoch === 0 ? 'virgin' : 'active')
+        if (actualState.generation !== trustedScope.generation) {
+          operationError = authorityError(actualState, trustedScope)
+          try { transaction.abort() } catch { /* transaction already closed */ }
+          return
+        }
+        if (actualState.authority === 'revoked' || actualState.authority === 'pending' || (actualState.authority !== expectedAuthority && !(actualState.authority === 'virgin' && expectedAuthority === 'active'))) {
+          operationError = authorityError(actualState, trustedScope)
+          try { transaction.abort() } catch { /* transaction already closed */ }
+          return
+        }
+        const actualEpoch = current?.epoch ?? 0
+        const actualRevision = current?.activeRevision ?? null
+        if (actualEpoch !== expected.epoch || actualRevision !== expected.activeRevision) {
+          operationError = new MapStaleCommitError('IDB epoch или active revision изменились до commit')
+          try { transaction.abort() } catch { /* transaction already closed */ }
+          return
+        }
+        currentEpoch = actualEpoch
+        resultGeneration = scope.generation
+        objectStore.put({
+          ownerKey: trustedScope.ownerKey,
+          generation: trustedScope.generation,
+          authority: 'active',
+          epoch: actualEpoch,
+          activeRevision: checkedManifest.revision,
+          snapshot: { manifest: checkedManifest, assets },
+        } satisfies PersistedOwnerRecord)
+      }
+    })
+    this.dispatchLifecycle({ kind: 'updated', ownerKey: trustedScope.ownerKey, generation: result.generation, epoch: result.epoch, revision: result.manifest.revision }, true)
+    return result
+  }
+
+  async revokeOwner(scope: MapOwnerScope): Promise<MapRevokeResult> {
+    return this.startRevoke(requireScope(scope))
+  }
+
+  async retryRevoke(scope: MapOwnerScope): Promise<MapRevokeResult> {
+    return this.startRevoke(requireScope(scope))
+  }
+
+  private async startRevoke(scope: MapOwnerScope): Promise<MapRevokeResult> {
+    const trustedScope = requireScope(scope)
+    const key = pendingRevocationKey(this.databaseName, trustedScope.ownerKey)
+    let pending = pendingRevocations.get(key)
+    if (pending && pending.generation !== trustedScope.generation) return failedRevoke(trustedScope, pending.epoch, new MapError('stale', 'очистка принадлежит другому trusted generation', { authorityChanged: true, ownerKey: trustedScope.ownerKey, generation: pending.generation, requestedGeneration: trustedScope.generation, epoch: pending.epoch, activeRevision: null }))
+    if (!pending) {
+      const generation = trustedScope.generation
+      let current: PersistedOwnerRecord | undefined
+      try {
+        current = await this.readRecord(trustedScope.ownerKey)
+      } catch (error) {
+        pending = pendingRevocations.get(key)
+        if (pending) return this.runPendingRevoke(pending, key)
+        const mapError = error instanceof MapError ? error : new MapError('storage', 'не удалось проверить durable authority перед revoke', error)
+        pending = { databaseName: this.databaseName, ownerKey: trustedScope.ownerKey, generation, epoch: 0, inFlight: null }
+        pendingRevocations.set(key, pending)
+        return failedRevoke(trustedScope, 0, mapError, true)
+      }
+      pending = pendingRevocations.get(key)
+      if (pending) return this.runPendingRevoke(pending, key)
+      const currentState = ownerStateFromRecord(trustedScope.ownerKey, current)
+      if (current && currentState.generation !== generation) {
+        return failedRevoke(trustedScope, currentState.epoch, authorityError(currentState, trustedScope))
+      }
+      pending = { databaseName: this.databaseName, ownerKey: trustedScope.ownerKey, generation, epoch: 0, inFlight: null }
+      pendingRevocations.set(key, pending)
+    }
+    return this.runPendingRevoke(pending, key)
+  }
+
+  private runPendingRevoke(pending: PendingRevocation, key: string): Promise<MapRevokeResult> {
+    if (pending.inFlight) return pending.inFlight
+    const operation = this.performRevoke(pending)
+    pending.inFlight = operation.finally(() => {
+      if (pendingRevocations.get(key) === pending) pending!.inFlight = null
+      this.closeIfSettled()
+    })
+    return pending.inFlight
+  }
+
+  private async performRevoke(pending: PendingRevocation): Promise<MapRevokeResult> {
+    let nextEpoch = pending.epoch
+    try {
+      const database = await this.openDatabase()
+      const transaction = database.transaction(OWNER_STORE, 'readwrite')
+      const objectStore = transaction.objectStore(OWNER_STORE)
+      let operationError: MapError | null = null
+      await new Promise<void>((resolve, reject) => {
+        transaction.oncomplete = () => {
+          if (operationError) reject(operationError)
+          else resolve()
+        }
+        transaction.onerror = () => { operationError ??= storageError(transaction.error) }
+        transaction.onabort = () => { reject(operationError ?? new MapError('storage', 'IDB revoke transaction aborted')) }
+        const request = objectStore.get(pending.ownerKey)
+        request.onerror = () => {
+          operationError = storageError(request.error)
+          try { transaction.abort() } catch { /* transaction already closed */ }
+        }
+        request.onsuccess = () => {
+          const current = request.result as PersistedOwnerRecord | undefined
+          const currentState = ownerStateFromRecord(pending.ownerKey, current, pending.generation)
+          if (current && currentState.generation !== pending.generation) {
+            operationError = authorityError(currentState, { ownerKey: pending.ownerKey, generation: pending.generation })
+            try { transaction.abort() } catch { /* transaction already closed */ }
+            return
+          }
+          const targetGeneration = pending.generation
+          nextEpoch = Math.max(pending.epoch, current?.epoch ?? 0) + 1
+          pending.epoch = nextEpoch
+          objectStore.put({
+            ownerKey: pending.ownerKey,
+            generation: targetGeneration,
+            authority: 'revoked',
+            epoch: nextEpoch,
+            activeRevision: null,
+            snapshot: null,
+          } satisfies PersistedOwnerRecord)
+        }
+      })
+      if (nextEpoch === 0) throw new MapError('storage', 'IDB revoke не вернул epoch')
+      pendingRevocations.delete(pendingRevocationKey(this.databaseName, pending.ownerKey))
+      this.dispatchLifecycle({ kind: 'revoked', ownerKey: pending.ownerKey, generation: pending.generation, epoch: nextEpoch, revision: null }, true)
+      return { ownerKey: pending.ownerKey, epoch: nextEpoch, status: 'completed', durable: true, pending: false }
+    } catch (error) {
+      const mapError = error instanceof MapError ? error : new MapError('storage', 'не удалось завершить очистку offline-кэша', error)
+      const pendingKey = pendingRevocationKey(this.databaseName, pending.ownerKey)
+      if (mapError.kind === 'stale' && pendingRevocations.get(pendingKey) === pending) pendingRevocations.delete(pendingKey)
+      return { ownerKey: pending.ownerKey, epoch: nextEpoch, status: 'failed', durable: false, pending: mapError.kind !== 'stale', error: mapError }
+    }
+  }
+
+  close(): void {
+    this.closeRequested = true
+    this.closeIfSettled()
+  }
+
+  private closeIfSettled(): void {
+    if (!this.closeRequested) return
+    for (const pending of pendingRevocations.values()) {
+      if (pending.databaseName === this.databaseName && pending.inFlight) return
+    }
+    this.lifecycleChannel?.close()
+    this.databasePromise?.then((database) => database.close()).catch(() => undefined)
+    this.databasePromise = null
+  }
+
+  private dispatchLifecycle(event: MapLifecycleEvent, broadcast: boolean): void {
+    if (broadcast) this.lifecycleChannel?.postMessage(event)
+    for (const listener of this.lifecycleListeners.get(event.ownerKey) ?? []) listener(event)
+  }
+
+  private async readRecord(ownerKey: string): Promise<PersistedOwnerRecord | undefined> {
+    const database = await this.openDatabase()
+    const transaction = database.transaction(OWNER_STORE, 'readonly')
+    const request = transaction.objectStore(OWNER_STORE).get(ownerKey)
+    return requestValue<PersistedOwnerRecord | undefined>(request)
+  }
+
+  private openDatabase(): Promise<IDBDatabase> {
+    if (this.databasePromise) return this.databasePromise
+    if (!this.indexedDb) {
+      return Promise.reject(new MapError('storage', 'IndexedDB недоступна в текущей оболочке'))
+    }
+    this.databasePromise = new Promise<IDBDatabase>((resolve, reject) => {
+      const request = this.indexedDb?.open(this.databaseName, DATABASE_VERSION)
+      if (!request) {
+        reject(new MapError('storage', 'IndexedDB не вернула open request'))
+        return
+      }
+      request.onupgradeneeded = () => {
+        const database = request.result
+        if (!database.objectStoreNames.contains(OWNER_STORE)) database.createObjectStore(OWNER_STORE, { keyPath: 'ownerKey' })
+      }
+      request.onsuccess = () => resolve(request.result)
+      request.onerror = () => reject(storageError(request.error))
+      request.onblocked = () => reject(new MapError('storage', 'IndexedDB upgrade заблокирован'))
+    }).catch((error: unknown) => {
+      this.databasePromise = null
+      throw error
+    })
+    return this.databasePromise
+  }
+}
+
+async function validateCompleteAssets(manifest: MapManifest, assets: readonly MapCachedAsset[], validation: AssetValidationOptions): Promise<void> {
+  const expected = readyDescriptors(manifest)
+  if (new Set(assets.map((asset) => asset.key)).size !== assets.length || expected.size !== assets.length) throw new MapError('storage', 'snapshot не содержит полный набор готовых ассетов')
+  for (const asset of assets) {
+    const descriptor = expected.get(asset.key)
+    if (!descriptor || asset.bytes !== descriptor.bytes || asset.sha256 !== descriptor.sha256) throw new MapError('storage', `snapshot содержит неожиданный ассет ${asset.key}`)
+    await validateCachedAsset(asset, descriptor, validation)
+  }
+}
+
+function readyDescriptors(manifest: MapManifest): Map<string, MapAssetDescriptor> {
+  const result = new Map<string, MapAssetDescriptor>()
+  for (const building of manifest.buildings) {
+    for (const floor of building.floors) {
+      if (!floor.plan) continue
+      for (const descriptor of [floor.plan.png, floor.plan.svg]) {
+        if (descriptor.state !== 'ready' || descriptor.id === null || descriptor.sha256 === null) continue
+        const key = mapAssetKey({ buildingId: building.id, floorId: floor.id, version: floor.plan.version, format: descriptor.format, assetId: descriptor.id })
+        result.set(key, descriptor)
+      }
+    }
+  }
+  return result
+}
+
+function ownerStateFromRecord(ownerKey: string, record: PersistedOwnerRecord | undefined, virginGeneration?: number): MapOwnerState {
+  if (!record) return { ownerKey, generation: virginGeneration ?? null, epoch: 0, activeRevision: null, authority: 'virgin' }
+  const generation = Number.isSafeInteger(record.generation) && (record.generation ?? 0) > 0 ? record.generation! : null
+  if (generation === null) return { ownerKey, generation: null, epoch: Math.max(0, record.epoch), activeRevision: record.activeRevision ?? null, authority: 'revoked' }
+  const authority = record.authority ?? (record.activeRevision === null ? (record.epoch > 0 ? 'revoked' : 'virgin') : 'active')
+  return { ownerKey, generation, epoch: Math.max(0, record.epoch), activeRevision: record.activeRevision ?? null, authority }
+}
+
+function pendingState(ownerKey: string, record: PersistedOwnerRecord | undefined, pending: PendingRevocation): MapOwnerState {
+  return {
+    ownerKey,
+    generation: pending.generation ?? ownerStateFromRecord(ownerKey, record).generation,
+    epoch: Math.max(record?.epoch ?? 0, pending.epoch),
+    activeRevision: null,
+    authority: 'pending',
+  }
+}
+
+function requireScope(value: unknown): MapOwnerScope {
+  if (typeof value !== 'object' || value === null) throw new MapError('stale', 'операция карты требует trusted MapOwnerScope')
+  const scope = value as Partial<MapOwnerScope>
+  const generation = scope.generation
+  if (typeof scope.ownerKey !== 'string' || scope.ownerKey.length === 0 || typeof generation !== 'number' || !Number.isSafeInteger(generation) || generation <= 0) {
+    throw new MapError('stale', 'операция карты требует полного trusted MapOwnerScope')
+  }
+  return scope as MapOwnerScope
+}
+
+function authorityError(state: MapOwnerState, scope: MapOwnerScope): MapError {
+  return new MapError('stale', 'durable authority владельца карты недействительна для trusted scope', {
+    authorityChanged: true,
+    authority: state.authority,
+    ownerKey: state.ownerKey,
+    generation: state.generation,
+    requestedGeneration: scope.generation,
+    epoch: state.epoch,
+    activeRevision: state.activeRevision,
+  })
+}
+
+function failedRevoke(scope: MapOwnerScope, epoch: number, error: MapError, pending = false): MapRevokeResult {
+  return { ownerKey: scope.ownerKey, epoch, status: 'failed', durable: false, pending, error }
+}
+
+function requestValue<T>(request: IDBRequest<T>): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    request.onsuccess = () => resolve(request.result)
+    request.onerror = () => reject(storageError(request.error))
+  })
+}
+
+function storageError(error: DOMException | null): MapError {
+  return new MapError('storage', error?.message || 'ошибка IndexedDB', error)
+}
