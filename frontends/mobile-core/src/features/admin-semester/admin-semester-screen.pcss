@import '../../styles/tokens.pcss';

.admin-semester-screen {
  min-block-size: 100dvh;
  max-inline-size: 26.625rem;
  margin-inline: auto;
  padding: calc(env(safe-area-inset-top) + var(--rct-space-5)) var(--rct-space-4) calc(env(safe-area-inset-bottom) + var(--rct-space-5));
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
  font-family: var(--rct-font-family-sans);
  @mixin rct-type-body;
}

.admin-semester-screen__header,
.admin-semester-screen__content,
.admin-semester-card,
.admin-semester-form,
.admin-semester-group {
  display: grid;
  gap: var(--rct-space-3);
}

.admin-semester-screen__header {
  gap: var(--rct-space-1);
  margin-block-end: var(--rct-space-5);
}

.admin-semester-screen__header p,
.admin-semester-screen h1,
.admin-semester-screen h2,
.admin-semester-screen h3,
.admin-semester-card p {
  margin: 0;
}

.admin-semester-screen__header > p,
.admin-semester-screen__description,
.admin-semester-form__hint {
  color: var(--rct-color-text-muted);
  font-size: var(--rct-font-size-caption);
}

.admin-semester-screen__heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-3);
}

.admin-semester-screen h1 {
  font-size: var(--rct-font-size-title-screen);
  font-weight: var(--rct-font-weight-bold);
}

.admin-semester-screen h2 {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  font-weight: var(--rct-font-weight-bold);
  text-transform: uppercase;
  letter-spacing: 0.01em;
}

.admin-semester-screen h3 {
  font-size: var(--rct-font-size-title);
  font-weight: var(--rct-font-weight-bold);
}

.admin-semester-screen__new,
.admin-semester-action {
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-2) var(--rct-space-3);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
  font: inherit;
  font-weight: var(--rct-font-weight-bold);
  cursor: pointer;
}

.admin-semester-screen__new {
  flex: 0 0 auto;
  font-size: var(--rct-font-size-caption);
}

.admin-semester-card {
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  background: var(--rct-color-surface-raised);
}

.admin-semester-card--active {
  background: var(--rct-color-success-surface);
}

.admin-semester-card__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--rct-space-3);
}

.admin-semester-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-2);
}

.admin-semester-card__period {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-dense);
}

.admin-semester-card__type {
  color: var(--rct-color-text-muted);
  font-size: var(--rct-font-size-caption);
}

.admin-semester-status {
  flex: 0 0 auto;
  color: var(--rct-color-text-muted);
  font-size: var(--rct-font-size-caption);
  white-space: nowrap;
}

.admin-semester-status--active {
  color: var(--rct-color-success-text);
}

.admin-semester-status--archived {
  color: var(--rct-color-warning-text);
}

.admin-semester-form {
  margin-block-end: var(--rct-space-5);
}

.admin-semester-form label {
  display: grid;
  gap: var(--rct-space-1);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.admin-semester-form input:not([type='radio']) {
  min-block-size: var(--rct-control-min-touch);
  inline-size: 100%;
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding: 0 var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
  font: inherit;
}

.admin-semester-form__types {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-2) var(--rct-space-4);
  border: 0;
  margin: 0;
  padding: 0;
}

.admin-semester-form__types legend {
  margin-block-end: var(--rct-space-1);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.admin-semester-form__type-option {
  display: inline-flex !important;
  min-block-size: var(--rct-control-min-touch);
  align-items: center;
  gap: var(--rct-space-2) !important;
  padding-inline: var(--rct-space-2);
  border-radius: var(--rct-radius-md);
  color: var(--rct-color-text-primary) !important;
  cursor: pointer;
}

.admin-semester-form__type-option input[type='radio'] {
  inline-size: 1.25rem;
  block-size: 1.25rem;
  margin: 0;
  accent-color: var(--rct-color-accent-now);
}

.admin-semester-form__dates {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--rct-space-3);
}

.admin-semester-form__hint {
  margin: 0;
}

.admin-semester-action--secondary {
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
}

.admin-semester-action--danger {
  border: var(--rct-border-hairline) solid var(--rct-color-danger-text);
  color: var(--rct-color-danger-text);
  background: var(--rct-color-surface-base);
}

.admin-semester-deletion-counts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--rct-space-2) var(--rct-space-3);
  margin: 0;
}

.admin-semester-deletion-counts > div {
  display: grid;
  gap: var(--rct-space-1);
  min-inline-size: 0;
}

.admin-semester-deletion-counts dt {
  color: var(--rct-color-text-muted);
  font-size: var(--rct-font-size-caption);
}

.admin-semester-deletion-counts dd {
  margin: 0;
  color: var(--rct-color-text-primary);
  font-weight: var(--rct-font-weight-bold);
}

.admin-semester-deletion-confirmation__warning,
.admin-semester-deletion-progress__reason {
  border-inline-start: var(--rct-border-hairline) solid var(--rct-color-danger-text);
  padding-inline-start: var(--rct-space-3);
  color: var(--rct-color-danger-text);
}

.admin-semester-deletion-confirmation__password {
  display: grid;
  gap: var(--rct-space-1);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.admin-semester-deletion-confirmation__password input {
  min-block-size: var(--rct-control-min-touch);
  inline-size: 100%;
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding: 0 var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-base);
  font: inherit;
}

.admin-semester-confirmation > p,
.admin-semester-archive-details > p {
  margin: 0;
}

.admin-semester-archive-progress {
  margin: 0;
  border-inline-start: var(--rct-border-hairline) solid var(--rct-color-warning-text);
  padding-inline-start: var(--rct-space-3);
  color: var(--rct-color-text-secondary);
}

.admin-semester-archive-details {
  display: grid;
  gap: var(--rct-space-1);
  color: var(--rct-color-text-muted);
  font-size: var(--rct-font-size-caption);
}

.admin-semester-archive-details ul {
  display: grid;
  gap: var(--rct-space-1);
  margin: 0;
  padding-inline-start: var(--rct-space-4);
}

.admin-semester-action:disabled,
.admin-semester-screen__new:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: default;
}

.admin-semester-state {
  margin: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-raised);
}

.admin-semester-state--error {
  color: var(--rct-color-danger-text);
}

.admin-semester-state--success {
  color: var(--rct-color-success-text);
}

.admin-semester-state--warning {
  color: var(--rct-color-warning-text);
}

.admin-semester-screen__new:focus-visible,
.admin-semester-action:focus-visible,
.admin-semester-form input:focus-visible,
.admin-semester-deletion-confirmation__password input:focus-visible,
.admin-semester-form__type-option:focus-within {
  outline: var(--rct-focus-width) solid var(--rct-color-accent-now);
  outline-offset: var(--rct-focus-offset);
}

@media (prefers-reduced-motion: reduce) {
  .admin-semester-screen *,
  .admin-semester-screen *::before,
  .admin-semester-screen *::after {
    scroll-behavior: auto;
    transition-duration: 0ms;
    animation-duration: 0ms;
  }
}

/* Mobile admin composition, preserving operation monitor styles. */
.admin-semester-screen { max-inline-size:var(--rct-today-content-max); padding-block-end:var(--rct-space-6); }
.admin-semester-screen__header { display:flex; align-items:center; gap:var(--rct-space-3); min-block-size:var(--rct-control-min-touch); margin-block-end:var(--rct-space-5); }
.admin-semester-screen__header h1 { min-inline-size:0; overflow-wrap:anywhere; line-height:var(--rct-leading-snug); }
.admin-semester-back { display:grid; place-items:center; inline-size:var(--rct-control-min-touch); min-block-size:var(--rct-control-min-touch); flex:none; border:0; border-radius:var(--rct-radius-full); background:var(--rct-color-surface-float); color:var(--rct-color-text-secondary); cursor:pointer; @mixin rct-focus-ring; }
.admin-semester-screen__new { inline-size:100%; border-radius:var(--rct-radius-full); margin-block-end:var(--rct-space-5); font-size:var(--rct-font-size-dense); font-weight:var(--rct-font-weight-medium); }
.admin-semester-group { gap:var(--rct-space-3); margin-block-end:var(--rct-space-4); }
.admin-semester-screen h2 { text-transform:none; letter-spacing:normal; font-size:var(--rct-font-size-title); color:var(--rct-color-text-primary); }
.admin-semester-screen h3 { font-size:var(--rct-font-size-body); font-weight:var(--rct-font-weight-medium); overflow-wrap:anywhere; }
.admin-semester-card { border-radius:var(--rct-radius-xl); gap:var(--rct-space-2); padding:var(--rct-space-3) var(--rct-space-4); }
.admin-semester-card--active { background:var(--rct-color-surface-raised); }
.admin-semester-action { border-radius:var(--rct-radius-full); font-size:var(--rct-font-size-dense); font-weight:var(--rct-font-weight-medium); @mixin rct-focus-ring; }
.admin-semester-action--secondary { border:0; background:var(--rct-color-surface-float); }
.admin-semester-card__actions { display:grid; grid-template-columns:minmax(0,1fr); }
.admin-semester-card__details > summary { min-block-size:var(--rct-control-min-touch); align-content:center; color:var(--rct-color-text-secondary); font-size:var(--rct-font-size-caption); cursor:pointer; @mixin rct-focus-ring; }
.admin-semester-card__details > p { color:var(--rct-color-text-secondary); font-size:var(--rct-font-size-caption); margin-block-end:var(--rct-space-3); }
.admin-semester-form { gap:var(--rct-space-4); margin-block-end:var(--rct-space-4); }
.admin-semester-form > label { border-radius:var(--rct-radius-xl); background:var(--rct-color-surface-raised); padding:var(--rct-space-2) var(--rct-space-4); }
.admin-semester-form input:not([type='radio']) { border:0; border-radius:0; padding:0; min-block-size:var(--rct-space-6); background:transparent; color:var(--rct-color-text-primary); font-size:var(--rct-font-size-body); @mixin rct-focus-ring; }
.admin-semester-form__types { display:block; background:transparent; }
.admin-semester-form__type-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--rct-space-2); border-radius:var(--rct-radius-full); background:var(--rct-color-surface-raised); }
.admin-semester-form__types legend { font-size:var(--rct-font-size-title); font-weight:var(--rct-font-weight-bold); color:var(--rct-color-text-primary); margin-block-end:var(--rct-space-3); }
.admin-semester-form .admin-semester-form__type-option { position:relative; display:flex !important; justify-content:center; padding:0; border-radius:var(--rct-radius-full); gap:0 !important; color:var(--rct-color-text-primary); font-size:var(--rct-font-size-dense); }
.admin-semester-form__type-option:has(input:checked) { background:var(--rct-color-accent-now); }
.admin-semester-form__type-option:has(input:checked) span { color:var(--rct-color-accent-on-now); }
.admin-semester-form__type-option:has(input:focus-visible) { outline:var(--rct-focus-width) solid var(--rct-color-accent-now); outline-offset:var(--rct-focus-offset); }
.admin-semester-form__type-option input[type='radio'] { position:absolute; opacity:0; inline-size:100%; block-size:100%; cursor:pointer; }
.admin-semester-form__dates { grid-template-columns:minmax(0,1fr); gap:var(--rct-space-4); }
.admin-semester-form__dates--calendar { grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--rct-space-2); }
.admin-semester-date { min-inline-size:0; padding:0; border-radius:var(--rct-radius-xl); background:var(--rct-color-surface-raised); }
.admin-semester-date__label { font-size:var(--rct-font-size-caption); color:var(--rct-color-text-secondary); }
.admin-semester-date button { display:grid; gap:var(--rct-space-1); min-inline-size:0; inline-size:100%; min-block-size:var(--rct-control-min-touch); padding:var(--rct-space-2) var(--rct-space-4); border:0; border-radius:inherit; background:transparent; color:var(--rct-color-text-primary); font:inherit; text-align:start; white-space:normal; overflow-wrap:anywhere; cursor:pointer; @mixin rct-focus-ring; }
.admin-semester-date[data-selected='true'] { outline:var(--rct-border-hairline) solid var(--rct-color-accent-now); }
.admin-semester-form > .admin-semester-action { margin-block-start:var(--rct-space-6); inline-size:100%; }
@media (max-width:22.5rem) { .admin-semester-form__dates--calendar { grid-template-columns:minmax(0,1fr); } }

.admin-semester-form { display:flex; flex-direction:column; min-block-size:calc(100dvh - var(--rct-control-min-touch) - var(--rct-space-5) * 3 - var(--rct-space-6)); }
.admin-semester-form > .admin-semester-action { margin-block-start:auto; min-block-size:var(--rct-form-submit-height); }

.admin-semester-visually-hidden { position:absolute; inline-size:1px; block-size:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }

/* R2 notices and explicit lifecycle actions. */
.admin-semester-screen > .admin-notice { margin-block-end:var(--rct-space-4); }
.admin-semester-card__details { display:grid; gap:var(--rct-space-3); }
.admin-semester-card__details > p { margin:0; }
.admin-semester-field-error { margin:0; font-size:var(--rct-font-size-caption); }
.admin-semester-form__dates + .semester-calendar { margin:0; }
