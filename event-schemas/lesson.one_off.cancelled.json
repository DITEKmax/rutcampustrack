{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson.one_off.cancelled",
  "description": "Разовая (one-off) пара удалена старостой. Подписчик attendance-service каскадно удаляет attendance-записи (D-22). Генерируется Schedule Service (Phase 60-04).",
  "type": "object",
  "required": ["event_type", "event_id", "occurred_at", "payload"],
  "properties": {
    "event_type": { "const": "lesson.one_off.cancelled" },
    "event_id": { "$ref": "_common.json#/$defs/eventId" },
    "occurred_at": { "$ref": "_common.json#/$defs/occurredAt" },
    "payload": {
      "type": "object",
      "required": ["group_id", "subject_id", "date", "lesson_number"],
      "properties": {
        "group_id": { "type": "integer" },
        "subject_id": { "type": "integer" },
        "date": { "type": "string", "format": "date" },
        "lesson_number": { "$ref": "_common.json#/$defs/lessonNumber" }
      }
    }
  }
}
