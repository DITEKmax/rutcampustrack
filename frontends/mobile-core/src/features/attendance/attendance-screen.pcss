}
:where([data-student-ui]) .attendance-status-badge--future,
:where([data-student-ui]):is(.attendance-status-badge--future) {
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  background: transparent;
}
:where([data-student-ui]) .attendance-graph__columns,
:where([data-student-ui]):is(.attendance-graph__columns) {
  position: relative;
  scrollbar-width: thin;
  touch-action: pan-x pan-y;
  padding-block-end: var(--rct-space-2);
}

:where([data-student-ui]) .attendance-status-explanation p,
:where([data-student-ui]):is(.attendance-status-explanation p) {
  margin: 0;
}

:where([data-student-ui]) .attendance-status-document,
:where([data-student-ui]):is(.attendance-status-document) {
  display: block;
  min-block-size: var(--rct-control-min-touch);
  max-inline-size: 100%;
  margin-block-start: var(--rct-space-2);
  padding: var(--rct-space-2) var(--rct-space-3);
  border: 0;
  border-radius: var(--rct-radius-full);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
  cursor: pointer;
  overflow-wrap: anywhere;
}

:where([data-student-ui]) .attendance-lesson-row__card > .attendance-status-explanation,
:where([data-student-ui]):is(.attendance-lesson-row__card > .attendance-status-explanation) {
  grid-column: 1 / -1;
}

/* The dock and the floating day control share the shell's semantic geometry. */
:where([data-student-ui]) .attendance-screen[data-today-visible='true'],
:where([data-student-ui]):is(.attendance-screen[data-today-visible='true']) {
  padding-block-end: calc(
    env(safe-area-inset-bottom) + var(--rct-mobile-dock-bottom) + var(--rct-mobile-dock-height) +
      var(--rct-control-min-touch) + var(--rct-space-6)
  );
}
:where([data-student-ui]) .attendance-today,
:where([data-student-ui]):is(.attendance-today) {
  position: fixed;
  z-index: 10;
  inset-inline-start: 50%;
  inset-block-end: calc(
    env(safe-area-inset-bottom) + var(--rct-mobile-dock-bottom) + var(--rct-mobile-dock-height) +
      var(--rct-space-3)
  );
  transform: translateX(-50%);
  min-block-size: var(--rct-control-min-touch);
  max-inline-size: calc(100% - var(--rct-space-8));
  padding: var(--rct-space-2) var(--rct-space-5);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-full);
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
  cursor: pointer;
  @mixin rct-type-body;
}
:where([data-student-ui]) .attendance-today:disabled,
:where([data-student-ui]):is(.attendance-today:disabled) {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: default;
}
:where([data-student-ui]) .attendance-subject-list__item--expanded + .attendance-subject-list__item,
:where([data-student-ui]):is(
  .attendance-subject-list__item--expanded + .attendance-subject-list__item
) {
  margin-block-start: var(--rct-space-3);
}
/* A padded background clip keeps square inner corners. Paint the rounded bar separately. */
:where([data-student-ui]) .attendance-type-card__segment--explanation,
:where([data-student-ui]):is(.attendance-type-card__segment--explanation) {
  position: relative;
  background: transparent;
  padding: 0;
}
:where([data-student-ui]) .attendance-type-card__segment--explanation::before,
:where([data-student-ui]):is(.attendance-type-card__segment--explanation::before) {
  content: '';
  position: absolute;
  inset-inline: 0;
  inset-block-start: 50%;
  block-size: var(--rct-space-2);
  transform: translateY(-50%);
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-text-muted);
}
:where([data-student-ui]) .attendance-type-card__segment--excused::before,
:where([data-student-ui]):is(.attendance-type-card__segment--excused::before) {
  background: var(--rct-color-status-excused-fill);
}
:where([data-student-ui]) .attendance-type-card__segment--present::before,
:where([data-student-ui]):is(.attendance-type-card__segment--present::before) {
  background: var(--rct-color-status-present-fill);
}
:where([data-student-ui]) .attendance-type-card__segment--absent::before,
:where([data-student-ui]):is(.attendance-type-card__segment--absent::before) {
  background: var(--rct-color-status-absent-fill);
}
:where([data-student-ui]) .attendance-period-pager button .mobile-icon,
:where([data-student-ui]):is(.attendance-period-pager button .mobile-icon) {
  inline-size: var(--rct-icon-size);
  block-size: var(--rct-icon-size);
}
:where([data-student-ui]) .attendance-period-pager button:enabled:hover,
:where([data-student-ui]):is(.attendance-period-pager button:enabled:hover) {
  color: var(--rct-color-text-primary);
}
:where([data-student-ui]) .attendance-period-pager button:focus-visible,
:where([data-student-ui]):is(.attendance-period-pager button:focus-visible),
:where([data-student-ui]) .attendance-today:focus-visible,
:where([data-student-ui]):is(.attendance-today:focus-visible),
:where([data-student-ui]) .attendance-document-preview:focus-visible,
:where([data-student-ui]):is(.attendance-document-preview:focus-visible),
:where([data-student-ui]) .attendance-explanation-close:focus-visible,
:where([data-student-ui]):is(.attendance-explanation-close:focus-visible),
:where([data-student-ui]) .attendance-document-full button:focus-visible,
:where([data-student-ui]):is(.attendance-document-full button:focus-visible) {
  outline: var(--rct-focus-width) solid var(--rct-color-border-focus);
  outline-offset: var(--rct-focus-offset);
}
:where([data-student-ui]) .attendance-document-preview,
:where([data-student-ui]):is(.attendance-document-preview) {
  display: block;
  inline-size: 100%;
  margin-block-start: var(--rct-space-3);
  padding: var(--rct-space-2);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-raised);
  color: var(--rct-color-text-primary);
  overflow: hidden;
  cursor: zoom-in;
}
:where([data-student-ui]) .attendance-document-preview :is(img, object),
:where([data-student-ui]):is(.attendance-document-preview :is(img, object)) {
  display: block;
  inline-size: 100%;
  block-size: var(--rct-mobile-hero-height);
  object-fit: contain;
  pointer-events: none;
}
:where([data-student-ui]) .attendance-document-full,
:where([data-student-ui]):is(.attendance-document-full) {
  position: fixed;
  inset: 0;
  box-sizing: border-box;
  inline-size: 100%;
  max-inline-size: 100%;
  block-size: 100%;
  max-block-size: 100%;
  margin: 0;
  padding: calc(env(safe-area-inset-top) + var(--rct-space-4)) var(--rct-space-4)
    calc(env(safe-area-inset-bottom) + var(--rct-space-4));
  border: 0;
  background: var(--rct-color-surface-base);
  color: var(--rct-color-text-primary);
}
:where([data-student-ui]) .attendance-document-full[open],
:where([data-student-ui]):is(.attendance-document-full[open]) {
  display: flex;
  flex-direction: column;
  gap: var(--rct-space-4);
}
:where([data-student-ui]) .attendance-document-full header,
:where([data-student-ui]):is(.attendance-document-full header) {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: var(--rct-space-3);
}
:where([data-student-ui]) .attendance-document-full h2,
:where([data-student-ui]):is(.attendance-document-full h2) {
  margin: 0;
  overflow-wrap: anywhere;
  @mixin rct-type-body;
}
:where([data-student-ui]) .attendance-document-full :is(img, object),
:where([data-student-ui]):is(.attendance-document-full :is(img, object)) {
  min-block-size: 0;
  flex: 1;
  inline-size: 100%;
  object-fit: contain;
}
:where([data-student-ui]) .attendance-explanation-close,
:where([data-student-ui]):is(.attendance-explanation-close),
:where([data-student-ui]) .attendance-document-full button,
:where([data-student-ui]):is(.attendance-document-full button) {
  min-block-size: var(--rct-control-min-touch);
  padding: var(--rct-space-2) var(--rct-space-3);
  border: 0;
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
  cursor: pointer;
}
:where([data-student-ui]) .attendance-explanation-close,
:where([data-student-ui]):is(.attendance-explanation-close),
:where([data-student-ui]) .attendance-document-full .attendance-document-close,
:where([data-student-ui]):is(.attendance-document-full .attendance-document-close) {
  display: grid;
  place-items: center;
  flex: 0 0 var(--rct-control-min-touch);
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  padding: 0;
}
:where([data-student-ui]) .attendance-explanation-close,
:where([data-student-ui]):is(.attendance-explanation-close) {
  position: absolute;
  inset-block-start: var(--rct-space-2);
  inset-inline-end: var(--rct-space-2);
}
:where([data-student-ui]) .attendance-status-explanation:has(.attendance-explanation-close) > p,
:where([data-student-ui]):is(
  .attendance-status-explanation:has(.attendance-explanation-close) > p
) {
  min-block-size: var(--rct-control-min-touch);
  padding-inline-end: calc(var(--rct-control-min-touch) + var(--rct-space-2));
}
