+    CONSTRAINT campus_map_floor_daily_demand_id_positive_chk CHECK (id > 0),
+    CONSTRAINT campus_map_floor_daily_demand_count_chk CHECK (open_count >= 0),
+    CONSTRAINT campus_map_floor_daily_demand_floor_fk
