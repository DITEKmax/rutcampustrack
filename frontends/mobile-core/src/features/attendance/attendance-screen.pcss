}

:where([data-student-ui]) .attendance-period-pager,
:where([data-student-ui]):is(.attendance-period-pager) {
  display: grid;
  grid-template-columns: var(--rct-control-min-touch) minmax(0, 1fr) var(--rct-control-min-touch);
  gap: var(--rct-space-1);
  align-items: center;
  text-align: center;
  color: var(--rct-color-text-secondary);
  @mixin rct-type-micro;
}

:where([data-student-ui]) .attendance-week-pager__label,
:where([data-student-ui]):is(.attendance-week-pager__label) {
  display: grid;
  gap: var(--rct-space-1);
  min-inline-size: 0;
  overflow-wrap: anywhere;
}

:where([data-student-ui]) .attendance-period-pager button,
:where([data-student-ui]):is(.attendance-period-pager button) {
  inline-size: var(--rct-control-min-touch);
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
  cursor: pointer;
}

:where([data-student-ui]) .attendance-period-pager button:disabled,
:where([data-student-ui]):is(.attendance-period-pager button:disabled) {
  opacity: 0.4;
  cursor: default;
}

:where([data-student-ui]) .attendance-sunday,
:where([data-student-ui]):is(.attendance-sunday) {
  inline-size: 100%;
  min-block-size: var(--rct-control-min-touch);
  margin-block-end: var(--rct-space-3);
  border: 0;
  border-radius: var(--rct-radius-xl);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
}

:where([data-student-ui]) .attendance-sunday[aria-pressed='true'],
:where([data-student-ui]):is(.attendance-sunday[aria-pressed='true']) {
  background: var(--rct-color-accent-now);
  color: var(--rct-color-accent-on-now);
}

:where([data-student-ui]) .attendance-days__empty,
:where([data-student-ui]):is(.attendance-days__empty) {
  display: grid;
  place-items: center;
  align-content: center;
  gap: var(--rct-space-3);
  min-block-size: var(--rct-attendance-empty-height, var(--rct-state-min-height));
  margin: 0;
  padding: var(--rct-space-4);
  border-radius: var(--rct-radius-2xl);
  background: var(--rct-color-surface-raised);
  color: var(--rct-color-text-primary);
  @mixin rct-type-screen-title;
}

:where([data-student-ui]) .attendance-days__empty p,
:where([data-student-ui]):is(.attendance-days__empty p) {
  margin: 0;
}

:where([data-student-ui]) .attendance-days__empty-art,
:where([data-student-ui]):is(.attendance-days__empty-art) {
  inline-size: calc(var(--rct-space-8) * 5);
  max-inline-size: 100%;
}

:where([data-student-ui]) .attendance-days__empty-art svg,
:where([data-student-ui]):is(.attendance-days__empty-art svg) {
  display: block;
  inline-size: 100%;
  block-size: auto;
}

:where([data-student-ui]) .attendance-lesson-row__time,
:where([data-student-ui]):is(.attendance-lesson-row__time) {
  @mixin rct-type-lesson-meta;
  color: var(--rct-color-text-secondary);
  margin: 0;
  gap: var(--rct-space-half);
  align-content: start;
  display: grid;
  padding-block-start: 0;
}

:where([data-student-ui]) button.attendance-status-badge,
:where([data-student-ui]):is(button.attendance-status-badge) {
  cursor: pointer;
}

:where([data-student-ui]) button.attendance-status-badge::after,
:where([data-student-ui]):is(button.attendance-status-badge::after) {
  content: '';
  position: absolute;
  min-inline-size: var(--rct-control-min-touch);
  min-block-size: var(--rct-control-min-touch);
  inset: var(--rct-status-hit-offset);
  border-radius: inherit;
}

:where([data-student-ui]) .attendance-lesson-row__metadata span,
:where([data-student-ui]):is(.attendance-lesson-row__metadata span) {
  overflow-wrap: anywhere;
  gap: var(--rct-space-1);
  min-inline-size: 0;
  align-items: center;
  display: inline-flex;
  min-block-size: var(--rct-icon-size);
}

:where([data-student-ui]) .attendance-lesson-row__action,
:where([data-student-ui]):is(.attendance-lesson-row__action) {
  cursor: pointer;
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
  padding: var(--rct-space-2) var(--rct-space-3);
  border: 0;
  min-block-size: var(--rct-control-min-touch);
  border-radius: var(--rct-radius-full);
  text-align: center;
}

:where([data-student-ui])
  .attendance-lesson-row[data-status='cancelled']
  .attendance-lesson-row__card,
:where([data-student-ui]):is(
  .attendance-lesson-row[data-status='cancelled'] .attendance-lesson-row__card
) {
  color: var(--rct-color-text-muted);
}

:where([data-student-ui]) .attendance-lesson-row[data-status='cancelled'] h3,
:where([data-student-ui]):is(.attendance-lesson-row[data-status='cancelled'] h3) {
  color: inherit;
  text-decoration: line-through;
}

:where([data-student-ui]) .attendance-subject-list > ul,
:where([data-student-ui]):is(.attendance-subject-list > ul) {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: var(--rct-space-3);
}

:where([data-student-ui]) .attendance-subject-list__item,
:where([data-student-ui]):is(.attendance-subject-list__item) {
  border-radius: var(--rct-radius-xl);
  min-inline-size: 0;
  background: transparent;
}

:where([data-student-ui]) .attendance-subject-list__trigger,
:where([data-student-ui]):is(.attendance-subject-list__trigger) {
  text-align: start;
  cursor: pointer;
  background: transparent;
  color: var(--rct-color-text-primary);
  border-radius: var(--rct-radius-xl);
  border: 0;
  min-block-size: var(--rct-control-min-touch);
  inline-size: 100%;
  align-items: center;
  display: flex;
  justify-content: start;
  padding: 0;
  gap: var(--rct-space-1);
}

:where([data-student-ui]) .attendance-subject-list__trigger-label,
:where([data-student-ui]):is(.attendance-subject-list__trigger-label) {
  @mixin rct-type-date-heading;
  overflow-wrap: anywhere;
  min-inline-size: 0;
}

:where([data-student-ui]) .attendance-subject-list__disclosure :is(img, .rct-svg-icon),
:where([data-student-ui]):is(.attendance-subject-list__disclosure :is(img, .rct-svg-icon)) {
  block-size: var(--rct-icon-size);
  inline-size: var(--rct-icon-size);
  transform: rotate(-90deg);
  transition: none;
}

:where([data-student-ui]) .attendance-subject-list__cards,
:where([data-student-ui]):is(.attendance-subject-list__cards) {
  padding: var(--rct-space-3) var(--rct-space-2) var(--rct-space-4);
  gap: var(--rct-attendance-type-card-gap);
  display: grid;
  padding-inline: 0;
  padding-block: var(--rct-space-6);
}

:where([data-student-ui]) .attendance-type-card__metrics,
:where([data-student-ui]):is(.attendance-type-card__metrics) {
  @mixin rct-type-micro;
  color: var(--rct-color-text-primary);
  gap: var(--rct-space-2);
  justify-content: space-between;
  display: flex;
  flex-wrap: wrap;
}

:where([data-student-ui]) .attendance-state,
:where([data-student-ui]):is(.attendance-state) {
  text-align: center;
  background: var(--rct-color-surface-raised);
  color: var(--rct-color-text-secondary);
  padding: var(--rct-space-5);
  border-radius: var(--rct-radius-2xl);
  min-block-size: var(--rct-state-min-height);
  gap: var(--rct-space-3);
  justify-items: center;
  display: grid;
  border: 0;
}

:where([data-student-ui]) .attendance-graph,
:where([data-student-ui]):is(.attendance-graph) {
  display: grid;
  min-inline-size: 0;
  gap: var(--rct-space-3);
  padding: var(--rct-space-3);
  border-radius: var(--rct-radius-2xl);
  background: var(--rct-color-surface-raised);
}

:where([data-student-ui]) .attendance-graph__range,
:where([data-student-ui]):is(.attendance-graph__range) {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--rct-space-2);
}

:where([data-student-ui]) .attendance-graph__range-button,
:where([data-student-ui]):is(.attendance-graph__range-button) {
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
}

:where([data-student-ui]) .attendance-graph__plot,
:where([data-student-ui]):is(.attendance-graph__plot) {
  position: relative;
  display: grid;
  grid-template-columns: max-content minmax(0, 1fr);
  gap: var(--rct-space-2);
  min-inline-size: 0;
  padding: 0;
  border-radius: var(--rct-radius-lg);
  background: var(--rct-color-surface-float);
}

:where([data-student-ui]) .attendance-graph__axis,
