{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutcampustrack.ru/event-schemas/password.changed.json",
  "title": "password.changed",
  "description": "Metadata-only credential-change intent; v2 retains original account and generation for exact-card cleanup.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "traceparent": {
      "description": "Optional standard W3C parent captured before durable outbox serialization.",
      "type": "string",
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "request_id": {
      "description": "Optional canonical request correlation, independent of event and trace IDs.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "event_type": {
      "const": "password.changed"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "event_version": {
      "type": "integer"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "const": "auth-service"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "event_version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "telegram_id"
          ],
          "properties": {
            "telegram_id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "event_version": {
          "const": 2
        },
        "payload": {
          "type": "object",
          "required": [
            "user_id",
            "credentials_version",
            "telegram_binding_version"
          ],
          "properties": {
            "user_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "credentials_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "telegram_binding_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "telegram_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
