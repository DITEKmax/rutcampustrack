{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "group.membership.changed",
  "description": "Личный факт перевода в группу без персональных данных.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "group.membership.changed"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "new_group_id",
        "effective_date",
        "change"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "old_group_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "new_group_id": {
          "type": "integer",
          "minimum": 1
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "change": {
          "const": "TRANSFERRED"
        },
        "actor_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "event_version": {
      "const": 1
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
