@import '../styles/tokens.pcss';
.admin-academic-review__toolbar {
  position: relative;
  z-index: 2;
  display: flex;
  gap: var(--rct-space-3);
  padding: var(--rct-space-2);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
  font-size: var(--rct-font-size-caption);
}
.admin-academic-review__toolbar select,
.admin-academic-review__toolbar button {
  font: inherit;
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  border: 0;
  min-block-size: var(--rct-control-min-touch);
}
.admin-academic-review[data-back-owner='host'] .admin-groups-back,
.admin-academic-review[data-back-owner='host'] .admin-semester-back {
  display: none;
}
