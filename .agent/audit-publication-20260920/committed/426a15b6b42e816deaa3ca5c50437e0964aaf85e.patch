+  try {
+    response = await fetcher(path, {
+      method,
+      headers,
+      credentials: 'include',
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+    })
+  } catch (error) {
+    throw new AuthRequestError(operation, undefined, { code: 'NETWORK', title: 'Нет соединения с сервером' }, error)
