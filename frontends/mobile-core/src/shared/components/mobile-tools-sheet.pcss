@import '../../styles/tokens.pcss';
.mobile-tools-sheet { inline-size: calc(100% - var(--rct-space-4) * 2); max-inline-size: var(--rct-mobile-content-width); max-block-size: calc(100dvh - var(--rct-space-4) * 2); border: 0; border-radius: var(--rct-radius-2xl); padding: var(--rct-space-4); color: var(--rct-color-text-primary); background: var(--rct-color-surface-float); overflow: auto; }
.mobile-tools-sheet::backdrop { background: var(--rct-role-overlay-surface); }
.mobile-tools-sheet > header { display: flex; align-items: center; justify-content: space-between; gap: var(--rct-space-3); margin-block-end: var(--rct-space-4); }
.mobile-tools-sheet h2 { margin: 0; font-size: var(--rct-font-size-title); overflow-wrap: anywhere; }
.mobile-tools-sheet > header button, .mobile-toolbar button { min-block-size: var(--rct-control-min-touch); border: 0; border-radius: var(--rct-radius-xl); padding: var(--rct-space-2) var(--rct-space-3); color: var(--rct-color-text-primary); background: var(--rct-color-surface-raised); font: inherit; cursor: pointer; @mixin rct-focus-ring; }
.mobile-tools-sheet__content { display: grid; gap: var(--rct-space-3); min-inline-size: 0; }
.mobile-toolbar { display: flex; flex-wrap: wrap; gap: var(--rct-space-2); }
.mobile-toolbar button { flex: 1; min-inline-size: 0; font-size: var(--rct-font-size-caption); }
.mobile-toolbar button:disabled { color: var(--rct-color-disabled-text); background: var(--rct-color-disabled-surface); cursor: not-allowed; }

.mobile-tools-sheet:not([open]) { display: none; }

.mobile-tools-sheet > header .mobile-tools-sheet__icon-close { display: grid; place-items: center; flex: 0 0 auto; inline-size: var(--rct-control-min-touch); padding: var(--rct-space-2); border-radius: var(--rct-radius-full); }
.mobile-tools-sheet__icon-close svg { inline-size: var(--rct-icon-size); block-size: var(--rct-icon-size); }
