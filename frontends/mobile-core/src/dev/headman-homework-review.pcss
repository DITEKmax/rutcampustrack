@import '../styles/tokens.pcss';
.headman-review > .mobile-shell { min-block-size: 100dvh; }
.headman-review__links { display: flex; flex-wrap: wrap; gap: var(--rct-space-2); padding: var(--rct-space-4); font-size: var(--rct-font-size-micro); }
.headman-review__links a { color: var(--rct-color-text-secondary); }
