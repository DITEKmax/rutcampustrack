@import '../styles/tokens.pcss';
.notifications-review-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--rct-space-3);
  padding: var(--rct-space-4);
  color: var(--rct-color-text-primary);
}
.notifications-review-controls p {
  flex-basis: 100%;
}
.notifications-review-controls button,
.notifications-review-controls label {
  min-block-size: var(--rct-control-min-touch);
}
