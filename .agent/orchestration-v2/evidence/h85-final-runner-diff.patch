+function ConvertTo-StrictActuatorCount {
+    param(
+        [AllowNull()][object]$Value,
+        [Parameter(Mandatory = $true)][string]$Context
+    )
+    Assert-That ($null -ne $Value) "$Context COUNT value is missing"
+    Assert-That (-not ($Value -is [bool])) "$Context COUNT value is not numeric"
+    $numeric = $null
+    if ($Value -is [sbyte] -or $Value -is [byte] -or $Value -is [int16] -or $Value -is [uint16] -or $Value -is [int32] -or $Value -is [uint32] -or $Value -is [int64] -or $Value -is [uint64] -or $Value -is [decimal]) {
+        $numeric = [decimal]$Value
+    } elseif ($Value -is [single] -or $Value -is [double]) {
+        $doubleValue = [double]$Value
+        Assert-That (-not [double]::IsNaN($doubleValue) -and -not [double]::IsInfinity($doubleValue)) "$Context COUNT value is not finite"
+        Assert-That ($doubleValue -eq [Math]::Truncate($doubleValue)) "$Context COUNT value is not an exact integer"
+        Assert-That ($doubleValue -le 9007199254740991) "$Context COUNT floating value exceeds the exact safe integer range"
+        $numeric = [decimal]$doubleValue
+    } else {
+        throw "$Context COUNT value has an unsupported type"
+    }
+    Assert-That ($numeric -ge 0 -and $numeric -eq [decimal]::Truncate($numeric)) "$Context COUNT value is not a non-negative exact integer"
+    Assert-That ($numeric -le [decimal][long]::MaxValue) "$Context COUNT value exceeds Int64"
+    return [int64]$numeric
+}
