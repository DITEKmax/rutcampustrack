@import '../../styles/tokens.pcss';
.teacher-screen .teacher-lesson-card {
  padding-inline-end: var(--rct-space-4);
  margin-block-start: var(--rct-space-4);
  padding-block-start: var(--rct-space-5);
  min-block-size: var(--rct-control-min-touch);
}
.teacher-lesson-card[data-one-off='true']:not([data-presentation='today']) {
  color: var(--rct-color-status-present-on-fill);
  background: var(--rct-color-status-present-fill);
}
.teacher-lesson-card[data-current='true'] {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
.teacher-lesson-card[data-cancelled='true']:not([data-presentation='today']) {
  color: var(--rct-color-status-absent-on-fill);
  background: var(--rct-color-status-absent-fill);
}
.teacher-lesson-card__topline {
  display: flex;
  flex-direction: row-reverse;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  column-gap: var(--rct-space-2);
  row-gap: var(--rct-space-1);
  min-inline-size: 0;
}
.teacher-lesson-card .teacher-lesson-card__time {
  flex: 1 0 auto;
  max-inline-size: 100%;
  min-inline-size: 0;
  margin: 0;
}
.teacher-lesson-card__identity {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: var(--rct-space-1);
  min-inline-size: 0;
  max-inline-size: 100%;
  margin-inline-start: auto;
}
.teacher-lesson-card__header {
  display: contents;
}
.teacher-lesson-card[data-presentation='today'] .teacher-lesson-card__header {
  position: absolute;
  inset-block-start: 0;
  inset-inline: var(--rct-space-4);
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-2);
}
.teacher-lesson-card:not([data-presentation='today']) .teacher-lesson-card__group {
  position: absolute;
  inset-block-start: 0;
  inset-inline-end: var(--rct-space-4);
  transform: translateY(-50%);
  max-inline-size: calc(100% - var(--rct-space-4) * 2);
}
.teacher-lesson-card .teacher-lesson-card__group,
.teacher-lesson-card__header > .teacher-lesson-card__tag {
  min-inline-size: 0;
  margin: 0;
  padding: var(--rct-space-1) var(--rct-space-3);
  border-radius: var(--rct-radius-full);
  background: var(--rct-color-surface-float);
  color: var(--rct-color-text-primary);
  font-size: var(--rct-font-size-caption);
  line-height: var(--rct-leading-caption);
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}
.teacher-lesson-card__header > .teacher-lesson-card__tag {
  flex: none;
}
.teacher-lesson-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-1);
  margin-block-end: var(--rct-space-1);
}
.teacher-lesson-card__tag {
  min-inline-size: 0;
  padding: var(--rct-space-half);
  border-radius: var(--rct-radius-full);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  font-size: var(--rct-font-size-micro);
  line-height: var(--rct-leading-caption);
  overflow-wrap: anywhere;
}
.teacher-lesson-card__identity > .teacher-lesson-card__tag {
  flex: 0 1 auto;
}
.teacher-lesson-card__tag[data-tone='cancelled'],
.teacher-lesson-card__tag[data-tone='one-off'] {
  color: inherit;
  background: transparent;
}
.teacher-lesson-card__tag[data-tone='active'] {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
.teacher-lesson-card__header > .teacher-lesson-card__tag[data-tone='active'] {
  color: var(--rct-color-accent-now);
  background: var(--rct-color-accent-soft);
}
.teacher-lesson-card__header > .teacher-lesson-card__tag[data-tone='moved'] {
  color: var(--rct-color-state-warning-text);
  background: var(--rct-color-state-warning-bg);
}
.teacher-lesson-card__header > .teacher-lesson-card__tag[data-tone='one-off'] {
  color: var(--rct-color-state-success-text);
  background: var(--rct-color-state-success-bg);
}
.teacher-lesson-card__header > .teacher-lesson-card__tag[data-tone='cancelled'] {
  color: var(--rct-color-state-danger-text);
  background: var(--rct-color-state-danger-bg);
}
.teacher-lesson-card__cancellation {
  margin-block-start: var(--rct-space-2);
  font-size: var(--rct-font-size-caption);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.teacher-lesson-detail__download {
  position: relative;
  flex: none;
  margin-inline-start: auto;
}

.teacher-lesson-card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-3);
  min-inline-size: 0;
}
.teacher-lesson-card__title-row .teacher-lesson-card__title {
  min-inline-size: 0;
  padding-inline-end: 0;
}
.teacher-lesson-card__title-row .teacher-lesson-card__next {
  position: static;
  flex: none;
}
.teacher-lesson-detail__download > .teacher-screen__icon-button {
  position: relative;
  z-index: 20;
}

.teacher-lesson-card__meta {
  font-size: var(--rct-font-size-caption);
  flex-wrap: wrap;
  column-gap: var(--rct-space-5);
  row-gap: var(--rct-space-1);
}
.teacher-lesson-card__meta-item {
  display: inline-flex;
  align-items: center;
  gap: var(--rct-space-1);
  min-inline-size: 0;
}
.teacher-lesson-card__meta-item > span {
  min-inline-size: 0;
  overflow-wrap: anywhere;
}
.teacher-lesson-card[data-current='true'] .teacher-lesson-card__meta,
.teacher-lesson-card[data-one-off='true']:not([data-presentation='today']) .teacher-lesson-card__meta,
.teacher-lesson-card[data-cancelled='true']:not([data-presentation='today'])
  .teacher-lesson-card__meta {
  color: inherit;
}
.teacher-lesson-card[data-compact='true'] .teacher-lesson-card__meta {
  padding-inline-end: calc(var(--rct-space-4) * 2);
}
