@import '../../styles/tokens.pcss';

.requests-form-screen {
  --requests-base: var(--rct-color-surface-base);
  --requests-raised: var(--rct-color-surface-raised);
  --requests-float: var(--rct-color-surface-float);
  --requests-text: var(--rct-color-text-primary);
  --requests-secondary: var(--rct-color-text-secondary);
  --requests-muted: var(--rct-color-text-muted);
  --requests-border: var(--rct-color-border-default);
  --requests-on-accent: var(--rct-color-accent-on-now);
  --requests-danger-fill: var(--rct-color-status-absent-fill);
  --requests-warning-fill: var(--rct-warning-surface, color-mix(in srgb, var(--rct-color-warning-text) 14%, var(--rct-color-surface-raised)));
  --requests-warning-soft: var(--requests-warning-fill);
  inline-size: 100%;
  max-inline-size: var(--rct-today-content-max);
  min-inline-size: 0;
  padding-block: var(--rct-space-5) var(--rct-space-6);
  padding-inline: var(--rct-space-4);
  overflow-wrap: anywhere;
}

.requests-form-screen .requests-form-header {
  gap: var(--rct-space-2-half);
  margin-block-end: var(--rct-space-3);
}

.requests-form-screen .requests-form-header h1 {
  min-inline-size: 0;
  @mixin rct-type-task-title;
}

.requests-form-screen .requests-back-button {
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border-radius: var(--rct-task-back-radius);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-float);
}

.requests-form-screen .requests-back-button .mobile-icon {
  inline-size: var(--rct-icon-size);
  block-size: var(--rct-icon-size);
}

.requests-form-screen .requests-form {
  min-inline-size: 0;
  gap: var(--rct-space-3);
}

.requests-form-screen .requests-form__section {
  min-inline-size: 0;
  gap: var(--rct-space-2);
}

.requests-form-screen .request-field {
  min-inline-size: 0;
  gap: var(--rct-space-3);
}

.requests-form-screen .request-field__label {
  @mixin rct-type-field-label;
}

.requests-form-screen .request-field select,
.requests-form-screen .request-field textarea {
  min-inline-size: 0;
  border: 0;
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-2-half) var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  @mixin rct-type-body;
  @mixin rct-focus-ring;
}

.requests-form-screen .request-field select {
  min-block-size: var(--rct-form-select-height);
  padding-inline-end: calc(var(--rct-space-3) * 2 + var(--rct-icon-size));
}

.requests-form-screen .request-field textarea {
  min-block-size: var(--rct-form-textarea-height);
}

.requests-form-screen .request-field textarea::placeholder {
  color: var(--rct-color-text-secondary);
  opacity: 1;
}

.requests-form-screen .request-select-icon {
  inset-inline-end: var(--rct-space-3);
  inline-size: var(--rct-icon-size);
  block-size: var(--rct-icon-size);
}

.requests-form-screen .request-field__help,
.requests-form-screen .request-validation-hint,
.requests-form-screen .request-form-error,
.requests-form-screen .requests-form-status,
.requests-form-screen .requests-offline {
  overflow-wrap: anywhere;
  @mixin rct-type-lesson-meta;
}

.requests-form-screen .requests-submit-action {
  min-block-size: var(--rct-form-submit-height);
  margin-block-start: 0;
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-2) var(--rct-space-4);
  color: var(--rct-color-text-primary);
  background: var(--rct-today-action-gradient);
  overflow-wrap: anywhere;
  @mixin rct-type-action;
  @mixin rct-focus-ring;
}

.requests-form-screen .requests-submit-action:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
}

.requests-form-screen .requests-secondary-action {
  min-inline-size: 0;
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  padding: var(--rct-space-2) var(--rct-space-4);
  overflow-wrap: anywhere;
  @mixin rct-type-action;
}

.requests-form-screen .requests-state,
.requests-form-screen .request-budget-card,
.requests-form-screen .request-confirmation-panel {
  min-inline-size: 0;
  gap: var(--rct-space-3);
  border: 0;
  padding: var(--rct-space-4);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-raised);
}

.requests-form-screen .request-confirmation-panel h2,
.requests-form-screen .requests-state h2 {
  color: var(--rct-color-text-primary);
  @mixin rct-type-list-title;
}

.requests-form-screen .request-budget-card p,
.requests-form-screen .request-confirmation-panel p {
  @mixin rct-type-field-label;
}

.request-attachment-field--compact {
  min-inline-size: 0;
  gap: var(--rct-space-2);
}

.request-attachment-field--compact .request-attachment-picker {
  min-inline-size: 0;
  min-block-size: var(--rct-form-upload-height);
  gap: var(--rct-space-1);
  border: var(--rct-border-hairline) dashed var(--rct-color-border-default);
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-2-half) var(--rct-space-4);
  color: var(--rct-color-text-primary);
  overflow-wrap: anywhere;
  @mixin rct-type-body;
  place-items: center;
  text-align: center;
}

.request-attachment-field--compact .request-attachment-picker__hint {
  color: var(--rct-color-text-muted);
  @mixin rct-type-lesson-meta;
}

.request-attachment-field--compact .request-attachment-preview__image,
.request-attachment-field--compact .request-attachment-preview__pdf {
  border: 0;
}

.requests-form-screen .request-validation-hint,
.requests-form-screen .request-form-error,
.requests-form-screen .request-lesson-option__reason,
.requests-form-screen .request-lesson-selector__unavailable,
.requests-form-screen .request-lesson-recovery-panel h3,
.requests-form-screen .request-lesson-recovery-panel p,
.requests-form-screen .request-lesson-recovery-list {
  color: var(--rct-color-danger-text);
}

.requests-form-screen .request-lesson-recovery-panel {
  border: 0;
  background: var(--rct-error-surface, color-mix(in srgb, var(--rct-color-danger-text) 14%, var(--rct-color-surface-raised)));
}

.requests-form-screen .request-lesson-recovery-list li {
  flex-wrap: wrap;
}

.requests-form-screen .request-lesson-option {
  border: 0;
  padding: var(--rct-space-3);
  background: var(--rct-color-surface-raised);
}

.requests-form-screen .request-lesson-option--selected {
  outline: var(--rct-border-hairline) solid var(--rct-color-accent-now);
  outline-offset: calc(0rem - var(--rct-border-hairline));
}

.requests-form-screen .request-lesson-option--disabled {
  opacity: 1;
}

.requests-form-screen .request-budget-card,
.requests-form-screen .request-confirmation-panel {
  border-radius: var(--rct-radius-2xl);
}

.requests-form-screen .request-lesson-selector__empty,
.requests-form-screen .request-field__help--error { color: var(--rct-color-danger-text); }
