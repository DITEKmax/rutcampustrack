{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "homework.due_reminder",
  "description": "Academic Service sends a per-student reminder two days before a homework due date.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "homework.due_reminder"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "group_id",
        "semester_id",
        "days_before_due",
        "due_date",
        "homework"
      ],
      "properties": {
        "user_id": {
          "type": "integer"
        },
        "group_id": {
          "type": "integer"
        },
        "semester_id": {
          "type": "integer"
        },
        "days_before_due": {
          "const": 2
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "homework": {
          "$ref": "#/$defs/homeworkItem"
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string"
    }
  },
  "$defs": {
    "homeworkItem": {
      "type": "object",
      "required": [
        "homework_id",
        "subject_id",
        "subject_name",
        "title",
        "has_link",
        "lesson_date",
        "lesson_number"
      ],
      "properties": {
        "homework_id": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "subject_name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_link": {
          "type": "boolean"
        },
        "lesson_date": {
          "type": "string",
          "format": "date"
        },
        "lesson_number": {
          "$ref": "_common.json#/$defs/lessonNumber"
        }
      }
    }
  }
}
