  "components" : {
    "schemas" : {
      "Keys" : {
        "type" : "object",
        "description" : "Ключи шифрования Web Push подписки",
        "properties" : {
          "p256dh" : {
            "type" : "string",
            "description" : "Публичный ключ P-256 ECDH в base64url",
            "example" : "BKR2jT5k1Iu93_V8AHx3cpqE...",
            "minLength" : 1
          },
          "auth" : {
            "type" : "string",
            "description" : "Auth secret в base64url",
            "example" : "tBHItJI5svbpez7KI4CCXg",
            "minLength" : 1
          }
        },
        "required" : [ "auth", "p256dh" ]
      },
      "SubscribeRequest" : {
        "type" : "object",
        "description" : "Запрос подписки клиента на Web Push (endpoint + ключи шифрования)",
        "properties" : {
          "endpoint" : {
            "type" : "string",
            "description" : "Endpoint push-подписки (FCM, Mozilla autopush и т.д.)",
            "example" : "https://fcm.googleapis.com/fcm/send/abc123DEF456",
            "minLength" : 1
          },
          "keys" : {
            "$ref" : "#/components/schemas/Keys",
            "description" : "Публичные ключи подписки (p256dh, auth) из PushSubscription"
          }
        },
        "required" : [ "endpoint", "keys" ]
      },
      "EntityModelVapidPublicKeyResponse" : {
        "type" : "object",
        "properties" : {
          "publicKey" : {
            "type" : "string"
          },
          "_links" : {
            "$ref" : "#/components/schemas/Links"
          }
        }
      },
      "Pageable" : {
        "type" : "object",
        "properties" : {
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          },
          "sort" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "PagedResourcesAssemblerNotificationHistoryDto" : {
        "type" : "object",
        "properties" : {
          "forceFirstAndLastRels" : {
            "type" : "boolean",
            "writeOnly" : true
          }
        }
      },
      "EntityModelNotificationHistoryDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "EXCUSE_REQUESTED", "EXCUSE_APPROVED", "EXCUSE_REJECTED", "LATE_CHECKIN_REQUESTED", "LATE_CHECKIN_APPROVED", "LATE_CHECKIN_REJECTED", "LESSON_STARTED", "LESSON_CLOSED", "LESSON_CANCELLED", "LESSON_REMINDER", "ATTENDANCE_RED_ZONE", "ATTENDANCE_MARKED_BY_HEADMAN" ]
          },
          "payload" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object"
            }
          },
          "sentAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "readAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "_links" : {
            "$ref" : "#/components/schemas/Links"
          }
        }
      },
      "PageMetadata" : {
        "type" : "object",
        "properties" : {
          "size" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int64"
          },
          "number" : {
