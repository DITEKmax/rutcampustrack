}

:where([data-student-ui]) .profile-form,
:where([data-student-ui]):is(.profile-form) {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  min-inline-size: 0;
  gap: var(--rct-space-4);
}

:where([data-student-ui]) .profile-field,
:where([data-student-ui]):is(.profile-field) {
