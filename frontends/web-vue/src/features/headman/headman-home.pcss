.headman-home {
  --headman-home-scroll-height: calc(var(--control-height) * 12);
  gap: var(--space-6);
}
.headman-home :is(h2, h3) { margin: 0; }
.headman-home h2 { font-size: var(--font-size-dense); font-weight: var(--font-weight-medium); }
.headman-home h3 { font-size: var(--font-size-body); font-weight: var(--font-weight-medium); }
.headman-home-card {
  min-inline-size: 0;
  padding: var(--space-4);
  border: var(--web-border) solid var(--color-border-default);
  border-radius: var(--radius-2xl);
  background: var(--color-surface-raised);
}
.headman-home-counters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
.headman-home-counters > section { min-block-size: calc(var(--control-height) * 2 + var(--space-6) + var(--space-1)); }
.headman-home-current { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-3); padding: var(--space-3); }
.headman-home-current.is-current { background: var(--color-accent-now); border-color: var(--color-border-accent); color: var(--color-accent-on-now); }
.headman-home-current-main { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-4); font-size: var(--font-size-dense); }
.headman-home-current-main > div { display: grid; gap: var(--space-1); }
.headman-home-current-main > p { white-space: nowrap; }
.headman-home-progress { appearance: none; display: block; flex-shrink: 0; inline-size: 100%; block-size: var(--space-1); overflow: hidden; border: 0; border-radius: var(--radius-full); background: var(--color-accent-now-hover); color: var(--color-accent-soft); }
.headman-home-progress::-webkit-progress-bar { background: var(--color-accent-now-hover); border-radius: var(--radius-full); }
.headman-home-progress::-webkit-progress-value { background: var(--color-accent-soft); border-radius: var(--radius-full); }
.headman-home-progress::-moz-progress-bar { background: var(--color-accent-soft); border-radius: var(--radius-full); }
.headman-home-counter { display: grid; align-content: start; gap: var(--space-2); }
.headman-home-ratio { display: flex; align-items: baseline; gap: 0; }
.headman-home-ratio strong { font-size: var(--font-size-display); line-height: 1.15; font-weight: var(--font-weight-bold); }
.headman-home-ratio > span { font-size: var(--font-size-caption); color: var(--color-text-muted); }
.headman-home-work { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; grid-template-rows: auto auto minmax(calc(var(--control-height) * 3), auto); gap: var(--space-4) var(--space-6); }
.headman-home-panel { display: grid; gap: var(--space-4); min-inline-size: 0; }
.headman-home-panel .student-period-context { inline-size: 100%; }
.headman-home-blockage { display: grid; gap: var(--space-2); }
.headman-home-blockage-switch { display: inline-flex; align-items: center; justify-self: start; flex-wrap: wrap; gap: var(--space-2); min-block-size: var(--control-height); padding: var(--space-2) 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--color-text-primary); font: inherit; font-size: var(--font-size-dense); text-align: start; cursor: pointer; }
.headman-home-blockage-switch > svg { inline-size: var(--space-5); block-size: var(--space-5); flex-shrink: 0; }
.headman-home-switch-track { display: inline-flex; align-items: center; flex-shrink: 0; inline-size: var(--space-10); block-size: var(--space-6); padding: var(--web-border); border: var(--web-border) solid var(--color-border-strong); border-radius: var(--radius-full); background: var(--color-surface-float); }
.headman-home-switch-track > span { inline-size: var(--space-5); block-size: var(--space-5); border-radius: var(--radius-full); background: var(--color-text-secondary); }
.headman-home-blockage-switch[aria-checked='true'] .headman-home-switch-track { justify-content: end; border-color: var(--color-accent-now); background: var(--color-accent-now); }
.headman-home-blockage-switch[aria-checked='true'] .headman-home-switch-track > span { background: var(--color-accent-on-now); }
.headman-home-switch-state { font-size: var(--font-size-caption); color: var(--color-text-muted); }
.headman-home-blockage-switch:disabled { cursor: default; opacity: .6; }
.headman-home-blockage-switch:focus-visible { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: var(--space-1); }
.headman-home-roster { overflow: clip; border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-2xl); }
.headman-home-work > .headman-home-panel { grid-row: span 3; grid-template-rows: subgrid; min-block-size: 0; }
.headman-home-work > .headman-home-panel > nav { grid-row: 1; }
.headman-home-manual-controls { display: grid; gap: var(--space-2); grid-row: 2; }
.headman-home-manual-panel > :is(.headman-home-roster, .headman-home-empty) { grid-row: 3; }
.headman-home-audit-panel > .headman-home-audit { grid-row: 3; contain: size; }
.headman-home-table { inline-size: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; font-size: var(--font-size-dense); }
.headman-home-table :is(th, td) { padding: var(--space-2) var(--space-3); border-inline-end: var(--web-border) solid var(--color-border-subtle); border-block-end: var(--web-border) solid var(--color-border-subtle); text-align: start; vertical-align: middle; overflow-wrap: anywhere; }
.headman-home-table :is(th, td):last-child { border-inline-end: 0; }
.headman-home-table tbody tr:last-child :is(th, td) { border-block-end: 0; }
.headman-home-table tbody th { font-weight: var(--font-weight-regular); }
.headman-home-table thead th { position: sticky; inset-block-start: 0; z-index: 1; background: var(--color-surface-raised); font-weight: var(--font-weight-medium); color: var(--color-text-secondary); text-align: center; }
.headman-home-table th:first-child { inline-size: 34%; }
.headman-home-table th:nth-child(2) { inline-size: 25%; }
.headman-home-table th:nth-child(3) { inline-size: 27%; }
.headman-home-table tbody td:last-child { text-align: center; color: var(--color-text-muted); }
.headman-home-table tbody tr { block-size: calc(var(--control-height) + var(--space-2)); }
.headman-home-status { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-1); }
.headman-home-status small { color: var(--color-text-secondary); font-size: var(--font-size-micro); line-height: 1.35; text-align: center; }
.headman-home-mark-actions { display: flex; align-items: center; justify-content: center; gap: 0; }
.headman-home-mark-control { display: inline-grid; place-items: center; flex-shrink: 0; inline-size: var(--space-8); block-size: var(--space-8); padding: 0; border: 0; border-radius: var(--radius-full); background: transparent; color: inherit; cursor: pointer; }
.headman-home-mark-control:focus-visible { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: 0; }
.headman-home-mark-control:disabled { cursor: default; opacity: .6; }
.headman-home-mark-actions.has-mark .headman-home-mark.is-neutral { opacity: .12; }
.headman-home-mark-actions.has-mark .headman-home-mark-control:is(:hover, :focus-visible) .headman-home-mark.is-neutral { opacity: 1; }
.headman-home-mark-control .headman-home-mark { inline-size: var(--space-6); block-size: var(--space-6); font-size: var(--font-size-caption); }
.headman-home-excuse-form { display: grid; gap: var(--space-3); inline-size: min(100%, calc(var(--control-height) * 12)); margin-inline: auto; padding: var(--space-2); }
.headman-home-excuse-select > label { position: absolute; inline-size: var(--web-border); block-size: var(--web-border); padding: 0; margin: calc(-1 * var(--web-border)); overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.headman-home-excuse-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
.headman-home-excuse-actions > button { inline-size: 100%; min-block-size: var(--control-height); }
.headman-home-excuse-actions > button:not(.web-button-primary):not(:disabled) { color: var(--color-text-primary); }
.headman-home-table .headman-home-excuse-row > td { text-align: start; }
.headman-home-mark { display: inline-grid; place-items: center; flex-shrink: 0; inline-size: var(--space-5); block-size: var(--space-5); border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-full); background: var(--color-status-none-fill); color: var(--color-status-none-on-fill); font-size: var(--font-size-micro); font-weight: var(--font-weight-medium); line-height: 1; }
.headman-home-mark.is-neutral { background: var(--color-surface-inverse); color: var(--color-text-on-inverse); border-color: var(--color-border-default); }
[data-theme='light'] .headman-home-mark.is-neutral { background: var(--color-status-none-fill); color: var(--color-status-none-on-fill); }
.headman-home-mark[data-status='PRESENT'] { background: var(--color-status-present-fill); color: var(--color-status-present-on-fill); border-color: transparent; }
.headman-home-mark[data-status='EXCUSED'] { background: var(--color-status-excused-fill); color: var(--color-status-excused-on-fill); border-color: transparent; }
.headman-home-mark[data-status='ABSENT'] { background: var(--color-status-absent-fill); color: var(--color-status-absent-on-fill); border-color: transparent; }
.headman-home-mark[data-status='CANCELLED'] { background: transparent; color: var(--color-text-muted); }
.headman-home-audit { display: flex; flex-direction: column; min-block-size: 0; gap: var(--space-3); }
.headman-home-audit-scroll { flex: 1; min-block-size: 0; overflow: auto; }
.headman-home-events { list-style: none; padding: 0; margin: 0; }
.headman-home-events li { display: grid; grid-template-columns: max-content minmax(0, 1fr); align-items: start; gap: var(--space-3); padding-block: var(--space-3); border-block-end: var(--web-border) solid var(--color-border-subtle); font-size: var(--font-size-dense); }
.headman-home-events li:first-child { padding-block-start: 0; }
.headman-home-events li:last-child { border-block-end: 0; padding-block-end: 0; }
.headman-home-events time { padding-block-start: var(--web-border); color: var(--color-text-secondary); font-size: var(--font-size-caption); white-space: nowrap; }
.headman-home-events li > div { display: grid; gap: var(--space-1); min-inline-size: 0; overflow-wrap: anywhere; }
.headman-home-empty { padding: var(--space-4); color: var(--color-text-secondary); font-size: var(--font-size-dense); }
.headman-home-bottom { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: start; gap: var(--space-6); }
.headman-home-homework, .headman-home-homework-list, .headman-home-requests { display: grid; align-content: start; min-inline-size: 0; gap: var(--space-3); }
.headman-home-homework-list { max-block-size: calc(var(--headman-home-scroll-height) + var(--control-height) * 2); overflow: auto; }
.headman-home-homework-card { display: grid; gap: var(--space-3); border-color: var(--color-border-subtle); }
.headman-home-homework-card > .web-caption:first-child { margin-block-end: calc(-1 * var(--space-2)); }
.headman-home-homework-description { white-space: pre-wrap; overflow-wrap: anywhere; }
.headman-home-homework-card a { justify-self: start; overflow-wrap: anywhere; }
.headman-home-request-group { display: grid; gap: var(--space-2); }
.headman-home-request-group h2 a { text-decoration: none; }
.headman-home-request { display: grid; grid-template-columns: max-content minmax(0, 1fr); align-items: start; gap: var(--space-3); padding: var(--space-2); border-radius: 1rem; background: var(--color-surface-base); font-size: var(--font-size-dense); text-decoration: none; }
.headman-home-request > span { overflow-wrap: anywhere; max-inline-size: calc(var(--control-height) * 2); }
.headman-home-request > div { display: grid; gap: var(--space-1); min-inline-size: 0; overflow-wrap: anywhere; }
.headman-home-request .web-caption { color: var(--color-text-muted); }
.headman-home-scroll { scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--color-border-accent) 55%, transparent) transparent; overscroll-behavior: contain; }
.headman-home-scroll::-webkit-scrollbar { inline-size: var(--space-1); block-size: var(--space-1); }
.headman-home-scroll::-webkit-scrollbar-track, .headman-home-scroll::-webkit-scrollbar-corner { background: transparent; }
.headman-home-scroll::-webkit-scrollbar-thumb { border-radius: var(--radius-full); background: color-mix(in srgb, var(--color-border-accent) 55%, transparent); }
.headman-home-scroll::-webkit-scrollbar-button { display: none; inline-size: 0; block-size: 0; }
.headman-home-scroll:focus-visible { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: var(--space-1); }
@supports selector(::-webkit-scrollbar) { .headman-home-scroll { scrollbar-width: auto; scrollbar-color: auto; } }
@media (width < 60rem) { .headman-home-counters { grid-template-columns: minmax(0, 1fr); } .headman-home-work, .headman-home-bottom { grid-template-columns: minmax(0, 1fr); } }

@media (width < 60rem) {
  .headman-home-work { grid-template-rows: none; gap: var(--space-6); }
  .headman-home-work > .headman-home-panel { grid-row: auto; grid-template-rows: none; }
  .headman-home-work > .headman-home-panel > nav, .headman-home-manual-controls, .headman-home-manual-panel > :is(.headman-home-roster, .headman-home-empty), .headman-home-audit-panel > .headman-home-audit { grid-row: auto; }
  .headman-home-audit-panel > .headman-home-audit { contain: none; }
  .headman-home-audit-scroll { flex: initial; max-block-size: var(--headman-home-scroll-height); }
}
