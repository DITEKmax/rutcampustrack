@import '../../styles/tokens.pcss';
.request-server-preview { display: grid; gap: var(--rct-space-3); min-inline-size: 0; }
.request-server-preview img { display: block; max-inline-size: 100%; block-size: auto; border-radius: var(--rct-radius-xl); }
.request-server-preview object { inline-size: 100%; block-size: calc(var(--rct-form-textarea-height) * 3); border: 0; border-radius: var(--rct-radius-xl); }
.request-server-preview button { inline-size: 100%; min-block-size: var(--rct-control-min-touch); padding: var(--rct-space-2) var(--rct-space-3); border: 0; border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-float); color: var(--rct-color-text-primary); font: inherit; cursor: pointer; @mixin rct-focus-ring; }
.request-status-badge { justify-self: start; display: inline-block; padding: var(--rct-space-1) var(--rct-space-3); border-radius: var(--rct-radius-full); background: var(--rct-color-surface-float); color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-caption); }
.request-status-badge[data-status='APPROVED'] { background: var(--rct-color-status-present-fill); color: var(--rct-color-status-on-fill); }
.request-status-badge[data-status='REJECTED'], .request-status-badge[data-status='CANCELLED'] { background: var(--rct-color-danger-fill); color: var(--rct-color-text-on-fill-strong); }
.request-status-badge[data-status='PENDING'] { background: var(--rct-color-status-excused-fill); color: var(--rct-color-status-on-fill); }

.request-server-preview .request-server-preview__image-open { padding: 0; min-block-size: 0; background: transparent; border-radius: var(--rct-radius-xl); overflow: hidden; }
.request-server-preview__image-open img { inline-size: 100%; }
.request-server-preview object a { color: var(--rct-color-text-primary); }
