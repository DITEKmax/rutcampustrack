+++ b/frontends/mobile-core/src/features/map/map-contract.ts
@@ -0,0 +1,225 @@
+export type MapSurface = 'pwa' | 'tma'
+export type MapFormat = 'png' | 'svg'
+export type MapAssetState = 'absent' | 'processing' | 'ready' | 'failed'
+
+export interface MapAssetDescriptor {
+  readonly id: string | null
+  readonly format: MapFormat
+  readonly contentType: 'image/png' | 'image/svg+xml'
+  readonly state: MapAssetState
+  readonly bytes: number
+  readonly sha256: string | null
+  readonly width?: number
+  readonly height?: number
+  readonly viewBox?: readonly [number, number, number, number]
+}
+
+export interface MapPlanMetadata {
+  readonly buildingId: string
+  readonly floorId: string
+  readonly version: string
+  readonly label: string
+  readonly png: MapAssetDescriptor
+  readonly svg: MapAssetDescriptor
+}
+
+export interface MapFloor {
+  readonly id: string
+  readonly label: string
+  readonly plan: MapPlanMetadata | null
+}
+
+export interface MapBuilding {
+  readonly id: string
+  readonly label: string
+  readonly floors: readonly MapFloor[]
+}
+
+export interface MapCatalog {
+  readonly revision: string
+  readonly buildings: readonly MapBuilding[]
+}
+
+export interface MapManifest extends MapCatalog {
+  readonly schemaVersion: 1
+  readonly validationPolicyVersion: 1
+}
+
+export type MapPlan = MapPlanMetadata
+
+export interface MapAssetRequest {
+  readonly buildingId: string
+  readonly floorId: string
+  readonly version: string
+  readonly format: MapFormat
+  readonly assetId: string
+  readonly signal: AbortSignal
+}
+
+export interface MapFloorRequest {
+  readonly buildingId: string
+  readonly floorId: string
+  readonly signal: AbortSignal
+}
+
+export interface MapOpenFloorRequest extends MapFloorRequest {
+  readonly intentId: string
+}
+
+export interface MapManifestRequest {
+  readonly knownRevision?: string
+  readonly signal: AbortSignal
+}
+
+export type MapManifestResponse =
+  | { readonly kind: 'unchanged'; readonly revision: string }
+  | { readonly kind: 'snapshot'; readonly manifest: MapManifest }
+
+export interface MapReadPort {
+  readCatalog(signal: AbortSignal): Promise<MapCatalog>
+  readPlan(request: MapFloorRequest): Promise<MapPlan | null>
+  readAsset(request: MapAssetRequest): Promise<Blob>
+  openFloor(request: MapOpenFloorRequest): Promise<void>
+  readManifest?(request: MapManifestRequest): Promise<MapManifestResponse>
+}
+
+export interface MapOwnerScope {
+  readonly ownerKey: string
+  readonly generation: number
+  /** Only the authenticated session adapter may set this for an explicit new generation. */
+  readonly freshAuthority?: boolean
+}
+
+export interface MapCachedAsset {
+  readonly key: string
+  readonly buildingId: string
+  readonly floorId: string
+  readonly version: string
+  readonly format: MapFormat
+  readonly assetId: string
+  readonly contentType: 'image/png' | 'image/svg+xml'
+  readonly bytes: number
+  readonly sha256: string
+  readonly blob: Blob
+}
+
+export interface MapSnapshot {
+  readonly ownerKey: string
+  readonly generation: number
+  readonly epoch: number
+  readonly manifest: MapManifest
+  readonly assets: readonly MapCachedAsset[]
+}
+
+export type MapAuthorityState = 'virgin' | 'active' | 'revoked' | 'pending'
+
+export interface MapOwnerState {
+  readonly ownerKey: string
+  readonly generation: number | null
+  readonly epoch: number
+  readonly activeRevision: string | null
+  readonly authority: MapAuthorityState
+}
+
+export type MapRevokeStatus = 'completed' | 'failed'
+
+export interface MapRevokeResult {
+  readonly ownerKey: string
+  readonly epoch: number
+  readonly status: MapRevokeStatus
+  readonly durable: boolean
+  readonly pending: boolean
+  readonly error?: MapError
+}
+
+export type MapInvalidationKind = 'unauthorized' | 'forbidden' | 'authority-changed' | 'session-inactive'
+
+export interface MapRevokeSignal {
+  readonly ownerKey: string
+  readonly generation: number
+  readonly authKind: MapInvalidationKind
+  readonly result: MapRevokeResult | null
+}
+
+export type MapSyncStatus =
+  | 'disabled'
+  | 'unchanged'
+  | 'updated'
+  | 'no-cache'
+  | 'update-failed'
+  | 'storage-unavailable'
+  | 'stale'
+
+export interface MapSyncResult {
+  readonly status: MapSyncStatus
+  readonly snapshot: MapSnapshot | null
+  readonly error?: MapError
+}
+
+export type MapErrorKind =
+  | 'aborted'
+  | 'network'
+  | 'unauthorized'
+  | 'forbidden'
+  | 'session-inactive'
+  | 'offline'
+  | 'invalid-response'
+  | 'asset-invalid'
+  | 'corrupt'
+  | 'storage'
+  | 'stale'
+  | 'unknown'
+
+export class MapError extends Error {
+  readonly kind: MapErrorKind
+  readonly causeValue: unknown
+
+  constructor(kind: MapErrorKind, message: string, causeValue?: unknown) {
+    super(message)
+    this.name = 'MapError'
+    this.kind = kind
+    this.causeValue = causeValue
+  }
+}
+
+export class MapStaleCommitError extends MapError {
+  constructor(message = 'Снимок карты устарел и не был записан') {
+    super('stale', message)
+    this.name = 'MapStaleCommitError'
+  }
+}
+
+export interface MapViewState {
+  readonly phase:
+    | 'idle'
+    | 'loading'
+    | 'ready'
+    | 'empty-catalog'
+    | 'empty-floors'
+    | 'no-plan'
+    | 'offline-no-cache'
+    | 'unavailable'
+    | 'forbidden'
+    | 'session-inactive'
+    | 'error'
+  readonly message: string | null
+  readonly catalog: MapCatalog | null
+  readonly selectedBuildingId: string | null
+  readonly selectedFloorId: string | null
+  readonly plan: MapPlan | null
+  readonly assetUrl: string | null
+  readonly assetFormat: MapFormat | null
+  readonly assetAlt: string | null
+  readonly scale: number
+  readonly announcement: string
+  readonly offline: boolean
+  readonly syncStatus: MapSyncStatus | null
+}
+
+export function mapAssetKey(asset: Pick<MapCachedAsset, 'buildingId' | 'floorId' | 'version' | 'format' | 'assetId'>): string {
+  return [asset.buildingId, asset.floorId, asset.version, asset.format, asset.assetId].map(encodeURIComponent).join('/')
+}
+
+export function mapFloorKey(buildingId: string, floorId: string): string {
+  return `${encodeURIComponent(buildingId)}/${encodeURIComponent(floorId)}`
+}
diff --git a/frontends/mobile-core/src/features/map/map-controller.ts b/frontends/mobile-core/src/features/map/map-controller.ts
