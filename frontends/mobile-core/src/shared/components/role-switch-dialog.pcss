@import '../../styles/tokens.pcss';
.role-dialog-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: start center;
  overflow-y: auto;
  padding: calc(env(safe-area-inset-top) + var(--rct-space-5)) var(--rct-space-4);
  background: var(--rct-role-overlay-surface);
  backdrop-filter: blur(var(--rct-mobile-blur));
}
.role-dialog {
  inline-size: 100%;
  max-inline-size: var(--rct-today-content-max);
  max-block-size: calc(100dvh - var(--rct-space-4) * 2);
  overflow-y: auto;
  border: 0;
  outline: none;
  border-radius: 0;
  padding: 0;
  color: var(--rct-color-text-primary);
  background: transparent;
  font-family: var(--rct-font-family-sans);
  overflow-wrap: anywhere;
  @mixin rct-type-body;
}
.role-dialog__title {
  position: absolute;
  inline-size: var(--rct-border-hairline);
  block-size: var(--rct-border-hairline);
  margin: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
.role-dialog__list {
  display: grid;
  gap: var(--rct-space-3);
}
.role-dialog__row {
  display: flex;
  align-items: center;
  gap: var(--rct-space-3);
  inline-size: 100%;
  min-block-size: var(--rct-role-row-height);
  border: 0;
  outline: none;
  border-radius: var(--rct-radius-full);
  padding: var(--rct-space-2) var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  cursor: pointer;
  text-align: start;
  overflow-wrap: anywhere;
  @mixin rct-type-list-title;
}
.role-dialog__row[data-selected='true'] {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
.role-dialog__row:disabled {
  cursor: default;
}
.role-dialog__row:disabled:not([data-selected='true']) {
  color: var(--rct-color-text-muted);
}
.role-dialog__avatar {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  inline-size: var(--rct-role-avatar-size);
  block-size: var(--rct-role-avatar-size);
  border-radius: var(--rct-radius-full);
  background: color-mix(in srgb, currentColor 12%, transparent);
}
.role-dialog__pending {
  margin-inline-start: auto;
  @mixin rct-type-lesson-meta;
}
.role-dialog__notice {
  color: var(--rct-color-warning-text);
}
.role-dialog__error {
  color: var(--rct-color-danger-text);
}

.role-dialog__row:focus-visible .role-dialog__label,
.role-dialog:focus-visible .role-dialog__status,
.role-dialog:focus-visible .role-dialog__pending {
  text-decoration-line: underline;
  text-decoration-thickness: var(--rct-focus-width);
  text-underline-offset: var(--rct-focus-offset);
}

/* Accepted Student presentation; existing roles retain their base rules. */
:where([data-student-ui]) .role-dialog-backdrop,
:where([data-student-ui]):is(.role-dialog-backdrop) {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: start center;
  overflow-y: auto;
  padding: calc(env(safe-area-inset-top) + var(--rct-space-5)) var(--rct-space-4);
  background: var(--rct-role-overlay-surface);
  backdrop-filter: blur(var(--rct-mobile-blur));
}
:where([data-student-ui]) .role-dialog,
:where([data-student-ui]):is(.role-dialog) {
  inline-size: 100%;
  max-inline-size: var(--rct-today-content-max);
  max-block-size: calc(100dvh - var(--rct-space-4) * 2);
  overflow-y: auto;
  border: 0;
  outline: none;
  border-radius: 0;
  padding: 0;
  color: var(--rct-color-text-primary);
  background: transparent;
  font-family: var(--rct-font-family-sans);
  overflow-wrap: anywhere;
  @mixin rct-type-body;
}
:where([data-student-ui]) .role-dialog-backdrop[data-full-width='true'],
:where([data-student-ui]):is(.role-dialog-backdrop[data-full-width='true']) {
  padding-inline-start: max(env(safe-area-inset-left), var(--rct-space-4));
  padding-inline-end: max(env(safe-area-inset-right), var(--rct-space-4));
  padding-block-end: calc(env(safe-area-inset-bottom) + var(--rct-space-4));
}
:where([data-student-ui]) .role-dialog-backdrop[data-full-width='true'] .role-dialog,
:where([data-student-ui]):is(.role-dialog-backdrop[data-full-width='true'] .role-dialog) {
  max-inline-size: none;
}
:where([data-student-ui]) .role-dialog__close,
:where([data-student-ui]):is(.role-dialog__close) {
  display: grid;
  place-items: center;
  inline-size: var(--rct-control-min-touch);
  min-block-size: var(--rct-control-min-touch);
  margin: 0 0 var(--rct-space-2) auto;
  border: 0;
  padding: 0;
  border-radius: var(--rct-radius-full);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  cursor: pointer;
  @mixin rct-focus-ring;
}
:where([data-student-ui]) .role-dialog__close svg,
:where([data-student-ui]):is(.role-dialog__close svg) {
  inline-size: var(--rct-space-5);
  block-size: var(--rct-space-5);
}
:where([data-student-ui]) .role-dialog__close:disabled,
:where([data-student-ui]):is(.role-dialog__close:disabled) {
  cursor: default;
  color: var(--rct-color-text-muted);
}
:where([data-student-ui]) .role-dialog__title,
:where([data-student-ui]):is(.role-dialog__title) {
  position: absolute;
  inline-size: var(--rct-border-hairline);
  block-size: var(--rct-border-hairline);
  margin: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
:where([data-student-ui]) .role-dialog__list,
:where([data-student-ui]):is(.role-dialog__list) {
  display: grid;
  gap: var(--rct-space-3);
}
:where([data-student-ui]) .role-dialog__row,
:where([data-student-ui]):is(.role-dialog__row) {
  display: flex;
  align-items: center;
  gap: var(--rct-space-3);
  inline-size: 100%;
  min-block-size: var(--rct-role-row-height);
  border: 0;
  outline: none;
  border-radius: var(--rct-radius-full);
  padding: var(--rct-space-2) var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  cursor: pointer;
  text-align: start;
  overflow-wrap: anywhere;
  @mixin rct-type-list-title;
}
:where([data-student-ui]) .role-dialog__row[data-selected='true'],
:where([data-student-ui]):is(.role-dialog__row[data-selected='true']) {
  color: var(--rct-color-accent-on-now);
  background: var(--rct-color-accent-now);
}
:where([data-student-ui]) .role-dialog__row:disabled,
:where([data-student-ui]):is(.role-dialog__row:disabled) {
  cursor: default;
}
:where([data-student-ui]) .role-dialog__row:disabled:not([data-selected='true']),
:where([data-student-ui]):is(.role-dialog__row:disabled:not([data-selected='true'])) {
  color: var(--rct-color-text-muted);
}
:where([data-student-ui]) .role-dialog__avatar,
:where([data-student-ui]):is(.role-dialog__avatar) {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  inline-size: var(--rct-role-avatar-size);
  block-size: var(--rct-role-avatar-size);
  border-radius: var(--rct-radius-full);
  background: color-mix(in srgb, currentColor 12%, transparent);
}
:where([data-student-ui]) .role-dialog__pending,
:where([data-student-ui]):is(.role-dialog__pending) {
  margin-inline-start: auto;
  @mixin rct-type-lesson-meta;
}
:where([data-student-ui]) .role-dialog__notice,
:where([data-student-ui]):is(.role-dialog__notice) {
  color: var(--rct-color-warning-text);
}
:where([data-student-ui]) .role-dialog__error,
:where([data-student-ui]):is(.role-dialog__error) {
  color: var(--rct-color-danger-text);
}

:where([data-student-ui]) .role-dialog__row:focus-visible .role-dialog__label,
:where([data-student-ui]):is(.role-dialog__row:focus-visible .role-dialog__label),
:where([data-student-ui]) .role-dialog:focus-visible .role-dialog__status,
:where([data-student-ui]):is(.role-dialog:focus-visible .role-dialog__status),
:where([data-student-ui]) .role-dialog:focus-visible .role-dialog__pending,
:where([data-student-ui]):is(.role-dialog:focus-visible .role-dialog__pending) {
  text-decoration-line: underline;
  text-decoration-thickness: var(--rct-focus-width);
  text-underline-offset: var(--rct-focus-offset);
}

/* Optional anchored presentation; the Student owner uses the full-width overlay. */
:where([data-student-ui]) .role-dialog-backdrop[data-compact='true'],
:where([data-student-ui]):is(.role-dialog-backdrop[data-compact='true']) {
  display: block;
  padding: 0;
  background: transparent;
  backdrop-filter: none;
}
:where([data-student-ui]) .role-dialog-backdrop[data-compact='true'] .role-dialog,
:where([data-student-ui]):is(.role-dialog-backdrop[data-compact='true'] .role-dialog) {
  position: fixed;
  max-block-size: calc(100dvh - var(--rct-space-8));
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-2);
  background: var(--rct-color-surface-float);
  box-shadow: var(--rct-shadow-overlay);
}
:where([data-student-ui]) .role-dialog-backdrop[data-compact='true'] .role-dialog__list,
:where([data-student-ui]):is(.role-dialog-backdrop[data-compact='true'] .role-dialog__list) {
  gap: var(--rct-space-1);
}
:where([data-student-ui]) .role-dialog-backdrop[data-compact='true'] .role-dialog__row,
:where([data-student-ui]):is(.role-dialog-backdrop[data-compact='true'] .role-dialog__row) {
  min-block-size: var(--rct-control-min-touch);
  border-radius: var(--rct-radius-md);
  font-size: var(--rct-font-size-body);
}
:where([data-student-ui]) .role-dialog-backdrop[data-compact='true'] .role-dialog__avatar,
:where([data-student-ui]):is(.role-dialog-backdrop[data-compact='true'] .role-dialog__avatar) {
  inline-size: var(--rct-space-7);
  block-size: var(--rct-space-7);
}
:where([data-student-ui])
  .role-dialog-backdrop[data-compact='true']
  .role-dialog__row:hover:not(:disabled):not([data-selected='true']),
:where([data-student-ui]):is(
  .role-dialog-backdrop[data-compact='true']
    .role-dialog__row:hover:not(:disabled):not([data-selected='true'])
) {
  background: var(--rct-color-surface-raised);
}
:where([data-student-ui])
  .role-dialog-backdrop[data-compact='true']
  .role-dialog__row:focus-visible,
:where([data-student-ui]):is(
  .role-dialog-backdrop[data-compact='true'] .role-dialog__row:focus-visible
) {
  outline: var(--rct-focus-width) solid var(--rct-color-border-accent);
  outline-offset: var(--rct-focus-offset);
}
