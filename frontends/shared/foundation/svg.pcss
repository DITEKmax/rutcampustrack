/* Preserve the local SVG silhouette while inheriting the caller's semantic color. */
.rct-svg-icon {
  display: inline-block;
  flex: 0 0 auto;
  inline-size: var(--rct-svg-width);
  block-size: var(--rct-svg-height);
  vertical-align: middle;
  background-color: currentColor;
  mask: var(--rct-svg-source) center / contain no-repeat;
  -webkit-mask: var(--rct-svg-source) center / contain no-repeat;
}
