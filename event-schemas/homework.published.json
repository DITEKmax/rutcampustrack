{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "homework.published",
  "description": "Староста опубликовал домашнее задание. Генерируется Academic Service.",
  "type": "object",
  "required": ["event_type", "event_id", "occurred_at", "payload"],
  "properties": {
    "event_type": { "const": "homework.published" },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["homework_id", "group_id", "subject_id", "title"],
      "properties": {
        "homework_id": { "type": "integer" },
        "group_id": { "type": "integer" },
        "subject_id": { "type": "integer" },
        "lesson_id": { "type": "integer" },
        "title": { "type": "string" },
        "has_link": { "type": "boolean" }
      }
    }
  }
}
