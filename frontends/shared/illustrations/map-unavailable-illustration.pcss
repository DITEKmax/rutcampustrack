.rct-map-unavailable-illustration {
  display: block;
  inline-size: calc(var(--control-height) * 7);
  max-inline-size: 100%;
  block-size: auto;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.rct-map-unavailable-illustration__facet {
  fill: var(--color-surface-float);
}
.rct-map-unavailable-illustration__paper {
  fill: var(--color-surface-raised);
}
.rct-map-unavailable-illustration__outline,
.rct-map-unavailable-illustration__fold {
  stroke: var(--color-border-strong);
}
.rct-map-unavailable-illustration__street {
  stroke: var(--color-border-default);
}
.rct-map-unavailable-illustration__route {
  stroke: var(--color-border-accent);
}
.rct-map-unavailable-illustration__origin {
  fill: var(--color-surface-float);
  stroke: var(--color-border-accent);
}
.rct-map-unavailable-illustration__break,
.rct-map-unavailable-illustration__detail {
  stroke: var(--color-text-muted);
}
.rct-map-unavailable-illustration__pin {
  fill: var(--color-accent-soft);
  stroke: var(--color-border-accent);
}
.rct-map-unavailable-illustration__pin-center {
  fill: var(--color-surface-raised);
  stroke: var(--color-border-accent);
}
.rct-map-unavailable-illustration__accent {
  fill: var(--color-border-strong);
}
