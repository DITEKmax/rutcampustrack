+    private static boolean isHomeworkOperation(HttpServletRequest request) {
+        String path = request.getRequestURI();
+        String contextPath = request.getContextPath();
+        if (!contextPath.isEmpty() && path.startsWith(contextPath)) {
+            path = path.substring(contextPath.length());
+        }
+        if ("GET".equalsIgnoreCase(request.getMethod())) {
+            return HOMEWORK_PATH.equals(path);
+        }
+        if (!"PUT".equalsIgnoreCase(request.getMethod())
+                || !path.startsWith(HOMEWORK_PATH + "/")
+                || !path.endsWith(COMPLETION_SUFFIX)) {
+            return false;
+        }
+        int idStart = HOMEWORK_PATH.length() + 1;
+        int completionStart = path.length() - COMPLETION_SUFFIX.length();
+        return path.indexOf('/', idStart) == completionStart;
+    }
+}
