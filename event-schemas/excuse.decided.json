{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "excuse.decided",
  "description": "Староста одобрил или отклонил тикет студента о пропуске с уважительной причиной. Генерируется Attendance Service после обработки решения (59-06 / D-28).",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "traceparent": {"$ref": "_common.json#/$defs/traceparent"},
    "request_id": {"$ref": "_common.json#/$defs/requestId"},
    "event_type": {
      "const": "excuse.decided"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "ticket_id",
        "user_id",
        "status"
      ],
      "properties": {
        "ticket_id": {
          "type": "string",
          "description": "Идентификатор excuse-тикета"
        },
        "user_id": {
          "type": "integer",
          "description": "Студент — получатель уведомления об итоге"
        },
        "group_id": {
          "type": "integer",
          "description": "Группа студента (для маршрутизации Web Push / STOMP)"
        },
        "status": {
          "enum": [
            "approved",
            "rejected",
            "cancelled"
          ]
        },
        "decision_by": {
          "type": [
            "integer",
            "null"
          ],
          "description": "user_id старосты, принявшего решение"
        },
        "decision_comment": {
          "type": [
            "string",
            "null"
          ],
          "description": "Необязательный комментарий старосты, показывается студенту"
        },
        "request_key": { "type": "string", "format": "uuid" },
        "expected_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "included_lesson_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "excluded_lesson_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "included_occurrence_ids": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "uniqueItems": true },
        "excluded_occurrence_ids": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "uniqueItems": true },
        "excluded_lessons": {
          "type": "array",
          "description": "Исключённые пары из неизменяемого состава решения; метаданные могут отсутствовать у старых заявок.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lesson_id", "occurrence_id", "date", "lesson_number", "subject_name", "lesson_type"],
            "properties": {
              "lesson_id": { "type": "integer", "minimum": 1 },
              "occurrence_id": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*$" },
              "date": { "type": ["string", "null"], "format": "date" },
              "lesson_number": { "type": ["integer", "null"], "minimum": 1 },
              "subject_name": { "type": ["string", "null"] },
              "lesson_type": { "type": ["string", "null"] }
            }
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
