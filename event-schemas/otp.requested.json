{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "otp.requested",
  "description": "Auth Service публикует OTP-код с явным назначением login или password_reset. notification-bot доставляет код в Telegram; password_reset дополнительно связывает код с challenge_id и передаёт серверный остаток попыток. OTP не возвращается в HTTP body.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "otp.requested"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "telegram_id",
        "code",
        "ttl_seconds",
        "purpose"
      ],
      "properties": {
        "telegram_id": {
          "type": "integer",
          "description": "Telegram user id — адресат сообщения с кодом"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "description": "6-значный OTP-код. Живёт в Redis TTL seconds. Секретный — consumer должен логировать MASKED (см. shared-logback masking правила)."
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Время жизни кода в секундах — bot показывает пользователю срок действия"
        },
        "purpose": {
          "type": "string",
          "enum": ["login", "password_reset"],
          "description": "Назначение кода; proof одного сценария не действует в другом"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 64,
          "description": "Opaque reset challenge handle; present only for password_reset"
        },
        "attempts_remaining": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Server-reported account-window verification attempts remaining"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"purpose": {"const": "password_reset"}},
            "required": ["purpose"]
          },
          "then": {"required": ["challenge_id", "attempts_remaining"]}
        }
      ]
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (всегда auth-service для otp.requested)."
    }
  }
}
