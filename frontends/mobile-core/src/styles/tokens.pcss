@import '../../../shared/foundation/tokens.pcss';
@import '../../../shared/foundation/mixins.pcss';

:root,
[data-theme] {
  /* Dark semantic aliases reference canonical primitives. */
  /* Homework aliases: canonical color/surface/success = #063429. */
  /* Canonical color/state/info/text dark -> blue/300; color/state/info/bg dark -> blue/900. */
  --rct-primitive-danger-fill: #d63535; /* Figma canonical state/danger/fill, requests159. */
  --rct-mobile-dock-opacity: 78%; /* component/mobile-bottom-nav/glass-surface-opacity */
  --rct-mobile-dock-blur: 1.5625rem; /* component/mobile-bottom-nav/glass-background-blur */
  --rct-teacher-journal-name-width: 9rem;
  /* Homework aliases: canonical dimension/font/size/title-block = 1.125rem. */
  /* Homework alias: canonical dimension/font/size/title-screen = 1.5rem. */
  --rct-mobile-content-width: 22.375rem;
  --rct-mobile-hero-height: 10.6875rem;
  --rct-mobile-hero-pending-height: 12.5625rem;
  --rct-mobile-row-height: 5.875rem;
  --rct-mobile-time-column: 3.375rem;
  --rct-mobile-dock-height: 4.75rem;
  --rct-mobile-dock-bottom: 1rem;
  --rct-mobile-blur: var(--rct-mobile-dock-blur);
  --rct-today-role-width: 7rem;
  --rct-today-role-height: 2.75rem;
  --rct-today-action-height: 2.8125rem;
  --rct-today-present-size: 2rem;
  --rct-today-dock-item-width: 4.075rem;
  --rct-today-dock-item-height: 3.75rem;
  --rct-today-list-heading-size: 1.125rem;
  --rct-today-list-heading-leading: 1.2777777778;
  --rct-today-hero-time-size: 0.875rem;
  --rct-today-hero-time-leading: 1.2857142857;
  --rct-today-hero-title-size: 1.25rem;
  --rct-today-hero-title-leading: 1.3;
  --rct-today-hero-meta-size: 0.8125rem;
  --rct-today-hero-meta-leading: 1.3076923077;
  --rct-today-action-size: 0.9375rem;
  --rct-today-action-leading: 1.2666666667;
  --rct-today-row-end-size: 0.75rem;
  --rct-today-row-end-leading: 1.25;
  --rct-today-card-title-size: 0.875rem;
  --rct-today-card-title-leading: 1.2857142857;
  --rct-today-card-meta-size: 0.8125rem;
  --rct-today-card-meta-leading: 1.3076923077;
  --rct-today-room-old-size: 0.6875rem;
  --rct-today-room-old-leading: 1.2727272727;
  --rct-today-present-font-size: 1rem;
  --rct-today-present-leading: 1.25;
  --rct-today-dock-label-leading: 1.35;
  /* Accepted Homework date heading: final source 4601-142.txt, lines 34/69 (17px). */
  --rct-homework-date-heading-size: 1.0625rem;
  --rct-today-role-gradient: linear-gradient(
    104.93deg,
    #3b1a7a -5.26%,
    #5729a1 49.47%,
    #2e1f4d 100%
  );
  --rct-today-action-gradient: linear-gradient(90deg, #171229 0%, #29174d 55%, #3b146b 100%);
  /* Headman mobile aliases approved by root 2026-10-06. */
  --rct-headman-homework-collapsed-min-height: calc(var(--rct-space-4) * 4);
  --rct-headman-status-size: var(--rct-space-6);
  --rct-headman-calendar-day-size: var(--rct-profile-row-height);
  --rct-headman-calendar-mark-width: var(--rct-space-5);
  --rct-headman-calendar-mark-height: var(--rct-space-half);
  --rct-headman-current-card-min-height: 7.25rem;
  --rct-headman-metric-min-height: 2.25rem;
  --rct-headman-page-bottom-space: var(--rct-today-bottom-space);
  --rct-headman-lesson-card-bg: var(--rct-color-accent-now);
  --rct-headman-lesson-card-text: var(--rct-color-accent-on-now);
  --rct-headman-more-title-size: 1.75rem;
  --rct-profile-row-radius: 1.125rem;
  --rct-profile-row-height: 3.5rem;
  --rct-profile-more-row-height: 5rem;
  --rct-profile-avatar-size: 3.5rem;
  --rct-profile-card-height: 6rem;
  --rct-profile-card-gap: 0.875rem;
  --rct-profile-icon-size: 1.5rem;
  --rct-profile-control-icon-size: 1.25rem;
  --rct-map-select-height: 2.5rem;
  --rct-color-status-on-fill: var(--rct-color-status-none-on-fill);
  --rct-icon-size: 1rem;
  --rct-lesson-meta-icon-size: 0.625rem;
  --rct-task-title-size: 1.375rem;
  --rct-task-title-leading: 1.2727272727;
  --rct-task-back-radius: 1.375rem;
  --rct-form-select-height: 2.75rem;
  --rct-form-textarea-height: 6rem;
  --rct-form-upload-height: 4.125rem;
  --rct-form-submit-height: 3rem;
  --rct-lesson-expanded-height: 12.25rem;
  --rct-lesson-request-height: 7.3125rem;
  --rct-status-hit-offset: -0.375rem;
  --rct-today-content-max: 26.625rem;
  --rct-today-bottom-space: 6.75rem;
  --rct-state-min-height: 12rem;
  --rct-progress-size: 1.25rem;
  --rct-progress-stroke: 0.1875rem;
  --rct-warning-surface: color-mix(
    in srgb,
    var(--rct-color-warning-text) 16%,
    var(--rct-color-surface-base)
  );
  --rct-error-surface: color-mix(
    in srgb,
    var(--rct-color-danger-text) 14%,
    var(--rct-color-surface-base)
  );
  --rct-form-summary-title-size: 1.0625rem;
  --rct-form-summary-title-leading: 1.3;
  --rct-attendance-plot-height: 10rem;
  --rct-attendance-empty-height: 13.75rem;
  --rct-attendance-summary-symbol: 1.75rem;
  --rct-attendance-chart-column: 2.75rem;
  --rct-role-overlay-surface: color-mix(in srgb, var(--rct-color-surface-base) 68%, transparent);
  --rct-role-avatar-size: 3rem;
  --rct-role-row-height: 4.75rem;
  --rct-attendance-day-height: 3rem;
  --rct-attendance-metric-height: 3rem;
  --rct-attendance-type-card-gap: 1.75rem;
  --rct-attendance-type-pill-height: 1.75rem;
  --rct-attendance-type-pill-offset: -0.875rem;
}

@define-mixin rct-type-role {
  font-size: var(--rct-today-hero-meta-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-today-hero-meta-leading);
}

@define-mixin rct-type-hero-time {
  font-size: var(--rct-today-hero-time-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-today-hero-time-leading);
}

@define-mixin rct-type-hero-title {
  font-size: var(--rct-today-hero-title-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-today-hero-title-leading);
}

@define-mixin rct-type-action {
  font-size: var(--rct-today-action-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-today-action-leading);
}

@define-mixin rct-type-list-title {
  font-size: var(--rct-today-list-heading-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-today-list-heading-leading);
}

@define-mixin rct-type-lesson-title {
  font-size: var(--rct-today-card-title-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-today-card-title-leading);
}

@define-mixin rct-type-lesson-meta {
  font-size: var(--rct-today-card-meta-size);
  font-weight: var(--rct-font-weight-regular);
  line-height: var(--rct-today-card-meta-leading);
}

@define-mixin rct-type-lesson-end {
  font-size: var(--rct-today-row-end-size);
  font-weight: var(--rct-font-weight-regular);
  line-height: var(--rct-today-row-end-leading);
}

@define-mixin rct-type-status {
  font-size: var(--rct-today-present-font-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-today-present-leading);
}

@define-mixin rct-type-task-title {
  font-size: var(--rct-task-title-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-task-title-leading);
}

@define-mixin rct-type-field-label {
  font-size: var(--rct-font-size-dense);
  font-weight: var(--rct-font-weight-regular);
  line-height: var(--rct-today-hero-time-leading);
}

@define-mixin rct-type-screen-title {
  font-size: var(--rct-font-size-title-screen);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-leading-tight);
}
@define-mixin rct-type-date-heading {
  font-size: var(--rct-homework-date-heading-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: var(--rct-leading-snug);
}

[data-theme='light'] {
  --rct-mobile-dock-opacity: 90%;
  --rct-today-role-gradient: linear-gradient(
    104.93deg,
    var(--rct-color-accent-soft),
    var(--rct-color-surface-raised)
  );
  --rct-today-action-gradient: linear-gradient(
    90deg,
    var(--rct-color-accent-soft),
    var(--rct-color-surface-raised)
  );
}
