@import '../styles/tokens.pcss';
.admin-users-review-catalog {
  display: flex;
  flex-wrap: wrap;
  gap: var(--rct-space-2);
  padding: var(--rct-space-4);
  font-size: var(--rct-font-size-micro);
}
.admin-users-review-catalog a {
  color: var(--rct-color-text-secondary);
}
.admin-users-review[data-back-owner='host'] .admin-users-screen__header > .admin-users-icon-button {
  display: none;
}
.admin-users-review-hostback {
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  padding: var(--rct-space-2) var(--rct-space-4);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  font: inherit;
}
