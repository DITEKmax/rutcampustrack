{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "homework.withdrawn",
  "description": "Ручное снятие активного опубликованного домашнего задания.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "homework.withdrawn"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "homework_id",
        "group_id",
        "subject_id",
        "semester_id",
        "lesson_date",
        "binding_mode"
      ],
      "properties": {
        "homework_id": {
          "type": "integer",
          "minimum": 1
        },
        "group_id": {
          "type": "integer",
          "minimum": 1
        },
        "subject_id": {
          "type": "integer",
          "minimum": 1
        },
        "semester_id": {
          "type": "integer",
          "minimum": 1
        },
        "lesson_type": {
          "enum": [
            "lecture",
            "practice",
            "lab"
          ]
        },
        "lesson_date": {
          "type": "string",
          "format": "date"
        },
        "lesson_number": {
          "anyOf": [
            { "$ref": "_common.json#/$defs/lessonNumber" },
            { "type": "null" }
          ]
        },
        "binding_mode": {
          "enum": ["LESSON", "DATE"]
        },
        "actor_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "binding_mode": { "const": "LESSON" } }
          },
          "then": {
            "required": ["lesson_type", "lesson_number"],
            "properties": {
              "lesson_type": { "$ref": "#/properties/payload/properties/lesson_type" },
              "lesson_number": { "$ref": "_common.json#/$defs/lessonNumber" }
            }
          }
        }
      ]
    },
    "event_version": {
      "const": 1
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
