@import '../../styles/tokens.pcss';
.headman-stats-select { display: grid; gap: var(--rct-space-1); min-inline-size: 0; inline-size: 100%; }
.headman-stats-select__trigger { display: flex; align-items: center; justify-content: space-between; gap: var(--rct-space-2); min-inline-size: 0; inline-size: 100%; min-block-size: var(--rct-control-min-touch); border: 0; border-radius: var(--rct-radius-xl); padding: var(--rct-space-2) var(--rct-space-3); color: var(--rct-color-text-primary); background: var(--rct-color-surface-float); text-align: start; font: inherit; font-size: var(--rct-font-size-caption); @mixin rct-focus-ring; }
.headman-stats-select__trigger > span { min-inline-size: 0; overflow-wrap: anywhere; }
.headman-stats-select__trigger > svg { flex: none; inline-size: var(--rct-icon-size); block-size: var(--rct-icon-size); }
.headman-stats-select__options { display: grid; gap: var(--rct-space-1); min-inline-size: 0; padding: var(--rct-space-1); border-radius: var(--rct-radius-xl); background: var(--rct-color-surface-base); }
.headman-stats-select__options > button { inline-size: 100%; min-inline-size: 0; min-block-size: var(--rct-control-min-touch); border: 0; border-radius: var(--rct-radius-lg); padding: var(--rct-space-2); color: var(--rct-color-text-primary); background: transparent; font: inherit; font-size: var(--rct-font-size-caption); text-align: start; overflow-wrap: anywhere; @mixin rct-focus-ring; }
.headman-stats-select__options > button[aria-selected='true'] { color: var(--rct-color-accent-on-now); background: var(--rct-color-accent-now); }
