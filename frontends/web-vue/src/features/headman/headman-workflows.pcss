.headman-workflows { gap: var(--space-5); }
.headman-flow-tabs { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
.headman-flow-filters > summary { inline-size: fit-content; cursor: pointer; list-style: none; }
.headman-flow-filters > summary::-webkit-details-marker { display: none; }
.headman-flow-filters[open] > summary { margin-block-end: var(--space-3); }
.headman-flow-filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, calc(var(--control-height) * 5)), 1fr)); align-items: end; gap: var(--space-4); padding: var(--space-4); border: var(--web-border) solid var(--web-panel-line); border-radius: var(--radius-lg); background: var(--color-surface-raised); }
.headman-workflows .headman-flow-fields { display: grid; gap: var(--space-4); padding: 0; border: 0; border-radius: 0; }
.headman-homework-composer { inline-size: min(100%, calc(var(--control-height) * 18)); }
.headman-homework-composer h2 { font-size: var(--font-size-title-block); }
.headman-workflows .web-field textarea { min-block-size: calc(var(--control-height) * 4); padding: var(--space-4); border-radius: var(--radius-2xl); }
.headman-flow-form-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
.headman-flow-toggle { display: flex; align-items: center; gap: var(--space-3); min-block-size: var(--control-height); font-size: var(--font-size-dense); }
.headman-flow-toggle input { appearance: none; inline-size: var(--space-5); block-size: var(--space-5); flex-shrink: 0; margin: 0; border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-full); background: var(--color-surface-raised); }
.headman-flow-toggle input:checked { border-color: var(--color-accent-now); background: var(--color-accent-now); box-shadow: inset 0 0 0 var(--space-1) var(--color-surface-base); }
.headman-flow-toggle input:focus-visible { outline: var(--focus-width) solid var(--color-border-focus); outline-offset: var(--space-1); }
.headman-flow-placement { display: grid; justify-items: start; gap: var(--space-2); }
.headman-homework-group { gap: var(--space-3); }
.headman-homework-group + .headman-homework-group { padding-block-start: var(--space-3); }
.headman-homework-group > h2 { font-size: var(--font-size-dense); font-weight: var(--font-weight-medium); }
.headman-flow-card { display: grid; min-inline-size: 0; gap: var(--space-3); padding: var(--space-4); border: var(--web-border) solid var(--web-panel-line); border-radius: var(--radius-lg); background: var(--color-surface-raised); }
.headman-flow-card h3 { font-size: var(--font-size-title-block); font-weight: var(--font-weight-medium); }
.headman-flow-card .headman-heading > .web-stack { gap: var(--space-1); }
.headman-flow-description { white-space: pre-wrap; overflow-wrap: anywhere; }
.headman-flow-card a { justify-self: start; overflow-wrap: anywhere; }
.headman-flow-card-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
.headman-flow-card-footer > .web-caption { color: var(--color-text-muted); }
.headman-flow-status { display: inline-flex; align-items: center; justify-content: center; min-block-size: var(--control-height); padding-inline: var(--space-4); border: var(--web-border) solid var(--color-border-default); border-radius: var(--radius-full); font-size: var(--font-size-caption); white-space: nowrap; }
.headman-flow-status[data-status='PENDING'] { color: var(--color-state-warning-text); background: var(--color-state-warning-bg); border-color: var(--color-state-warning-border); }
.headman-flow-status[data-status='APPROVED'] { color: var(--color-state-success-text); background: var(--color-state-success-bg); border-color: var(--color-state-success-border); }
.headman-flow-status[data-status='REJECTED'] { color: var(--color-state-danger-text); background: var(--color-state-danger-bg); border-color: var(--color-state-danger-border); }
.headman-flow-status[data-status='CANCELLED'] { color: var(--color-text-muted); background: var(--color-surface-base); }
.headman-flow-empty { display: flex; gap: var(--space-3); align-items: center; padding: var(--space-4); color: var(--color-text-secondary); }
.headman-flow-empty svg { flex: none; inline-size: var(--space-10); color: var(--web-focus-color); }
.headman-request-list { display: grid; gap: var(--space-4); }
.headman-request-card h2 { font-size: var(--font-size-title-block); font-weight: var(--font-weight-medium); }
.headman-request-expand[aria-expanded='true'] svg { transform: rotate(180deg); }
.headman-request-detail { padding-block-start: var(--space-3); border-block-start: var(--web-border) solid var(--color-border-subtle); }
.headman-request-lessons { max-block-size: calc(var(--control-height) * 8); overflow: auto; border: var(--web-border) solid var(--web-panel-line); border-radius: var(--radius-lg); }
.headman-request-table { border-collapse: separate; border-spacing: 0; inline-size: 100%; font-size: var(--font-size-dense); }
.headman-request-table :is(th, td) { padding: var(--space-3); border-block-end: var(--web-border) solid var(--color-border-subtle); text-align: start; }
.headman-request-table td small { display: block; }
.headman-request-table th { background: var(--web-data-header-surface); color: var(--color-text-secondary); font-weight: var(--font-weight-medium); }
.headman-request-table tr:last-child td { border-block-end: 0; }
.headman-request-files { display: grid; justify-items: start; gap: var(--space-2); }
.headman-request-decision { max-inline-size: calc(var(--control-height) * 18); }
.headman-request-decision > .web-button { justify-self: end; }
.headman-flow-scroll, .headman-workflows textarea { scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--color-border-accent) 55%, transparent) transparent; overscroll-behavior: contain; }
:is(.headman-flow-scroll, .headman-workflows textarea)::-webkit-scrollbar { inline-size: var(--space-1); block-size: var(--space-1); }
:is(.headman-flow-scroll, .headman-workflows textarea)::-webkit-scrollbar-track, :is(.headman-flow-scroll, .headman-workflows textarea)::-webkit-scrollbar-corner { background: transparent; }
:is(.headman-flow-scroll, .headman-workflows textarea)::-webkit-scrollbar-thumb { border-radius: var(--radius-full); background: color-mix(in srgb, var(--color-border-accent) 55%, transparent); }
:is(.headman-flow-scroll, .headman-workflows textarea)::-webkit-scrollbar-button { display: none; inline-size: 0; block-size: 0; }
@supports selector(::-webkit-scrollbar) { .headman-flow-scroll, .headman-workflows textarea { scrollbar-width: auto; scrollbar-color: auto; } }

.headman-homework-placement-row { display: flex; align-items: end; gap: var(--space-3); flex-wrap: wrap; }
.headman-homework-placement-row > .web-field { flex: 1 1 calc(var(--control-height) * 5); min-inline-size: 0; }
.headman-homework-placement-row > .web-button { align-self: end; }
.headman-homework-filters { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) repeat(2, minmax(0, 1fr)) minmax(0, 1.5fr); }
.headman-homework-entry { display: grid; min-inline-size: 0; gap: var(--space-3); }
.headman-homework-events { display: grid; gap: var(--space-5); list-style: none; padding: 0; margin: 0; }
.headman-homework-events > li + li { padding-block-start: var(--space-5); border-block-start: var(--web-border) solid var(--color-border-subtle); }
.headman-homework-event-header { display: flex; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; margin-block-end: var(--space-3); }
.headman-homework-event-header > div { display: grid; gap: var(--space-1); }
.headman-homework-event-header > div:last-child { color: var(--color-text-secondary); font-size: var(--font-size-caption); }
.headman-homework-diff { overflow-x: auto; border: var(--web-border) solid var(--color-border-subtle); border-radius: var(--radius-xl); }
.headman-homework-diff table { table-layout: fixed; inline-size: 100%; border-collapse: separate; border-spacing: 0; font-size: var(--font-size-dense); }
.headman-homework-diff :is(th, td) { padding: var(--space-3); text-align: start; vertical-align: top; overflow-wrap: anywhere; white-space: pre-wrap; border-block-end: var(--web-border) solid var(--color-border-subtle); }
.headman-homework-diff th { font-weight: var(--font-weight-medium); color: var(--color-text-secondary); }
.headman-homework-diff th:first-child { inline-size: 22%; }
.headman-homework-diff :is(th, td) + :is(th, td) { border-inline-start: var(--web-border) solid var(--color-border-subtle); }
.headman-homework-diff tbody tr:last-child > * { border-block-end: 0; }
@media (max-width: 60rem) { .headman-homework-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 36rem) { .headman-homework-filters { grid-template-columns: minmax(0, 1fr); } }

.headman-request-filters { grid-template-columns: repeat(4, minmax(0, 1fr)) auto; }
.headman-request-filters > .web-button { align-self: end; }
.headman-request-summary { flex: 1 1 12rem; display: grid; gap: var(--space-1); min-inline-size: 0; overflow-wrap: anywhere; }
@media (max-width: 60rem) { .headman-request-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

.headman-request-context, .headman-request-section { display: grid; gap: var(--space-3); min-inline-size: 0; }
.headman-request-context h3 { overflow-wrap: anywhere; }
.headman-request-context dl { margin: 0; }
.headman-request-section { padding: var(--space-4); border: var(--web-border) solid var(--web-panel-line); border-radius: var(--radius-lg); }
.headman-request-section h3 { margin: 0; }
.headman-homework-assignment { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
.headman-homework-assignment legend { padding-inline: var(--space-2); }
.headman-homework-placement { grid-column: 1 / -1; display: grid; gap: var(--space-2); }
.headman-homework-content { padding-block: var(--space-1); }
@media (width <= 36rem) {
  .headman-homework-assignment, .headman-request-filters { grid-template-columns: minmax(0, 1fr); }
}
