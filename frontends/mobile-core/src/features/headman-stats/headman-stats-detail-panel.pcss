@import '../../styles/tokens.pcss';

.headman-stats-detail {
  display: grid;
  gap: var(--rct-space-4);
  min-inline-size: 0;
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-xl);
  padding: var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-raised);
  @mixin rct-focus-ring;
}

.headman-stats-detail__header,
.headman-stats-detail__pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--rct-space-2);
}

.headman-stats-detail__header h2,
.headman-stats-detail__section h3 {
  margin: 0;
}

.headman-stats-detail__header h2 {
  font-size: var(--rct-font-size-title);
}

.headman-stats-detail__eyebrow {
  margin: 0 0 var(--rct-space-1);
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.headman-stats-detail__button {
  min-block-size: var(--rct-control-min-touch);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-2) var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: var(--rct-color-surface-float);
  font: inherit;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.headman-stats-detail__button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.headman-stats-detail__section {
  display: grid;
  gap: var(--rct-space-3);
  min-inline-size: 0;
}

.headman-stats-detail__section h3 {
  font-size: var(--rct-font-size-title);
}

.headman-stats-detail__state {
  margin: 0;
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-surface-base);
}

.headman-stats-detail__state--error {
  color: var(--rct-color-danger-text);
}

.headman-stats-detail__metrics {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--rct-space-2);
  margin: 0;
}

.headman-stats-detail__metrics > div {
  display: grid;
  gap: var(--rct-space-1);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
}

.headman-stats-detail__metrics dt {
  color: var(--rct-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.headman-stats-detail__metrics dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

.headman-stats-detail__table-wrap {
  overflow: auto;
  max-inline-size: 100%;
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  @mixin rct-focus-ring;
}

.headman-stats-detail__table-wrap table {
  inline-size: 100%;
  min-inline-size: 48rem;
  border-collapse: collapse;
  font-size: var(--rct-font-size-caption);
  font-variant-numeric: tabular-nums;
}

.headman-stats-detail__table-wrap th,
.headman-stats-detail__table-wrap td {
  border-block-end: var(--rct-border-hairline) solid var(--rct-color-border-default);
  padding: var(--rct-space-2);
  text-align: start;
  vertical-align: top;
}

.headman-stats-detail__table-wrap th {
  color: var(--rct-color-text-primary);
  font-weight: var(--rct-font-weight-medium);
}

.headman-stats-detail__type {
  padding-inline-start: var(--rct-space-5) !important;
  color: var(--rct-color-text-secondary);
}

.headman-stats-detail__tickets {
  display: grid;
  gap: var(--rct-space-2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.headman-stats-detail__tickets li {
  display: grid;
  gap: var(--rct-space-1);
  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
  border-radius: var(--rct-radius-lg);
  padding: var(--rct-space-3);
  font-size: var(--rct-font-size-caption);
}

.headman-stats-detail__tickets span,
.headman-stats-detail__pagination span {
  color: var(--rct-color-text-secondary);
}

.headman-stats-detail__pagination {
  justify-content: center;
}

@media (min-width: 48rem) {
  .headman-stats-detail__metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
