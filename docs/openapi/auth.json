{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:9090",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "JWT authentication endpoints"
    },
    {
      "name": "Internal",
      "description": "Gateway/service-to-service endpoints (shared-secret guarded)"
    },
    {
      "name": "Internal Issuer",
      "description": "Token exchange for downstream-service auth (M03a C0-1)"
    }
  ],
  "paths": {
    "/internal/issue-internal-jwt": {
      "post": {
        "tags": [
          "Internal Issuer"
        ],
        "summary": "Issue Internal JWT",
        "description": "Exchange shared-secret + claims for a signed Internal JWT (audience=rutcampustrack-internal)",
        "operationId": "issue",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InternalIssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InternalIssueResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing X-Internal-Issuer-Secret",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InternalIssueResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/consume-ws-ticket": {
      "post": {
        "tags": [
          "Internal"
        ],
        "summary": "Consume WebSocket ticket",
        "description": "Atomic GET+DEL for single-use ticket. Returns {userId, role} if ticket was valid + not yet consumed, otherwise 404.",
        "operationId": "consume",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsumeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ticket consumed, identity returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ticket not found or already consumed/expired",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/ws-ticket": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Issue WebSocket ticket",
        "description": "Generate short-lived (30s, single-use) ticket for WebSocket handshake. Client uses it as `?ticket=<value>` query param. Replaces legacy `?token=<access_jwt>` pattern which leaked JWT into nginx/Gateway logs.",
        "operationId": "issueTicket",
        "responses": {
          "200": {
            "description": "Ticket issued",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WsTicketResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WsTicketResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/tma": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate via Telegram Mini App",
        "description": "Validate Telegram initData (HMAC-SHA256) and return JWT token pair. Cookie also set for web-panel fallback; TMA clients read refreshToken from body.",
        "operationId": "tmaAuth",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TmaAuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated via TMA",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or tampered initData, or user not linked",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh access token",
        "description": "Read refresh token from HttpOnly cookie 'rct_refresh', rotate it, return new access in body + new cookie.",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "rct_refresh",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tokens refreshed successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired refresh cookie",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh-body": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh tokens (body-based, deprecated)",
        "description": "Exchange refresh token in request body for new token pair. DEPRECATED in M03b — use cookie-based POST /auth/refresh instead. Planned removal: M04/M05.",
        "operationId": "refreshBody",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tokens refreshed successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify OTP code",
        "description": "Verify OTP code and receive JWT token pair + refresh cookie",
        "operationId": "verifyOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP verified, JWT pair returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired OTP code",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/otp/verify-by-code": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify OTP code without telegram ID",
        "description": "Verify OTP code by reverse lookup (code → telegramId). Used by web-panel where the user only enters the 6-digit code received in Telegram bot.",
        "operationId": "verifyOtpByCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyByCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP verified, JWT pair returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired OTP code",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/otp/request": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request OTP code",
        "description": "Generate OTP code for Telegram-based authentication and return it in response body for bot delivery",
        "operationId": "requestOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP code generated and returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OtpCodeResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited — too many requests",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OtpCodeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Logout",
        "description": "Invalidate refresh token, ws-tickets, and clear refresh cookie",
        "operationId": "logout",
        "parameters": [
          {
            "name": "rct_refresh",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully logged out"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login with credentials",
        "description": "Authenticate with login and password, returns JWT token pair + refresh cookie",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully authenticated",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Change password",
        "description": "Change password for authenticated user",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password changed successfully"
          },
          "401": {
            "description": "Current password is incorrect"
          }
        }
      }
    },
    "/auth/public-key": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get RSA public key",
        "description": "Returns RSA public key in PEM format for JWT verification",
        "operationId": "getPublicKey",
        "responses": {
          "200": {
            "description": "Public key retrieved",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PublicKeyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InternalIssueRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "groupId": {
            "type": "integer",
            "format": "int64"
          },
          "isHeadman": {
            "type": "boolean"
          }
        },
        "required": [
          "userId"
        ]
      },
      "InternalIssueResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConsumeRequest": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ConsumeResponse": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "format": "int64"
          },
          "role": {
            "type": "string"
          },
          "group_id": {
            "type": "integer",
            "format": "int64"
          },
          "is_headman": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WsTicketResponse": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TmaAuthRequest": {
        "type": "object",
        "properties": {
          "initData": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "OtpVerifyRequest": {
        "type": "object",
        "properties": {
          "telegramId": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6
          }
        },
        "required": [
          "telegramId"
        ]
      },
      "OtpVerifyByCodeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6
          }
        }
      },
      "OtpRequest": {
        "type": "object",
        "properties": {
          "telegramId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "telegramId"
        ]
      },
      "OtpCodeResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).+$"
          }
        }
      },
      "PublicKeyResponse": {
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          }
        }
      }
    }
  }
}
