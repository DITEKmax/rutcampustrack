{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "group.renamed",
  "description": "Группа переименована (ручное редактирование админом или автопромоушен на следующий курс). Генерируется Academic Service. Минимальный payload (D-01): consumers вызывают gRPC AcademicGrpcService.GetGroup для актуального имени.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "traceparent": {"$ref": "_common.json#/$defs/traceparent"},
    "request_id": {"$ref": "_common.json#/$defs/requestId"},
    "event_type": {
      "const": "group.renamed"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "group_id"
      ],
      "properties": {
        "group_id": {
          "type": "integer"
        },
        "actor_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notification_cause": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "AUTOMATIC_GROUP_CYCLE",
            null
          ]
        },
        "cycle_semester_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
