+  box-sizing: inherit;
+}
+
+.map-screen__header {
+  display: grid;
+  grid-template-columns: var(--rct-map-min-touch) minmax(0, 1fr) var(--rct-map-min-touch);
+  align-items: center;
+  gap: var(--rct-space-2);
+  margin-block-end: var(--rct-space-5);
+}
+
+.map-screen__back,
+.map-viewer__button {
+  display: inline-grid;
+  place-items: center;
+  min-inline-size: var(--rct-map-min-touch);
+  min-block-size: var(--rct-map-min-touch);
+  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
+  border-radius: var(--rct-map-radius-md);
+  color: var(--rct-color-text-primary);
+  background: var(--rct-color-surface-raised);
+  font: inherit;
+  cursor: pointer;
+  @mixin rct-focus-ring;
+}
+
+.map-screen__back {
+  font-size: var(--rct-map-title-size);
+}
+
+.map-screen__back:disabled,
+.map-viewer__button:disabled {
+  color: var(--rct-color-disabled-text);
+  background: var(--rct-color-disabled-surface);
+  cursor: not-allowed;
+}
+
+.map-screen__header h1 {
+  margin: 0;
+  font-size: var(--rct-map-title-size);
+  font-weight: var(--rct-font-weight-bold);
+  line-height: var(--rct-leading-tight);
+  text-align: center;
+}
+
+.map-screen__header-spacer {
+  min-block-size: var(--rct-map-min-touch);
+}
+
+.map-screen__offline {
+  grid-column: 1 / -1;
+  margin: 0;
+  color: var(--rct-color-warning-text);
+  text-align: center;
+  @mixin rct-type-micro;
+}
+
+.map-screen__selectors {
+  display: grid;
+  gap: var(--rct-space-3);
+  margin-block-end: var(--rct-space-4);
+}
+
+.map-field {
+  display: grid;
+  gap: var(--rct-map-label-gap);
+}
+
+.map-field span {
+  color: var(--rct-color-text-primary);
+  @mixin rct-type-dense;
+}
+
+.map-field select {
+  min-block-size: var(--rct-map-field-height);
+  inline-size: 100%;
+  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
+  border-radius: var(--rct-map-radius-md);
+  padding: 0 var(--rct-space-3);
+  color: var(--rct-color-text-primary);
+  background: var(--rct-color-surface-raised);
+  font: inherit;
+  @mixin rct-focus-ring;
+}
+
+.map-field select:disabled {
+  color: var(--rct-color-disabled-text);
+  background: var(--rct-color-disabled-surface);
+}
+
+.map-screen__state {
+  display: grid;
+  gap: var(--rct-space-3);
+  justify-items: center;
+  min-block-size: var(--rct-map-canvas-min-block);
+  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
+  border-radius: var(--rct-map-radius-md);
+  padding: var(--rct-space-5);
+  color: var(--rct-color-text-secondary);
+  background: var(--rct-color-surface-raised);
+  text-align: center;
+}
+
+.map-screen__state h2,
+.map-screen__state p {
+  margin: 0;
+}
+
+.map-screen__state h2 {
+  color: var(--rct-color-text-primary);
+  font-size: var(--rct-font-size-title);
+  font-weight: var(--rct-font-weight-bold);
+  line-height: var(--rct-leading-tight);
+}
+
+.map-screen__state--error {
+  border-color: var(--rct-color-danger-text);
+}
+
+.map-screen__state--empty {
+  align-content: center;
+  gap: var(--rct-space-2);
+  justify-items: start;
+  block-size: var(--rct-map-canvas-min-block);
+  min-block-size: var(--rct-map-canvas-min-block);
+  padding: var(--rct-space-4);
+  color: var(--rct-color-text-primary);
+  background: var(--rct-color-surface-base);
+  text-align: start;
+}
+
+.map-screen__state--empty p {
+  @mixin rct-type-dense;
+}
+
+.map-screen__state--empty p:first-child {
+  color: var(--rct-color-text-primary);
+  font-weight: var(--rct-font-weight-medium);
+}
+
+.map-screen__state--empty p + p {
+  color: var(--rct-color-text-secondary);
+}
+
+.map-screen__retry {
+  min-block-size: var(--rct-map-min-touch);
+  border: 0;
+  border-radius: var(--rct-map-radius-md);
+  padding: 0 var(--rct-space-4);
+  color: var(--rct-color-accent-on-now);
+  background: var(--rct-color-accent-now);
+  font: inherit;
+  font-weight: var(--rct-font-weight-bold);
+  cursor: pointer;
+  @mixin rct-focus-ring;
+}
+
+.map-screen__sync {
+  margin: var(--rct-space-3) 0 0;
+  color: var(--rct-color-warning-text);
+  @mixin rct-type-micro;
+}
+
+.map-viewer {
+  display: grid;
+  gap: var(--rct-space-3);
+}
+
+.map-viewer__canvas {
+  position: relative;
+  min-inline-size: 0;
+}
+
+.map-viewer__toolbar {
+  position: absolute;
+  z-index: 1;
+  inset-block-start: var(--rct-space-3);
+  inset-inline-start: var(--rct-space-2);
+  inset-inline-end: var(--rct-space-3);
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: var(--rct-space-2);
+  max-inline-size: calc(100% - var(--rct-space-2) - var(--rct-space-3));
+  flex-wrap: wrap;
+}
+
+.map-viewer__toolbar-label {
+  color: var(--rct-color-text-secondary);
+  text-align: center;
+  @mixin rct-type-micro;
+}
+
+.map-viewer__button {
+  font-size: var(--rct-font-size-title);
+}
+
+.map-viewer__viewport {
+  display: block;
+  inline-size: 100%;
+  min-inline-size: 0;
+  block-size: var(--rct-map-canvas-min-block);
+  overflow: auto;
+  border: var(--rct-border-hairline) solid var(--rct-color-border-default);
+  border-radius: var(--rct-map-radius-md);
+  background: var(--rct-color-surface-raised);
+  cursor: grab;
+  touch-action: none;
+  @mixin rct-focus-ring;
+}
+
+.map-viewer__viewport:active {
+  cursor: grabbing;
+}
+
+.map-viewer__image {
+  display: block;
+  margin: auto;
+  user-select: none;
+  pointer-events: none;
+  object-fit: contain;
+}
+
+.map-viewer__status {
+  margin: 0;
+  color: var(--rct-color-text-secondary);
+  text-align: center;
+  @mixin rct-type-micro;
+}
+
+.map-screen__visually-hidden {
+  position: absolute;
+  inline-size: var(--rct-border-hairline);
+  block-size: var(--rct-border-hairline);
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .map-screen * {
+    scroll-behavior: auto;
+    transition-duration: 0s;
+    animation-duration: 0s;
+  }
+}
diff --git a/frontends/mobile-core/src/features/map/map-sync.ts b/frontends/mobile-core/src/features/map/map-sync.ts
new file mode 100644
index 00000000..ae5a4357
--- /dev/null
+++ b/frontends/mobile-core/src/features/map/map-sync.ts
@@ -0,0 +1,383 @@
+import type {
+  MapAssetDescriptor,
+  MapCachedAsset,
+  MapManifest,
+  MapOwnerScope,
+  MapOwnerState,
+  MapReadPort,
+  MapSnapshot,
+  MapSyncResult,
+} from './map-contract'
+import { MapError, MapStaleCommitError, mapAssetKey } from './map-contract'
+import { assetRequestFor, validateAssetBlob, validateManifest, type AssetValidationOptions } from './map-validation'
+import { MapOfflineStore } from './map-offline-store'
+
+const MAX_SNAPSHOT_BYTES = 128 * 1024 * 1024
+const DEFAULT_CONCURRENCY = 3
+
+export interface MapSynchronizerOptions {
+  readonly port: MapReadPort
+  readonly store: MapOfflineStore
+  readonly validation?: AssetValidationOptions
+  readonly concurrency?: number
+  readonly isCurrent?: (scope: MapOwnerScope) => boolean
+}
+
+export class MapSynchronizer {
+  private readonly port: MapReadPort
+  private readonly store: MapOfflineStore
+  private readonly validation: AssetValidationOptions
+  private readonly concurrency: number
+  private readonly isCurrent: (scope: MapOwnerScope) => boolean
+  private currentScope: MapOwnerScope | null = null
+  private currentActive = true
+  private operationToken = 0
+  private operationController: AbortController | null = null
+  private operationSignal: AbortSignal | null = null
+  private readonly signalTokens = new WeakMap<AbortSignal, number>()
+
+  constructor(options: MapSynchronizerOptions) {
+    this.port = options.port
+    this.store = options.store
+    this.validation = options.validation ?? {}
+    this.concurrency = Math.max(1, Math.min(6, Math.floor(options.concurrency ?? DEFAULT_CONCURRENCY)))
+    this.isCurrent = options.isCurrent ?? (() => true)
+  }
+
+  setScope(scope: MapOwnerScope, active = true): void {
+    this.operationToken += 1
+    this.operationController?.abort()
+    this.operationController = null
+    this.operationSignal = null
+    this.currentScope = scope
+    this.currentActive = active
+  }
+
+  async synchronize(scope: MapOwnerScope, signal: AbortSignal): Promise<MapSyncResult> {
+    this.operationController?.abort()
+    const operationController = new AbortController()
+    this.operationToken += 1
+    this.operationController = operationController
+    this.operationSignal = signal
+    this.signalTokens.set(signal, this.operationToken)
+    let ownerState: MapOwnerState
+    let previous: MapSnapshot | null
+    let previousCorrupt = false
+    try {
+      this.assertCurrent(scope, signal)
+      ownerState = await this.store.getOwnerState(scope)
+      this.assertCurrent(scope, signal)
+    } catch (error) {
+      if (signal.aborted || !this.scopeIsCurrent(scope, signal)) return staleResult()
+      const mapError = asMapError(error, 'сохранённый offline snapshot недоступен')
+      if (mapError.kind === 'stale') return staleResult(mapError)
+      return result('storage-unavailable', null, mapError)
+    }
+    if (!this.scopeIsCurrent(scope, signal)) return staleResult()
+    if (!authorityAllowsSync(ownerState, scope)) return result('stale', null, ownerAuthorityError(ownerState, scope))
+    try {
+      this.assertCurrent(scope, signal)
+      previous = await this.store.readSnapshot(scope)
+      this.assertCurrent(scope, signal)
+      if (!this.scopeIsCurrent(scope, signal)) return staleResult()
+    } catch (error) {
+      if (!this.scopeIsCurrent(scope, signal)) return staleResult()
+      const mapError = asMapError(error, 'сохранённый offline snapshot недоступен')
+      if (mapError.kind === 'stale') return staleResult(mapError)
+      if (mapError.kind !== 'corrupt') return await this.resultAfterReconcile(scope, signal, ownerState, null, 'storage-unavailable', mapError)
+      previous = null
+      previousCorrupt = true
+    }
+
+    if (!authorityAllowsSync(ownerState, scope)) return result('stale', null, ownerAuthorityError(ownerState, scope))
+    if (!this.port.readManifest) {
+      return this.resultAfterReconcile(scope, signal, ownerState, previous, 'update-failed', new MapError('invalid-response', 'MapReadPort не предоставил full manifest'))
+    }
+    let response
+    try {
+      await this.requireAuthority(scope, signal)
+      this.assertCurrent(scope, signal)
+      response = await this.port.readManifest({
+        ...(!previousCorrupt && ownerState.activeRevision ? { knownRevision: ownerState.activeRevision } : {}),
+        signal,
+      })
+      this.assertCurrent(scope, signal)
+    } catch (error) {
+      const mapError = asMapError(error, 'не удалось проверить версию offline snapshot')
+      if (mapError.kind === 'aborted' || mapError.kind === 'stale') return staleResult(mapError)
+      return this.resultAfterReconcile(scope, signal, ownerState, previous, 'update-failed', mapError)
+    }
+    if (!this.scopeIsCurrent(scope, signal) || signal.aborted) return staleResult()
+    const afterManifest = await this.reconcileAuthority(scope, signal, ownerState, previous)
+    if (!this.scopeIsCurrent(scope, signal)) return staleResult()
+    if (afterManifest.kind !== 'same' && !canRepairCorruptSnapshot(afterManifest, previousCorrupt)) return reconciliationResult(afterManifest, 'update-failed', previous)
+
+    if (response.kind === 'unchanged') {
+      if (previousCorrupt) return result('update-failed', null, new MapError('corrupt', 'повреждённый offline snapshot требует полного manifest'))
+      if (!response.revision || !previous || previous.manifest.revision !== response.revision) {
+        return result('no-cache', null, new MapError('storage', 'сервер подтвердил revision без полного offline snapshot'))
+      }
+      return result('unchanged', reconciliationSnapshot(afterManifest, previous))
+    }
+
+    let manifest: MapManifest
+    try {
+      manifest = validateManifest(response.manifest)
+    } catch (error) {
+      return this.resultAfterReconcile(scope, signal, ownerState, previous, 'update-failed', asMapError(error, 'manifest карты не прошёл проверку'))
+    }
+    const afterManifestValidation = await this.reconcileAuthority(scope, signal, ownerState, previous)
+    if (!this.scopeIsCurrent(scope, signal)) return staleResult()
+    if (afterManifestValidation.kind !== 'same' && !canRepairCorruptSnapshot(afterManifestValidation, previousCorrupt)) return reconciliationResult(afterManifestValidation, 'update-failed', previous)
+    if (previous?.manifest.revision === manifest.revision) return result('unchanged', reconciliationSnapshot(afterManifestValidation, previous))
+
+    const entries = readyAssetEntries(manifest)
+    const totalBytes = entries.reduce((sum, entry) => sum + entry.descriptor.bytes, 0)
+    if (totalBytes > MAX_SNAPSHOT_BYTES) return result('update-failed', previous, new MapError('asset-invalid', 'полный offline snapshot превышает лимит 128 MiB'))
+    const previousByIdentity = new Map(previous?.assets.map((asset) => [assetIdentity(asset), asset]) ?? [])
+    let assets: MapCachedAsset[]
+    try {
+      assets = await this.fetchAssets(entries, previousByIdentity, scope, signal)
+    } catch (error) {
+      const mapError = asMapError(error, 'offline snapshot не собран атомарно')
+      if (mapError.kind === 'stale' || mapError.kind === 'aborted') return staleResult(mapError)
+      return this.resultAfterReconcile(scope, signal, ownerState, previous, 'update-failed', mapError)
+    }
+    if (!this.scopeIsCurrent(scope, signal) || signal.aborted) return staleResult()
+    const afterAssets = await this.reconcileAuthority(scope, signal, ownerState, previous)
+    if (!this.scopeIsCurrent(scope, signal)) return staleResult()
+    if (afterAssets.kind !== 'same' && !canRepairCorruptSnapshot(afterAssets, previousCorrupt)) return reconciliationResult(afterAssets, 'update-failed', previous)
+    try {
+      const commitAuthority = await this.requireAuthority(scope, signal)
+      this.assertCurrent(scope, signal)
+      const snapshot = await this.store.commitSnapshot(scope, commitAuthority, manifest, assets)
+      this.assertCurrent(scope, signal)
+      if (!this.scopeIsCurrent(scope, signal) || signal.aborted) return staleResult()
+      await this.requireAuthority(scope, signal)
+      const committedOwnerState: MapOwnerState = { ownerKey: snapshot.ownerKey, generation: snapshot.generation, epoch: snapshot.epoch, activeRevision: snapshot.manifest.revision, authority: 'active' }
+      return this.resultAfterReconcile(scope, signal, committedOwnerState, snapshot, 'updated', undefined, snapshot)
+    } catch (error) {
+      const mapError = asMapError(error, 'offline snapshot не был переключён')
+      return this.resultAfterReconcile(scope, signal, ownerState, previous, mapError.kind === 'storage' ? 'storage-unavailable' : 'update-failed', mapError)
+    }
+  }
+
+  private async fetchAssets(
+    entries: readonly ReadyAssetEntry[],
+    previousByIdentity: ReadonlyMap<string, MapCachedAsset>,
+    scope: MapOwnerScope,
+    signal: AbortSignal,
+  ): Promise<MapCachedAsset[]> {
+    const assets: MapCachedAsset[] = []
+    let cursor = 0
+    const worker = async (): Promise<void> => {
+      while (true) {
+        if (signal.aborted || !this.scopeIsCurrent(scope, signal)) throw new MapStaleCommitError()
+        const index = cursor++
+        const entry = entries[index]
+        if (!entry) return
+        const key = mapAssetKey({
+          buildingId: entry.buildingId,
+          floorId: entry.floorId,
+          version: entry.version,
+          format: entry.descriptor.format,
+          assetId: entry.descriptor.id,
+        })
+        const reused = previousByIdentity.get(assetIdentity(entry.descriptor))
+        if (reused) {
+          this.assertCurrent(scope, signal)
+          assets[index] = {
+            ...reused,
+            key,
+            buildingId: entry.buildingId,
+            floorId: entry.floorId,
+            version: entry.version,
+            format: entry.descriptor.format,
+            assetId: entry.descriptor.id,
+            contentType: entry.descriptor.contentType,
+            bytes: entry.descriptor.bytes,
+            sha256: entry.descriptor.sha256,
+          }
+          continue
+        }
+        await this.requireAuthority(scope, signal)
+        this.assertCurrent(scope, signal)
+        const request = assetRequestFor(entry.descriptor, entry.buildingId, entry.floorId, entry.version, signal)
+        const blob = await this.port.readAsset(request)
+        this.assertCurrent(scope, signal)
+        await this.requireAuthority(scope, signal)
+        const validated = await validateAssetBlob(entry.descriptor, blob, this.validation)
+        this.assertCurrent(scope, signal)
+        await this.requireAuthority(scope, signal)
+        if (!this.scopeIsCurrent(scope, signal)) throw new MapStaleCommitError()
+        assets[index] = {
+          key,
+          buildingId: entry.buildingId,
+          floorId: entry.floorId,
+          version: entry.version,
+          format: entry.descriptor.format,
+          assetId: entry.descriptor.id,
+          contentType: entry.descriptor.contentType,
+          bytes: validated.blob.size,
+          sha256: validated.sha256,
+          blob: validated.blob,
+        }
+      }
+    }
+    await Promise.all(Array.from({ length: Math.min(this.concurrency, Math.max(entries.length, 1)) }, () => worker()))
+    return assets
+  }
+
+  private scopeIsCurrent(scope: MapOwnerScope, signal?: AbortSignal): boolean {
+    const operationToken = signal ? this.signalTokens.get(signal) : this.operationToken
+    return operationToken === this.operationToken && this.operationController !== null && (signal === undefined || this.operationSignal === signal) && !this.operationController.signal.aborted && this.currentActive && (this.currentScope === null || (this.currentScope.ownerKey === scope.ownerKey && this.currentScope.generation === scope.generation)) && this.isCurrent(scope)
+  }
+
+  private assertCurrent(scope: MapOwnerScope, signal: AbortSignal): void {
+    if (!this.scopeIsCurrent(scope, signal) || signal.aborted) throw new MapStaleCommitError()
+  }
+
+  private async requireAuthority(scope: MapOwnerScope, signal: AbortSignal): Promise<MapOwnerState> {
+    this.assertCurrent(scope, signal)
+    const state = await this.store.getOwnerState(scope)
+    this.assertCurrent(scope, signal)
+    if (!authorityAllowsSync(state, scope)) throw ownerAuthorityError(state, scope)
+    return state
+  }
+
+  private async resultAfterReconcile(
+    scope: MapOwnerScope,
+    signal: AbortSignal,
+    ownerState: MapOwnerState,
+    previous: MapSnapshot | null,
+    status: MapSyncResult['status'],
+    error?: MapError,
+    fallbackSnapshot: MapSnapshot | null = previous,
+  ): Promise<MapSyncResult> {
+    const reconciliation = await this.reconcileAuthority(scope, signal, ownerState, previous)
+    return reconciliationResult(reconciliation, status, fallbackSnapshot, error)
+  }
+
+  private async reconcileAuthority(
+    scope: MapOwnerScope,
+    signal: AbortSignal,
+    expected: MapOwnerState,
+    previous: MapSnapshot | null,
+  ): Promise<Reconciliation> {
+    if (!this.scopeIsCurrent(scope, signal)) return { kind: 'stale', error: new MapStaleCommitError() }
+
+    let current: MapOwnerState
+    try {
+      this.assertCurrent(scope, signal)
+      current = await this.store.getOwnerState(scope)
+    } catch (error) {
+      if (!this.scopeIsCurrent(scope, signal)) return { kind: 'stale', error: new MapStaleCommitError() }
+      const mapError = asMapError(error, 'сохранённый offline snapshot недоступен')
+      return mapError.kind === 'stale' ? { kind: 'stale', error: mapError } : { kind: 'storage-error', error: mapError }
+    }
+    if (!this.scopeIsCurrent(scope, signal)) return { kind: 'stale', error: new MapStaleCommitError() }
+
+    if (!authorityAllowsSync(current, scope) || (expected.generation !== null && current.generation !== expected.generation)) return { kind: 'authority-lost', error: ownerAuthorityError(current, scope) }
+    const epochChanged = current.epoch !== expected.epoch
+    const authorityBecameNull = current.activeRevision === null && (expected.activeRevision !== null || previous !== null)
+    if (epochChanged || authorityBecameNull) return { kind: 'authority-lost', error: ownerAuthorityError(current, scope) }
+
+    let latest: MapSnapshot | null
+    try {
+      this.assertCurrent(scope, signal)
+      latest = await this.store.readSnapshot(scope)
+    } catch (error) {
+      if (!this.scopeIsCurrent(scope, signal)) return { kind: 'stale', error: new MapStaleCommitError() }
+      const mapError = asMapError(error, 'сохранённый offline snapshot недоступен')
+      if (mapError.kind === 'stale') return { kind: 'authority-lost', error: ownerAuthorityError(current, scope) }
+      if (current.activeRevision !== expected.activeRevision || current.generation !== expected.generation || !authorityAllowsSync(current, scope)) return { kind: 'authority-lost', error: ownerAuthorityError(current, scope) }
+      if (mapError.kind === 'corrupt') return { kind: 'storage-error', error: mapError }
+      return { kind: 'storage-error', error: authorityUnchangedStorageError(mapError, current, scope) }
+    }
+    if (!this.scopeIsCurrent(scope, signal)) return { kind: 'stale', error: new MapStaleCommitError() }
+
+    if (!latest) {
+      if (current.activeRevision !== null || previous !== null) return { kind: 'authority-lost', error: ownerAuthorityError(current, scope) }
+      return { kind: 'same', snapshot: null }
+    }
+    if (latest.generation !== scope.generation || latest.epoch !== expected.epoch || latest.epoch !== current.epoch) return { kind: 'authority-lost', error: ownerAuthorityError(current, scope) }
+    if (current.activeRevision === null || current.authority !== 'active') return { kind: 'authority-lost', error: ownerAuthorityError(current, scope) }
+    if (current.activeRevision !== expected.activeRevision || latest.manifest.revision !== previous?.manifest.revision) return { kind: 'winner', snapshot: latest }
+    return { kind: 'same', snapshot: latest }
+  }
+}
+
+type Reconciliation =
+  | { readonly kind: 'same'; readonly snapshot: MapSnapshot | null }
+  | { readonly kind: 'winner'; readonly snapshot: MapSnapshot }
+  | { readonly kind: 'authority-lost'; readonly error: MapError }
+  | { readonly kind: 'storage-error'; readonly error: MapError }
+  | { readonly kind: 'stale'; readonly error: MapError }
+
+function reconciliationResult(reconciliation: Reconciliation, status: MapSyncResult['status'], fallbackSnapshot: MapSnapshot | null, error?: MapError): MapSyncResult {
+  if (reconciliation.kind === 'same') return result(status, reconciliation.snapshot ?? fallbackSnapshot, error)
+  if (reconciliation.kind === 'winner') return result('stale', reconciliation.snapshot, error ?? new MapStaleCommitError())
+  if (reconciliation.kind === 'authority-lost') return result('stale', null, reconciliation.error)
+  if (reconciliation.kind === 'stale') return staleResult(reconciliation.error)
+  return result(status === 'updated' ? 'storage-unavailable' : status, fallbackSnapshot, reconciliation.error)
+}
+
+function authorityAllowsSync(ownerState: MapOwnerState, scope: MapOwnerScope): boolean {
+  return ownerState.ownerKey === scope.ownerKey && ownerState.generation === scope.generation && (ownerState.authority === 'virgin' || ownerState.authority === 'active')
+}
+
+function ownerAuthorityError(ownerState: MapOwnerState, scope: MapOwnerScope): MapError {
+  return new MapError('stale', 'durable authority владельца карты изменилась', { authorityChanged: true, authority: ownerState.authority, generation: ownerState.generation, requestedGeneration: scope.generation, epoch: ownerState.epoch, activeRevision: ownerState.activeRevision })
+}
+
+function authorityUnchangedStorageError(error: MapError, ownerState: MapOwnerState, scope: MapOwnerScope): MapError {
+  return new MapError('storage', error.message, { authorityUnchanged: authorityAllowsSync(ownerState, scope), authority: ownerState.authority, generation: ownerState.generation, epoch: ownerState.epoch, activeRevision: ownerState.activeRevision, cause: error })
+}
+
+function canRepairCorruptSnapshot(reconciliation: Reconciliation, previousCorrupt: boolean): boolean {
+  return previousCorrupt && reconciliation.kind === 'storage-error' && reconciliation.error.kind === 'corrupt'
+}
+
+function reconciliationSnapshot(reconciliation: Reconciliation, fallback: MapSnapshot | null): MapSnapshot | null {
+  if (reconciliation.kind === 'same') return reconciliation.snapshot ?? fallback
+  if (reconciliation.kind === 'winner') return reconciliation.snapshot
+  return fallback
+}
+
+interface ReadyAssetEntry {
+  readonly buildingId: string
+  readonly floorId: string
+  readonly version: string
+  readonly descriptor: MapAssetDescriptor & { readonly id: string; readonly sha256: string }
+}
+
+function assetIdentity(asset: Pick<MapCachedAsset, 'assetId' | 'format' | 'sha256' | 'bytes'> | (MapAssetDescriptor & { readonly id: string; readonly sha256: string })): string {
+  const id = 'assetId' in asset ? asset.assetId : asset.id
+  return [id, asset.format, asset.sha256, asset.bytes].map(encodeURIComponent).join('/')
+}
+
+function readyAssetEntries(manifest: MapManifest): ReadyAssetEntry[] {
+  const entries: ReadyAssetEntry[] = []
+  for (const building of manifest.buildings) {
+    for (const floor of building.floors) {
+      if (!floor.plan) continue
+      for (const descriptor of [floor.plan.png, floor.plan.svg]) {
+        if (descriptor.state === 'ready' && descriptor.id !== null && descriptor.sha256 !== null) entries.push({ buildingId: building.id, floorId: floor.id, version: floor.plan.version, descriptor: descriptor as ReadyAssetEntry['descriptor'] })
+      }
+    }
+  }
+  return entries
+}
+
+function result(status: MapSyncResult['status'], snapshot: MapSnapshot | null, error?: MapError): MapSyncResult {
+  return error ? { status, snapshot, error } : { status, snapshot }
+}
+
+function staleResult(error = new MapStaleCommitError()): MapSyncResult {
+  return result('stale', null, error)
+}
+
+function asMapError(error: unknown, message: string): MapError {
+  if (error instanceof MapError) return error
+  return new MapError('unknown', message, error)
+}
