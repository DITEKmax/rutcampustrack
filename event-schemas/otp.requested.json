{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "otp.requested",
  "description": "Auth publishes a purpose-bound OTP for login, password reset, or one exact full-subject deletion. Codes are delivered only through the notification consumer, never in the HTTP response.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "otp.requested"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": ["telegram_id", "code", "ttl_seconds", "purpose"],
      "properties": {
        "telegram_id": {
          "type": "integer",
          "description": "Telegram user id — адресат сообщения с кодом"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "description": "6-значный OTP-код. Живёт в Redis TTL seconds. Секретный — consumer должен логировать MASKED (см. shared-logback masking правила)."
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Время жизни кода в секундах — bot показывает пользователю срок действия"
        },
        "purpose": {
          "type": "string",
          "enum": ["login", "password_reset", "subject_delete"],
          "description": "Назначение кода; proof одного сценария не действует в другом"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 64,
          "description": "Opaque purpose-bound challenge handle; required for password_reset and subject_delete"
        },
        "attempts_remaining": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Server-reported account-window verification attempts remaining"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "password_reset"
              }
            },
            "required": ["purpose"]
          },
          "then": {
            "required": ["challenge_id", "attempts_remaining"]
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "subject_delete"
              }
            },
            "required": ["purpose"]
          },
          "then": {
            "required": ["challenge_id", "attempts_remaining"],
            "properties": {
              "challenge_id": {
                "pattern": "^[A-Za-z0-9_-]{32}$"
              }
            }
          }
        }
      ]
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (всегда auth-service для otp.requested)."
    }
  }
}
