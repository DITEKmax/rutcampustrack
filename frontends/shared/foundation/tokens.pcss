:root {
  --rct-control-min-touch: 2.75rem; /* canonical control/min-touch: 44px */
  --rct-font-family-sans: 'Onest Variable', Onest, sans-serif;
  --rct-font-size-body: 1rem;
  --rct-font-size-dense: 0.875rem;
  --rct-font-size-caption: 0.8125rem;
  --rct-font-size-micro: 0.75rem;
  --rct-font-size-title: 1.125rem;
  --rct-font-size-title-block: var(--rct-font-size-title);
  --rct-font-size-title-screen: 1.5rem;
  --rct-font-weight-regular: 400;
  --rct-font-weight-medium: 500;
  --rct-font-weight-bold: 600;
  --rct-leading-tight: 1.15;
  --rct-leading-snug: 1.35;
  --rct-leading-caption: 1.4;
  --rct-space-1: 0.25rem;
  --rct-space-half: 0.125rem;
  --rct-space-1-half: 0.375rem;
  --rct-space-2-half: 0.625rem;
  --rct-space-2: 0.5rem;
  --rct-space-3: 0.75rem;
  --rct-space-4: 1rem;
  --rct-space-5: 1.25rem;
  --rct-space-6: 1.5rem;
  --rct-radius-lg: 0.75rem;
  --rct-radius-xl: 1rem;
  --rct-radius-2xl: 1.5rem;
  --rct-radius-full: 62.4375rem;
  --rct-border-hairline: 0.0625rem;
  --rct-focus-width: 0.125rem;
  --rct-focus-offset: 0.125rem;
  --rct-radius-xs: 0.25rem;
  --rct-space-7: 1.75rem;
  --rct-space-8: 2rem;
  --rct-space-9: 2.25rem;
  --rct-space-10: 2.5rem;
  --rct-radius-md: 0.625rem;
  --rct-leading-normal: 1.5;
  --rct-control-height: 2.5rem;
  --rct-space-0: 0;
  --space-0: var(--rct-space-0);
  --rct-font-size-display: 2rem;
