@import '../../styles/tokens.pcss';

.mobile-shell {
  position: relative;
  min-block-size: 100%;
  font-family: var(--rct-font-family-sans);
  font-feature-settings:
    'tnum' 1,
    'lnum' 1;
  font-variant-numeric: tabular-nums;
}

.mobile-shell__back {
  display: inline-flex;
  align-items: center;
  min-block-size: var(--rct-control-min-touch);
  min-inline-size: var(--rct-control-min-touch);
  border: 0;
  padding: var(--rct-space-2) var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: transparent;
  font: inherit;
  cursor: pointer;
  @mixin rct-focus-ring;
}

/* Accepted Student presentation; existing roles retain their base rules. */
:where([data-student-ui]) .mobile-shell,
:where([data-student-ui]):is(.mobile-shell) {
  position: relative;
  min-block-size: 100%;
  font-family: var(--rct-font-family-sans);
  font-feature-settings:
    'tnum' 1,
    'lnum' 1;
  font-variant-numeric: tabular-nums;
}

:where([data-student-ui]) .mobile-shell__back,
:where([data-student-ui]):is(.mobile-shell__back) {
  display: inline-flex;
  align-items: center;
  min-block-size: var(--rct-control-min-touch);
  min-inline-size: var(--rct-control-min-touch);
  border: 0;
  padding: var(--rct-space-2) var(--rct-space-3);
  color: var(--rct-color-text-primary);
  background: transparent;
  font: inherit;
  cursor: pointer;
  @mixin rct-focus-ring;
}

/* Student native host owns Back; product handlers remain the same in PWA. */
:where([data-student-ui])
  .mobile-shell[data-student='true'][data-back-owner='host']
  :is(
    .profile-back,
    .today-back,
    .requests-back-button,
    .statistics-back-button,
    .attendance-back-button,
    .map-screen__back
  ),
:where([data-student-ui]):is(
  .mobile-shell[data-student='true'][data-back-owner='host']
    :is(
      .profile-back,
      .today-back,
      .requests-back-button,
      .statistics-back-button,
      .attendance-back-button,
      .map-screen__back
    )
) {
  display: none;
}
