{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "homework.updated",
  "description": "Домашнее задание обновлено. Генерируется Academic Service.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "homework.updated"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": [
        "homework_id",
        "group_id",
        "subject_id",
        "title",
        "lesson_date",
        "lesson_number"
      ],
      "properties": {
        "homework_id": {
          "type": "integer"
        },
        "group_id": {
          "type": "integer"
        },
        "subject_id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "has_link": {
          "type": "boolean"
        },
        "lesson_date": {
          "type": "string",
          "format": "date"
        },
        "lesson_number": {
          "$ref": "_common.json#/$defs/lessonNumber"
        }
      }
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
