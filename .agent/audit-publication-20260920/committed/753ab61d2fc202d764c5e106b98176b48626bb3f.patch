+                url("/api/v1/student/homework/9001/completion"), HttpMethod.PUT,
+                new HttpEntity<>("{\"completed\":true}", headers(token, false)), String.class);
+        assertProblem(notFound, HttpStatus.NOT_FOUND, "HOMEWORK_NOT_FOUND");
