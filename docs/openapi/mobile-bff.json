{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "RutCampusTrack Student Mobile BFF",
    "description" : "Canonical PWA/TMA student contract. Domain handlers land after contract freeze.",
    "version" : "JS-STUDENT-01-r1"
  },
  "tags" : [ {
    "name" : "Student mobile",
    "description" : "PWA/TMA student read model and geo check-in"
  } ],
  "paths" : {
    "/api/v1/student/lessons/{lessonId}/checkin" : {
      "post" : {
        "tags" : [ "Student mobile" ],
        "summary" : "Attempt student geo check-in",
        "description" : "The attendance domain owns the window, geofence, cooldown, idempotency and automatic request.",
        "operationId" : "checkin",
        "parameters" : [ {
          "name" : "lessonId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "pattern" : "^[1-9][0-9]*$",
            "type" : "string"
          }
        }, {
          "name" : "Idempotency-Key",
          "in" : "header",
          "description" : "Opaque 16-128 ASCII character command key",
          "required" : true,
          "schema" : {
            "maxLength" : 128,
            "minLength" : 16,
            "pattern" : "^[\\x21-\\x7E]+$",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StudentCheckinCommand"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "PRESENT or atomically persisted PENDING_CONFIRMATION",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StudentCheckinAck"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid input or idempotency key",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid or expired session",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "403" : {
            "description" : "Wrong role or group scope",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "404" : {
            "description" : "Lesson not found",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "409" : {
            "description" : "Manual absence, ineligible state or idempotency payload mismatch",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "429" : {
            "description" : "Durable 300-second pair cooldown",
            "headers" : {
              "Retry-After" : {
                "description" : "Whole seconds until retry",
                "style" : "simple"
              }
            },
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "503" : {
            "description" : "Mandatory dependency unavailable",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/student/today" : {
      "get" : {
        "tags" : [ "Student mobile" ],
        "summary" : "Today projection with current or nearest lesson",
        "operationId" : "getToday",
        "responses" : {
          "200" : {
            "description" : "Live Today projection",
            "headers" : {
              "Cache-Control" : {
                "description" : "Always no-store",
                "style" : "simple"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StudentToday"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid or expired session",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "403" : {
            "description" : "Wrong role or group scope",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "503" : {
            "description" : "Mandatory dependency unavailable; eligibility fails closed",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/student/session" : {
      "get" : {
        "tags" : [ "Student mobile" ],
        "summary" : "Current student session projection",
        "operationId" : "getSession",
        "responses" : {
          "200" : {
            "description" : "Session projection",
            "headers" : {
              "Cache-Control" : {
                "description" : "Always no-store",
                "style" : "simple"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StudentSession"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid or expired session",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "403" : {
            "description" : "Active role is not STUDENT",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "503" : {
            "description" : "Mandatory dependency unavailable",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/v1/student/schedule" : {
      "get" : {
        "tags" : [ "Student mobile" ],
        "summary" : "Server-scoped semester schedule for PWA offline reads",
        "operationId" : "getSchedule",
        "parameters" : [ {
          "name" : "semesterId",
          "in" : "query",
          "required" : true,
          "schema" : {
            "pattern" : "^[1-9][0-9]*$",
            "type" : "string"
          }
        }, {
          "name" : "If-None-Match",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Materialized lessons in one authorized semester",
            "headers" : {
              "Cache-Control" : {
                "description" : "private, no-cache",
                "style" : "simple"
              },
              "ETag" : {
                "description" : "Authorized stable representation validator",
                "style" : "simple"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StudentSemesterSchedule"
                }
              }
            }
          },
          "304" : {
            "description" : "Authorized representation unchanged",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StudentSemesterSchedule"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid or expired session",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "403" : {
            "description" : "Semester is outside the student's group scope",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          },
          "503" : {
            "description" : "Mandatory dependency unavailable",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MobileProblemDetails"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CoordinatesGeo" : {
        "required" : [ "kind", "latitude", "longitude" ],
        "type" : "object",
        "properties" : {
          "kind" : {
            "type" : "string",
            "enum" : [ "COORDINATES" ]
          },
          "latitude" : {
            "maximum" : 90.0,
            "exclusiveMaximum" : false,
            "minimum" : -90.0,
            "exclusiveMinimum" : false,
            "type" : "number",
            "format" : "double"
          },
          "longitude" : {
            "maximum" : 180.0,
            "exclusiveMaximum" : false,
            "minimum" : -180.0,
            "exclusiveMinimum" : false,
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "GeoInput" : {
        "type" : "object",
        "discriminator" : {
          "propertyName" : "kind",
          "mapping" : {
            "COORDINATES" : "#/components/schemas/CoordinatesGeo",
            "UNAVAILABLE" : "#/components/schemas/UnavailableGeo"
          }
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/CoordinatesGeo"
        }, {
          "$ref" : "#/components/schemas/UnavailableGeo"
        } ]
      },
      "StudentCheckinCommand" : {
        "required" : [ "geo" ],
        "type" : "object",
        "properties" : {
          "geo" : {
            "$ref" : "#/components/schemas/GeoInput"
          }
        }
      },
      "UnavailableGeo" : {
        "required" : [ "kind", "reason" ],
        "type" : "object",
        "properties" : {
          "kind" : {
            "type" : "string",
            "enum" : [ "UNAVAILABLE" ]
          },
          "reason" : {
            "type" : "string",
            "enum" : [ "PERMISSION_DENIED", "POSITION_UNAVAILABLE", "TIMEOUT" ]
          }
        }
      },
      "Attendance" : {
        "required" : [ "markedAt", "source", "status" ],
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "PRESENT", "ABSENT", "EXCUSED" ]
          },
          "source" : {
            "type" : "string",
            "enum" : [ "STUDENT_GEO", "LATE_CHECKIN", "HEADMAN", "TEACHER", "SYSTEM" ]
          },
          "markedAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          }
        },
        "nullable" : true
      },
      "AutomaticCheckinRequest" : {
        "required" : [ "id", "origin", "resolutionReason", "status" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "APPROVED", "REJECTED", "CANCELLED" ]
          },
          "origin" : {
            "type" : "string",
            "enum" : [ "AUTO_GEO_FAILURE" ]
          },
          "resolutionReason" : {
            "type" : "string",
            "nullable" : true,
            "enum" : [ "GEO_CONFIRMED", "HEADMAN_APPROVED", "HEADMAN_REJECTED", "STUDENT_CANCELLED" ]
          }
        },
        "nullable" : true
      },
      "Link" : {
        "required" : [ "href" ],
        "type" : "object",
        "properties" : {
          "href" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "StudentCheckinAck" : {
        "required" : [ "_links", "attendance", "lessonId", "outcome", "request", "retryAt", "serverNow" ],
        "type" : "object",
        "properties" : {
          "outcome" : {
            "type" : "string",
            "enum" : [ "PRESENT", "PENDING_CONFIRMATION" ]
          },
          "lessonId" : {
            "type" : "string"
          },
          "attendance" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/Attendance"
            } ]
          },
          "request" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/AutomaticCheckinRequest"
            } ]
          },
          "retryAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "serverNow" : {
            "type" : "string",
            "format" : "date-time"
          },
          "_links" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/Link"
            }
          }
        }
      },
      "MobileProblemDetails" : {
        "required" : [ "code", "detail", "instance", "status", "timestamp", "title", "type" ],
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "traceId" : {
            "type" : "string",
            "nullable" : true
          },
          "code" : {
            "type" : "string",
            "enum" : [ "INVALID_REQUEST", "INVALID_IDEMPOTENCY_KEY", "INVALID_SESSION", "WRONG_ROLE", "OUT_OF_SCOPE", "LESSON_NOT_FOUND", "CHECKIN_COOLDOWN", "MANUAL_ABSENCE_REQUIRES_APPEAL", "IDEMPOTENCY_PAYLOAD_MISMATCH", "CHECKIN_NOT_ELIGIBLE", "DEPENDENCY_UNAVAILABLE" ]
          },
          "retryAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "extras" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string",
              "nullable" : true
            },
            "nullable" : true
          }
        },
        "description" : "RFC 9457 Problem Details with a stable machine code"
      },
      "CheckinEligibility" : {
        "required" : [ "allowed", "reason", "retryAt" ],
        "type" : "object",
        "properties" : {
          "allowed" : {
            "type" : "boolean"
          },
          "reason" : {
            "type" : "string",
            "enum" : [ "ELIGIBLE", "ALREADY_PRESENT", "LESSON_CANCELLED", "TOO_EARLY", "WINDOW_CLOSED", "GEO_BLOCKED", "PENDING_CONFIRMATION", "COOLDOWN", "HEADMAN_ABSENT_REQUIRES_APPEAL", "HEADMAN_USES_JOURNAL", "DEPENDENCY_UNAVAILABLE" ]
          },
          "retryAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          }
        }
      },
      "LessonSchedule" : {
        "required" : [ "date", "endsAt", "id", "lessonNumber", "room", "startsAt", "status", "subject" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "lessonNumber" : {
            "type" : "integer",
            "format" : "int32"
          },
          "startsAt" : {
            "type" : "string",
            "example" : "14:30:00"
          },
          "endsAt" : {
            "type" : "string",
            "example" : "14:30:00"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PLANNED", "ACTIVE", "CLOSED", "CANCELLED" ]
          },
          "subject" : {
            "$ref" : "#/components/schemas/Subject"
          },
          "room" : {
            "$ref" : "#/components/schemas/Room"
          }
        }
      },
      "Room" : {
        "required" : [ "changeState", "current", "previous" ],
        "type" : "object",
        "properties" : {
          "current" : {
            "type" : "string",
            "nullable" : true
          },
          "previous" : {
            "type" : "string",
            "nullable" : true
          },
          "changeState" : {
            "type" : "string",
            "enum" : [ "UNCHANGED", "CHANGED", "UNKNOWN" ]
          }
        }
      },
      "StudentToday" : {
        "required" : [ "_links", "date", "lessons", "serverNow", "timeZone" ],
        "type" : "object",
        "properties" : {
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "timeZone" : {
            "type" : "string"
          },
          "serverNow" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lessons" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TodayLesson"
            }
          },
          "_links" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/Link"
            }
          }
        }
      },
      "Subject" : {
        "required" : [ "id", "name", "type" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "LECTURE", "PRACTICE", "LAB" ]
          }
        }
      },
      "TodayLesson" : {
        "required" : [ "attendance", "checkinEligibility", "request", "schedule" ],
        "type" : "object",
        "properties" : {
          "schedule" : {
            "$ref" : "#/components/schemas/LessonSchedule"
          },
          "attendance" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/Attendance"
            } ]
          },
          "checkinEligibility" : {
            "$ref" : "#/components/schemas/CheckinEligibility"
          },
          "request" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/AutomaticCheckinRequest"
            } ]
          }
        }
      },
      "GroupSummary" : {
        "required" : [ "id", "name" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "nullable" : true
      },
      "SemesterSummary" : {
        "required" : [ "endsOn", "id", "name", "startsOn" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "startsOn" : {
            "type" : "string",
            "format" : "date"
          },
          "endsOn" : {
            "type" : "string",
            "format" : "date"
          }
        }
      },
      "StudentSession" : {
        "required" : [ "_links", "activeRole", "capabilities", "group", "semester", "serverNow", "user" ],
        "type" : "object",
        "properties" : {
          "user" : {
            "$ref" : "#/components/schemas/StudentUser"
          },
          "activeRole" : {
            "type" : "string",
            "enum" : [ "STUDENT" ]
          },
          "group" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/GroupSummary"
            } ]
          },
          "semester" : {
            "nullable" : true,
            "allOf" : [ {
              "$ref" : "#/components/schemas/SemesterSummary"
            } ]
          },
          "capabilities" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "TODAY", "GEO_CHECKIN", "OFFLINE_SEMESTER_SCHEDULE" ]
            }
          },
          "serverNow" : {
            "type" : "string",
            "format" : "date-time"
          },
          "_links" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/Link"
            }
          }
        }
      },
      "StudentUser" : {
        "required" : [ "displayName", "id" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          }
        }
      },
      "StudentSemesterSchedule" : {
        "required" : [ "_links", "dateFrom", "dateTo", "lessons", "semester", "updatedAt" ],
        "type" : "object",
        "properties" : {
          "semester" : {
            "$ref" : "#/components/schemas/SemesterSummary"
          },
          "dateFrom" : {
            "type" : "string",
            "format" : "date"
          },
          "dateTo" : {
            "type" : "string",
            "format" : "date"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lessons" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LessonSchedule"
            }
          },
          "_links" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/Link"
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "description" : "Validated access JWT; client X-User-* headers are never identity",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
