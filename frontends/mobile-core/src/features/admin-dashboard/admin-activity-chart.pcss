@import '../../styles/tokens.pcss';

.admin-activity-chart { position: relative; display: grid; min-inline-size: 0; gap: var(--rct-space-3); }
.admin-activity-chart h3 { margin: 0; font-size: var(--rct-font-size-dense); font-weight: var(--rct-font-weight-medium); line-height: var(--rct-leading-snug); }
.admin-activity-chart__plot { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--rct-space-2); }
.admin-activity-chart__values { display: flex; flex-direction: column; justify-content: space-between; color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-micro); line-height: 1; }
.admin-activity-chart__canvas { min-inline-size: 0; block-size: var(--rct-attendance-plot-height); background: var(--rct-color-surface-float); border-radius: var(--rct-radius-lg); cursor: crosshair; touch-action: pan-y; @mixin rct-focus-ring; }
.admin-activity-chart__canvas svg { display: block; inline-size: 100%; block-size: 100%; overflow: visible; }
.admin-activity-chart__grid { fill: none; stroke: var(--rct-color-border-default); stroke-width: .5; }
.admin-activity-chart__line { fill: none; stroke: var(--rct-color-accent-now); stroke-width: 2; stroke-linejoin: round; }
.admin-activity-chart__point { fill: var(--rct-color-accent-now); stroke: var(--rct-color-surface-float); stroke-width: 1; }
.admin-activity-chart__selection { fill: none; stroke: var(--rct-color-text-primary); stroke-width: 1; stroke-dasharray: 3 3; }
.admin-activity-chart__ticks { position: relative; min-inline-size: 0; min-block-size: var(--rct-space-5); grid-column: 2; column-gap: var(--rct-space-3); color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-micro); }
.admin-activity-chart__measure { position: absolute; visibility: hidden; pointer-events: none; inset: 0; display: flex; inline-size: 100%; overflow: hidden; gap: var(--rct-space-3); }
.admin-activity-chart__measure span { flex: none; white-space: nowrap; }
.admin-activity-chart__tick { position: absolute; transform: translateX(-50%); white-space: nowrap; }
.admin-activity-chart__tick--first { transform: none; }
.admin-activity-chart__tick--last { transform: translateX(-100%); }
.admin-activity-chart__ticks--stacked { display: grid; min-block-size: calc(var(--rct-space-5) * 2); }
.admin-activity-chart__ticks--stacked > .admin-activity-chart__tick { position: static; transform: none; }
.admin-activity-chart__ticks--stacked > .admin-activity-chart__tick:last-child { justify-self: end; }
.admin-activity-chart__readout { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--rct-space-2); padding: var(--rct-space-3); border-radius: var(--rct-radius-lg); background: var(--rct-color-surface-float); font-size: var(--rct-font-size-dense); }
.admin-activity-chart__readout p { grid-column: 1 / -1; margin: 0; color: var(--rct-color-text-secondary); }
.admin-activity-chart__hint, .admin-activity-chart__empty { margin: 0; color: var(--rct-color-text-secondary); font-size: var(--rct-font-size-micro); }
.admin-activity-chart__alternative { position: absolute; inset-inline-start: 0; inset-block-start: 0; inline-size: var(--rct-border-hairline); block-size: var(--rct-border-hairline); padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
