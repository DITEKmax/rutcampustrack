@import '../../styles/tokens.pcss';
@import './statistics-tokens.pcss';

.statistics-screen,
.statistics-detail {
  display: flex;
  flex-direction: column;
  inline-size: min(100%, var(--rct-today-content-max));
  box-sizing: border-box;
  min-block-size: 100dvh;
  margin-inline: auto;
  padding: calc(env(safe-area-inset-top) + var(--rct-space-5)) var(--statistics-inset) calc(env(safe-area-inset-bottom) + var(--rct-today-bottom-space));
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-base);
  font-size: var(--statistics-font-body);
  line-height: 1.5;
}

.statistics-screen *,
.statistics-detail *,
.statistics-screen *::before,
.statistics-detail *::before,
.statistics-screen *::after,
.statistics-detail *::after {
  box-sizing: border-box;
}

.statistics-screen button,
.statistics-detail button {
  font: inherit;
}

.statistics-screen button,
.statistics-detail button {
  @mixin statistics-focus-ring;
}

.statistics-screen__header,
.statistics-detail__header {
  display: flex;
  align-items: center;
  min-block-size: var(--statistics-control);
  margin-block-end: var(--rct-space-3);
}

.statistics-screen__header h1,
.statistics-detail__header h1 {
  min-inline-size: 0;
  margin: 0;
  overflow-wrap: anywhere;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-title);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.2;
}

.statistics-rank {
  display: grid;
  gap: var(--rct-space-2);
  min-block-size: calc(var(--rct-control-min-touch) + var(--rct-space-5) * 2 + var(--rct-space-half));
  margin-block-end: var(--rct-space-3);
  border-radius: var(--statistics-radius-2xl);
  padding: var(--rct-space-4);
  background: var(--statistics-surface-raised);
}

.statistics-rank p,
.statistics-rank strong {
  margin: 0;
}

.statistics-rank p {
  color: var(--statistics-text-secondary);
  font-size: var(--statistics-font-dense);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.35;
}

.statistics-rank strong {
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-display);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.15;
}

.statistics-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--rct-space-3);
  margin-block-end: var(--rct-space-3);
}

.statistics-metric {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-block-size: var(--rct-attendance-metric-height);
  min-inline-size: 0;
  border-radius: var(--statistics-radius-xl);
  padding: var(--rct-space-2-half);
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-raised);
  font-size: var(--statistics-font-block);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.25;
}

.statistics-metric__symbol {
  display: grid;
  place-items: center;
  inline-size: var(--rct-attendance-summary-symbol);
  block-size: var(--rct-attendance-summary-symbol);
  flex: 0 0 auto;
  border-radius: var(--statistics-radius-full);
  color: var(--statistics-accent-on-now);
  font-size: var(--rct-today-present-font-size);
}

.statistics-metric--present .statistics-metric__symbol { background: var(--statistics-present-fill); }
.statistics-metric--absent .statistics-metric__symbol { background: var(--statistics-absent-fill); }
.statistics-metric--excused .statistics-metric__symbol { background: var(--statistics-excused-fill); }

.statistics-state {
  display: grid;
  justify-items: center;
  gap: var(--rct-space-3);
  min-block-size: var(--rct-state-min-height);
  border: var(--statistics-border-hairline) solid var(--statistics-border-default);
  border-radius: var(--statistics-radius-2xl);
  padding: var(--rct-space-5);
  color: var(--statistics-text-secondary);
  background: var(--statistics-surface-raised);
  text-align: center;
}

.statistics-state h2,
.statistics-state p {
  margin: 0;
}

.statistics-state h2 {
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-block);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.3;
}

.statistics-state__spinner {
  inline-size: var(--rct-space-5);
  block-size: var(--rct-space-5);
  border: var(--rct-progress-stroke) solid color-mix(in srgb, var(--statistics-text-primary) 30%, transparent);
  border-block-start-color: var(--statistics-text-primary);
  border-radius: var(--statistics-radius-full);
  animation: statistics-spin 0.8s linear infinite;
}

.statistics-chart {
  display: grid;
  gap: var(--rct-space-3);
  margin-block-end: var(--rct-space-5);
  border-radius: var(--statistics-radius-xl);
  padding: var(--rct-space-4);
  background: var(--statistics-surface-raised);
}

.statistics-chart__header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--rct-space-2) var(--rct-space-3);
}

.statistics-chart__header > h2 {
  flex: 1 1 var(--rct-state-min-height);
  min-inline-size: 0;
  margin: 0;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-block);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.3;
}

.statistics-chart__range {
  display: flex;
  flex: 0 1 auto;
  max-inline-size: 100%;
  gap: var(--rct-space-1);
  border-radius: var(--statistics-radius-lg);
  padding: var(--rct-space-1);
  background: var(--statistics-surface-float);
  justify-self: start;
}

.statistics-chart__range-button {
  flex: 0 1 auto;
  min-block-size: var(--statistics-control);
  border: 0;
  border-radius: var(--statistics-radius-lg);
  padding: var(--rct-space-2) var(--rct-space-2-half);
  color: var(--statistics-text-secondary);
  background: transparent;
  cursor: pointer;
  font-size: var(--statistics-font-dense);
  font-weight: var(--statistics-font-weight-medium);
}

.statistics-chart__range-button--selected {
  color: var(--statistics-accent-on-now) !important;
  background: var(--statistics-accent-now) !important;
}

.statistics-chart__plot { display: grid; grid-template-columns: calc(var(--rct-control-min-touch) - var(--rct-space-2)) minmax(0, 1fr); gap: var(--rct-space-2); }
.statistics-chart__axis { display: flex; flex-direction: column; justify-content: space-between; color: var(--statistics-text-secondary); font-size: var(--statistics-font-micro); line-height: 1; }
.statistics-chart__canvas { min-inline-size: 0; block-size: var(--rct-attendance-plot-height); border-radius: var(--statistics-radius-lg); overflow: hidden; background: var(--statistics-surface-float); cursor: crosshair; touch-action: pan-y; }
.statistics-chart__canvas:focus-visible { outline: var(--rct-focus-width) solid var(--rct-color-accent-now); outline-offset: var(--rct-focus-offset); }
.statistics-chart__canvas svg { display: block; inline-size: 100%; block-size: 100%; }
.statistics-chart__grid { fill: none; stroke: var(--statistics-border-default); stroke-width: 0.5; }
.statistics-chart__area--present { fill: color-mix(in srgb, var(--statistics-present-fill) 72%, transparent); }
.statistics-chart__area--excused { fill: color-mix(in srgb, var(--statistics-excused-fill) 72%, transparent); }
.statistics-chart__area--absent { fill: color-mix(in srgb, var(--statistics-absent-fill) 72%, transparent); }
.statistics-chart__neutral { fill: var(--statistics-none-fill); opacity: 0.16; }
.statistics-chart__neutral[data-state='FUTURE'] { opacity: 0.07; }
.statistics-chart__selection { fill: none; stroke: var(--statistics-text-primary); stroke-width: 1; stroke-dasharray: 3 3; }
.statistics-chart__ticks { position: relative; block-size: var(--rct-space-5); margin-inline-start: var(--rct-control-min-touch); column-gap: var(--rct-space-2); color: var(--statistics-text-secondary); font-size: var(--statistics-font-micro); }
.statistics-chart__tick { position: absolute; transform: translateX(-50%); white-space: nowrap; }
.statistics-chart__tick--first { transform: none; }
.statistics-chart__tick--last { transform: translateX(-100%); }
.statistics-chart__ticks--stacked { block-size: calc(var(--rct-space-5) * 2); }
.statistics-chart__ticks--stacked .statistics-chart__tick { max-inline-size: 100%; white-space: normal; overflow-wrap: anywhere; }
.statistics-chart__ticks--stacked .statistics-chart__tick--last { inset-block-end: 0; }
.statistics-chart__tick-measure { position: absolute; inset: 0 auto auto 0; inline-size: max-content; block-size: 0; overflow: hidden; visibility: hidden; pointer-events: none; }
.statistics-chart__tick-measure span { display: block; inline-size: max-content; white-space: nowrap; }
.statistics-chart__detail { display: grid; gap: var(--rct-space-1); min-inline-size: 0; }
.statistics-chart__detail h3, .statistics-chart__detail p { margin: 0; font-size: var(--statistics-font-caption); }
.statistics-chart__detail p { color: var(--statistics-text-secondary); }
.statistics-chart__percentages { display: flex; block-size: var(--rct-attendance-type-pill-height); border-radius: var(--statistics-radius-full); overflow: hidden; }
.statistics-chart__percentage { display: grid; place-items: center; flex: 0 0 auto; min-inline-size: 0; color: var(--rct-color-status-on-fill); font-size: var(--statistics-font-caption); font-weight: var(--statistics-font-weight-bold); }
.statistics-chart__percentage-label { white-space: nowrap; }
.statistics-chart__percentages--outside { block-size: var(--rct-space-2); }
.statistics-chart__percentages--outside .statistics-chart__percentage-label { visibility: hidden; }
.statistics-chart__percentage-labels span { display: flex; align-items: center; gap: var(--rct-space-1); }
.statistics-chart__percentage-labels span::before { content: ''; inline-size: var(--rct-space-2); block-size: var(--rct-space-2); border-radius: var(--rct-radius-xs); background: currentColor; }
.statistics-chart__percentage--present { background: var(--statistics-present-fill); }
.statistics-chart__percentage--excused { background: var(--statistics-excused-fill); }
.statistics-chart__percentage--absent { background: var(--statistics-absent-fill); }
.statistics-chart__percentage-labels { display: flex; justify-content: space-between; gap: var(--rct-space-2); font-size: var(--statistics-font-caption); }
.statistics-chart__value--present { color: var(--statistics-present-text); }
.statistics-chart__value--excused { color: var(--statistics-excused-text); }
.statistics-chart__value--absent { color: var(--statistics-absent-text); }
.statistics-chart__loading { display: grid; place-items: center; min-block-size: var(--rct-attendance-plot-height); margin: 0; border-radius: var(--statistics-radius-lg); background: var(--statistics-surface-float); color: var(--statistics-text-secondary); }
.statistics-chart__empty { margin: 0; color: var(--statistics-text-muted); }

.statistics-subjects {
  display: grid;
  gap: var(--rct-space-3);
}

.statistics-subjects h2,
.statistics-type-stack h2,
.statistics-type-filter h2 {
  margin: 0;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-block);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.3;
}

.statistics-subjects > ul {
  display: grid;
  gap: var(--rct-space-2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.statistics-subject-summary {
  display: grid;
  align-items: center;
  grid-template-columns: minmax(0, 1fr) auto;
  grid-template-rows: auto auto;
  inline-size: 100%;
  min-block-size: calc(var(--rct-control-min-touch) + var(--rct-space-5) * 2);
  gap: var(--rct-space-3);
  border: 0;
  border-radius: var(--statistics-radius-xl);
  padding: calc(var(--rct-space-3) + var(--rct-space-half)) var(--rct-space-4);
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-raised);
  cursor: pointer;
  text-align: start;
}

.statistics-subject-summary:disabled {
  cursor: default;
  opacity: 0.65;
}

.statistics-subject-summary__name {
  grid-column: 1;
  grid-row: 1;
  min-inline-size: 0;
  overflow-wrap: anywhere;
  font-size: var(--statistics-font-dense);
  font-weight: var(--statistics-font-weight-bold);
}

.statistics-subject-summary__metrics {
  display: flex;
  flex-wrap: wrap;
  grid-column: 1;
  grid-row: 2;
  align-items: center;
  min-inline-size: 0;
  gap: var(--rct-space-1) var(--rct-space-3);
  color: var(--statistics-text-secondary);
  font-size: var(--statistics-font-caption);
  font-weight: var(--statistics-font-weight-bold);
}

.statistics-subject-summary__metric {
  display: inline-flex;
  align-items: center;
  min-inline-size: 0;
  gap: var(--statistics-meta-gap);
}

.statistics-subject-summary__metric i {
  inline-size: var(--rct-space-2);
  block-size: var(--rct-space-2);
  flex: 0 0 auto;
  border-radius: var(--statistics-radius-full);
}

.statistics-subject-summary__metric--present i { background: var(--statistics-present-fill); }
.statistics-subject-summary__metric--excused i { background: var(--statistics-excused-fill); }
.statistics-subject-summary__metric--absent i { background: var(--statistics-absent-fill); }

.statistics-subject-summary__disclosure {
  display: grid;
  grid-column: 2;
  grid-row: 1 / span 2;
  flex: 0 0 var(--statistics-control);
  place-items: center;
  inline-size: var(--statistics-control);
  block-size: var(--statistics-control);
}

.statistics-subject-summary__disclosure .mobile-icon {
  inline-size: var(--statistics-disclosure);
  block-size: var(--statistics-disclosure);
  transform: rotate(-90deg);
}

.statistics-subjects__empty {
  margin: var(--rct-space-6) 0;
  color: var(--statistics-text-secondary);
  text-align: center;
}

.statistics-detail__header {
  gap: var(--rct-space-2-half);
}

.statistics-detail {
  padding-block-end: calc(env(safe-area-inset-bottom) + var(--rct-space-5));
}

.statistics-back-button {
  display: grid;
  flex: 0 0 var(--statistics-control);
  place-items: center;
  inline-size: var(--statistics-control);
  block-size: var(--statistics-control);
  border: 0;
  border-radius: var(--statistics-radius-full);
  padding: 0;
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-float);
  cursor: pointer;
}

.statistics-back-button .mobile-icon {
  inline-size: var(--rct-space-4);
  block-size: var(--rct-space-4);
}

.statistics-detail__header h1 {
  font-size: var(--rct-task-title-size);
}

.statistics-type-filter {
  display: grid;
  gap: var(--rct-space-2-half);
}

.statistics-type-filter__options {
  display: flex;
  gap: var(--rct-space-2);
  inline-size: 100%;
  flex-wrap: wrap;
  padding-block: var(--rct-space-half);
}

.statistics-type-filter__button {
  flex: 1 1 auto;
  min-block-size: var(--statistics-control);
  border: var(--statistics-border-hairline) solid var(--statistics-border-default);
  border-radius: var(--statistics-radius-full);
  padding: var(--rct-space-2) var(--rct-space-3);
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-float);
  cursor: pointer;
  font-size: var(--statistics-font-caption);
  font-weight: var(--statistics-font-weight-bold);
  white-space: nowrap;
}

.statistics-type-filter__button--selected {
  border-color: var(--statistics-accent-now);
  color: var(--statistics-accent-on-now);
  background: var(--statistics-accent-now);
}

.statistics-type-stack {
  display: grid;
  gap: var(--rct-attendance-type-card-gap);
  margin-block-start: var(--rct-space-3);
}

.statistics-type-card {
  position: relative;
  display: grid;
  gap: var(--rct-space-2-half);
  min-inline-size: 0;
  min-block-size: calc(var(--rct-attendance-metric-height) * 2 + var(--rct-space-6));
  align-content: space-between;
  border: 0;
  border-radius: var(--statistics-radius-xl);
  padding: var(--rct-space-4) var(--rct-space-3) var(--rct-space-3);
  background: var(--statistics-surface-raised);
}

.statistics-type-card__pill {
  position: absolute;
  inset-block-start: var(--rct-attendance-type-pill-offset);
  inset-inline-end: var(--rct-space-3);
  min-block-size: var(--rct-attendance-summary-symbol);
  border: var(--statistics-border-hairline) solid var(--statistics-border-default);
  border-radius: var(--statistics-radius-full);
  padding: var(--rct-space-1-half) var(--rct-space-4);
  color: var(--statistics-text-primary);
  background: var(--statistics-surface-raised);
  font-size: var(--statistics-font-micro);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.25;
}

.statistics-type-card h3 {
  margin: 0;
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-caption);
  font-weight: var(--statistics-font-weight-bold);
  line-height: 1.35;
}

.statistics-type-card__metrics {
  display: flex;
  justify-content: space-between;
  gap: var(--rct-space-2);
  color: var(--statistics-text-primary);
  font-size: var(--statistics-font-micro);
  font-weight: var(--statistics-font-weight-bold);
}

.statistics-type-card__metric {
  display: inline-flex;
  align-items: center;
  min-inline-size: 0;
  gap: var(--statistics-meta-gap);
}

.statistics-type-card__metric i {
  inline-size: var(--rct-space-2);
  block-size: var(--rct-space-2);
  flex: 0 0 auto;
  border-radius: var(--rct-space-1);
}

.statistics-type-card__metric--present i { background: var(--statistics-present-fill); }
.statistics-type-card__metric--excused i { background: var(--statistics-excused-fill); }
.statistics-type-card__metric--absent i { background: var(--statistics-absent-fill); }

.statistics-type-card__history {
  display: flex;
  inline-size: 100%;
  min-block-size: var(--statistics-history-height);
  gap: min(var(--rct-space-1), 1%);
}

.statistics-type-card__segment {
  display: block;
  min-inline-size: 0;
  min-block-size: var(--statistics-history-height);
  flex: 1 1 0;
  border-radius: var(--statistics-radius-full);
  background: var(--statistics-none-fill);
}

.statistics-type-card__segment--present { background: var(--statistics-present-fill); }
.statistics-type-card__segment--absent { background: var(--statistics-absent-fill); }
.statistics-type-card__segment--excused { background: var(--statistics-excused-fill); }
.statistics-type-card__segment--future { background: var(--statistics-none-fill); }
.statistics-type-card__segment--no-data { background: transparent; outline: var(--statistics-border-hairline) solid var(--statistics-none-fill); outline-offset: calc(-1 * var(--statistics-border-hairline)); }

.statistics-visually-hidden {
  position: absolute;
  inline-size: var(--statistics-border-hairline);
  block-size: var(--statistics-border-hairline);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

@keyframes statistics-spin {
  to { transform: rotate(1turn); }
}

@media (prefers-reduced-motion: reduce) {
  .statistics-state__spinner { animation: none; }
}

@media (max-width: 22rem) {
  .statistics-screen,
  .statistics-detail { padding-inline: var(--rct-space-3); }
  .statistics-metrics {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--rct-space-1-half);
  }
  .statistics-metric { padding-inline: var(--rct-space-2); gap: var(--rct-space-1); flex-wrap: wrap; font-size: var(--statistics-font-dense); }
  .statistics-metric__symbol { inline-size: var(--rct-space-6); block-size: var(--rct-space-6); }

}

@media (min-width: 26.625rem) {
  .statistics-screen,
  .statistics-detail { border-inline: var(--statistics-border-hairline) solid var(--statistics-border-default); }
}
