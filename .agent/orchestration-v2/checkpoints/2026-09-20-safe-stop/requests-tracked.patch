+function Get-GitBlobHashForBytes {
+    param(
+        [Parameter(Mandatory = $true)][byte[]]$Bytes,
+        [Parameter(Mandatory = $true)][string]$Context,
+        [string]$RelativePathForGit = ''
+    )
