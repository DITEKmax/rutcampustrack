{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "otp.verified",
  "description": "Auth reports consumed OTP. Existing login cleanup remains compatible; subject_delete cleanup is bound to the exact challenge.",
  "type": "object",
  "required": [
    "event_type",
    "event_id",
    "occurred_at",
    "payload",
    "event_version",
    "trace_id",
    "source"
  ],
  "properties": {
    "event_type": {
      "const": "otp.verified"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/eventId"
    },
    "occurred_at": {
      "$ref": "_common.json#/$defs/occurredAt"
    },
    "payload": {
      "type": "object",
      "required": ["telegram_id"],
      "properties": {
        "telegram_id": {
          "type": "integer"
        },
        "purpose": {
          "type": "string",
          "enum": ["login", "subject_delete"]
        },
        "challenge_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "subject_delete"
              }
            },
            "required": ["purpose"]
          },
          "then": {
            "required": ["challenge_id"]
          }
        }
      ]
    },
    "event_version": {
      "$ref": "_common.json#/$defs/eventVersion"
    },
    "trace_id": {
      "$ref": "_common.json#/$defs/traceId"
    },
    "source": {
      "type": "string",
      "description": "Имя сервиса-источника (academic-service / schedule-service / attendance-service / auth-service)."
    }
  }
}
