--- /dev/null
+++ b/frontends/mobile-core/src/features/map/map-controller.ts
@@ -0,0 +1,826 @@
+import type {
+  MapAssetDescriptor,
+  MapCatalog,
+  MapOpenFloorRequest,
+  MapOwnerScope,
+  MapOwnerState,
+  MapPlan,
+  MapReadPort,
+  MapInvalidationKind,
+  MapRevokeResult,
+  MapRevokeSignal,
+  MapSnapshot,
+  MapViewState,
+} from './map-contract'
+import { MapError, MapStaleCommitError, mapAssetKey } from './map-contract'
+import { MapOfflineStore, type MapLifecycleEvent } from './map-offline-store'
+import { assetRequestFor, validateAssetBlob, validateCatalog, validatePlan } from './map-validation'
+import { MapSynchronizer } from './map-sync'
+
+export interface MapObjectUrlApi {
+  createObjectURL(blob: Blob): string
+  revokeObjectURL(url: string): void
+}
+
+export interface MapControllerOptions {
+  readonly port: MapReadPort
+  readonly surface: 'pwa' | 'tma'
+  readonly online: boolean
+  readonly sessionActive: boolean
+  readonly scope: MapOwnerScope
+  readonly store?: MapOfflineStore
+  readonly synchronizer?: MapSynchronizer
+  readonly objectUrlApi?: MapObjectUrlApi
+  readonly intentIdFactory?: () => string
+}
+
+export type MapStateListener = (state: MapViewState) => void
+export type MapInvalidationListener = (signal: MapRevokeSignal) => void
+
+const initialState: MapViewState = {
+  phase: 'idle',
+  message: null,
+  catalog: null,
+  selectedBuildingId: null,
+  selectedFloorId: null,
+  plan: null,
+  assetUrl: null,
+  assetFormat: null,
+  assetAlt: null,
+  scale: 1,
+  announcement: '',
+  offline: false,
+  syncStatus: null,
+}
+
+interface MapRequest {
+  readonly token: number
+  readonly sessionToken: number
+  readonly controller: AbortController
+  readonly signal: AbortSignal
+  readonly scope: MapOwnerScope
+}
+
+export class MapController {
+  private readonly port: MapReadPort
+  private readonly surface: 'pwa' | 'tma'
+  private readonly store: MapOfflineStore | undefined
+  private readonly synchronizer: MapSynchronizer | undefined
+  private readonly objectUrlApi: MapObjectUrlApi | undefined
+  private readonly intentIdFactory: () => string
+  private readonly listeners = new Set<MapStateListener>()
+  private readonly invalidationListeners = new Set<MapInvalidationListener>()
+  private state: MapViewState = initialState
+  private online: boolean
+  private sessionActive: boolean
+  private scope: MapOwnerScope
+  private requestController: AbortController | null = null
+  private loadToken = 0
+  private sessionToken = 0
+  private currentUrl: string | null = null
+  private disposed = false
+  private syncInFlightToken: number | null = null
+  private pendingLifecycleEvent: MapLifecycleEvent | null = null
+  private unsubscribeLifecycle: (() => void) | null = null
+  private revokeInFlight: Promise<MapRevokeResult | null> | null = null
+  private revokeInFlightScope: MapOwnerScope | null = null
+  private liveOnlyScope: MapOwnerScope | null = null
+  private retainedLiveOnlyOfflineScope: MapOwnerScope | null = null
+
+  constructor(options: MapControllerOptions) {
+    this.port = options.port
+    this.surface = options.surface
+    this.online = options.online
+    this.sessionActive = options.sessionActive
+    this.scope = options.scope
+    this.store = options.store
+    this.synchronizer = options.synchronizer
+    this.synchronizer?.setScope(this.scope, this.sessionActive)
+    this.objectUrlApi = options.objectUrlApi ?? defaultObjectUrlApi()
+    this.intentIdFactory = options.intentIdFactory ?? defaultIntentId
+    if (this.surface === 'pwa' && this.store) {
+      this.unsubscribeLifecycle = this.store.subscribeLifecycle(this.scope, (event) => this.handleLifecycleEvent(event))
+    }
+  }
+
+  getSnapshot(): MapViewState {
+    return this.state
+  }
+
+  subscribe(listener: MapStateListener): () => void {
+    this.listeners.add(listener)
+    listener(this.state)
+    return () => this.listeners.delete(listener)
+  }
+
+  subscribeInvalidation(listener: MapInvalidationListener): () => void {
+    this.invalidationListeners.add(listener)
+    return () => this.invalidationListeners.delete(listener)
+  }
+
+  async open(): Promise<MapRevokeResult | null> {
+    return this.reload(true)
+  }
+
+  async retry(): Promise<MapRevokeResult | null> {
+    if (this.hasRetainedLiveOnlyOfflineView()) return null
+    return this.reload(false)
+  }
+
+  async selectBuilding(buildingId: string): Promise<MapRevokeResult | null> {
+    if (this.hasRetainedLiveOnlyOfflineView()) return null
+    const request = this.startRequest()
+    try {
+      await this.requireDurableAuthority(request, true)
+    } catch (error) {
+      return this.isCurrent(request) ? this.handleLoadError(error) : null
+    }
+    const building = this.state.catalog?.buildings.find((item) => item.id === buildingId)
+    if (!building) {
+      try {
+        await this.requireDurableAuthority(request, true)
+      } catch (error) {
+        return this.isCurrent(request) ? this.handleLoadError(error) : null
+      }
+      return null
+    }
+    const floorId = building.floors.some((floor) => floor.id === this.state.selectedFloorId) ? this.state.selectedFloorId : building.floors[0]?.id ?? null
+    if (this.state.selectedBuildingId === buildingId && this.state.selectedFloorId === floorId) {
+      try {
+        await this.requireDurableAuthority(request, true)
+      } catch (error) {
+        return this.isCurrent(request) ? this.handleLoadError(error) : null
+      }
+      return null
+    }
+    if (!this.updateSelection(request, buildingId, floorId)) return null
+    try {
+      const snapshot = await this.offlineSnapshot(request)
+      if (!this.isCurrent(request)) return null
+      return await this.loadSelectedFloor(true, request, snapshot)
+    } catch (error) {
+      if (this.isCurrent(request)) return await this.handleLoadError(error)
+      return null
+    }
+  }
+
+  async selectFloor(floorId: string): Promise<MapRevokeResult | null> {
+    if (this.hasRetainedLiveOnlyOfflineView()) return null
+    const request = this.startRequest()
+    try {
+      await this.requireDurableAuthority(request, true)
+    } catch (error) {
+      return this.isCurrent(request) ? this.handleLoadError(error) : null
+    }
+    const building = this.selectedBuilding()
+    if (!building || !building.floors.some((floor) => floor.id === floorId)) {
+      try {
+        await this.requireDurableAuthority(request, true)
+      } catch (error) {
+        return this.isCurrent(request) ? this.handleLoadError(error) : null
+      }
+      return null
+    }
+    if (this.state.selectedBuildingId === building.id && this.state.selectedFloorId === floorId) {
+      try {
+        await this.requireDurableAuthority(request, true)
+      } catch (error) {
+        return this.isCurrent(request) ? this.handleLoadError(error) : null
+      }
+      return null
+    }
+    if (!this.updateSelection(request, building.id, floorId)) return null
+    try {
+      const snapshot = await this.offlineSnapshot(request)
+      if (!this.isCurrent(request)) return null
+      return await this.loadSelectedFloor(true, request, snapshot)
+    } catch (error) {
+      if (this.isCurrent(request)) return await this.handleLoadError(error)
+      return null
+    }
+  }
+
+  setOnline(online: boolean): void {
+    if (this.disposed || online === this.online) return
+    const wasCurrentLiveOnlyRetained = !online && this.online && this.surface === 'pwa' && this.sessionActive && this.liveOnlyScope !== null && sameScope(this.liveOnlyScope, this.scope) && this.hasRetainedView()
+    this.online = online
+    this.liveOnlyScope = null
+    this.retainedLiveOnlyOfflineScope = null
+    this.abortRequest()
+    if (!online && this.surface === 'tma') {
+      this.clearAssetUrl()
+      this.patchState({ phase: 'unavailable', offline: true, catalog: null, selectedBuildingId: null, selectedFloorId: null, plan: null, assetUrl: null, assetFormat: null, assetAlt: null, scale: 1, syncStatus: null, message: 'Карта доступна только онлайн в этой оболочке.', announcement: '' })
+      return
+    }
+    if (wasCurrentLiveOnlyRetained) {
+      this.retainedLiveOnlyOfflineScope = this.scope
+      this.patchState({ phase: 'ready', offline: true, syncStatus: 'storage-unavailable', message: 'Текущая карта доступна из памяти; подключись к сети, чтобы обновить её.' })
+      return
+    }
+    this.patchState(this.hasRetainedView() ? { offline: !online, syncStatus: null } : { offline: !online, assetUrl: null, assetFormat: null, plan: null, syncStatus: null })
+    void this.reload(false)
+  }
+
+  setSession(active: boolean, scope: MapOwnerScope, options: { readonly revokeCache?: boolean } = {}): Promise<MapRevokeResult | null> {
+    if (this.disposed) return Promise.resolve(null)
+    const previousScope = this.scope
+    this.liveOnlyScope = null
+    this.retainedLiveOnlyOfflineScope = null
+    const ownerChanged = scope.ownerKey !== previousScope.ownerKey
+    const changed = active !== this.sessionActive || scope.ownerKey !== this.scope.ownerKey || scope.generation !== this.scope.generation
+    const shouldRevoke = this.surface === 'pwa' && this.store && (!active || ownerChanged || options.revokeCache === true)
+    if (changed || shouldRevoke) this.sessionToken += 1
+    const revocation = shouldRevoke ? this.revokeScope(previousScope).then((result) => {
+      this.emitInvalidation(previousScope, 'session-inactive', result)
+      return result
+    }) : Promise.resolve(null)
+    this.sessionActive = active
+    this.scope = scope
+    this.synchronizer?.setScope(scope, active)
+    this.pendingLifecycleEvent = null
+    if (!changed) {
+      if (shouldRevoke) {
+        this.sessionActive = false
+        this.synchronizer?.setScope(this.scope, false)
+        this.abortRequest()
+        this.clearAssetUrl()
+        this.patchState({ catalog: null, plan: null, assetUrl: null, assetFormat: null, assetAlt: null, selectedBuildingId: null, selectedFloorId: null, syncStatus: null, phase: 'session-inactive', message: 'Сессия недоступна. Войди снова, чтобы открыть карту.', announcement: '', offline: !this.online })
+      }
+      return revocation
+    }
+    this.abortRequest()
+    this.clearAssetUrl()
+    this.patchState({ catalog: null, plan: null, assetUrl: null, assetFormat: null, assetAlt: null, selectedBuildingId: null, selectedFloorId: null, syncStatus: null, phase: active ? 'idle' : 'session-inactive', message: active ? null : 'Сессия недоступна. Войди снова, чтобы открыть карту.', announcement: '', offline: !this.online })
+    if (this.surface === 'pwa' && this.store) {
+      this.unsubscribeLifecycle?.()
+      this.unsubscribeLifecycle = this.store.subscribeLifecycle(this.scope, (event) => this.handleLifecycleEvent(event))
+    }
+    if (active) void this.reload(true)
+    return revocation
+  }
+
+  dispose(): void {
+    if (this.disposed) return
+    this.disposed = true
+    this.liveOnlyScope = null
+    this.retainedLiveOnlyOfflineScope = null
+    this.abortRequest()
+    this.clearAssetUrl()
+    this.unsubscribeLifecycle?.()
+    this.listeners.clear()
+  }
+
+  private async reload(explicitOpen: boolean): Promise<MapRevokeResult | null> {
+    if (this.disposed) return null
+    const request = this.startRequest()
+    const retained = this.hasRetainedView()
+    this.patchRequestState(request, { phase: retained ? 'ready' : 'loading', message: retained ? this.state.message : null, offline: !this.online, ...(retained ? {} : { assetUrl: null, assetFormat: null, plan: null }) })
+    if (!this.sessionActive) {
+      this.patchState({ phase: 'session-inactive', message: 'Сессия недоступна. Войди снова, чтобы открыть карту.', assetAlt: null, announcement: '' })
+      return null
+    }
+    try {
+      if (!this.online) {
+        if (this.surface !== 'pwa' || !this.store) {
+          this.patchRequestState(request, { phase: 'unavailable', message: 'Карта доступна только онлайн в этой оболочке.' })
+          return null
+        }
+        await this.requireDurableAuthority(request)
+        this.assertCurrent(request)
+        let snapshot
+        try {
+          this.assertCurrent(request)
+          snapshot = await this.store.readSnapshot(request.scope)
+          this.assertCurrent(request)
+        } catch (error) {
+          if (error instanceof MapError && error.kind === 'storage') {
+            const authority = await this.requireDurableAuthority(request)
+            if (authority) throw new MapError('storage', error.message, { authorityUnchanged: true, cause: error })
+          }
+          throw error
+        }
+        if (!this.isCurrent(request)) return null
+        await this.requireDurableAuthority(request)
+        if (!snapshot) {
+          this.patchRequestState(request, { phase: 'offline-no-cache', message: 'Сохранённой карты ещё нет. Подключись к сети, чтобы загрузить карты.' })
+          return null
+        }
+        return await this.showSnapshot(snapshot, request, false, explicitOpen)
+      }
+
+      if (this.surface === 'pwa' && this.synchronizer && !this.isLiveOnly(request)) {
+        this.syncInFlightToken = request.token
+        let adoptedPendingEvent = false
+        let sync
+        try {
+          this.assertCurrent(request)
+          sync = await this.synchronizer.synchronize(request.scope, request.signal)
+        } finally {
+          if (this.syncInFlightToken === request.token) this.syncInFlightToken = null
+        }
+        if (!this.isCurrent(request)) return null
+        const pending = this.takePendingLifecycleEvent()
+        if (pending?.kind === 'updated') {
+          const latest = await this.readCurrentSnapshot(request)
+          if (latest) {
+            sync = { ...sync, snapshot: latest }
+            adoptedPendingEvent = true
+          }
+        }
+        if (!this.isCurrent(request)) return null
+        this.patchRequestState(request, { syncStatus: sync.status })
+        if (sync.error?.kind === 'unauthorized' || sync.error?.kind === 'forbidden') {
+          return await this.revokeCache(sync.error.kind)
+        }
+        if (sync.error && isDurableAuthorityLoss(sync.error)) {
+          this.denyDurableAuthority(sync.error)
+          return null
+        }
+        if (sync.status === 'stale' && !sync.snapshot) return null
+        if (sync.status === 'storage-unavailable') this.enterLiveOnly(request)
+        if (sync.status !== 'storage-unavailable' && sync.error?.kind === 'storage' && this.hasRetainedView() && isRecoverableStorageError(sync.error)) return await this.handleLoadError(sync.error)
+        if (sync.snapshot && !this.isLiveOnly(request)) {
+          return await this.showSnapshot(sync.snapshot, request, !adoptedPendingEvent && (sync.status === 'update-failed' || sync.status === 'storage-unavailable'), explicitOpen)
+        }
+      } else if (this.isLiveOnly(request)) {
+        this.patchRequestState(request, { syncStatus: 'storage-unavailable' })
+      }
+      await this.requireDurableAuthority(request, true)
+      this.assertCurrent(request)
+      const rawCatalog = await this.port.readCatalog(request.signal)
+      this.assertCurrent(request)
+      const catalog = validateCatalog(rawCatalog)
+      this.assertCurrent(request)
+      if (!this.patchCatalog(catalog, request)) return null
+      return await this.loadSelectedFloor(explicitOpen, request)
+    } catch (error) {
+      if (!this.isCurrent(request)) return null
+      return await this.handleLoadError(error)
+    }
+  }
+
+  private async showSnapshot(snapshot: MapSnapshot, request: MapRequest, updateFailed: boolean, explicitOpen: boolean): Promise<MapRevokeResult | null> {
+    await this.requireDurableAuthority(request)
+    if (!this.isCurrent(request) || !this.patchCatalog(snapshot.manifest, request)) return null
+    return this.loadSelectedFloor(explicitOpen, request, snapshot, updateFailed)
+  }
+
+  private async loadSelectedFloor(explicitOpen: boolean, request: MapRequest, snapshot?: MapSnapshot, updateFailed = false): Promise<MapRevokeResult | null> {
+    if (this.isLiveOnly(request)) snapshot = undefined
+    await this.requireDurableAuthority(request, true)
+    if (!this.isCurrent(request)) return null
+    const building = this.selectedBuilding()
+    if (!building) {
+      this.clearAssetUrl(request)
+      this.patchRequestState(request, { phase: 'empty-catalog', message: 'Корпусов для показа карты пока нет.', catalog: this.state.catalog, plan: null, assetUrl: null, assetFormat: null, assetAlt: null })
+      return null
+    }
+    const floor = building.floors.find((item) => item.id === this.state.selectedFloorId) ?? building.floors[0]
+    if (!floor) {
+      this.clearAssetUrl(request)
