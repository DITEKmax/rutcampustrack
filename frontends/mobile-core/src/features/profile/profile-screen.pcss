@import '../../styles/tokens.pcss';

.profile-screen {
  --profile-color-surface-base: var(--rct-color-surface-base);
  --profile-color-surface-raised: var(--rct-color-surface-raised);
  --profile-color-surface-float: var(--rct-color-surface-float);
  --profile-color-text-primary: var(--rct-color-text-primary);
  --profile-color-text-secondary: var(--rct-color-text-secondary);
  --profile-color-text-muted: var(--rct-color-text-muted);
  --profile-color-border-default: var(--rct-color-border-default);
  --profile-color-accent-now: var(--rct-color-accent-now);
  --profile-color-accent-on-now: var(--rct-color-accent-on-now);
  --profile-color-success-bg: var(--rct-color-success-surface);
  --profile-color-success-text: var(--rct-color-success-text);
  --profile-color-warning-bg: var(--rct-warning-surface);
  --profile-color-warning-text: var(--rct-color-warning-text);
  --profile-color-danger-fill: var(--rct-color-danger-fill, var(--rct-color-danger-text));
  --profile-color-danger-text: var(--rct-color-danger-text);
  max-inline-size: var(--rct-today-content-max);
  margin-inline: auto;
  overflow-x: clip;
  padding: calc(env(safe-area-inset-top) + var(--rct-space-5)) var(--rct-space-4) calc(env(safe-area-inset-bottom) + var(--rct-space-5));
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-base);
  font-family: var(--rct-font-family-sans);
  @mixin rct-type-body;
}



.mobile-shell[data-surface='root'][data-dock-visible='true'] .profile-screen {
  padding-block-end: calc(env(safe-area-inset-bottom) + var(--rct-today-bottom-space));
}

.profile-screen__content {
  display: flex;
  flex-direction: column;
  gap: var(--rct-space-3);
  inline-size: 100%;
  min-inline-size: 0;
  min-block-size: 0;
}

.profile-screen__title {
  margin: 0;
  color: var(--profile-color-text-primary);
  font-size: var(--rct-font-size-title-screen);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.25;
}

.profile-screen__title--compact {
  font-size: var(--rct-task-title-size);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: var(--rct-space-2-half);
  min-block-size: var(--rct-control-min-touch);
}

.profile-header__title {
  flex: 1 1 auto;
  min-inline-size: 0;
  margin: 0;
  color: var(--profile-color-text-primary);
  font-size: var(--rct-task-title-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.45;
}

.profile-back,
.profile-row,
.profile-more-row,
.profile-session-card,
.profile-history-card,
.profile-danger-button,
.profile-primary-button,
.profile-secondary-button,
.profile-show-more,
.profile-role-card {
  @mixin rct-focus-ring;
}

.profile-back {
  display: grid;
  flex: 0 0 var(--rct-control-min-touch);
  place-items: center;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-2xl);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-float);
  cursor: pointer;
}

.profile-back img {
  inline-size: var(--rct-space-4);
  block-size: var(--rct-space-4);
}

.profile-icon {
  flex: 0 0 var(--rct-profile-icon-size, var(--rct-space-6));
  inline-size: var(--rct-profile-icon-size, var(--rct-space-6));
  block-size: var(--rct-profile-icon-size, var(--rct-space-6));
  object-fit: contain;
}

.profile-more-row,
.profile-row {
  display: flex;
  align-items: center;
  gap: var(--rct-space-3);
  inline-size: 100%;
  min-block-size: var(--rct-profile-row-height, calc(var(--rct-control-min-touch) + var(--rct-space-3)));
  border: 0;
  border-radius: var(--rct-profile-row-radius, var(--rct-radius-xl));
  padding: var(--rct-space-4);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-raised);
  font: inherit;
  font-size: var(--rct-today-action-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.45;
  text-align: start;
  cursor: pointer;
}

.profile-more-row {
  min-block-size: var(--rct-profile-more-row-height, calc(var(--rct-control-min-touch) + var(--rct-space-5) + var(--rct-space-4)));
  border-radius: var(--rct-radius-2xl);
  font-size: var(--rct-font-size-body);
}

.profile-more-row:hover,
.profile-row:hover,
.profile-role-card:hover {
  background: color-mix(in srgb, var(--profile-color-surface-raised) 88%, var(--profile-color-accent-now));
}

.profile-more-row:disabled,
.profile-row:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
  opacity: 0.72;
}

.profile-more-row:active,
.profile-row:active,
.profile-role-card:active {
  transform: translateY(var(--rct-border-hairline));
}

.profile-card {
  display: flex;
  align-items: center;
  gap: var(--rct-profile-card-gap, var(--rct-space-3));
  inline-size: 100%;
  min-block-size: var(--rct-profile-card-height, var(--rct-form-textarea-height));
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  background: var(--profile-color-surface-raised);
}

.profile-avatar {
  display: grid;
  flex: 0 0 var(--rct-profile-avatar-size, calc(var(--rct-role-avatar-size) + var(--rct-space-2)));
  place-items: center;
  inline-size: var(--rct-profile-avatar-size, calc(var(--rct-role-avatar-size) + var(--rct-space-2)));
  block-size: var(--rct-profile-avatar-size, calc(var(--rct-role-avatar-size) + var(--rct-space-2)));
  border-radius: var(--rct-radius-full);
  color: var(--profile-color-accent-on-now);
  background: var(--profile-color-accent-now);
  font-size: var(--rct-font-size-title);
  font-weight: var(--rct-font-weight-bold);
}

.profile-card__copy {
  display: grid;
  min-inline-size: 0;
  gap: var(--rct-space-1);
}

.profile-card__name,
.profile-card__meta {
  overflow-wrap: anywhere;
  margin: 0;
}

.profile-card__name {
  font-size: var(--rct-homework-date-heading-size);
  font-weight: var(--rct-font-weight-bold);
}

.profile-card__meta {
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.profile-role-list {
  display: grid;
  gap: var(--rct-space-3);
}

.profile-role-card {
  display: flex;
  align-items: center;
  gap: var(--rct-space-3);
  inline-size: 100%;
  min-block-size: var(--rct-profile-more-row-height, calc(var(--rct-control-min-touch) + var(--rct-space-5) + var(--rct-space-4)));
  border: 0;
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-raised);
  font: inherit;
  text-align: start;
  cursor: pointer;
}

.profile-role-card[data-selected='true'] {
  color: var(--profile-color-accent-on-now);
  background: var(--profile-color-accent-now);
}

.profile-role-card[data-disabled='true'] {
  color: var(--profile-color-text-secondary);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}

.profile-role-card__avatar {
  display: grid;
  flex: 0 0 var(--rct-role-avatar-size);
  place-items: center;
  inline-size: var(--rct-role-avatar-size);
  block-size: var(--rct-role-avatar-size);
  border-radius: var(--rct-radius-full);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-float);
  font-size: var(--rct-font-size-body);
  font-weight: var(--rct-font-weight-bold);
}

.profile-role-card[data-selected='true'] .profile-role-card__avatar {
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-base);
}

.profile-role-card__copy {
  display: grid;
  min-inline-size: 0;
  gap: var(--rct-space-half);
}

.profile-role-card__title,
.profile-role-card__meta {
  overflow-wrap: anywhere;
  margin: 0;
}

.profile-role-card__title {
  font-size: var(--rct-font-size-body);
  font-weight: var(--rct-font-weight-bold);
}

.profile-role-card__meta {
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
}

.profile-role-card[data-selected='true'] .profile-role-card__meta {
  color: color-mix(in srgb, var(--profile-color-accent-on-now) 72%, transparent);
}

.profile-role-card[data-disabled='true'] .profile-role-card__meta {
  color: var(--profile-color-text-secondary);
}

.profile-role-card__status {
  margin-inline-start: auto;
  color: inherit;
  font-size: var(--rct-font-size-micro);
  text-align: end;
}

.profile-theme-group {
  display: grid;
  gap: var(--rct-space-2);
  border: 0;
  margin: 0;
  padding: 0;
}

.profile-theme-group legend {
  margin-block-end: var(--rct-space-1);
  color: var(--profile-color-text-primary);
  font-size: var(--rct-font-size-dense);
  font-weight: var(--rct-font-weight-medium);
  line-height: 1.45;
}

.profile-theme-option {
  display: flex;
  align-items: center;
  gap: var(--rct-space-2);
  min-block-size: var(--rct-control-min-touch);
  color: var(--profile-color-text-primary);
  font-size: var(--rct-font-size-dense);
  cursor: pointer;
}

.profile-theme-option input {
  flex: 0 0 var(--rct-space-4);
  inline-size: var(--rct-space-4);
  block-size: var(--rct-space-4);
  accent-color: var(--profile-color-accent-now);
}

.profile-note,
.profile-security-note {
  display: grid;
  gap: var(--rct-space-1-half);
  inline-size: 100%;
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
}

.profile-note {
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-raised);
}

.profile-security-note {
  color: var(--profile-color-warning-text);
  background: var(--profile-color-warning-bg);
}

.profile-note__title,
.profile-note__body,
.profile-security-note__title,
.profile-security-note__body {
  overflow-wrap: anywhere;
  margin: 0;
}

.profile-note__title,
.profile-security-note__title {
  font-size: var(--rct-today-action-size);
  font-weight: var(--rct-font-weight-bold);
}

.profile-note__body,
.profile-security-note__body {
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  line-height: 1.55;
}

.profile-security-note__body {
  color: inherit;
}

.profile-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  min-inline-size: 0;
  gap: var(--rct-space-4);
}

.profile-field {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  min-inline-size: 0;
  gap: var(--rct-space-1);
}

.profile-field label {
  min-inline-size: 0;
  overflow-wrap: anywhere;
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  line-height: 1.4;
}

.profile-field__control {
  display: flex;
  min-inline-size: 0;
  align-items: center;
  gap: var(--rct-space-2);
  min-block-size: var(--rct-control-min-touch);
  border: var(--rct-border-hairline) solid var(--profile-color-border-default);
  border-radius: var(--rct-radius-full);
  padding-inline: var(--rct-font-size-title) var(--rct-space-2);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-raised);
}

.profile-field__control:focus-within {
  border-color: var(--profile-color-accent-now);
  outline: var(--rct-focus-width) solid var(--profile-color-accent-now);
  outline-offset: var(--rct-focus-offset);
}

.profile-field__control input {
  inline-size: 0;
  min-inline-size: 0;
  flex: 1 1 0;
  border: 0;
  outline: 0;
  padding: 0;
  color: inherit;
  background: transparent;
  font: inherit;
  font-size: var(--rct-font-size-body);
}

.profile-field__toggle {
  display: grid;
  flex: 0 0 var(--rct-control-min-touch);
  place-items: center;
  inline-size: var(--rct-control-min-touch);
  block-size: var(--rct-control-min-touch);
  border: 0;
  border-radius: var(--rct-radius-full);
  padding: 0;
  background: transparent;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.profile-field__toggle img {
  inline-size: var(--rct-profile-control-icon-size, var(--rct-space-5));
  block-size: var(--rct-profile-control-icon-size, var(--rct-space-5));
}



.profile-password-policy {
  display: flex;
  min-inline-size: 0;
  align-items: flex-start;
  gap: var(--rct-space-2);
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  line-height: 1.4;
}


.profile-password-policy[data-valid='true'] {
  color: var(--profile-color-success-text);
}


.profile-password-policy[data-invalid='true'] {
  color: var(--profile-color-danger-text);
}


.profile-password-policy > span:last-child {
  min-inline-size: 0;
  overflow-wrap: anywhere;
}

.profile-recovery-link {
  justify-self: start;
  max-inline-size: 100%;
  overflow-wrap: anywhere;
  min-block-size: var(--rct-control-min-touch);
  border: 0;
  border-block-end: var(--rct-border-hairline) solid currentColor;
  padding: 0 var(--rct-space-1);
  color: var(--profile-color-text-primary);
  background: transparent;
  font: inherit;
  font-size: var(--rct-font-size-body);
  text-align: start;
  cursor: pointer;
  @mixin rct-focus-ring;
}

.profile-form__actions {
  display: flex;
  min-inline-size: 0;
  justify-content: flex-end;
}

.profile-primary-button,
.profile-secondary-button,
.profile-danger-button,
.profile-show-more {
  min-block-size: var(--rct-control-min-touch);
  border-radius: var(--rct-radius-full);
  padding-inline: var(--rct-space-4);
  font: inherit;
  font-size: var(--rct-font-size-dense);
  font-weight: var(--rct-font-weight-medium);
  cursor: pointer;
}

.profile-primary-button {
  max-inline-size: 100%;
  overflow-wrap: anywhere;
  border: 0;
  color: var(--profile-color-accent-on-now);
  background: var(--profile-color-accent-now);
}

.profile-secondary-button,
.profile-show-more {
  border: var(--rct-border-hairline) solid var(--profile-color-border-default);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-float);
}

.profile-danger-button {
  inline-size: 100%;
  border: 0;
  color: var(--rct-color-text-on-fill-strong);
  background: var(--profile-color-danger-fill);
}

.profile-primary-button:disabled,
.profile-secondary-button:disabled,
.profile-danger-button:disabled,
.profile-show-more:disabled {
  color: var(--rct-color-disabled-text);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}

.profile-session-list,
.profile-history-list {
  display: grid;
  gap: var(--rct-space-3);
  margin: 0;
  padding: 0;
  list-style: none;
}

.profile-session-card,
.profile-history-card {
  display: grid;
  gap: var(--rct-space-2);
  inline-size: 100%;
  border: 0;
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  color: var(--profile-color-text-primary);
  background: var(--profile-color-surface-raised);
  text-align: start;
}

.profile-session-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--rct-space-3);
}

.profile-session-card__title,
.profile-session-card__meta,
.profile-history-card__title,
.profile-history-card__description,
.profile-history-card__time {
  overflow-wrap: anywhere;
  margin: 0;
}

.profile-session-card__title,
.profile-history-card__title {
  font-size: var(--rct-today-action-size);
  font-weight: var(--rct-font-weight-bold);
}

.profile-session-card__meta,
.profile-history-card__description,
.profile-history-card__time {
  color: var(--profile-color-text-secondary);
  font-size: var(--rct-font-size-caption);
  line-height: 1.55;
}

.profile-history-card__time {
  font-size: var(--rct-font-size-micro);
}

.profile-session-card__current {
  flex: 0 0 auto;
  border-radius: var(--rct-radius-full);
  padding: var(--rct-space-2) var(--rct-font-size-dense);
  color: var(--profile-color-success-text);
  background: var(--profile-color-success-bg);
  font-size: var(--rct-today-room-old-size);
  font-weight: var(--rct-font-weight-bold);
  line-height: 1.2;
}

.profile-state {
  display: grid;
  gap: var(--rct-space-2);
  border: 0;
  border-radius: var(--rct-radius-2xl);
  padding: var(--rct-space-4);
  color: var(--profile-color-text-secondary);
  background: var(--profile-color-surface-raised);
  text-align: start;
}

.profile-state[data-error='true'] {
  color: var(--profile-color-danger-text);
  background: var(--rct-error-surface);
}

.profile-state h2,
.profile-state p {
  margin: 0;
}

.profile-inline-error {
  color: var(--profile-color-danger-text);
  font-size: var(--rct-font-size-caption);
}

@media (prefers-reduced-motion: reduce) {
  .profile-more-row,
  .profile-row,
  .profile-role-card {
    transition: none;
  }
}



.profile-row span, .profile-more-row span { min-inline-size: 0; overflow-wrap: anywhere; }
.profile-session-card__top { flex-wrap: wrap; }
.profile-session-card__title { flex: 1 1 auto; min-inline-size: 0; }
.profile-theme-group { gap: var(--rct-space-2); }
.profile-theme-option { min-block-size: calc(var(--rct-control-min-touch) + var(--rct-space-2)); }
.profile-password-policy { margin: 0; }
.profile-history-card { gap: var(--rct-space-1-half); }
.profile-history-card__time { margin-block-start: var(--rct-space-3); }

.profile-notification-icon {
  position: relative;
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  inline-size: var(--rct-profile-icon-size);
  block-size: var(--rct-profile-icon-size);
}

.profile-notification-badge {
  position: absolute;
  inset-block-start: calc(0rem - var(--rct-space-2));
  inset-inline-end: calc(0rem - var(--rct-space-3));
  pointer-events: none;
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  min-inline-size: var(--rct-space-4);
  min-block-size: var(--rct-space-4);
  border-radius: var(--rct-radius-full);
  padding-inline: var(--rct-space-1);
  color: var(--rct-color-text-on-fill-strong);
  background: var(--rct-color-danger-fill);
  @mixin rct-type-micro;
}
.profile-session-terminate {
  justify-self: start;
  min-inline-size: 0;
  max-inline-size: 100%;
  min-block-size: var(--rct-control-min-touch);
  margin-block-start: var(--rct-space-2);
  border: 0;
  border-radius: var(--rct-radius-full);
  padding: var(--rct-space-2) var(--rct-space-4);
  color: var(--rct-color-text-on-fill-strong);
  background: var(--rct-color-danger-fill);
  font: inherit;
  overflow-wrap: anywhere;
  cursor: pointer;
  @mixin rct-type-dense;
  @mixin rct-focus-ring;
}
.profile-session-terminate:disabled {
  color: var(--rct-color-text-secondary);
  background: var(--rct-color-disabled-surface);
  cursor: not-allowed;
}
