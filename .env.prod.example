# =============================================================================
# Production environment template (M13 G13)
#
# Usage:
#   1. cp .env.prod.example .env.prod
#   2. Заполнить все CHANGE_ME (см. команды генерации в комментариях ниже)
#   3. ./scripts/validate-env-prod.sh — проверка формата
#   4. docker compose -f docker-compose.prod.yml up -d
#
# .env.prod gitignored, секреты НИКОГДА не коммитятся. Если случайно
# committed — rotate ВСЕ значения (bot tokens, passwords, GHCR_TOKEN).
# Rotation runbook: docs/runbooks/secret-rotation.md
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag (CI/CD)
# -----------------------------------------------------------------------------
# Default :latest, override на :v0.0.0 после tag для immutable deploys.
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_ACADEMIC_PASSWORD=CHANGE_ME
POSTGRES_SCHEDULE_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# MongoDB (M13 G7 — Bitnami replica set rs0)
# -----------------------------------------------------------------------------
MONGO_USER=rct_user
MONGO_PASSWORD=CHANGE_ME              # openssl rand -base64 24
MONGO_ROOT_PASSWORD=CHANGE_ME         # openssl rand -base64 32

# M10 G1 D2 — отдельный credential для notification_db (PoLP).
# Rotation: docs/runbooks/secret-rotation.md
MONGO_NOTIFICATION_USER=rct_notification_user
MONGO_NOTIFICATION_PASSWORD=CHANGE_ME

# M13 G7 — Bitnami replica set keyfile. ОБЯЗАТЕЛЕН для transactions.
# Generate: openssl rand -base64 756 | tr -d '\n'
# Length: ровно 1024 base64 chars (756 raw bytes per Mongo keyfile spec).
# Rotation: требует restart всех RS nodes (у нас один → restart контейнера).
#
# КРИТИЧНО: ОБЯЗАТЕЛЬНО wrap в double quotes — base64 содержит `+` и `/`,
# docker-compose env-parser interpret'ит unquoted `+` как multi-line
# variable name → ошибка «unexpected character "+"».
MONGODB_REPLICA_SET_KEY="CHANGE_ME"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_USER=rct_user
RABBITMQ_PASSWORD=CHANGE_ME           # openssl rand -base64 24

# -----------------------------------------------------------------------------
# Telegram (M05 v5.0 — Notification Bot + TMA)
# -----------------------------------------------------------------------------
# @BotFather → /newbot. Format: digits:chars (e.g. "8744653460:AAF...")
BOT_TOKEN=CHANGE_ME

# Same value as BOT_TOKEN — TMA initData verification использует один shared bot.
TMA_BOT_TOKEN=CHANGE_ME

# Отдельный bot для Alertmanager → Telegram (M04 G9). Не использует TMA.
# @BotFather → /newbot, добавить в admin chat'ы.
BOT_ALERT_TOKEN=CHANGE_ME

# Comma-separated Telegram user IDs админов которые получают alerts.
# Узнать ID: @userinfobot. Default 0 (никто) — fail-safe если не выставлен.
ADMIN_TELEGRAM_IDS=

# -----------------------------------------------------------------------------
# VAPID (Web Push, M06 v6.0)
# -----------------------------------------------------------------------------
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME            # base64url, 87 chars (P-256 EC)
VAPID_PRIVATE_KEY=CHANGE_ME           # base64url, 43 chars
VAPID_SUBJECT=mailto:admin@ruttrack.site

# -----------------------------------------------------------------------------
# Frontend / App URLs
# -----------------------------------------------------------------------------
MINI_APP_URL=https://t.me/ruttrack_bot/ruttrack
MINI_APP_WEB_URL=https://ruttrack.site/mini-app/
CORS_ALLOWED_ORIGIN=https://ruttrack.site

# WebSocket allowed origins (CSV). Default — production hostname.
# При смене домена в dev — добавить через запятую.
NOTIFICATION_WS_ALLOWED_ORIGINS=https://ruttrack.site

# -----------------------------------------------------------------------------
# Internal service-to-service auth (M03a + M03b)
# -----------------------------------------------------------------------------
# Shared secret для gRPC inter-service вызовов. Min 32 bytes.
# Generate: openssl rand -base64 32
GRPC_SECRET=CHANGE_ME

# Token-exchange shared secret (api-gateway ↔ auth-service). Min 32 bytes.
# Generate: openssl rand -base64 32
# Rotation: одновременно на обоих сервисах (см. secret-rotation.md).
INTERNAL_ISSUER_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# M14 G1 (CSO CRIT-01) — strict-mode invariant
# -----------------------------------------------------------------------------
# НЕ переопределять следующие переменные в prod. Defaults в application.yml
# выставлены на secure-by-default:
#   - RUTCAMPUSTRACK_SECURITY_LEGACY_HEADERS_ENABLED=false (downstream services)
#   - GATEWAY_STRIP_LEGACY_HEADERS=true (api-gateway)
#
# Иначе любой compromised контейнер на private_net (notification-bot,
# blackbox-exporter, certbot, cadvisor) сможет форджить admin-claims через
# X-User-Id / X-User-Role headers, минуя Internal JWT validation.
# Strict-mode = downstream сервисы принимают ТОЛЬКО Internal JWT, gateway
# strip'ает X-User-* перед proxy. Парная настройка.
# Подробности: docs/milestones/M13-pre-deploy-hardening/G27-cso-comprehensive-audit.md § CRIT-01.

# -----------------------------------------------------------------------------
# Monitoring secrets
# -----------------------------------------------------------------------------
# Bearer token для Alertmanager → notification-web webhook (M04 G9).
# Generate: openssl rand -hex 32
ALERT_WEBHOOK_SECRET=CHANGE_ME

# Grafana admin password (default user: admin).
# Generate: openssl rand -base64 16
GRAFANA_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Notification history retention (M10)
# -----------------------------------------------------------------------------
# TTL для notification_history collection в днях. Default 30.
NOTIFICATION_HISTORY_TTL_DAYS=30

# -----------------------------------------------------------------------------
# M11 G4 (NEW-125) — Swagger UI basic-auth
# -----------------------------------------------------------------------------
# Format: «login:hashed_password» (htpasswd-совместимый bcrypt или apr1).
# Generate (bcrypt предпочтительно):
#   htpasswd -nB swagger
# Generate (apr1 fallback без apache2-utils):
#   openssl passwd -apr1 <password> | awk '{print "swagger:"$1}'
#
# КРИТИЧНО: docker-compose интерполирует ${VAR} → нужно экранировать `$`
# как `$$` в этом файле. Пример: hash `$apr1$abc$xyz` → пишем
# `$$apr1$$abc$$xyz`. В runtime контейнера `$$` декодируется обратно в `$`.
#
# Rotation раз в 6 мес — docs/runbooks/swagger-prod-access.md.
SWAGGER_HTPASSWD=swagger:$$apr1$$CHANGE$$ME
